@@ -0,0 +1,246 @@
+//! UC Functions endpoints. A UC function is a stored routine definition
+//! (`uc_function` entity) inside a top-level namespace ("schema") of a
+//! warehouse ("catalog").
+//!
+//! Wire fidelity (design D3): the request's `function_info` is kept as an
+//! opaque [`serde_json::Value`] — the server never re-models the ~20 UC
+//! function fields, so `routine_definition`, `input_params.parameters` (array
+//! order and every per-parameter field), the `properties` JSON-string quirk
+//! (literal `"null"` from unitycatalog-ai) and all enum spellings round-trip
+//! unmodified. Responses are the stored spec with server fields merged in.
+//! There is no PATCH: UC has no function update endpoint.
+
+use axum::{
+    Extension, Json,
+    extract::{Path, Query, State},
+};
+use serde::{Deserialize, Serialize};
+
+use super::UcCatalogService;
+use crate::{
+    api::{
+        ApiContext,
+        uc::{UcEmptyResponse, UcErrorResponse, UcResult},
+    },
+    request_metadata::RequestMetadata,
+};
+
+/// UC `CreateFunctionRequest`: the body is a wrapper — the function fields
+/// are nested under `function_info`, NOT flat (compatibility trap).
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct CreateFunctionRequest {
+    pub function_info: serde_json::Value,
+}
+
+/// UC `FunctionInfo` response: the stored `function_info` JSON with server
+/// fields merged in. Kept as raw JSON to guarantee byte-fidelity of all
+/// client-supplied fields.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+#[serde(transparent)]
+pub struct FunctionInfo(pub serde_json::Value);
+
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct ListFunctionsResponse {
+    #[serde(default)]
+    pub functions: Vec<FunctionInfo>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub next_page_token: Option<String>,
+}
+
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct ListFunctionsQuery {
+    pub catalog_name: String,
+    pub schema_name: String,
+    #[serde(default)]
+    pub max_results: Option<i64>,
+    #[serde(default)]
+    pub page_token: Option<String>,
+}
+
+impl axum::response::IntoResponse for FunctionInfo {
+    fn into_response(self) -> axum::response::Response {
+        Json(self.0).into_response()
+    }
+}
+
+impl axum::response::IntoResponse for ListFunctionsResponse {
+    fn into_response(self) -> axum::response::Response {
+        Json(self).into_response()
+    }
+}
+
+/// The 14 required `CreateFunction` fields (uc-api-contract.md §4). Presence
+/// is validated; values (except the three name fields) are passed through
+/// verbatim.
+pub(crate) const REQUIRED_CREATE_FUNCTION_FIELDS: [&str; 14] = [
+    "name",
+    "catalog_name",
+    "schema_name",
+    "input_params",
+    "data_type",
+    "full_data_type",
+    "routine_body",
+    "routine_definition",
+    "parameter_style",
+    "is_deterministic",
+    "sql_data_access",
+    "is_null_call",
+    "security_type",
+    "specific_name",
+];
+
+/// Validate a `function_info` create payload and extract
+/// `(name, catalog_name, schema_name)`.
+pub(crate) fn validate_function_info(
+    function_info: &serde_json::Value,
+) -> UcResult<(String, String, String)> {
+    let obj = function_info
+        .as_object()
+        .ok_or_else(|| UcErrorResponse::invalid_argument("function_info must be a JSON object."))?;
+
+    for field in REQUIRED_CREATE_FUNCTION_FIELDS {
+        if !obj.contains_key(field) {
+            return Err(UcErrorResponse::invalid_argument(format!(
+                "Missing required field in function_info: {field}"
+            )));
+        }
+    }
+
+    let string_field = |field: &str| -> UcResult<String> {
+        obj.get(field)
+            .and_then(serde_json::Value::as_str)
+            .map(ToString::to_string)
+            .ok_or_else(|| {
+                UcErrorResponse::invalid_argument(format!(
+                    "function_info.{field} must be a non-null string."
+                ))
+            })
+    };
+
+    let name = string_field("name")?;
+    let catalog_name = string_field("catalog_name")?;
+    let schema_name = string_field("schema_name")?;
+
+    // `input_params` must be the `{"parameters": [...]}` object wrapper (not
+    // a bare array — another compatibility trap).
+    let input_params = &obj["input_params"];
+    if !input_params.is_object() {
+        return Err(UcErrorResponse::invalid_argument(
+            "function_info.input_params must be an object of the form {\"parameters\": [...]}.",
+        ));
+    }
+
+    Ok((name, catalog_name, schema_name))
+}
+
+pub(crate) async fn create_function<I: UcCatalogService<S>, S: crate::api::ThreadSafe>(
+    State(api_context): State<ApiContext<S>>,
+    Extension(metadata): Extension<RequestMetadata>,
+    Json(request): Json<CreateFunctionRequest>,
+) -> UcResult<FunctionInfo> {
+    I::create_function(request, api_context, metadata).await
+}
+
+pub(crate) async fn list_functions<I: UcCatalogService<S>, S: crate::api::ThreadSafe>(
+    Query(query): Query<ListFunctionsQuery>,
+    State(api_context): State<ApiContext<S>>,
+    Extension(metadata): Extension<RequestMetadata>,
+) -> UcResult<ListFunctionsResponse> {
+    I::list_functions(query, api_context, metadata).await
+}
+
+pub(crate) async fn get_function<I: UcCatalogService<S>, S: crate::api::ThreadSafe>(
+    Path(full_name): Path<String>,
+    State(api_context): State<ApiContext<S>>,
+    Extension(metadata): Extension<RequestMetadata>,
+) -> UcResult<FunctionInfo> {
+    I::get_function(full_name, api_context, metadata).await
+}
+
+pub(crate) async fn delete_function<I: UcCatalogService<S>, S: crate::api::ThreadSafe>(
+    Path(full_name): Path<String>,
+    State(api_context): State<ApiContext<S>>,
+    Extension(metadata): Extension<RequestMetadata>,
+) -> UcResult<UcEmptyResponse> {
+    I::delete_function(full_name, api_context, metadata)
+        .await
+        .map(|()| UcEmptyResponse {})
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn valid_info() -> serde_json::Value {
+        serde_json::json!({
+            "name": "fn1",
+            "catalog_name": "cat",
+            "schema_name": "sch",
+            "input_params": {"parameters": []},
+            "data_type": "LONG",
+            "full_data_type": "LONG",
+            "routine_body": "EXTERNAL",
+            "routine_definition": "return 1",
+            "parameter_style": "S",
+            "is_deterministic": true,
+            "sql_data_access": "NO_SQL",
+            "is_null_call": false,
+            "security_type": "DEFINER",
+            "specific_name": "fn1",
+            "properties": "null"
+        })
+    }
+
+    #[test]
+    fn test_create_function_request_is_wrapped() {
+        // The body nests everything under `function_info` (not flat).
+        let request: CreateFunctionRequest =
+            serde_json::from_value(serde_json::json!({"function_info": valid_info()})).unwrap();
+        assert_eq!(request.function_info["name"], "fn1");
+        assert!(serde_json::from_value::<CreateFunctionRequest>(valid_info()).is_err());
+    }
+
+    #[test]
+    fn test_validate_function_info_ok() {
+        let (name, catalog, schema) = validate_function_info(&valid_info()).unwrap();
+        assert_eq!(name, "fn1");
+        assert_eq!(catalog, "cat");
+        assert_eq!(schema, "sch");
+    }
+
+    #[test]
+    fn test_validate_function_info_missing_required_fields() {
+        for field in REQUIRED_CREATE_FUNCTION_FIELDS {
+            let mut info = valid_info();
+            info.as_object_mut().unwrap().remove(field);
+            let err = validate_function_info(&info).unwrap_err();
+            assert_eq!(err.status, 400, "{field}");
+            assert_eq!(err.error_code, "INVALID_ARGUMENT", "{field}");
+            assert!(err.message.contains(field), "{field}: {}", err.message);
+        }
+    }
+
+    #[test]
+    fn test_validate_function_info_rejects_bare_parameter_array() {
+        let mut info = valid_info();
+        info["input_params"] = serde_json::json!([]);
+        let err = validate_function_info(&info).unwrap_err();
+        assert_eq!(err.status, 400);
+        assert_eq!(err.error_code, "INVALID_ARGUMENT");
+    }
+
+    #[test]
+    fn test_validate_function_info_rejects_non_string_name() {
+        let mut info = valid_info();
+        info["name"] = serde_json::json!(42);
+        let err = validate_function_info(&info).unwrap_err();
+        assert_eq!(err.status, 400);
+        assert_eq!(err.error_code, "INVALID_ARGUMENT");
+    }
+
+    #[test]
+    fn test_function_info_serializes_transparently() {
+        let info = FunctionInfo(valid_info());
+        assert_eq!(serde_json::to_value(&info).unwrap(), valid_info());
+    }
+}
