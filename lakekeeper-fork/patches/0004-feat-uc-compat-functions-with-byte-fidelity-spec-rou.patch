+/// An action on a function with authorization context. Functions are not part
+/// of DEFINER view chains, so there is no delegated-execution flag.
+pub struct ActionOnFunction<'a, 'u, I: AuthZFunctionInfo, A> {
+    pub info: &'a I,
+    pub action: A,
+    pub user: Option<&'u UserOrRole>,
+}
+
+impl<I: AuthZFunctionInfo, A: Clone> Clone for ActionOnFunction<'_, '_, I, A> {
+    fn clone(&self) -> Self {
+        Self {
+            info: self.info,
+            action: self.action.clone(),
+            user: self.user,
+        }
+    }
+}
+
+impl<I: AuthZFunctionInfo, A> std::fmt::Debug for ActionOnFunction<'_, '_, I, A> {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("ActionOnFunction")
+            .field("info", &format!("<{}>", std::any::type_name::<I>()))
+            .field("action", &std::any::type_name::<A>())
+            .field("user", &self.user)
+            .finish()
+    }
+}
