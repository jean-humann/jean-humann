diff --git a/crates/lakekeeper-storage-postgres/src/uc/function.rs b/crates/lakekeeper-storage-postgres/src/uc/function.rs
new file mode 100644
index 00000000..bdbe5516
--- /dev/null
+++ b/crates/lakekeeper-storage-postgres/src/uc/function.rs
@@ -0,0 +1,622 @@
+//! Unity Catalog function queries (`uc_function` table).
+//!
+//! Functions are a dedicated entity: name uniqueness is case-insensitive per
+//! namespace. The client's `function_info` JSON lives verbatim in the `spec`
+//! JSONB column; JSONB preserves all JSON *values* exactly (strings byte for
+//! byte, array order, numbers) while normalizing object key order — which is
+//! semantically irrelevant on the wire. There is no update path: UC has no
+//! function PATCH endpoint.
+
+use iceberg::TableIdent;
+use lakekeeper::{
+    CONFIG, WarehouseId,
+    service::{
+        CatalogBackendError, CreateFunctionError, DropFunctionError, FunctionAlreadyExists,
+        FunctionCreation, FunctionId, FunctionInfo, FunctionListEntry, FunctionNotFound,
+        ListFunctionsError, LoadFunctionError, NamespaceId, NamespaceVersion, WarehouseVersion,
+    },
+};
+use uuid::Uuid;
+
+use crate::{
+    dbutils::DBErrorHandler as _,
+    namespace::parse_namespace_identifier_from_vec,
+    pagination::{PaginateToken, V1PaginateToken},
+};
+
+struct FunctionFullRow {
+    function_id: Uuid,
+    warehouse_id: Uuid,
+    warehouse_version: i64,
+    namespace_id: Uuid,
+    namespace_version: i64,
+    namespace_name: Vec<String>,
+    name: String,
+    spec: serde_json::Value,
+    created_at: chrono::DateTime<chrono::Utc>,
+    updated_at: Option<chrono::DateTime<chrono::Utc>>,
+}
+
+struct FunctionListRow {
+    function_id: Uuid,
+    warehouse_id: Uuid,
+    namespace_id: Uuid,
+    name: String,
+    spec: serde_json::Value,
+    created_at: chrono::DateTime<chrono::Utc>,
+    updated_at: Option<chrono::DateTime<chrono::Utc>>,
+}
+
+fn full_row_to_info(row: FunctionFullRow) -> Result<FunctionInfo, CatalogBackendError> {
+    let warehouse_id = WarehouseId::from(row.warehouse_id);
+    let namespace_ident = parse_namespace_identifier_from_vec(
+        &row.namespace_name,
+        warehouse_id,
+        Some(row.namespace_id),
+    )
+    .map_err(CatalogBackendError::new_unexpected)?;
+
+    let name = row.name;
+    let function_ident = TableIdent {
+        namespace: namespace_ident.clone(),
+        name: name.clone(),
+    };
+
+    Ok(FunctionInfo {
+        function_id: row.function_id.into(),
+        warehouse_id,
+        warehouse_version: WarehouseVersion::new(row.warehouse_version),
+        namespace_id: row.namespace_id.into(),
+        namespace_version: NamespaceVersion::new(row.namespace_version),
+        namespace_ident,
+        name,
+        function_ident,
+        spec: row.spec,
+        created_at: row.created_at,
+        updated_at: row.updated_at,
+    })
+}
+
+pub(crate) async fn create_function(
+    creation: FunctionCreation,
+    transaction: &mut sqlx::Transaction<'_, sqlx::Postgres>,
+) -> Result<FunctionInfo, CreateFunctionError> {
+    let function_id: Uuid = *creation.function_id;
+    let warehouse_id: Uuid = *creation.warehouse_id;
+    let namespace_id: Uuid = *creation.namespace_id;
+
+    let row = sqlx::query_as!(
+        FunctionFullRow,
+        r#"
+        WITH inserted AS (
+            INSERT INTO uc_function (warehouse_id, function_id, namespace_id, name, spec)
+            SELECT $1, $2, $3, $4, $5
+            FROM namespace n
+            WHERE n.namespace_id = $3 AND n.warehouse_id = $1
+            RETURNING function_id, warehouse_id, namespace_id, name, spec, created_at, updated_at
+        )
+        SELECT
+            i.function_id,
+            i.warehouse_id,
+            w.version as "warehouse_version!",
+            i.namespace_id,
+            n.version as "namespace_version!",
+            n.namespace_name as "namespace_name!",
+            i.name,
+            i.spec,
+            i.created_at,
+            i.updated_at
+        FROM inserted i
+        INNER JOIN warehouse w ON w.warehouse_id = $1 AND w.status = 'active'
+        INNER JOIN namespace n ON n.namespace_id = $3 AND n.warehouse_id = $1
+        "#,
+        warehouse_id,
+        function_id,
+        namespace_id,
+        &creation.name,
+        &creation.spec,
+    )
+    .fetch_optional(&mut **transaction)
+    .await
+    .map_err(|e| match &e {
+        sqlx::Error::Database(db_err)
+            if [
+                Some("uc_function_unique_name_per_namespace_idx"),
+                Some("uc_function_pkey"),
+            ]
+            .contains(&db_err.constraint()) =>
+        {
+            CreateFunctionError::from(FunctionAlreadyExists::new())
+        }
+        _ => e.into_catalog_backend_error().into(),
+    })?
+    .ok_or_else(|| {
+        CreateFunctionError::from(CatalogBackendError::new_unexpected(
+            lakekeeper::service::InternalErrorMessage(format!(
+                "Namespace {namespace_id} not found in warehouse {warehouse_id} or warehouse not active while creating function"
+            )),
+        ))
+    })?;
+
+    full_row_to_info(row).map_err(CreateFunctionError::from)
+}
+
+pub(crate) async fn load_function(
+    warehouse_id: WarehouseId,
+    namespace_id: NamespaceId,
+    function_name: &str,
+    transaction: &mut sqlx::Transaction<'_, sqlx::Postgres>,
+) -> Result<FunctionInfo, LoadFunctionError> {
+    let row = sqlx::query_as!(
+        FunctionFullRow,
+        r#"
+        SELECT
+            f.function_id,
+            f.warehouse_id,
+            w.version as "warehouse_version!",
+            f.namespace_id,
+            n.version as "namespace_version!",
+            n.namespace_name as "namespace_name!",
+            f.name,
+            f.spec,
+            f.created_at,
+            f.updated_at
+        FROM uc_function f
+        INNER JOIN warehouse w ON w.warehouse_id = f.warehouse_id AND w.status = 'active'
+        INNER JOIN namespace n ON n.namespace_id = f.namespace_id AND n.warehouse_id = f.warehouse_id
+        WHERE f.warehouse_id = $1
+          AND f.namespace_id = $2
+          AND f.name = $3
+          AND f.deleted_at IS NULL
+        "#,
+        *warehouse_id,
+        *namespace_id,
+        function_name,
+    )
+    .fetch_optional(&mut **transaction)
+    .await
+    .map_err(|e| LoadFunctionError::from(e.into_catalog_backend_error()))?
+    .ok_or_else(|| LoadFunctionError::from(FunctionNotFound::new()))?;
+
+    full_row_to_info(row).map_err(LoadFunctionError::from)
+}
+
+/// Load a function by its stable id (TOCTOU-safe follow-up reads after an
+/// authorization check).
+pub(crate) async fn load_function_by_id(
+    warehouse_id: WarehouseId,
+    function_id: FunctionId,
+    transaction: &mut sqlx::Transaction<'_, sqlx::Postgres>,
+) -> Result<FunctionInfo, LoadFunctionError> {
+    let row = sqlx::query_as!(
+        FunctionFullRow,
+        r#"
+        SELECT
+            f.function_id,
+            f.warehouse_id,
+            w.version as "warehouse_version!",
+            f.namespace_id,
+            n.version as "namespace_version!",
+            n.namespace_name as "namespace_name!",
+            f.name,
+            f.spec,
+            f.created_at,
+            f.updated_at
+        FROM uc_function f
+        INNER JOIN warehouse w ON w.warehouse_id = f.warehouse_id AND w.status = 'active'
+        INNER JOIN namespace n ON n.namespace_id = f.namespace_id AND n.warehouse_id = f.warehouse_id
+        WHERE f.warehouse_id = $1
+          AND f.function_id = $2
+          AND f.deleted_at IS NULL
+        "#,
+        *warehouse_id,
+        *function_id,
+    )
+    .fetch_optional(&mut **transaction)
+    .await
+    .map_err(|e| LoadFunctionError::from(e.into_catalog_backend_error()))?
+    .ok_or_else(|| LoadFunctionError::from(FunctionNotFound::new()))?;
+
+    full_row_to_info(row).map_err(LoadFunctionError::from)
+}
+
+pub(crate) async fn list_functions(
+    warehouse_id: WarehouseId,
+    namespace_id: NamespaceId,
+    namespace_ident: &iceberg::NamespaceIdent,
+    page_size: Option<i64>,
+    page_token: Option<&str>,
+    transaction: &mut sqlx::Transaction<'_, sqlx::Postgres>,
+) -> Result<(Vec<FunctionListEntry>, Option<String>), ListFunctionsError> {
+    let page_size = CONFIG.page_size_or_pagination_default(page_size);
+
+    let token = page_token
+        .map(PaginateToken::<Uuid>::try_from)
+        .transpose()
+        .map_err(|e| ListFunctionsError::from(CatalogBackendError::new_unexpected(e)))?;
+
+    let (token_ts, token_id) = token
+        .as_ref()
+        .map(
+            |PaginateToken::V1(V1PaginateToken { created_at, id }): &PaginateToken<Uuid>| {
+                (created_at, id)
+            },
+        )
+        .map_or((None, None), |(ts, id)| (Some(*ts), Some(*id)));
+
+    let rows = sqlx::query_as!(
+        FunctionListRow,
+        r#"
+        SELECT
+            f.function_id,
+            f.warehouse_id,
+            f.namespace_id,
+            f.name,
+            f.spec,
+            f.created_at,
+            f.updated_at
+        FROM uc_function f
+        INNER JOIN warehouse w ON w.warehouse_id = f.warehouse_id AND w.status = 'active'
+        WHERE f.warehouse_id = $1
+          AND f.namespace_id = $2
+          AND f.deleted_at IS NULL
+          AND (
+            ($3::timestamptz IS NULL)
+            OR (f.created_at, f.function_id) > ($3, $4)
+          )
+        ORDER BY f.created_at ASC, f.function_id ASC
+        LIMIT $5
+        "#,
+        *warehouse_id,
+        *namespace_id,
+        token_ts,
+        token_id,
+        page_size,
+    )
+    .fetch_all(&mut **transaction)
+    .await
+    .map_err(|e| ListFunctionsError::from(e.into_catalog_backend_error()))?;
+
+    let mut entries = Vec::with_capacity(rows.len());
+    let mut next_page_token = None;
+
+    for row in rows {
+        next_page_token = Some(
+            PaginateToken::V1(V1PaginateToken {
+                created_at: row.created_at,
+                id: row.function_id,
+            })
+            .to_string(),
+        );
+
+        let function_ident = TableIdent::new(namespace_ident.clone(), row.name.clone());
+        entries.push(FunctionListEntry {
+            function_id: row.function_id.into(),
+            warehouse_id: row.warehouse_id.into(),
+            namespace_id: row.namespace_id.into(),
+            name: row.name,
+            function_ident,
+            namespace_ident: namespace_ident.clone(),
+            spec: row.spec,
+            created_at: row.created_at,
+            updated_at: row.updated_at,
+        });
+    }
+
+    Ok((entries, next_page_token))
+}
+
+/// Hard delete (UC DELETE semantics in v1).
+pub(crate) async fn drop_function(
+    warehouse_id: WarehouseId,
+    namespace_id: NamespaceId,
+    function_name: &str,
+    transaction: &mut sqlx::Transaction<'_, sqlx::Postgres>,
+) -> Result<FunctionId, DropFunctionError> {
+    let row = sqlx::query!(
+        r#"
+        DELETE FROM uc_function f
+        USING warehouse w
+        WHERE w.warehouse_id = f.warehouse_id
+          AND w.status = 'active'
+          AND f.warehouse_id = $1
+          AND f.namespace_id = $2
+          AND f.name = $3
+          AND f.deleted_at IS NULL
+        RETURNING f.function_id
+        "#,
+        *warehouse_id,
+        *namespace_id,
+        function_name,
+    )
+    .fetch_optional(&mut **transaction)
+    .await
+    .map_err(|e| DropFunctionError::from(e.into_catalog_backend_error()))?
+    .ok_or_else(|| DropFunctionError::from(FunctionNotFound::new()))?;
+
+    Ok(row.function_id.into())
+}
+
+#[cfg(test)]
+mod tests {
+    use iceberg::NamespaceIdent;
+    use lakekeeper::service::{FunctionCreation, FunctionId};
+    use sqlx::PgPool;
+    use uuid::Uuid;
+
+    use super::*;
+    use crate::{
+        CatalogState, namespace::tests::initialize_namespace, warehouse::test::initialize_warehouse,
+    };
+
+    async fn setup(pool: PgPool) -> (CatalogState, PgPool, WarehouseId, NamespaceId) {
+        let state = CatalogState::from_pools(pool.clone(), pool.clone());
+        let (_project_id, warehouse_id) =
+            initialize_warehouse(state.clone(), None, None, None, true).await;
+        let namespace = NamespaceIdent::new(Uuid::now_v7().to_string());
+        let ns = initialize_namespace(state.clone(), warehouse_id, &namespace, None).await;
+        let namespace_id = ns.namespace_id();
+        (state, pool, warehouse_id, namespace_id)
+    }
+
+    /// A realistic unitycatalog-ai `function_info` payload with the quirks
+    /// the round-trip must preserve: `properties` as the literal string
+    /// `"null"`, embedded-JSON `type_json` strings, a multi-line
+    /// `routine_definition` and `parameter_default`.
+    fn ai_spec(name: &str) -> serde_json::Value {
+        serde_json::json!({
+            "name": name,
+            "catalog_name": "cat",
+            "schema_name": "sch",
+            "input_params": {
+                "parameters": [
+                    {
+                        "name": "a",
+                        "type_text": "long",
+                        "type_json": "{\"name\": \"a\", \"type\": \"long\", \"nullable\": false, \"metadata\": {\"comment\": \"The first number.\"}}",
+                        "type_name": "LONG",
+                        "position": 0,
+                        "parameter_mode": "IN",
+                        "parameter_type": "PARAM",
+                        "comment": "The first number."
+                    },
+                    {
+                        "name": "b",
+                        "type_text": "array<string>",
+                        "type_json": "{\"name\": \"b\", \"type\": \"array<string>\", \"nullable\": true, \"metadata\": {}}",
+                        "type_name": "ARRAY",
+                        "position": 1,
+                        "parameter_default": "NULL"
+                    }
+                ]
+            },
+            "data_type": "LONG",
+            "full_data_type": "LONG",
+            "routine_body": "EXTERNAL",
+            "routine_definition": "result = a + len(b or [])\nreturn result",
+            "external_language": "PYTHON",
+            "parameter_style": "S",
+            "is_deterministic": true,
+            "sql_data_access": "NO_SQL",
+            "is_null_call": false,
+            "security_type": "DEFINER",
+            "specific_name": name,
+            "comment": "Adds two numbers.\n\nArgs:\n    a: The first number.",
+            "properties": "null"
+        })
+    }
+
+    fn test_creation(
+        warehouse_id: WarehouseId,
+        namespace_id: NamespaceId,
+        name: &str,
+    ) -> FunctionCreation {
+        FunctionCreation {
+            function_id: FunctionId::from(Uuid::now_v7()),
+            namespace_id,
+            warehouse_id,
+            name: name.to_string(),
+            spec: ai_spec(name),
+        }
+    }
+
+    #[sqlx::test]
+    async fn test_create_and_load(pool: PgPool) {
+        let (_state, pool, warehouse_id, namespace_id) = setup(pool).await;
+        let creation = test_creation(warehouse_id, namespace_id, "add_numbers");
+
+        let mut t = pool.begin().await.unwrap();
+        let info = create_function(creation.clone(), &mut t).await.unwrap();
+        t.commit().await.unwrap();
+
+        assert_eq!(info.name, "add_numbers");
+        assert_eq!(info.spec, creation.spec);
+        assert_eq!(info.function_id, creation.function_id);
+
+        // Load by name
+        let mut t = pool.begin().await.unwrap();
+        let loaded = load_function(warehouse_id, namespace_id, "add_numbers", &mut t)
+            .await
+            .unwrap();
+        t.commit().await.unwrap();
+        assert_eq!(loaded.function_id, info.function_id);
+        assert_eq!(loaded.name, "add_numbers");
+
+        // Load by id
+        let mut t = pool.begin().await.unwrap();
+        let by_id = load_function_by_id(warehouse_id, info.function_id, &mut t)
+            .await
+            .unwrap();
+        t.commit().await.unwrap();
+        assert_eq!(by_id.function_id, info.function_id);
+        assert_eq!(by_id.spec, creation.spec);
+    }
+
+    #[sqlx::test]
+    async fn test_spec_roundtrip_fidelity(pool: PgPool) {
+        let (_state, pool, warehouse_id, namespace_id) = setup(pool).await;
+        let creation = test_creation(warehouse_id, namespace_id, "fidelity");
+        let original_spec = creation.spec.clone();
+
+        let mut t = pool.begin().await.unwrap();
+        create_function(creation, &mut t).await.unwrap();
+        t.commit().await.unwrap();
+
+        let mut t = pool.begin().await.unwrap();
+        let loaded = load_function(warehouse_id, namespace_id, "fidelity", &mut t)
+            .await
+            .unwrap();
+        t.commit().await.unwrap();
+
+        // Exact JSON equality of the whole stored document.
+        assert_eq!(loaded.spec, original_spec);
+
+        // The load-bearing string values must come back byte-identical:
+        // `properties` is the literal 4-char string "null" (not JSON null),
+        // `type_json` values are embedded-JSON strings, the routine body
+        // keeps its newlines.
+        assert_eq!(
+            loaded.spec["properties"],
+            serde_json::Value::String("null".to_string())
+        );
+        assert_eq!(
+            loaded.spec["routine_definition"].as_str().unwrap(),
+            "result = a + len(b or [])\nreturn result"
+        );
+        let params = loaded.spec["input_params"]["parameters"]
+            .as_array()
+            .unwrap();
+        assert_eq!(params.len(), 2);
+        assert_eq!(
+            params[0]["type_json"].as_str().unwrap(),
+            "{\"name\": \"a\", \"type\": \"long\", \"nullable\": false, \"metadata\": {\"comment\": \"The first number.\"}}"
+        );
+        assert_eq!(params[1]["type_name"], "ARRAY");
+        assert_eq!(params[1]["type_text"], "array<string>");
+        assert_eq!(params[1]["parameter_default"], "NULL");
+        assert_eq!(params[0]["position"], 0);
+        assert_eq!(params[1]["position"], 1);
+    }
+
+    #[sqlx::test]
+    async fn test_name_conflict(pool: PgPool) {
+        let (_state, pool, warehouse_id, namespace_id) = setup(pool).await;
+
+        let mut t = pool.begin().await.unwrap();
+        create_function(test_creation(warehouse_id, namespace_id, "dup"), &mut t)
+            .await
+            .unwrap();
+        t.commit().await.unwrap();
+
+        // Case-insensitive conflict.
+        let mut t = pool.begin().await.unwrap();
+        let err = create_function(test_creation(warehouse_id, namespace_id, "DUP"), &mut t)
+            .await
+            .expect_err("duplicate name should fail");
+        t.rollback().await.ok();
+
+        assert!(
+            matches!(err, CreateFunctionError::FunctionAlreadyExists(_)),
+            "expected AlreadyExists, got: {err:?}"
+        );
+    }
+
+    #[sqlx::test]
+    async fn test_list_with_pagination(pool: PgPool) {
+        let (_state, pool, warehouse_id, namespace_id) = setup(pool).await;
+        let ns_ident = NamespaceIdent::new("test".to_string());
+
+        for name in ["a", "b", "c"] {
+            let mut t = pool.begin().await.unwrap();
+            create_function(test_creation(warehouse_id, namespace_id, name), &mut t)
+                .await
+                .unwrap();
+            t.commit().await.unwrap();
+        }
+
+        let mut t = pool.begin().await.unwrap();
+        let (page1, token) =
+            list_functions(warehouse_id, namespace_id, &ns_ident, Some(2), None, &mut t)
+                .await
+                .unwrap();
+        t.commit().await.unwrap();
+        assert_eq!(page1.len(), 2);
+        assert!(token.is_some());
+        // List entries carry the full spec (UC list returns FunctionInfo).
+        assert_eq!(page1[0].spec, ai_spec("a"));
+
+        let mut t = pool.begin().await.unwrap();
+        let (page2, token2) = list_functions(
+            warehouse_id,
+            namespace_id,
+            &ns_ident,
+            Some(2),
+            token.as_deref(),
+            &mut t,
+        )
+        .await
+        .unwrap();
+        t.commit().await.unwrap();
+        assert_eq!(page2.len(), 1);
+
+        if token2.is_some() {
+            let mut t = pool.begin().await.unwrap();
+            let (page3, _) = list_functions(
+                warehouse_id,
+                namespace_id,
+                &ns_ident,
+                Some(2),
+                token2.as_deref(),
+                &mut t,
+            )
+            .await
+            .unwrap();
+            t.commit().await.unwrap();
+            assert!(page3.is_empty());
+        }
+    }
+
+    #[sqlx::test]
+    async fn test_drop_and_verify_gone(pool: PgPool) {
+        let (_state, pool, warehouse_id, namespace_id) = setup(pool).await;
+
+        let mut t = pool.begin().await.unwrap();
+        let info = create_function(test_creation(warehouse_id, namespace_id, "to-drop"), &mut t)
+            .await
+            .unwrap();
+        t.commit().await.unwrap();
+
+        let mut t = pool.begin().await.unwrap();
+        let dropped_id = drop_function(warehouse_id, namespace_id, "to-drop", &mut t)
+            .await
+            .unwrap();
+        t.commit().await.unwrap();
+        assert_eq!(dropped_id, info.function_id);
+
+        let mut t = pool.begin().await.unwrap();
+        let err = load_function(warehouse_id, namespace_id, "to-drop", &mut t)
+            .await
+            .expect_err("should be gone");
+        t.commit().await.unwrap();
+        assert!(matches!(err, LoadFunctionError::FunctionNotFound(_)));
+
+        // Hard delete: the name is free again.
+        let mut t = pool.begin().await.unwrap();
+        create_function(test_creation(warehouse_id, namespace_id, "to-drop"), &mut t)
+            .await
+            .expect("name is free after hard delete");
+        t.commit().await.unwrap();
+    }
+
+    #[sqlx::test]
+    async fn test_drop_not_found(pool: PgPool) {
+        let (_state, pool, warehouse_id, namespace_id) = setup(pool).await;
+
+        let mut t = pool.begin().await.unwrap();
+        let err = drop_function(warehouse_id, namespace_id, "ghost", &mut t)
+            .await
+            .expect_err("should not exist");
+        t.rollback().await.ok();
+        assert!(matches!(err, DropFunctionError::FunctionNotFound(_)));
+    }
+}
