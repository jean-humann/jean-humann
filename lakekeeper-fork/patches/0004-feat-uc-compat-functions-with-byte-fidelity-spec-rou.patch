+//! Unity Catalog compatibility API (Phase C): Functions, driven through the
+//! `UcCatalogService` trait on `CatalogServer` (same harness as
+//! `server_uc_volumes.rs`).
+//!
+//! The payloads mirror what unitycatalog-ai's `create_python_function` sends
+//! (uc-api-contract.md §8); the assertions check the byte-fidelity guarantees
+//! client-side execution depends on.
+
+use std::collections::HashMap;
+
+use lakekeeper::{
+    api::{
+        ApiContext,
+        uc::v1::{
+            CreateFunctionRequest, CreateSchemaRequest, ListFunctionsQuery, UcCatalogService as _,
+        },
+    },
+    server::CatalogServer,
+    service::{
+        CatalogStore, CatalogWarehouseOps as _, State, Transaction as _,
+        authz::AllowAllAuthorizer,
+        storage::{MemoryProfile, StorageProfile},
+    },
+};
+use lakekeeper_integration_tests::{get_api_context, random_request_metadata};
+use lakekeeper_storage_postgres::{
+    PostgresBackend, SecretsState, warehouse::test::initialize_warehouse,
+};
+use sqlx::PgPool;
+
+type Ctx = ApiContext<State<AllowAllAuthorizer, PostgresBackend, SecretsState>>;
+
+const SCHEMA: &str = "fns_schema";
+
+/// Returns `(ctx, catalog_name)` with the schema `SCHEMA` pre-created.
+async fn setup(pool: PgPool) -> (Ctx, String) {
+    lakekeeper_storage_postgres::migrations::migrate_core_only(&pool)
+        .await
+        .unwrap();
+    let api_context = get_api_context(&pool, AllowAllAuthorizer::default()).await;
+    let state = api_context.v1_state.catalog.clone();
+
+    let profile = StorageProfile::Memory(MemoryProfile::default());
+    let (_project_id, warehouse_id) =
+        initialize_warehouse(state.clone(), Some(profile), None, None, true).await;
+
+    // Unique warehouse name: the name→id cache is process-global while each
+    // `#[sqlx::test]` runs against its own database.
+    let catalog_name = format!("uc_wh_{}", uuid::Uuid::now_v7().simple());
+    let mut t = <PostgresBackend as CatalogStore>::Transaction::begin_write(state)
+        .await
+        .unwrap();
+    PostgresBackend::rename_warehouse(warehouse_id, &catalog_name, t.transaction())
+        .await
+        .unwrap();
+    t.commit().await.unwrap();
+
+    CatalogServer::create_schema(
+        CreateSchemaRequest {
+            name: SCHEMA.to_string(),
+            catalog_name: catalog_name.clone(),
+            comment: None,
+            properties: HashMap::new(),
+            storage_root: None,
+        },
+        api_context.clone(),
+        random_request_metadata(),
+    )
+    .await
+    .unwrap();
+
+    (api_context, catalog_name)
+}
+
+/// A realistic `function_info` as sent by unitycatalog-ai's
+/// `create_python_function(add_numbers, ...)`: EXTERNAL PYTHON routine with a
+/// multi-line body, `properties` as the literal string `"null"`, and
+/// parameters carrying embedded-JSON `type_json` strings.
+fn ai_function_info(catalog: &str, name: &str) -> serde_json::Value {
+    serde_json::json!({
+        "name": name,
+        "catalog_name": catalog,
+        "schema_name": SCHEMA,
+        "input_params": {
+            "parameters": [
+                {
+                    "name": "a",
+                    "type_text": "long",
+                    "type_json": "{\"name\": \"a\", \"type\": \"long\", \"nullable\": false, \"metadata\": {\"comment\": \"The first number.\"}}",
+                    "type_name": "LONG",
+                    "position": 0,
+                    "parameter_mode": "IN",
+                    "parameter_type": "PARAM",
+                    "comment": "The first number."
+                },
+                {
+                    "name": "b",
+                    "type_text": "array<string>",
+                    "type_json": "{\"name\": \"b\", \"type\": \"array<string>\", \"nullable\": true, \"metadata\": {}}",
+                    "type_name": "ARRAY",
+                    "position": 1,
+                    "parameter_default": "NULL",
+                    "comment": "The second number."
+                }
+            ]
+        },
+        "data_type": "LONG",
+        "full_data_type": "LONG",
+        "routine_body": "EXTERNAL",
+        "routine_definition": "result = a + len(b or [])\nreturn result",
+        "external_language": "PYTHON",
+        "parameter_style": "S",
+        "is_deterministic": true,
+        "sql_data_access": "NO_SQL",
+        "is_null_call": false,
+        "security_type": "DEFINER",
+        "specific_name": name,
+        "comment": "Adds two numbers and returns the result.\n\nArgs:\n    a: The first number.",
+        "properties": "null"
+    })
+}
+
+fn create_request(catalog: &str, name: &str) -> CreateFunctionRequest {
+    CreateFunctionRequest {
+        function_info: ai_function_info(catalog, name),
+    }
+}
+
+#[sqlx::test]
+async fn test_create_get_roundtrip_byte_fidelity(pool: PgPool) {
+    let (ctx, catalog) = setup(pool).await;
+    let sent = ai_function_info(&catalog, "add_numbers");
+
+    let created = CatalogServer::create_function(
+        create_request(&catalog, "add_numbers"),
+        ctx.clone(),
+        random_request_metadata(),
+    )
+    .await
+    .unwrap();
+    let created = created.0;
+
+    // Server fields.
+    assert_eq!(created["name"], "add_numbers");
+    assert_eq!(created["catalog_name"], catalog.as_str());
+    assert_eq!(created["schema_name"], SCHEMA);
+    assert_eq!(
+        created["full_name"],
+        format!("{catalog}.{SCHEMA}.add_numbers")
+    );
+    uuid::Uuid::parse_str(created["function_id"].as_str().unwrap())
+        .expect("function_id must be a UUID");
+    assert!(created["created_at"].is_i64());
+
+    // Fetch and compare byte-fidelity of every client-supplied field.
+    let fetched = CatalogServer::get_function(
+        format!("{catalog}.{SCHEMA}.add_numbers"),
+        ctx.clone(),
+        random_request_metadata(),
+    )
+    .await
+    .unwrap();
+    let fetched = fetched.0;
+    assert_eq!(fetched, created, "get must return exactly what create did");
+
+    for field in [
+        "routine_definition",
+        "external_language",
+        "routine_body",
+        "data_type",
+        "full_data_type",
+        "parameter_style",
+        "is_deterministic",
+        "sql_data_access",
+        "is_null_call",
+        "security_type",
+        "specific_name",
+        "comment",
+        "properties",
+        "input_params",
+    ] {
+        assert_eq!(fetched[field], sent[field], "field {field} must round-trip");
+    }
+    // The critical unitycatalog-ai quirks, spelled out:
+    assert_eq!(fetched["properties"], serde_json::json!("null"));
+    assert_eq!(
+        fetched["routine_definition"].as_str().unwrap(),
+        "result = a + len(b or [])\nreturn result"
+    );
+    let params = fetched["input_params"]["parameters"].as_array().unwrap();
+    assert_eq!(params.len(), 2);
+    assert_eq!(params[0]["name"], "a");
+    assert_eq!(params[0]["position"], 0);
+    assert_eq!(params[1]["name"], "b");
+    assert_eq!(params[1]["position"], 1);
+    assert_eq!(params[1]["type_name"], "ARRAY");
+    assert_eq!(params[1]["type_text"], "array<string>");
+    assert_eq!(params[1]["parameter_default"], "NULL");
+    assert_eq!(
+        params[0]["type_json"].as_str().unwrap(),
+        "{\"name\": \"a\", \"type\": \"long\", \"nullable\": false, \"metadata\": {\"comment\": \"The first number.\"}}"
+    );
+}
+
+#[sqlx::test]
+async fn test_list_functions_with_pagination(pool: PgPool) {
+    let (ctx, catalog) = setup(pool).await;
+    for name in ["fa", "fb", "fc"] {
+        CatalogServer::create_function(
+            create_request(&catalog, name),
+            ctx.clone(),
+            random_request_metadata(),
+        )
+        .await
+        .unwrap();
+    }
+
+    let query = |max_results, page_token| ListFunctionsQuery {
+        catalog_name: catalog.clone(),
+        schema_name: SCHEMA.to_string(),
+        max_results,
+        page_token,
+    };
+
+    let all =
+        CatalogServer::list_functions(query(None, None), ctx.clone(), random_request_metadata())
+            .await
+            .unwrap();
+    assert_eq!(all.functions.len(), 3);
+    // List returns full FunctionInfo objects, not stubs.
+    assert_eq!(all.functions[0].0["routine_body"], "EXTERNAL");
+    assert!(all.functions[0].0["function_id"].is_string());
+
+    let page1 =
+        CatalogServer::list_functions(query(Some(2), None), ctx.clone(), random_request_metadata())
+            .await
+            .unwrap();
+    assert_eq!(page1.functions.len(), 2);
+    let token = page1.next_page_token.expect("more pages");
+
+    let page2 = CatalogServer::list_functions(
+        query(Some(2), Some(token)),
+        ctx.clone(),
+        random_request_metadata(),
+    )
+    .await
+    .unwrap();
+    assert_eq!(page2.functions.len(), 1);
+
+    let names: Vec<_> = page1
+        .functions
+        .iter()
+        .chain(page2.functions.iter())
+        .map(|f| f.0["name"].as_str().unwrap().to_string())
+        .collect();
+    assert_eq!(names, ["fa", "fb", "fc"]);
+
+    // Negative max_results is INVALID_ARGUMENT.
+    let err = CatalogServer::list_functions(query(Some(-1), None), ctx, random_request_metadata())
+        .await
+        .unwrap_err();
+    assert_eq!(err.status, 400);
+    assert_eq!(err.error_code, "INVALID_ARGUMENT");
+}
+
+#[sqlx::test]
+async fn test_delete_function(pool: PgPool) {
+    let (ctx, catalog) = setup(pool).await;
+    let full_name = format!("{catalog}.{SCHEMA}.gone");
+    CatalogServer::create_function(
+        create_request(&catalog, "gone"),
+        ctx.clone(),
+        random_request_metadata(),
+    )
+    .await
+    .unwrap();
+
+    CatalogServer::delete_function(full_name.clone(), ctx.clone(), random_request_metadata())
+        .await
+        .unwrap();
+
+    let err =
+        CatalogServer::get_function(full_name.clone(), ctx.clone(), random_request_metadata())
+            .await
+            .unwrap_err();
+    assert_eq!(err.status, 404);
+    assert_eq!(err.error_code, "NOT_FOUND");
+
+    // unitycatalog-ai `replace=True` flow: name is free again after delete.
+    CatalogServer::create_function(
+        create_request(&catalog, "gone"),
+        ctx,
+        random_request_metadata(),
+    )
+    .await
+    .expect("name must be reusable after hard delete");
+}
+
+#[sqlx::test]
+async fn test_name_conflict_is_409(pool: PgPool) {
+    let (ctx, catalog) = setup(pool).await;
+    CatalogServer::create_function(
+        create_request(&catalog, "dup"),
+        ctx.clone(),
+        random_request_metadata(),
+    )
+    .await
+    .unwrap();
+
+    // Case-insensitive conflict.
+    let err = CatalogServer::create_function(
+        create_request(&catalog, "DUP"),
+        ctx,
+        random_request_metadata(),
+    )
+    .await
+    .unwrap_err();
+    assert_eq!(err.status, 409, "{err:?}");
+    assert_eq!(err.error_code, "ALREADY_EXISTS");
+}
+
+#[sqlx::test]
+async fn test_missing_required_field_is_400(pool: PgPool) {
+    let (ctx, catalog) = setup(pool).await;
+
+    for field in [
+        "name",
+        "input_params",
+        "routine_definition",
+        "specific_name",
+        "is_deterministic",
+    ] {
+        let mut info = ai_function_info(&catalog, "bad");
+        info.as_object_mut().unwrap().remove(field);
+        let err = CatalogServer::create_function(
+            CreateFunctionRequest {
+                function_info: info,
+            },
+            ctx.clone(),
+            random_request_metadata(),
+        )
+        .await
+        .unwrap_err();
+        assert_eq!(err.status, 400, "{field}");
+        assert_eq!(err.error_code, "INVALID_ARGUMENT", "{field}");
+        assert!(err.message.contains(field), "{field}: {}", err.message);
+    }
+
+    // Invalid function names.
+    for bad_name in ["", "a.b", "a/b"] {
+        let err = CatalogServer::create_function(
+            create_request(&catalog, bad_name),
+            ctx.clone(),
+            random_request_metadata(),
+        )
+        .await
+        .unwrap_err();
+        assert_eq!(err.status, 400, "{bad_name}");
+        assert_eq!(err.error_code, "INVALID_ARGUMENT", "{bad_name}");
+    }
+}
+
+#[sqlx::test]
+async fn test_three_part_name_parsing(pool: PgPool) {
+    let (ctx, _catalog) = setup(pool).await;
+    for bad in ["", "cat", "cat.schema", "cat.schema.fn.extra", "a..b"] {
+        let err =
+            CatalogServer::get_function(bad.to_string(), ctx.clone(), random_request_metadata())
+                .await
+                .unwrap_err();
+        assert_eq!(err.status, 400, "{bad}");
+        assert_eq!(err.error_code, "INVALID_ARGUMENT", "{bad}");
+    }
+}
+
+#[sqlx::test]
+async fn test_404_masking_for_missing_function(pool: PgPool) {
+    let (ctx, catalog) = setup(pool).await;
+
+    // Missing function in an existing schema.
+    let err = CatalogServer::get_function(
+        format!("{catalog}.{SCHEMA}.ghost"),
+        ctx.clone(),
+        random_request_metadata(),
+    )
+    .await
+    .unwrap_err();
+    assert_eq!(err.status, 404);
+    assert_eq!(err.error_code, "NOT_FOUND");
+
+    // Missing schema.
+    let err = CatalogServer::get_function(
+        format!("{catalog}.no_such_schema.ghost"),
+        ctx.clone(),
+        random_request_metadata(),
+    )
+    .await
+    .unwrap_err();
+    assert_eq!(err.status, 404);
+    assert_eq!(err.error_code, "NOT_FOUND");
+
+    // Missing catalog.
+    let err = CatalogServer::get_function(
+        "no_such_catalog.schema.ghost".to_string(),
+        ctx.clone(),
+        random_request_metadata(),
+    )
+    .await
+    .unwrap_err();
+    assert_eq!(err.status, 404);
+    assert_eq!(err.error_code, "NOT_FOUND");
+
+    // Delete of a missing function is a masked 404 too.
+    let err = CatalogServer::delete_function(
+        format!("{catalog}.{SCHEMA}.ghost"),
+        ctx,
+        random_request_metadata(),
+    )
+    .await
+    .unwrap_err();
+    assert_eq!(err.status, 404);
+    assert_eq!(err.error_code, "NOT_FOUND");
+}
diff --git a/crates/lakekeeper-storage-postgres/migrations/20260703000002_add_uc_function.sql b/crates/lakekeeper-storage-postgres/migrations/20260703000002_add_uc_function.sql
new file mode 100644
index 00000000..5b12790f
--- /dev/null
+++ b/crates/lakekeeper-storage-postgres/migrations/20260703000002_add_uc_function.sql
@@ -0,0 +1,40 @@
+-- Unity Catalog compatibility: functions.
+--
+-- Functions are a dedicated entity (no `tabular` piggyback). The client's
+-- `function_info` JSON is stored verbatim in `spec` (design D3 wire
+-- fidelity): the server only parses out `name`/`catalog_name`/`schema_name`
+-- and merges server-generated fields (function_id, full_name, timestamps)
+-- back in on read. UC DELETE is a hard delete in v1; `deleted_at` is
+-- reserved for future soft-delete support. UC has no function PATCH, so
+-- rows are immutable after insert (the version trigger is installed for
+-- consistency with other entities).
+
+CREATE TABLE uc_function (
+    warehouse_id UUID NOT NULL,
+    function_id  UUID NOT NULL,
+    namespace_id UUID NOT NULL,
+    name         TEXT COLLATE "case_insensitive" NOT NULL,
+    -- The client's `function_info` JSON, verbatim. Capped at 1 MiB.
+    spec         JSONB NOT NULL CHECK (octet_length(spec::text) <= 1048576),
+    created_at   TIMESTAMPTZ NOT NULL DEFAULT now(),
+    updated_at   TIMESTAMPTZ,
+    deleted_at   TIMESTAMPTZ,
+    version      BIGINT NOT NULL DEFAULT 0,
+    PRIMARY KEY (warehouse_id, function_id),
+    -- `unique_namespace_id_per_warehouse` on namespace backs this FK.
+    FOREIGN KEY (warehouse_id, namespace_id)
+        REFERENCES namespace (warehouse_id, namespace_id) ON DELETE CASCADE
+);
+
+SELECT trigger_updated_at_and_version_if_distinct('"uc_function"');
+
+-- Case-insensitive name uniqueness per namespace (name column uses the
+-- `case_insensitive` collation, mirroring uc_volume), scoped to live rows.
+CREATE UNIQUE INDEX uc_function_unique_name_per_namespace_idx
+    ON uc_function (warehouse_id, namespace_id, name)
+    WHERE deleted_at IS NULL;
+
+-- Keyset pagination (created_at, function_id).
+CREATE INDEX uc_function_created_at_function_id_idx
+    ON uc_function (warehouse_id, namespace_id, created_at, function_id)
+    WHERE deleted_at IS NULL;
