diff --git a/crates/lakekeeper/src/service/authz/function.rs b/crates/lakekeeper/src/service/authz/function.rs
new file mode 100644
index 00000000..ce356114
--- /dev/null
+++ b/crates/lakekeeper/src/service/authz/function.rs
@@ -0,0 +1,445 @@
+//! Authorization for Unity Catalog functions. Mirrors
+//! `service::authz::volume` (can-see = `GetMetadata`, 404-masking).
+//!
+//! No function action is data-plane: UC function execution is client-side
+//! (the client reconstructs the callable from the stored
+//! `routine_definition`), so `Execute` only gates retrieving the definition —
+//! which `GetMetadata` already reveals. All actions therefore stay inside the
+//! instance-admin bypass.
+
+use std::collections::HashMap;
+
+use iceberg_ext::catalog::rest::ErrorModel;
+
+use crate::{
+    WarehouseId,
+    api::RequestMetadata,
+    service::{
+        AuthZFunctionInfo, CatalogBackendError, FunctionIdentOrId, NamespaceHierarchy, NamespaceId,
+        NamespaceWithParent, ResolvedWarehouse,
+        authz::{
+            AuthorizationBackendUnavailable, AuthorizationCountMismatch, AuthorizationDecision,
+            Authorizer, AuthzBadRequest, CannotInspectPermissions, CatalogAction,
+            CatalogFunctionAction, IsAllowedActionError, MustUse, UserOrRole,
+        },
+        events::{
+            AuthorizationFailureReason, AuthorizationFailureSource,
+            delegate_authorization_failure_source,
+        },
+    },
+};
+
+const CAN_SEE_PERMISSION: CatalogFunctionAction = CatalogFunctionAction::GetMetadata;
+
+pub trait FunctionAction
+where
+    Self: CatalogAction + Clone + PartialEq + Eq + From<CatalogFunctionAction>,
+{
+    /// Whether this action reads or writes data (as opposed to metadata or
+    /// catalog operations). Always `false` for functions: execution happens
+    /// client-side, so no function action touches a data plane.
+    fn is_data_plane(&self) -> bool;
+}
+
+impl FunctionAction for CatalogFunctionAction {
+    fn is_data_plane(&self) -> bool {
+        false
+    }
+}
+
+// ------------------ Cannot See Error ------------------
+#[derive(Debug, PartialEq, Eq)]
+pub struct AuthZCannotSeeFunction {
+    warehouse_id: WarehouseId,
+    function: FunctionIdentOrId,
+    internal_resource_not_found: bool,
+}
+
+impl AuthZCannotSeeFunction {
+    #[must_use]
+    pub fn new(
+        warehouse_id: WarehouseId,
+        function: impl Into<FunctionIdentOrId>,
+        resource_not_found: bool,
+    ) -> Self {
+        Self {
+            warehouse_id,
+            function: function.into(),
+            internal_resource_not_found: resource_not_found,
+        }
+    }
+
+    #[must_use]
+    pub fn new_not_found(
+        warehouse_id: WarehouseId,
+        function: impl Into<FunctionIdentOrId>,
+    ) -> Self {
+        Self::new(warehouse_id, function, true)
+    }
+
+    #[must_use]
+    pub fn new_forbidden(
+        warehouse_id: WarehouseId,
+        function: impl Into<FunctionIdentOrId>,
+    ) -> Self {
+        Self::new(warehouse_id, function, false)
+    }
+}
+
+impl AuthorizationFailureSource for AuthZCannotSeeFunction {
+    fn into_error_model(self) -> ErrorModel {
+        let AuthZCannotSeeFunction {
+            warehouse_id,
+            function,
+            internal_resource_not_found: _,
+        } = self;
+        // 404 for both not-found and cannot-see: hide existence.
+        ErrorModel::not_found(
+            format!("Function {function} not found in warehouse `{warehouse_id}`"),
+            "FunctionNotFound",
+            None,
+        )
+    }
+
+    fn to_failure_reason(&self) -> AuthorizationFailureReason {
+        if self.internal_resource_not_found {
+            AuthorizationFailureReason::ResourceNotFound
+        } else {
+            AuthorizationFailureReason::CannotSeeResource
+        }
+    }
+}
