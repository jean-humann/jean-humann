@@ -0,0 +1,569 @@
+//! UC Functions handlers. Functions are dedicated entities (`uc_function`)
+//! below a top-level namespace; authorization mirrors volumes (can-see =
+//! `GetMetadata`, 404-masking, `IncludeInList` filtering on list).
+//!
+//! Fidelity rule (design D3): the response is the STORED spec JSON merged
+//! with server fields. Server fields win only for `function_id`, `full_name`,
+//! timestamps and `catalog_name`/`schema_name`/`name` normalization —
+//! everything else (`routine_definition`, `external_language`,
+//! `input_params.parameters` order and contents, the `properties`
+//! JSON-string, enum spellings, ...) is passed through unmodified, which is
+//! what makes client-side execution by unitycatalog-ai work.
+
+use std::{collections::HashMap, sync::Arc};
+
+use crate::{
+    api::{
+        ApiContext,
+        uc::{
+            UcErrorResponse, UcResult, effective_page_size, to_epoch_millis,
+            v1::{
+                self as uc_v1, CreateFunctionRequest, ListFunctionsQuery, ListFunctionsResponse,
+                functions::validate_function_info,
+            },
+        },
+    },
+    request_metadata::RequestMetadata,
+    server::uc::resolve::{resolve_catalog_warehouse, resolve_schema_namespace, uc_err},
+    service::{
+        CachePolicy, CatalogFunctionOps, CatalogNamespaceOps, CatalogStore, FunctionCreation,
+        FunctionId, FunctionIdentOrId, FunctionInfo, LoadFunctionError, NamespaceHierarchy,
+        ResolvedWarehouse, SecretStore, State, Transaction,
+        authz::{
+            ActionOnFunction, AuthZFunctionOps, Authorizer, AuthzNamespaceOps,
+            CatalogFunctionAction, CatalogNamespaceAction, RequireFunctionActionError,
+        },
+        events::{AuthorizationFailureSource, context::authz_to_error_no_audit},
+    },
+};
+
+/// Merge the stored spec with server-generated fields. Server fields win
+/// only for identity/timestamps; every other key is byte-preserved.
+pub(crate) fn function_info_response(
+    catalog_name: &str,
+    schema_name: &str,
+    name: &str,
+    function_id: FunctionId,
+    spec: &serde_json::Value,
+    created_at: chrono::DateTime<chrono::Utc>,
+    updated_at: Option<chrono::DateTime<chrono::Utc>>,
+) -> uc_v1::FunctionInfo {
+    let mut merged = match spec {
+        serde_json::Value::Object(map) => map.clone(),
+        // Specs are validated to be objects on create; be defensive anyway.
+        _ => serde_json::Map::new(),
+    };
+    merged.insert("name".to_string(), serde_json::json!(name));
+    merged.insert("catalog_name".to_string(), serde_json::json!(catalog_name));
+    merged.insert("schema_name".to_string(), serde_json::json!(schema_name));
+    merged.insert(
+        "full_name".to_string(),
+        serde_json::json!(format!("{catalog_name}.{schema_name}.{name}")),
+    );
+    merged.insert(
+        "function_id".to_string(),
+        serde_json::json!(function_id.to_string()),
+    );
+    merged.insert(
+        "created_at".to_string(),
+        serde_json::json!(to_epoch_millis(created_at)),
+    );
+    match updated_at {
+        Some(ts) => {
+            merged.insert(
+                "updated_at".to_string(),
+                serde_json::json!(to_epoch_millis(ts)),
+            );
+        }
+        None => {
+            // Server fields win: drop any client-supplied stale value.
+            merged.remove("updated_at");
+        }
+    }
+    uc_v1::FunctionInfo(serde_json::Value::Object(merged))
+}
+
+/// Split a UC function `full_name` (`<catalog>.<schema>.<function>`).
+pub(crate) fn split_function_full_name(full_name: &str) -> UcResult<(&str, &str, &str)> {
+    let parts: Vec<&str> = full_name.split('.').collect();
+    match parts.as_slice() {
+        [catalog, schema, function]
+            if !catalog.is_empty() && !schema.is_empty() && !function.is_empty() =>
+        {
+            Ok((catalog, schema, function))
+        }
+        _ => Err(UcErrorResponse::invalid_argument(format!(
+            "Invalid function full name '{full_name}'. Expected '<catalog>.<schema>.<function>'."
+        ))),
+    }
+}
+
+pub(crate) fn function_not_found(full_name: impl std::fmt::Display) -> UcErrorResponse {
+    UcErrorResponse::not_found(format!("Function not found: {full_name}"))
+}
+
+pub(crate) fn require_authz_to_uc_err(e: RequireFunctionActionError) -> UcErrorResponse {
+    UcErrorResponse::from(e.into_error_model())
+}
+
+/// Guard to clean up authorizer state if function creation fails after the
+/// authorizer tuples were written (they are not transactional with Postgres).
+struct FunctionCreationGuard<A: Authorizer> {
+    authorizer: A,
+    warehouse_id: crate::WarehouseId,
+    function_id: FunctionId,
+    authorizer_created: bool,
+}
+
+impl<A: Authorizer> FunctionCreationGuard<A> {
+    fn new(authorizer: A, warehouse_id: crate::WarehouseId, function_id: FunctionId) -> Self {
+        Self {
+            authorizer,
+            warehouse_id,
+            function_id,
+            authorizer_created: false,
+        }
+    }
+
+    fn mark_authorizer_created(&mut self) {
+        self.authorizer_created = true;
+    }
+
+    fn success(&mut self) {
+        self.authorizer_created = false;
+    }
+
+    async fn cleanup(&mut self) {
+        if self.authorizer_created
+            && let Err(e) = self
+                .authorizer
+                .delete_function(self.warehouse_id, self.function_id)
+                .await
+        {
+            tracing::warn!(
+                "Failed to cleanup authorizer function {} in warehouse {} after failed transaction: {e}",
+                self.function_id,
+                self.warehouse_id
+            );
+        }
+    }
+}
+
+/// Load `function_name` in the schema namespace and authorize `action` on
+/// it. Missing namespaces, missing functions and non-visible functions all
+/// surface as `NOT_FOUND` (existence masking).
+pub(crate) async fn load_and_authorize_function<C: CatalogStore, A: Authorizer>(
+    authorizer: &A,
+    request_metadata: &RequestMetadata,
+    warehouse: &Arc<ResolvedWarehouse>,
+    schema_name: &str,
+    function_name: &str,
+    action: CatalogFunctionAction,
+    catalog_state: C::State,
+) -> UcResult<(NamespaceHierarchy, FunctionInfo)> {
+    let warehouse_id = warehouse.warehouse_id;
+    let full_name = format!("{}.{schema_name}.{function_name}", warehouse.name);
+    let namespace_ident = iceberg::NamespaceIdent::new(schema_name.to_string());
+
+    let namespace = C::get_namespace_cache_aware(
+        warehouse_id,
+        namespace_ident.clone(),
+        CachePolicy::Skip,
+        catalog_state.clone(),
+    )
+    .await
+    .map_err(uc_err)?
+    .ok_or_else(|| function_not_found(&full_name))?;
+
+    let mut t = C::Transaction::begin_read(catalog_state)
+        .await
+        .map_err(uc_err)?;
+    let load_result: Result<Option<FunctionInfo>, RequireFunctionActionError> =
+        match C::load_function(
+            warehouse_id,
+            namespace.namespace.namespace_id(),
+            function_name,
+            t.transaction(),
+        )
+        .await
+        {
+            Ok(info) => Ok(Some(info)),
+            Err(LoadFunctionError::FunctionNotFound(_)) => Ok(None),
+            Err(e) => return Err(uc_err(e)),
+        };
+    t.commit().await.map_err(uc_err)?;
+
+    let user_provided = FunctionIdentOrId::Ident(iceberg::TableIdent::new(
+        namespace_ident,
+        function_name.to_string(),
+    ));
+    let info = authorizer
+        .require_function_action(
+            request_metadata,
+            warehouse,
+            &namespace,
+            user_provided,
+            load_result,
+            action,
+        )
+        .await
+        .map_err(require_authz_to_uc_err)?;
+
+    Ok((namespace, info))
+}
+
+pub(crate) async fn create_function<C: CatalogStore, A: Authorizer + Clone, S: SecretStore>(
+    request: CreateFunctionRequest,
+    state: ApiContext<State<A, C, S>>,
+    request_metadata: RequestMetadata,
+) -> UcResult<uc_v1::FunctionInfo> {
+    let CreateFunctionRequest { function_info } = request;
+
+    let (name, catalog_name, schema_name) = validate_function_info(&function_info)?;
+    if name.is_empty() || name.contains('.') || name.contains('/') {
+        return Err(UcErrorResponse::invalid_argument(format!(
+            "Invalid function name '{name}': function names must be non-empty and must not contain '.' or '/'."
+        )));
+    }
+
+    let warehouse = resolve_catalog_warehouse::<C>(
+        &request_metadata,
+        &catalog_name,
+        state.v1_state.catalog.clone(),
+    )
+    .await?;
+    let warehouse_id = warehouse.warehouse_id;
+    let function_id = FunctionId::new_random();
+
+    // ------------------- AUTHZ: namespace-level CreateFunction -------------------
+    let (_warehouse, ns_hierarchy) = resolve_schema_namespace::<C, A>(
+        &state.v1_state.authz,
+        &request_metadata,
+        warehouse_id,
+        &schema_name,
+        CatalogNamespaceAction::CreateFunction {
+            name: Some(name.clone()),
+            function_id: Some(function_id),
+        },
+        state.v1_state.catalog.clone(),
+    )
+    .await?;
+
+    // ------------------- CREATE (catalog + authorizer with guard) -------------------
+    let authorizer = state.v1_state.authz.clone();
+    let mut guard = FunctionCreationGuard::new(authorizer.clone(), warehouse_id, function_id);
+
+    // The whole `function_info` object is stored verbatim as the spec.
+    let creation = FunctionCreation {
+        function_id,
+        namespace_id: ns_hierarchy.namespace.namespace_id(),
+        warehouse_id,
+        name,
+        spec: function_info,
+    };
+
+    let result: UcResult<FunctionInfo> = async {
+        let mut t = C::Transaction::begin_write(state.v1_state.catalog.clone())
+            .await
+            .map_err(uc_err)?;
+        let info = C::create_function(creation, t.transaction())
+            .await
+            .map_err(uc_err)?;
+
+        // Authorizer tuples are written between the catalog insert and the
+        // commit; the guard removes them again if the commit fails.
+        authorizer
+            .create_function(
+                &request_metadata,
+                warehouse_id,
+                info.function_id,
+                info.namespace_id,
+            )
+            .await
+            .map_err(uc_err)?;
+        guard.mark_authorizer_created();
+
+        t.commit().await.map_err(uc_err)?;
+        Ok(info)
+    }
+    .await;
+
+    match result {
+        Ok(info) => {
+            guard.success();
+            Ok(function_info_response(
+                &catalog_name,
+                &schema_name,
+                &info.name,
+                info.function_id,
+                &info.spec,
+                info.created_at,
+                info.updated_at,
+            ))
+        }
+        Err(e) => {
+            guard.cleanup().await;
+            Err(e)
+        }
+    }
+}
+
+pub(crate) async fn list_functions<C: CatalogStore, A: Authorizer + Clone, S: SecretStore>(
+    query: ListFunctionsQuery,
+    state: ApiContext<State<A, C, S>>,
+    request_metadata: RequestMetadata,
+) -> UcResult<ListFunctionsResponse> {
+    let ListFunctionsQuery {
+        catalog_name,
+        schema_name,
+        max_results,
+        page_token,
+    } = query;
+    let page_size = effective_page_size(max_results)?;
+
+    let warehouse = resolve_catalog_warehouse::<C>(
+        &request_metadata,
+        &catalog_name,
+        state.v1_state.catalog.clone(),
+    )
+    .await?;
+    let authorizer = &state.v1_state.authz;
+
+    // ------------------- AUTHZ: namespace-level ListFunctions -------------------
+    let (warehouse, ns) = resolve_schema_namespace::<C, A>(
+        authorizer,
+        &request_metadata,
+        warehouse.warehouse_id,
+        &schema_name,
+        CatalogNamespaceAction::ListFunctions,
+        state.v1_state.catalog.clone(),
+    )
+    .await?;
+    let warehouse_id = warehouse.warehouse_id;
+    let namespace_ident = iceberg::NamespaceIdent::new(schema_name.clone());
+
+    let mut t = C::Transaction::begin_read(state.v1_state.catalog)
+        .await
+        .map_err(uc_err)?;
+    let (entries, next_page_token) = C::list_functions(
+        warehouse_id,
+        ns.namespace.namespace_id(),
+        &namespace_ident,
+        Some(page_size),
+        page_token.as_deref(),
+        t.transaction(),
+    )
+    .await
+    .map_err(uc_err)?;
+    t.commit().await.map_err(uc_err)?;
+
+    // ------------------- AUTHZ: per-entry IncludeInList filtering -------------------
+    let can_list_everything = authorizer
+        .is_allowed_namespace_action(
+            &request_metadata,
+            None,
+            &warehouse,
+            &ns.parents,
+            &ns.namespace,
+            CatalogNamespaceAction::ListEverything,
+        )
+        .await
+        .map_err(|e| uc_err(authz_to_error_no_audit(e)))?
+        .into_inner();
+
+    let masks = if can_list_everything {
+        vec![true; entries.len()]
+    } else {
+        let actions: Vec<_> = entries
+            .iter()
+            .map(|entry| {
+                (
+                    &ns.namespace,
+                    ActionOnFunction {
+                        info: entry,
+                        action: CatalogFunctionAction::IncludeInList,
+                        user: None,
+                    },
+                )
+            })
+            .collect();
+
+        let parents: HashMap<_, _> = ns
+            .parents
+            .iter()
+            .map(|n| (n.namespace_id(), n.clone()))
+            .collect();
+        authorizer
+            .are_allowed_function_actions_vec(&request_metadata, &warehouse, &parents, &actions)
+            .await
+            .map_err(|e| uc_err(authz_to_error_no_audit(e)))?
+            .into_allowed()
+    };
+
+    let functions = entries
+        .into_iter()
+        .zip(masks)
+        .filter(|(_, allowed)| *allowed)
+        .map(|(entry, _)| {
+            function_info_response(
+                &catalog_name,
+                &schema_name,
+                &entry.name,
+                entry.function_id,
+                &entry.spec,
+                entry.created_at,
+                entry.updated_at,
+            )
+        })
+        .collect();
+
+    Ok(ListFunctionsResponse {
+        functions,
+        next_page_token,
+    })
+}
+
+pub(crate) async fn get_function<C: CatalogStore, A: Authorizer + Clone, S: SecretStore>(
+    full_name: String,
+    state: ApiContext<State<A, C, S>>,
+    request_metadata: RequestMetadata,
+) -> UcResult<uc_v1::FunctionInfo> {
+    let (catalog_name, schema_name, function_name) = split_function_full_name(&full_name)?;
+    let warehouse = resolve_catalog_warehouse::<C>(
+        &request_metadata,
+        catalog_name,
+        state.v1_state.catalog.clone(),
+    )
+    .await?;
+
+    let (_ns, info) = load_and_authorize_function::<C, A>(
+        &state.v1_state.authz,
+        &request_metadata,
+        &warehouse,
+        schema_name,
+        function_name,
+        CatalogFunctionAction::GetMetadata,
+        state.v1_state.catalog,
+    )
+    .await?;
+
+    Ok(function_info_response(
+        catalog_name,
+        schema_name,
+        &info.name,
+        info.function_id,
+        &info.spec,
+        info.created_at,
+        info.updated_at,
+    ))
+}
+
+pub(crate) async fn delete_function<C: CatalogStore, A: Authorizer + Clone, S: SecretStore>(
+    full_name: String,
+    state: ApiContext<State<A, C, S>>,
+    request_metadata: RequestMetadata,
+) -> UcResult<()> {
+    let (catalog_name, schema_name, function_name) = split_function_full_name(&full_name)?;
+    let warehouse = resolve_catalog_warehouse::<C>(
+        &request_metadata,
+        catalog_name,
+        state.v1_state.catalog.clone(),
+    )
+    .await?;
+
+    let (ns, info) = load_and_authorize_function::<C, A>(
+        &state.v1_state.authz,
+        &request_metadata,
+        &warehouse,
+        schema_name,
+        function_name,
+        CatalogFunctionAction::Drop,
+        state.v1_state.catalog.clone(),
+    )
+    .await?;
+
+    let mut t = C::Transaction::begin_write(state.v1_state.catalog)
+        .await
+        .map_err(uc_err)?;
+    let dropped_id = C::drop_function(
+        warehouse.warehouse_id,
+        ns.namespace.namespace_id(),
+        function_name,
+        t.transaction(),
+    )
+    .await
+    .map_err(uc_err)?;
+    t.commit().await.map_err(uc_err)?;
+    debug_assert_eq!(dropped_id, info.function_id);
+
+    // Best-effort authorizer cleanup after the commit (mirrors volume drop):
+    // a failure leaves orphaned tuples, not broken authorization.
+    if let Err(e) = state
+        .v1_state
+        .authz
+        .delete_function(warehouse.warehouse_id, dropped_id)
+        .await
+    {
+        tracing::warn!(
+            "Failed to delete function {dropped_id} in warehouse {} from authorizer: {e}",
+            warehouse.warehouse_id
+        );
+    }
+
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn test_split_function_full_name() {
+        assert_eq!(
+            split_function_full_name("cat.schema.fn").unwrap(),
+            ("cat", "schema", "fn")
+        );
+        for bad in ["", "cat", "cat.schema", "cat.schema.fn.extra", "..", "a..b"] {
+            let err = split_function_full_name(bad).unwrap_err();
+            assert_eq!(err.status, 400, "{bad}");
+            assert_eq!(err.error_code, "INVALID_ARGUMENT", "{bad}");
+        }
+    }
+
+    #[test]
+    fn test_function_info_response_merges_server_fields_and_preserves_spec() {
+        let spec = serde_json::json!({
+            "name": "client_name",
+            "catalog_name": "client_cat",
+            "schema_name": "client_sch",
+            "routine_definition": "return a + b\n",
+            "properties": "null",
+            "input_params": {"parameters": [
+                {"name": "a", "type_name": "ARRAY", "type_text": "array<string>",
+                 "type_json": "{\"name\": \"a\"}", "position": 0, "parameter_default": "NULL"}
+            ]},
+            "updated_at": 12345,
+            "custom_extra": {"nested": [1, 2, 3]}
+        });
+        let function_id = FunctionId::new_random();
+        let created = chrono::Utc::now();
+        let info = function_info_response("cat", "sch", "fn1", function_id, &spec, created, None);
+        let v = &info.0;
+
+        // Server fields win.
+        assert_eq!(v["name"], "fn1");
+        assert_eq!(v["catalog_name"], "cat");
+        assert_eq!(v["schema_name"], "sch");
+        assert_eq!(v["full_name"], "cat.sch.fn1");
+        assert_eq!(v["function_id"], function_id.to_string());
+        assert_eq!(v["created_at"], created.timestamp_millis());
+        // No DB updated_at → the stale client value is dropped.
+        assert!(v.get("updated_at").is_none());
+
+        // Everything else is byte-preserved.
+        assert_eq!(v["routine_definition"], "return a + b\n");
+        assert_eq!(v["properties"], "null");
+        assert_eq!(v["custom_extra"], spec["custom_extra"]);
+        assert_eq!(v["input_params"], spec["input_params"]);
+    }
+}
