+// =================== Function Relations (Unity Catalog compat) ===================
+
+#[derive(
+    Debug, Clone, Copy, Hash, Eq, PartialEq, strum_macros::Display, IntoStaticStr, EnumIter,
+)]
+#[strum(serialize_all = "snake_case")]
+pub enum FunctionRelation {
+    // -- Hierarchical relations --
+    Parent,
+    // -- Direct relations --
+    Ownership,
+    PassGrants,
+    ManageGrants,
+    Describe,
+    Select,
+    Modify,
+    Execute,
+    // -- Actions --
+    CanDrop,
+    CanGetMetadata,
+    CanIncludeInList,
+    CanExecute,
+    // -- Read assignments / grant actions --
+    CanReadAssignments,
+    CanGrantPassGrants,
+    CanGrantManageGrants,
+    CanGrantDescribe,
+    CanGrantSelect,
+    CanGrantModify,
+    CanGrantExecute,
+    CanChangeOwnership,
+}
+
+impl FunctionAction for FunctionRelation {
+    fn is_data_plane(&self) -> bool {
+        // Function execution is client-side; no relation touches a data
+        // plane.
+        false
+    }
+}
+impl CatalogAction for FunctionRelation {
+    fn action_descriptor(&self) -> ActionDescriptor {
+        ActionDescriptor::builder().action_name(self.into()).build()
+    }
+}
+impl OpenFgaRelation for FunctionRelation {}
+
+impl From<CatalogFunctionAction> for FunctionRelation {
+    fn from(action: CatalogFunctionAction) -> Self {
+        action.to_openfga()
+    }
+}
+
+impl From<&CatalogFunctionAction> for FunctionRelation {
+    fn from(action: &CatalogFunctionAction) -> Self {
+        action.to_openfga()
+    }
+}
+
+impl ReducedRelation for CatalogFunctionAction {
+    type OpenFgaRelation = FunctionRelation;
+
+    fn to_openfga(&self) -> Self::OpenFgaRelation {
+        match self {
+            CatalogFunctionAction::GetMetadata => FunctionRelation::CanGetMetadata,
+            CatalogFunctionAction::Execute => FunctionRelation::CanExecute,
+            CatalogFunctionAction::Drop => FunctionRelation::CanDrop,
+            CatalogFunctionAction::IncludeInList => FunctionRelation::CanIncludeInList,
+        }
+    }
+}
+
+#[derive(Debug, Clone, Deserialize, Copy, Eq, PartialEq, EnumIter)]
+#[cfg_attr(feature = "open-api", derive(utoipa::ToSchema))]
+#[serde(rename_all = "snake_case")]
+#[cfg_attr(feature = "open-api", schema(as=FunctionRelation))]
+pub(super) enum APIFunctionRelation {
+    Ownership,
+    PassGrants,
+    ManageGrants,
+    Describe,
+    Select,
+    Modify,
+    Execute,
+}
+
+#[derive(Debug, Clone, Deserialize, Serialize, PartialEq)]
+#[cfg_attr(feature = "open-api", derive(utoipa::ToSchema))]
+#[serde(tag = "type", rename_all = "snake_case")]
+pub(super) enum FunctionAssignment {
+    #[cfg_attr(feature = "open-api", schema(title = "FunctionAssignmentOwnership"))]
+    Ownership(UserOrRole),
+    #[cfg_attr(feature = "open-api", schema(title = "FunctionAssignmentPassGrants"))]
+    PassGrants(UserOrRole),
+    #[cfg_attr(feature = "open-api", schema(title = "FunctionAssignmentManageGrants"))]
+    ManageGrants(UserOrRole),
+    #[cfg_attr(feature = "open-api", schema(title = "FunctionAssignmentDescribe"))]
+    Describe(UserOrRole),
+    #[cfg_attr(feature = "open-api", schema(title = "FunctionAssignmentSelect"))]
+    Select(UserOrRole),
+    #[cfg_attr(feature = "open-api", schema(title = "FunctionAssignmentModify"))]
+    Modify(UserOrRole),
+    #[cfg_attr(feature = "open-api", schema(title = "FunctionAssignmentExecute"))]
+    Execute(UserOrRole),
+}
+
+impl GrantableRelation for APIFunctionRelation {
+    fn grant_relation(&self) -> FunctionRelation {
+        match self {
+            APIFunctionRelation::Ownership => FunctionRelation::CanChangeOwnership,
+            APIFunctionRelation::PassGrants => FunctionRelation::CanGrantPassGrants,
+            APIFunctionRelation::ManageGrants => FunctionRelation::CanGrantManageGrants,
+            APIFunctionRelation::Describe => FunctionRelation::CanGrantDescribe,
+            APIFunctionRelation::Select => FunctionRelation::CanGrantSelect,
+            APIFunctionRelation::Modify => FunctionRelation::CanGrantModify,
+            APIFunctionRelation::Execute => FunctionRelation::CanGrantExecute,
+        }
+    }
+}
+
+impl Assignment for FunctionAssignment {
+    type Relation = APIFunctionRelation;
+
+    fn try_from_user(
+        user: &str,
+        relation: &Self::Relation,
+    ) -> Result<Self, ParseOpenFgaEntityError> {
+        match relation {
+            APIFunctionRelation::Ownership => {
+                UserOrRole::parse_from_openfga(user).map(FunctionAssignment::Ownership)
+            }
+            APIFunctionRelation::PassGrants => {
+                UserOrRole::parse_from_openfga(user).map(FunctionAssignment::PassGrants)
+            }
+            APIFunctionRelation::ManageGrants => {
+                UserOrRole::parse_from_openfga(user).map(FunctionAssignment::ManageGrants)
+            }
+            APIFunctionRelation::Describe => {
+                UserOrRole::parse_from_openfga(user).map(FunctionAssignment::Describe)
+            }
+            APIFunctionRelation::Select => {
+                UserOrRole::parse_from_openfga(user).map(FunctionAssignment::Select)
+            }
+            APIFunctionRelation::Modify => {
+                UserOrRole::parse_from_openfga(user).map(FunctionAssignment::Modify)
+            }
+            APIFunctionRelation::Execute => {
+                UserOrRole::parse_from_openfga(user).map(FunctionAssignment::Execute)
+            }
+        }
+    }
+
+    fn openfga_user(&self) -> String {
+        match self {
+            FunctionAssignment::Ownership(user)
+            | FunctionAssignment::PassGrants(user)
+            | FunctionAssignment::ManageGrants(user)
+            | FunctionAssignment::Describe(user)
+            | FunctionAssignment::Select(user)
+            | FunctionAssignment::Modify(user)
+            | FunctionAssignment::Execute(user) => user.to_openfga(),
+        }
+    }
+
+    fn relation(&self) -> Self::Relation {
+        match self {
+            FunctionAssignment::Ownership(_) => APIFunctionRelation::Ownership,
+            FunctionAssignment::PassGrants(_) => APIFunctionRelation::PassGrants,
+            FunctionAssignment::ManageGrants(_) => APIFunctionRelation::ManageGrants,
+            FunctionAssignment::Describe(_) => APIFunctionRelation::Describe,
+            FunctionAssignment::Select(_) => APIFunctionRelation::Select,
+            FunctionAssignment::Modify(_) => APIFunctionRelation::Modify,
+            FunctionAssignment::Execute(_) => APIFunctionRelation::Execute,
+        }
+    }
+}
+
+#[derive(Copy, Debug, Clone, Eq, PartialEq, Serialize, Deserialize, EnumIter)]
+#[cfg_attr(feature = "open-api", derive(utoipa::ToSchema))]
+#[serde(rename_all = "snake_case")]
+pub(super) enum OpenFGAFunctionAction {
+    ReadAssignments,
+    GrantPassGrants,
+    GrantManageGrants,
+    GrantDescribe,
+    GrantSelect,
+    GrantModify,
+    GrantExecute,
+    ChangeOwnership,
+}
+
+impl ReducedRelation for APIFunctionRelation {
+    type OpenFgaRelation = FunctionRelation;
+
+    fn to_openfga(&self) -> Self::OpenFgaRelation {
+        match self {
+            APIFunctionRelation::Ownership => FunctionRelation::Ownership,
+            APIFunctionRelation::PassGrants => FunctionRelation::PassGrants,
+            APIFunctionRelation::ManageGrants => FunctionRelation::ManageGrants,
+            APIFunctionRelation::Describe => FunctionRelation::Describe,
+            APIFunctionRelation::Select => FunctionRelation::Select,
+            APIFunctionRelation::Modify => FunctionRelation::Modify,
+            APIFunctionRelation::Execute => FunctionRelation::Execute,
+        }
+    }
+}
+
+impl ReducedRelation for OpenFGAFunctionAction {
+    type OpenFgaRelation = FunctionRelation;
+
+    fn to_openfga(&self) -> Self::OpenFgaRelation {
+        match self {
+            OpenFGAFunctionAction::ReadAssignments => FunctionRelation::CanReadAssignments,
+            OpenFGAFunctionAction::GrantPassGrants => FunctionRelation::CanGrantPassGrants,
+            OpenFGAFunctionAction::GrantManageGrants => FunctionRelation::CanGrantManageGrants,
+            OpenFGAFunctionAction::GrantDescribe => FunctionRelation::CanGrantDescribe,
+            OpenFGAFunctionAction::GrantSelect => FunctionRelation::CanGrantSelect,
+            OpenFGAFunctionAction::GrantModify => FunctionRelation::CanGrantModify,
+            OpenFGAFunctionAction::GrantExecute => FunctionRelation::CanGrantExecute,
+            OpenFGAFunctionAction::ChangeOwnership => FunctionRelation::CanChangeOwnership,
+        }
+    }
+}
