diff --git a/crates/lakekeeper/src/service/catalog_store/function.rs b/crates/lakekeeper/src/service/catalog_store/function.rs
new file mode 100644
index 00000000..59210af2
--- /dev/null
+++ b/crates/lakekeeper/src/service/catalog_store/function.rs
@@ -0,0 +1,258 @@
+//! Unity Catalog functions: dedicated catalog-store entity (design D1 — no
+//! tabular piggyback). Functions live in the `uc_function` table, are
+//! hard-deleted in v1 (`deleted_at` column reserved) and are never protected.
+//!
+//! Wire fidelity (design D3): the client's `function_info` JSON is stored
+//! verbatim as `spec` and echoed back on read with server fields
+//! (`function_id`, `full_name`, timestamps) merged in. Function execution is
+//! client-side (unitycatalog-ai reconstructs the callable from
+//! `routine_definition`), so there is no server-side execute path.
+
+use std::fmt;
+
+use http::StatusCode;
+use iceberg::{NamespaceIdent, TableIdent};
+use iceberg_ext::catalog::rest::ErrorModel;
+
+use super::{
+    CatalogStore, Transaction, define_simple_error, define_transparent_error,
+    impl_error_stack_methods, impl_from_with_detail,
+};
+use crate::{
+    WarehouseId,
+    service::{CatalogBackendError, FunctionId, NamespaceId, NamespaceVersion, WarehouseVersion},
+};
+
+/// Function addressed either by `<namespace>.<name>` identifier or by id.
+/// Used in authorization errors (mirrors `VolumeIdentOrId`).
+#[derive(Hash, Debug, Clone, PartialEq, Eq, derive_more::From)]
+pub enum FunctionIdentOrId {
+    Ident(TableIdent),
+    Id(FunctionId),
+}
+
+impl fmt::Display for FunctionIdentOrId {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            FunctionIdentOrId::Ident(ident) => write!(f, "'{ident}'"),
+            FunctionIdentOrId::Id(id) => write!(f, "ID '{id}'"),
+        }
+    }
+}
+
+/// The function fields authorization code needs. Mirrors [`AuthZVolumeInfo`];
+/// implemented by [`FunctionInfo`] and [`FunctionListEntry`].
+///
+/// [`AuthZVolumeInfo`]: crate::service::AuthZVolumeInfo
+pub trait AuthZFunctionInfo: Send + Sync {
+    fn warehouse_id(&self) -> WarehouseId;
+    fn function_ident(&self) -> &TableIdent;
+    fn function_id(&self) -> FunctionId;
+    fn namespace_id(&self) -> NamespaceId;
+    fn namespace_ident(&self) -> &NamespaceIdent {
+        self.function_ident().namespace()
+    }
+}
+
+#[derive(Debug, Clone)]
+pub struct FunctionInfo {
+    pub function_id: FunctionId,
+    pub warehouse_id: WarehouseId,
+    pub warehouse_version: WarehouseVersion,
+    pub namespace_id: NamespaceId,
+    pub namespace_version: NamespaceVersion,
+    pub namespace_ident: NamespaceIdent,
+    pub name: String,
+    /// `<namespace>.<name>` identifier (UC functions live in single-level
+    /// namespaces; `TableIdent` is reused as a generic two-part identifier).
+    pub function_ident: TableIdent,
+    /// The client's `function_info` JSON, stored verbatim.
+    pub spec: serde_json::Value,
+    pub created_at: chrono::DateTime<chrono::Utc>,
+    pub updated_at: Option<chrono::DateTime<chrono::Utc>>,
+}
+
+impl AuthZFunctionInfo for FunctionInfo {
+    fn warehouse_id(&self) -> WarehouseId {
+        self.warehouse_id
+    }
+
+    fn function_ident(&self) -> &TableIdent {
+        &self.function_ident
+    }
+
+    fn function_id(&self) -> FunctionId {
+        self.function_id
+    }
+
+    fn namespace_id(&self) -> NamespaceId {
+        self.namespace_id
+    }
+}
+
+#[derive(Debug, Clone)]
+pub struct FunctionCreation {
+    pub function_id: FunctionId,
+    pub namespace_id: NamespaceId,
+    pub warehouse_id: WarehouseId,
+    pub name: String,
+    /// The client's `function_info` JSON, stored verbatim.
+    pub spec: serde_json::Value,
+}
+
+/// UC `GET /functions` returns full `FunctionInfo` objects, so list entries
+/// carry the complete stored spec.
+#[derive(Debug, Clone)]
+pub struct FunctionListEntry {
+    pub function_id: FunctionId,
+    pub warehouse_id: WarehouseId,
+    pub namespace_id: NamespaceId,
+    pub name: String,
+    pub function_ident: TableIdent,
+    pub namespace_ident: NamespaceIdent,
+    pub spec: serde_json::Value,
+    pub created_at: chrono::DateTime<chrono::Utc>,
+    pub updated_at: Option<chrono::DateTime<chrono::Utc>>,
+}
+
+impl AuthZFunctionInfo for FunctionListEntry {
+    fn warehouse_id(&self) -> WarehouseId {
+        self.warehouse_id
+    }
+
+    fn function_ident(&self) -> &TableIdent {
+        &self.function_ident
+    }
+
+    fn function_id(&self) -> FunctionId {
+        self.function_id
+    }
+
+    fn namespace_id(&self) -> NamespaceId {
+        self.namespace_id
+    }
+}
+
+define_simple_error!(FunctionAlreadyExists, "Function already exists");
+impl From<FunctionAlreadyExists> for ErrorModel {
+    fn from(err: FunctionAlreadyExists) -> Self {
+        ErrorModel::builder()
+            .message(err.to_string())
+            .r#type("FunctionAlreadyExists")
+            .code(StatusCode::CONFLICT.as_u16())
+            .stack(err.stack)
+            .build()
+    }
+}
+
+define_simple_error!(FunctionNotFound, "Function not found");
+impl From<FunctionNotFound> for ErrorModel {
+    fn from(err: FunctionNotFound) -> Self {
+        ErrorModel::builder()
+            .message(err.to_string())
+            .r#type("FunctionNotFound")
+            .code(StatusCode::NOT_FOUND.as_u16())
+            .stack(err.stack)
+            .build()
+    }
+}
+
+define_transparent_error! {
+    pub enum CreateFunctionError,
+    stack_message: "Error creating function",
+    variants: [
+        FunctionAlreadyExists,
+        CatalogBackendError,
+    ]
+}
+
+define_transparent_error! {
+    pub enum LoadFunctionError,
+    stack_message: "Error loading function",
+    variants: [
+        FunctionNotFound,
+        CatalogBackendError,
+    ]
+}
+
+define_transparent_error! {
+    pub enum ListFunctionsError,
+    stack_message: "Error listing functions",
+    variants: [
+        CatalogBackendError,
+    ]
+}
+
+define_transparent_error! {
+    pub enum DropFunctionError,
+    stack_message: "Error dropping function",
+    variants: [
+        FunctionNotFound,
+        CatalogBackendError,
+    ]
+}
+
+#[async_trait::async_trait]
+pub trait CatalogFunctionOps
+where
+    Self: CatalogStore,
+{
+    async fn create_function<'a>(
+        creation: FunctionCreation,
+        transaction: <Self::Transaction as Transaction<Self::State>>::Transaction<'a>,
+    ) -> std::result::Result<FunctionInfo, CreateFunctionError> {
+        Self::create_function_impl(creation, transaction).await
+    }
+
+    async fn load_function<'a>(
+        warehouse_id: WarehouseId,
+        namespace_id: NamespaceId,
+        function_name: &str,
+        transaction: <Self::Transaction as Transaction<Self::State>>::Transaction<'a>,
+    ) -> std::result::Result<FunctionInfo, LoadFunctionError> {
+        Self::load_function_impl(warehouse_id, namespace_id, function_name, transaction).await
+    }
+
+    /// Load a function by its stable id. Prefer this over
+    /// [`Self::load_function`] after a successful authz check (TOCTOU:
+    /// rename/create races cannot substitute a different row).
+    async fn load_function_by_id<'a>(
+        warehouse_id: WarehouseId,
+        function_id: FunctionId,
+        transaction: <Self::Transaction as Transaction<Self::State>>::Transaction<'a>,
+    ) -> std::result::Result<FunctionInfo, LoadFunctionError> {
+        Self::load_function_by_id_impl(warehouse_id, function_id, transaction).await
+    }
+
+    async fn list_functions<'a>(
+        warehouse_id: WarehouseId,
+        namespace_id: NamespaceId,
+        namespace_ident: &iceberg::NamespaceIdent,
+        page_size: Option<i64>,
+        page_token: Option<&str>,
+        transaction: <Self::Transaction as Transaction<Self::State>>::Transaction<'a>,
+    ) -> std::result::Result<(Vec<FunctionListEntry>, Option<String>), ListFunctionsError> {
+        Self::list_functions_impl(
+            warehouse_id,
+            namespace_id,
+            namespace_ident,
+            page_size,
+            page_token,
+            transaction,
+        )
+        .await
+    }
+
+    /// Hard-delete a function (UC DELETE semantics; no soft delete in v1).
+    /// There is no update: UC has no function PATCH endpoint.
+    async fn drop_function<'a>(
+        warehouse_id: WarehouseId,
+        namespace_id: NamespaceId,
+        function_name: &str,
+        transaction: <Self::Transaction as Transaction<Self::State>>::Transaction<'a>,
+    ) -> std::result::Result<FunctionId, DropFunctionError> {
+        Self::drop_function_impl(warehouse_id, namespace_id, function_name, transaction).await
+    }
+}
+
+impl<T> CatalogFunctionOps for T where T: CatalogStore {}
