+#[async_trait::async_trait]
+pub trait CatalogModelOps
+where
+    Self: CatalogStore,
+{
+    async fn create_model<'a>(
+        creation: ModelCreation,
+        transaction: <Self::Transaction as Transaction<Self::State>>::Transaction<'a>,
+    ) -> std::result::Result<ModelInfo, CreateModelError> {
+        Self::create_model_impl(creation, transaction).await
+    }
+
+    async fn load_model<'a>(
+        warehouse_id: WarehouseId,
+        namespace_id: NamespaceId,
+        model_name: &str,
+        transaction: <Self::Transaction as Transaction<Self::State>>::Transaction<'a>,
+    ) -> std::result::Result<ModelInfo, LoadModelError> {
+        Self::load_model_impl(warehouse_id, namespace_id, model_name, transaction).await
+    }
+
+    /// Load a model by its stable id. Prefer this over [`Self::load_model`]
+    /// after a successful authz check (TOCTOU: rename/create races cannot
+    /// substitute a different row).
+    async fn load_model_by_id<'a>(
+        warehouse_id: WarehouseId,
+        model_id: ModelId,
+        transaction: <Self::Transaction as Transaction<Self::State>>::Transaction<'a>,
+    ) -> std::result::Result<ModelInfo, LoadModelError> {
+        Self::load_model_by_id_impl(warehouse_id, model_id, transaction).await
+    }
+
+    /// List registered models. `warehouse_id: None` lists across all active
+    /// warehouses of `project_id` (UC listRegisteredModels allows omitting
+    /// `catalog_name`); `namespace_id: None` lists across all namespaces of
+    /// the selected warehouse(s). Callers MUST filter the returned entries
+    /// per-model (`IncludeInList`) — no namespace-level authorization is
+    /// implied for the unscoped variants.
+    async fn list_models<'a>(
+        project_id: &ProjectId,
+        warehouse_id: Option<WarehouseId>,
+        namespace_id: Option<NamespaceId>,
+        page_size: Option<i64>,
+        page_token: Option<&str>,
+        transaction: <Self::Transaction as Transaction<Self::State>>::Transaction<'a>,
+    ) -> std::result::Result<(Vec<ModelListEntry>, Option<String>), ListModelsError> {
+        Self::list_models_impl(
+            project_id,
+            warehouse_id,
+            namespace_id,
+            page_size,
+            page_token,
+            transaction,
+        )
+        .await
+    }
+
+    /// Set (or clear) the model comment. The only supported model update in
+    /// v1 (UC `PATCH /models` supports `comment` and `new_name`; renames are
+    /// rejected at the API layer).
+    async fn update_model_comment<'a>(
+        warehouse_id: WarehouseId,
+        model_id: ModelId,
+        comment: Option<&str>,
+        transaction: <Self::Transaction as Transaction<Self::State>>::Transaction<'a>,
+    ) -> std::result::Result<(), UpdateModelError> {
+        Self::update_model_comment_impl(warehouse_id, model_id, comment, transaction).await
+    }
+
+    /// Hard-delete a model (UC DELETE semantics; no soft delete in v1).
+    /// Unless `force`, fails with [`ModelHasVersions`] if any versions exist;
+    /// with `force`, live versions are dropped along with the model.
+    async fn drop_model<'a>(
+        warehouse_id: WarehouseId,
+        namespace_id: NamespaceId,
+        model_name: &str,
+        force: bool,
+        transaction: <Self::Transaction as Transaction<Self::State>>::Transaction<'a>,
+    ) -> std::result::Result<ModelId, DropModelError> {
+        Self::drop_model_impl(warehouse_id, namespace_id, model_name, force, transaction).await
+    }
+
+    /// Create a model version. The integer `version` is assigned inside the
+    /// transaction as `MAX(version) + 1` for the model (the model row is
+    /// locked to serialize concurrent assignment); the version starts in
+    /// `PENDING_REGISTRATION`.
+    async fn create_model_version<'a>(
+        creation: ModelVersionCreation,
+        transaction: <Self::Transaction as Transaction<Self::State>>::Transaction<'a>,
+    ) -> std::result::Result<ModelVersionInfo, CreateModelVersionError> {
+        Self::create_model_version_impl(creation, transaction).await
+    }
+
+    /// Load a model version by its parent model and integer version number.
+    async fn load_model_version<'a>(
+        warehouse_id: WarehouseId,
+        model_id: ModelId,
+        version: i64,
+        transaction: <Self::Transaction as Transaction<Self::State>>::Transaction<'a>,
+    ) -> std::result::Result<ModelVersionInfo, LoadModelVersionError> {
+        Self::load_model_version_impl(warehouse_id, model_id, version, transaction).await
+    }
+
+    /// Load a model version by its stable internal id (TOCTOU-safe follow-up
+    /// reads after an authorization check).
+    async fn load_model_version_by_id<'a>(
+        warehouse_id: WarehouseId,
+        model_version_id: ModelVersionId,
+        transaction: <Self::Transaction as Transaction<Self::State>>::Transaction<'a>,
+    ) -> std::result::Result<ModelVersionInfo, LoadModelVersionError> {
+        Self::load_model_version_by_id_impl(warehouse_id, model_version_id, transaction).await
+    }
+
+    /// List versions of a model, ordered by ascending version number (keyset
+    /// pagination on the version number).
+    async fn list_model_versions<'a>(
+        warehouse_id: WarehouseId,
+        model_id: ModelId,
+        page_size: Option<i64>,
+        page_token: Option<&str>,
+        transaction: <Self::Transaction as Transaction<Self::State>>::Transaction<'a>,
+    ) -> std::result::Result<(Vec<ModelVersionInfo>, Option<String>), ListModelVersionsError> {
+        Self::list_model_versions_impl(warehouse_id, model_id, page_size, page_token, transaction)
+            .await
+    }
+
+    /// Transition a model version out of `PENDING_REGISTRATION` (finalize →
+    /// `Ready`, or mark `FailedRegistration`). Errors with
+    /// [`InvalidModelVersionStatusTransition`] if the version is not pending.
+    async fn update_model_version_status<'a>(
+        warehouse_id: WarehouseId,
+        model_version_id: ModelVersionId,
+        new_status: ModelVersionStatus,
+        transaction: <Self::Transaction as Transaction<Self::State>>::Transaction<'a>,
+    ) -> std::result::Result<(), UpdateModelVersionError> {
+        Self::update_model_version_status_impl(
+            warehouse_id,
+            model_version_id,
+            new_status,
+            transaction,
+        )
+        .await
+    }
+
+    /// Set (or clear) the version comment (UC `PATCH .../versions/{v}`
+    /// supports `comment` only).
+    async fn update_model_version_comment<'a>(
+        warehouse_id: WarehouseId,
+        model_version_id: ModelVersionId,
+        comment: Option<&str>,
+        transaction: <Self::Transaction as Transaction<Self::State>>::Transaction<'a>,
+    ) -> std::result::Result<(), UpdateModelVersionError> {
+        Self::update_model_version_comment_impl(
+            warehouse_id,
+            model_version_id,
+            comment,
+            transaction,
+        )
+        .await
+    }
+
+    /// Hard-delete a model version (UC DELETE semantics; no soft delete in
+    /// v1).
+    async fn drop_model_version<'a>(
+        warehouse_id: WarehouseId,
+        model_id: ModelId,
+        version: i64,
+        transaction: <Self::Transaction as Transaction<Self::State>>::Transaction<'a>,
+    ) -> std::result::Result<ModelVersionId, DropModelVersionError> {
+        Self::drop_model_version_impl(warehouse_id, model_id, version, transaction).await
+    }
+}
