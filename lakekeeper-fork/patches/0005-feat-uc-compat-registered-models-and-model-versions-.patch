diff --git a/crates/lakekeeper/src/service/authz/model.rs b/crates/lakekeeper/src/service/authz/model.rs
new file mode 100644
index 00000000..68735e25
--- /dev/null
+++ b/crates/lakekeeper/src/service/authz/model.rs
@@ -0,0 +1,442 @@
+//! Authorization for Unity Catalog registered models. Mirrors
+//! `service::authz::volume` (can-see = `GetMetadata`, 404-masking,
+//! data-plane exclusion from the instance-admin bypass).
+//!
+//! Model versions have NO authorization identity of their own: version
+//! operations authorize on the parent model. v1 mapping:
+//! - version create / finalize / comment update → `CreateVersion`
+//!   (FGA `can_create_version`, derived from `modify`)
+//! - version delete → `Drop` (destructive, like model delete)
+//! - version READ credentials → `ReadData`;
+//!   READ_WRITE credentials → `ReadData` + `WriteData` (data-plane actions,
+//!   excluded from the instance-admin bypass).
+
+use std::collections::HashMap;
+
+use iceberg_ext::catalog::rest::ErrorModel;
+
+use crate::{
+    WarehouseId,
+    api::RequestMetadata,
+    service::{
+        AuthZModelInfo, CatalogBackendError, ModelIdentOrId, NamespaceHierarchy, NamespaceId,
+        NamespaceWithParent, ResolvedWarehouse,
+        authz::{
+            AuthorizationBackendUnavailable, AuthorizationCountMismatch, AuthorizationDecision,
+            Authorizer, AuthzBadRequest, CannotInspectPermissions, CatalogAction,
+            CatalogModelAction, IsAllowedActionError, MustUse, UserOrRole,
+        },
+        events::{
+            AuthorizationFailureReason, AuthorizationFailureSource,
+            delegate_authorization_failure_source,
+        },
+    },
+};
+
+const CAN_SEE_PERMISSION: CatalogModelAction = CatalogModelAction::GetMetadata;
+
+pub trait ModelAction
+where
+    Self: CatalogAction + Clone + PartialEq + Eq + From<CatalogModelAction>,
+{
+    /// Whether this action reads or writes model artifact data (as opposed
+    /// to metadata or catalog operations). Used to exclude data-plane
+    /// actions from the instance-admin bypass.
+    fn is_data_plane(&self) -> bool;
+}
+
+impl ModelAction for CatalogModelAction {
+    fn is_data_plane(&self) -> bool {
+        matches!(self, Self::ReadData | Self::WriteData)
+    }
+}
+
+// ------------------ Cannot See Error ------------------
+#[derive(Debug, PartialEq, Eq)]
+pub struct AuthZCannotSeeModel {
+    warehouse_id: WarehouseId,
+    model: ModelIdentOrId,
+    internal_resource_not_found: bool,
+}
+
+impl AuthZCannotSeeModel {
+    #[must_use]
+    pub fn new(
+        warehouse_id: WarehouseId,
+        model: impl Into<ModelIdentOrId>,
+        resource_not_found: bool,
+    ) -> Self {
+        Self {
+            warehouse_id,
+            model: model.into(),
+            internal_resource_not_found: resource_not_found,
+        }
+    }
+
+    #[must_use]
+    pub fn new_not_found(warehouse_id: WarehouseId, model: impl Into<ModelIdentOrId>) -> Self {
+        Self::new(warehouse_id, model, true)
+    }
+
+    #[must_use]
+    pub fn new_forbidden(warehouse_id: WarehouseId, model: impl Into<ModelIdentOrId>) -> Self {
+        Self::new(warehouse_id, model, false)
+    }
+}
+
+impl AuthorizationFailureSource for AuthZCannotSeeModel {
+    fn into_error_model(self) -> ErrorModel {
+        let AuthZCannotSeeModel {
+            warehouse_id,
+            model,
+            internal_resource_not_found: _,
+        } = self;
+        // 404 for both not-found and cannot-see: hide existence.
+        ErrorModel::not_found(
+            format!("Registered model {model} not found in warehouse `{warehouse_id}`"),
+            "ModelNotFound",
+            None,
+        )
+    }
+
+    fn to_failure_reason(&self) -> AuthorizationFailureReason {
+        if self.internal_resource_not_found {
+            AuthorizationFailureReason::ResourceNotFound
+        } else {
+            AuthorizationFailureReason::CannotSeeResource
+        }
+    }
+}
+
+// ------------------ Action Forbidden Error ------------------
+#[derive(Debug, PartialEq, Eq)]
+pub struct AuthZModelActionForbidden {
+    warehouse_id: WarehouseId,
+    model: ModelIdentOrId,
+    action: String,
+}
+
+impl AuthZModelActionForbidden {
+    #[must_use]
+    pub fn new(
+        warehouse_id: WarehouseId,
+        model: impl Into<ModelIdentOrId>,
+        action: &impl ModelAction,
+    ) -> Self {
+        Self {
+            warehouse_id,
+            model: model.into(),
+            action: action.as_log_str(),
+        }
+    }
+}
+
+impl AuthorizationFailureSource for AuthZModelActionForbidden {
+    fn into_error_model(self) -> ErrorModel {
+        let AuthZModelActionForbidden {
+            warehouse_id,
+            model,
+            action,
+        } = self;
+        ErrorModel::forbidden(
+            format!(
+                "Model action `{action}` forbidden on registered model {model} in warehouse `{warehouse_id}`"
+            ),
+            "ModelActionForbidden",
+            None,
+        )
+    }
+
+    fn to_failure_reason(&self) -> AuthorizationFailureReason {
+        AuthorizationFailureReason::ActionForbidden
+    }
+}
+
+#[derive(Debug, derive_more::From)]
+pub enum RequireModelActionError {
+    AuthZModelActionForbidden(AuthZModelActionForbidden),
+    AuthorizationBackendUnavailable(AuthorizationBackendUnavailable),
+    AuthorizationCountMismatch(AuthorizationCountMismatch),
+    CannotInspectPermissions(CannotInspectPermissions),
+    AuthorizerValidationFailed(AuthzBadRequest),
+    AuthZCannotSeeModel(AuthZCannotSeeModel),
+    CatalogBackendError(CatalogBackendError),
+}
+
+impl From<IsAllowedActionError> for RequireModelActionError {
+    fn from(err: IsAllowedActionError) -> Self {
+        match err {
+            IsAllowedActionError::AuthorizationBackendUnavailable(e) => e.into(),
+            IsAllowedActionError::CannotInspectPermissions(e) => e.into(),
+            IsAllowedActionError::BadRequest(e) => e.into(),
+            IsAllowedActionError::CountMismatch(e) => e.into(),
+        }
+    }
+}
+
+delegate_authorization_failure_source!(RequireModelActionError => {
+    AuthZModelActionForbidden,
+    AuthorizationBackendUnavailable,
+    AuthorizationCountMismatch,
+    CannotInspectPermissions,
+    AuthZCannotSeeModel,
+    CatalogBackendError,
+    AuthorizerValidationFailed
+});
+
+/// An action on a registered model with authorization context. Models are
+/// not part of DEFINER view chains, so there is no delegated-execution flag.
+pub struct ActionOnModel<'a, 'u, I: AuthZModelInfo, A> {
+    pub info: &'a I,
+    pub action: A,
+    pub user: Option<&'u UserOrRole>,
+}
+
+impl<I: AuthZModelInfo, A: Clone> Clone for ActionOnModel<'_, '_, I, A> {
+    fn clone(&self) -> Self {
+        Self {
+            info: self.info,
+            action: self.action.clone(),
+            user: self.user,
+        }
+    }
+}
+
+impl<I: AuthZModelInfo, A> std::fmt::Debug for ActionOnModel<'_, '_, I, A> {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("ActionOnModel")
+            .field("info", &format!("<{}>", std::any::type_name::<I>()))
+            .field("action", &std::any::type_name::<A>())
+            .field("user", &self.user)
+            .finish()
+    }
+}
+
+#[async_trait::async_trait]
+pub trait AuthZModelOps: Authorizer {
+    fn require_model_presence<T: AuthZModelInfo>(
+        &self,
+        warehouse_id: WarehouseId,
+        user_provided: impl Into<ModelIdentOrId> + Send,
+        result: Result<Option<T>, impl Into<RequireModelActionError> + Send>,
+    ) -> Result<T, RequireModelActionError> {
+        let info = result.map_err(Into::into)?;
+        let Some(info) = info else {
+            return Err(AuthZCannotSeeModel::new_not_found(warehouse_id, user_provided).into());
+        };
+        Ok(info)
+    }
+
+    async fn require_model_action<T: AuthZModelInfo>(
+        &self,
+        metadata: &RequestMetadata,
+        warehouse: &ResolvedWarehouse,
+        namespace: &NamespaceHierarchy,
+        user_provided: impl Into<ModelIdentOrId> + Send,
+        result: Result<Option<T>, impl Into<RequireModelActionError> + Send>,
+        action: impl Into<Self::ModelAction> + Send,
+    ) -> Result<T, RequireModelActionError> {
+        let warehouse_id = warehouse.warehouse_id;
+        let user_provided = user_provided.into();
+        let info = self.require_model_presence(warehouse_id, user_provided.clone(), result)?;
+        let ident = info.model_ident().clone();
+
+        let cant_see_err = AuthZCannotSeeModel::new_forbidden(warehouse_id, user_provided).into();
+        let action = action.into();
+
+        if action == CAN_SEE_PERMISSION.into() {
+            let is_allowed = self
+                .is_allowed_model_action(metadata, None, warehouse, namespace, &info, action)
+                .await?
+                .into_inner();
+            is_allowed.then_some(info).ok_or(cant_see_err)
+        } else {
+            let [can_see, is_allowed] = self
+                .are_allowed_model_actions_arr(
+                    metadata,
+                    None,
+                    warehouse,
+                    namespace,
+                    &info,
+                    &[CAN_SEE_PERMISSION.into(), action.clone()],
+                )
+                .await?
+                .into_inner();
+            if can_see {
+                is_allowed.then_some(info).ok_or_else(|| {
+                    AuthZModelActionForbidden::new(warehouse_id, ident.clone(), &action).into()
+                })
+            } else {
+                Err(cant_see_err)
+            }
+        }
+    }
+
+    async fn is_allowed_model_action(
+        &self,
+        metadata: &RequestMetadata,
+        for_user: Option<&UserOrRole>,
+        warehouse: &ResolvedWarehouse,
+        namespace: &NamespaceHierarchy,
+        info: &impl AuthZModelInfo,
+        action: impl Into<Self::ModelAction> + Send,
+    ) -> Result<MustUse<bool>, IsAllowedActionError> {
+        let [decision] = self
+            .are_allowed_model_actions_arr(
+                metadata,
+                for_user,
+                warehouse,
+                namespace,
+                info,
+                &[action.into()],
+            )
+            .await?
+            .into_inner();
+        Ok(decision.into())
+    }
+
+    async fn are_allowed_model_actions_arr<
+        const N: usize,
+        A: ModelAction + Into<Self::ModelAction> + Send + Clone + Sync,
+    >(
+        &self,
+        metadata: &RequestMetadata,
+        for_user: Option<&UserOrRole>,
+        warehouse: &ResolvedWarehouse,
+        namespace_hierarchy: &NamespaceHierarchy,
+        info: &impl AuthZModelInfo,
+        actions: &[A; N],
+    ) -> Result<MustUse<[bool; N]>, IsAllowedActionError> {
+        let wrapped = actions
+            .iter()
+            .map(|a| {
+                (
+                    &namespace_hierarchy.namespace,
+                    ActionOnModel {
+                        info,
+                        action: a.clone(),
+                        user: for_user,
+                    },
+                )
+            })
+            .collect::<Vec<_>>();
+        let result = self
+            .are_allowed_model_actions_vec(
+                metadata,
+                warehouse,
+                &namespace_hierarchy
+                    .parents
+                    .iter()
+                    .map(|ns| (ns.namespace_id(), ns.clone()))
+                    .collect(),
+                &wrapped,
+            )
+            .await?
+            .into_allowed();
+        let n_returned = result.len();
+        let arr: [bool; N] = result
+            .try_into()
+            .map_err(|_| AuthorizationCountMismatch::new(N, n_returned, "model"))?;
+        Ok(MustUse::from(arr))
+    }
+
+    async fn are_allowed_model_actions_vec<
+        A: ModelAction + Into<Self::ModelAction> + Send + Clone + Sync,
+    >(
+        &self,
+        metadata: &RequestMetadata,
+        warehouse: &ResolvedWarehouse,
+        parent_namespaces: &HashMap<NamespaceId, NamespaceWithParent>,
+        actions: &[(
+            &NamespaceWithParent,
+            ActionOnModel<'_, '_, impl AuthZModelInfo, A>,
+        )],
+    ) -> Result<MustUse<Vec<AuthorizationDecision>>, IsAllowedActionError> {
+        #[cfg(debug_assertions)]
+        {
+            let namespaces: Vec<&NamespaceWithParent> = actions.iter().map(|(ns, _)| *ns).collect();
+            super::table::validate_namespace_hierarchy(&namespaces, parent_namespaces);
+        }
+
+        let internal = metadata.is_lakekeeper_internal();
+
+        let mut auto_approved: Vec<Option<bool>> = Vec::with_capacity(actions.len());
+        let mut actions_to_check = Vec::new();
+
+        for (ns, action) in actions {
+            let same_warehouse = action.info.warehouse_id() == warehouse.warehouse_id;
+            if !same_warehouse {
+                tracing::warn!(
+                    "Model warehouse_id `{}` does not match provided warehouse_id `{}`. Denying access.",
+                    action.info.warehouse_id(),
+                    warehouse.warehouse_id
+                );
+                auto_approved.push(Some(false));
+                continue;
+            }
+
+            // Normalize user: if it's the actor itself, treat as None (acting as self).
+            let normalized_user = if metadata.actor().to_user_or_role().as_ref() == action.user {
+                None
+            } else {
+                action.user
+            };
+
+            // `LakekeeperInternal` bypasses all actions including data-plane.
+            // Instance admins bypass only non-data-plane actions.
+            let bypass = metadata.bypasses_control_plane_authz(normalized_user)
+                && (internal || !action.action.is_data_plane());
+            if bypass {
+                auto_approved.push(Some(true));
+            } else {
+                auto_approved.push(None);
+                let mut normalized_action = action.clone();
+                normalized_action.user = normalized_user;
+                actions_to_check.push((*ns, normalized_action));
+            }
+        }
+
+        if actions_to_check.is_empty() {
+            Ok(auto_approved
+                .into_iter()
+                .map(|v| AuthorizationDecision::from(v.unwrap()))
+                .collect())
+        } else {
+            let decisions = self
+                .are_allowed_model_actions_impl(
+                    metadata,
+                    warehouse,
+                    parent_namespaces,
+                    &actions_to_check,
+                )
+                .await?;
+
+            if decisions.len() != actions_to_check.len() {
+                return Err(AuthorizationCountMismatch::new(
+                    actions_to_check.len(),
+                    decisions.len(),
+                    "model",
+                )
+                .into());
+            }
+
+            // Merge auto-approved decisions (warehouse-mismatch / bypass) with
+            // the authorizer's checked decisions.
+            let mut decision_iter = decisions.into_iter();
+            let final_decisions: Vec<AuthorizationDecision> = auto_approved
+                .into_iter()
+                .map(|auto| {
+                    auto.map_or_else(
+                        || decision_iter.next().unwrap(),
+                        AuthorizationDecision::from,
+                    )
+                })
+                .collect();
+
+            Ok(final_decisions)
+        }
+        .map(MustUse::from)
+    }
+}
+
+impl<T> AuthZModelOps for T where T: Authorizer {}
