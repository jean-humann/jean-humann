+        // row lock.
+        let mut t1 = pool.begin().await.unwrap();
+        let v1 = create_model_version(version_creation(warehouse_id, &model), &mut t1)
+            .await
+            .unwrap();
+        assert_eq!(v1.version, 1);
+
+        // Txn 2 must block on the lock and, once txn 1 commits, see its row
+        // and assign version 2 (NOT a duplicate 1).
+        let pool2 = pool.clone();
+        let creation2 = version_creation(warehouse_id, &model);
+        let handle = tokio::spawn(async move {
+            let mut t2 = pool2.begin().await.unwrap();
+            let v2 = create_model_version(creation2, &mut t2).await.unwrap();
+            t2.commit().await.unwrap();
+            v2.version
+        });
+
+        // Give txn 2 time to reach the lock, then commit txn 1.
+        tokio::time::sleep(std::time::Duration::from_millis(300)).await;
+        assert!(!handle.is_finished(), "txn 2 must block on the model lock");
+        t1.commit().await.unwrap();
+
+        let v2 = tokio::time::timeout(std::time::Duration::from_secs(10), handle)
+            .await
+            .expect("txn 2 must complete after txn 1 commits")
+            .unwrap();
+        assert_eq!(v2, 2);
+    }
+
+    #[sqlx::test]
+    async fn test_version_status_transitions(pool: PgPool) {
+        let (_state, pool, warehouse_id, namespace_id, _project_id) = setup(pool).await;
+        let model = create_model_committed(&pool, warehouse_id, namespace_id, "m").await;
+
+        let mut t = pool.begin().await.unwrap();
+        let v = create_model_version(version_creation(warehouse_id, &model), &mut t)
+            .await
+            .unwrap();
+        t.commit().await.unwrap();
+
+        // pending -> ready
+        let mut t = pool.begin().await.unwrap();
+        update_model_version_status(
+            warehouse_id,
+            v.model_version_id,
+            ModelVersionStatus::Ready,
+            &mut t,
+        )
+        .await
+        .unwrap();
+        t.commit().await.unwrap();
+
+        let mut t = pool.begin().await.unwrap();
+        let loaded = load_model_version(warehouse_id, model.model_id, v.version, &mut t)
+            .await
+            .unwrap();
+        let by_id = load_model_version_by_id(warehouse_id, v.model_version_id, &mut t)
+            .await
+            .unwrap();
+        t.commit().await.unwrap();
+        assert_eq!(loaded.status, ModelVersionStatus::Ready);
+        assert_eq!(by_id.model_version_id, v.model_version_id);
+        assert!(loaded.updated_at.is_some());
+
+        // ready -> ready is an invalid transition (double finalize).
+        let mut t = pool.begin().await.unwrap();
+        let err = update_model_version_status(
+            warehouse_id,
+            v.model_version_id,
+            ModelVersionStatus::Ready,
+            &mut t,
+        )
+        .await
+        .expect_err("double finalize must fail");
+        t.rollback().await.ok();
+        assert!(matches!(
+            err,
+            UpdateModelVersionError::InvalidModelVersionStatusTransition(_)
+        ));
+
+        // pending -> failed_registration is allowed.
+        let mut t = pool.begin().await.unwrap();
+        let v2 = create_model_version(version_creation(warehouse_id, &model), &mut t)
+            .await
+            .unwrap();
+        update_model_version_status(
+            warehouse_id,
+            v2.model_version_id,
+            ModelVersionStatus::FailedRegistration,
+            &mut t,
+        )
+        .await
+        .unwrap();
+        t.commit().await.unwrap();
+
+        // Unknown version errors NotFound.
+        let mut t = pool.begin().await.unwrap();
+        let err = update_model_version_status(
+            warehouse_id,
+            ModelVersionId::from(Uuid::now_v7()),
+            ModelVersionStatus::Ready,
+            &mut t,
+        )
+        .await
+        .expect_err("unknown version");
+        t.rollback().await.ok();
+        assert!(matches!(
+            err,
+            UpdateModelVersionError::ModelVersionNotFound(_)
+        ));
+    }
+
+    #[sqlx::test]
+    async fn test_drop_model_with_versions(pool: PgPool) {
+        let (_state, pool, warehouse_id, namespace_id, _project_id) = setup(pool).await;
+        let model = create_model_committed(&pool, warehouse_id, namespace_id, "m").await;
+
+        let mut t = pool.begin().await.unwrap();
+        let v = create_model_version(version_creation(warehouse_id, &model), &mut t)
+            .await
+            .unwrap();
+        t.commit().await.unwrap();
+
+        // Without force: fails while versions exist.
+        let mut t = pool.begin().await.unwrap();
+        let err = drop_model(warehouse_id, namespace_id, "m", false, &mut t)
+            .await
+            .expect_err("model with versions must not drop");
+        t.rollback().await.ok();
+        assert!(matches!(err, DropModelError::ModelHasVersions(_)));
+
+        // After deleting the version, the drop succeeds.
+        let mut t = pool.begin().await.unwrap();
+        let dropped = drop_model_version(warehouse_id, model.model_id, v.version, &mut t)
+            .await
+            .unwrap();
+        assert_eq!(dropped, v.model_version_id);
+        drop_model(warehouse_id, namespace_id, "m", false, &mut t)
+            .await
+            .unwrap();
+        t.commit().await.unwrap();
+
+        // Force-drop removes versions via cascade.
+        let model = create_model_committed(&pool, warehouse_id, namespace_id, "m2").await;
+        let mut t = pool.begin().await.unwrap();
+        create_model_version(version_creation(warehouse_id, &model), &mut t)
+            .await
+            .unwrap();
+        t.commit().await.unwrap();
+        let mut t = pool.begin().await.unwrap();
+        drop_model(warehouse_id, namespace_id, "m2", true, &mut t)
+            .await
+            .unwrap();
+        t.commit().await.unwrap();
+        let mut t = pool.begin().await.unwrap();
+        let err = load_model_version(warehouse_id, model.model_id, 1, &mut t)
+            .await
+            .expect_err("cascade must remove versions");
+        t.commit().await.unwrap();
+        assert!(matches!(
+            err,
+            LoadModelVersionError::ModelVersionNotFound(_)
+        ));
+    }
+
+    #[sqlx::test]
+    async fn test_version_location_overlap_conflict(pool: PgPool) {
+        let (_state, pool, warehouse_id, namespace_id, _project_id) = setup(pool).await;
+        let model = create_model_committed(&pool, warehouse_id, namespace_id, "m").await;
+
+        let mut t = pool.begin().await.unwrap();
+        let v1 = create_model_version(version_creation(warehouse_id, &model), &mut t)
+            .await
+            .unwrap();
+        t.commit().await.unwrap();
+
+        // A second version whose location nests inside the first one's must
+        // conflict.
+        let mut nested = version_creation(warehouse_id, &model);
+        nested.location = {
+            let mut l = v1.location.clone();
+            l.push("sub");
+            l
+        };
+        let mut t = pool.begin().await.unwrap();
+        let err = create_model_version(nested, &mut t)
+            .await
+            .expect_err("nested version location must conflict");
+        t.rollback().await.ok();
+        assert!(
+            matches!(err, CreateModelVersionError::LocationAlreadyTaken(_)),
+            "expected LocationAlreadyTaken, got: {err:?}"
+        );
+
+        // A volume inside a model version location must conflict too
+        // (three-way union).
+        let vol = lakekeeper::service::VolumeCreation {
+            volume_id: lakekeeper::service::VolumeId::from(Uuid::now_v7()),
+            namespace_id,
+            warehouse_id,
+            name: "inside-model-version".to_string(),
+            volume_type: lakekeeper::service::VolumeType::External,
+            location: {
+                let mut l = v1.location.clone();
+                l.push("vol");
+                l
+            },
+            comment: None,
+        };
+        let mut t = pool.begin().await.unwrap();
+        let err = crate::uc::volume::create_volume(vol, &mut t)
+            .await
+            .expect_err("volume inside model version location must conflict");
+        t.rollback().await.ok();
+        assert!(
+            matches!(
+                err,
+                lakekeeper::service::CreateVolumeError::LocationAlreadyTaken(_)
+            ),
+            "expected LocationAlreadyTaken, got: {err:?}"
+        );
+
+        // And a model version inside an existing volume location conflicts.
+        let vol_ok = lakekeeper::service::VolumeCreation {
+            volume_id: lakekeeper::service::VolumeId::from(Uuid::now_v7()),
+            namespace_id,
+            warehouse_id,
+            name: "standalone".to_string(),
+            volume_type: lakekeeper::service::VolumeType::External,
+            location: "s3://bucket/volumes/standalone".parse().unwrap(),
+            comment: None,
+        };
+        let mut t = pool.begin().await.unwrap();
+        crate::uc::volume::create_volume(vol_ok, &mut t)
+            .await
+            .unwrap();
+        t.commit().await.unwrap();
+
+        let mut inside_volume = version_creation(warehouse_id, &model);
+        inside_volume.location = "s3://bucket/volumes/standalone/mv".parse().unwrap();
+        let mut t = pool.begin().await.unwrap();
+        let err = create_model_version(inside_volume, &mut t)
+            .await
+            .expect_err("version inside volume location must conflict");
+        t.rollback().await.ok();
+        assert!(matches!(
+            err,
+            CreateModelVersionError::LocationAlreadyTaken(_)
+        ));
+    }
+
+    #[sqlx::test]
+    async fn test_version_comment_update_and_missing_model(pool: PgPool) {
+        let (_state, pool, warehouse_id, namespace_id, _project_id) = setup(pool).await;
+        let model = create_model_committed(&pool, warehouse_id, namespace_id, "m").await;
+
+        let mut t = pool.begin().await.unwrap();
+        let v = create_model_version(version_creation(warehouse_id, &model), &mut t)
+            .await
+            .unwrap();
+        t.commit().await.unwrap();
+
+        let mut t = pool.begin().await.unwrap();
+        update_model_version_comment(warehouse_id, v.model_version_id, Some("patched"), &mut t)
+            .await
+            .unwrap();
+        t.commit().await.unwrap();
+        let mut t = pool.begin().await.unwrap();
+        let loaded = load_model_version_by_id(warehouse_id, v.model_version_id, &mut t)
+            .await
+            .unwrap();
+        t.commit().await.unwrap();
+        assert_eq!(loaded.comment.as_deref(), Some("patched"));
+
+        // Creating a version for a missing model errors ModelNotFound.
+        let mut creation = version_creation(warehouse_id, &model);
+        creation.model_id = ModelId::from(Uuid::now_v7());
+        let mut t = pool.begin().await.unwrap();
+        let err = create_model_version(creation, &mut t)
+            .await
+            .expect_err("missing model");
+        t.rollback().await.ok();
+        assert!(matches!(err, CreateModelVersionError::ModelNotFound(_)));
+    }
+}
