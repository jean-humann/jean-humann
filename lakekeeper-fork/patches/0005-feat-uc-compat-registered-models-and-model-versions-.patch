+) -> UcResult<ListModelVersionsResponse> {
+    let (catalog_name, schema_name, model_name) = split_model_full_name(&full_name)?;
+    let page_size = effective_page_size(query.max_results)?;
+    let warehouse = resolve_catalog_warehouse::<C>(
+        &request_metadata,
+        catalog_name,
+        state.v1_state.catalog.clone(),
+    )
+    .await?;
+
+    let (_ns, model) = load_and_authorize_model::<C, A>(
+        &state.v1_state.authz,
+        &request_metadata,
+        &warehouse,
+        schema_name,
+        model_name,
+        CatalogModelAction::GetMetadata,
+        state.v1_state.catalog.clone(),
+    )
+    .await?;
+
+    let mut t = C::Transaction::begin_read(state.v1_state.catalog)
+        .await
+        .map_err(uc_err)?;
+    let (entries, next_page_token) = C::list_model_versions(
+        warehouse.warehouse_id,
