+pub(crate) async fn get_registered_model<C: CatalogStore, A: Authorizer + Clone, S: SecretStore>(
+    full_name: String,
+    state: ApiContext<State<A, C, S>>,
+    request_metadata: RequestMetadata,
+) -> UcResult<uc_v1::RegisteredModelInfo> {
+    let (catalog_name, schema_name, model_name) = split_model_full_name(&full_name)?;
+    let warehouse = resolve_catalog_warehouse::<C>(
+        &request_metadata,
+        catalog_name,
+        state.v1_state.catalog.clone(),
+    )
+    .await?;
+
+    let (_ns, info) = load_and_authorize_model::<C, A>(
+        &state.v1_state.authz,
+        &request_metadata,
+        &warehouse,
+        schema_name,
+        model_name,
+        CatalogModelAction::GetMetadata,
+        state.v1_state.catalog,
+    )
+    .await?;
+
+    Ok(registered_model_response(catalog_name, schema_name, &info))
+}
+
+pub(crate) async fn update_registered_model<
+    C: CatalogStore,
+    A: Authorizer + Clone,
+    S: SecretStore,
+>(
+    full_name: String,
+    request: UpdateRegisteredModelRequest,
+    state: ApiContext<State<A, C, S>>,
+    request_metadata: RequestMetadata,
+) -> UcResult<uc_v1::RegisteredModelInfo> {
+    let UpdateRegisteredModelRequest { comment, new_name } = request;
+    if new_name.is_some() {
+        return Err(UcErrorResponse::invalid_argument(
+            "Renaming registered models is not supported by the Unity Catalog compatibility API.",
+        ));
+    }
+    let (catalog_name, schema_name, model_name) = split_model_full_name(&full_name)?;
+    let warehouse = resolve_catalog_warehouse::<C>(
+        &request_metadata,
+        catalog_name,
+        state.v1_state.catalog.clone(),
+    )
+    .await?;
+
+    let Some(comment) = comment else {
+        // Nothing to change; behave like a get (incl. authorization).
+        return get_registered_model::<C, A, S>(full_name, state, request_metadata).await;
+    };
+
+    // The v1 model action set has no dedicated Update action; comment
+    // updates authorize `Drop`, the metadata-mutation privilege (FGA
+    // `modify` — same relation `can_create_version` derives from, but Drop
+    // is not a data-plane action, so instance admins retain it).
+    let (_ns, info) = load_and_authorize_model::<C, A>(
+        &state.v1_state.authz,
+        &request_metadata,
+        &warehouse,
+        schema_name,
+        model_name,
+        CatalogModelAction::Drop,
+        state.v1_state.catalog.clone(),
+    )
+    .await?;
+
+    let mut t = C::Transaction::begin_write(state.v1_state.catalog.clone())
+        .await
+        .map_err(uc_err)?;
+    // By-id (TOCTOU): the update must hit the row the authz check applied to,
+    // not whatever row currently carries the name.
+    C::update_model_comment(
+        warehouse.warehouse_id,
+        info.model_id,
+        Some(&comment),
+        t.transaction(),
+    )
+    .await
+    .map_err(uc_err)?;
+    let info = C::load_model_by_id(warehouse.warehouse_id, info.model_id, t.transaction())
+        .await
+        .map_err(uc_err)?;
+    t.commit().await.map_err(uc_err)?;
+
+    Ok(registered_model_response(catalog_name, schema_name, &info))
+}
+
+pub(crate) async fn delete_registered_model<
+    C: CatalogStore,
+    A: Authorizer + Clone,
+    S: SecretStore,
+>(
+    full_name: String,
+    query: DeleteRegisteredModelQuery,
+    state: ApiContext<State<A, C, S>>,
+    request_metadata: RequestMetadata,
+) -> UcResult<()> {
+    let (catalog_name, schema_name, model_name) = split_model_full_name(&full_name)?;
+    let force = query.force.unwrap_or(false);
+    let warehouse = resolve_catalog_warehouse::<C>(
+        &request_metadata,
+        catalog_name,
+        state.v1_state.catalog.clone(),
+    )
+    .await?;
+
+    let (ns, info) = load_and_authorize_model::<C, A>(
+        &state.v1_state.authz,
+        &request_metadata,
+        &warehouse,
+        schema_name,
+        model_name,
+        CatalogModelAction::Drop,
+        state.v1_state.catalog.clone(),
+    )
+    .await?;
+
+    let mut t = C::Transaction::begin_write(state.v1_state.catalog)
+        .await
+        .map_err(uc_err)?;
+    let dropped_id = C::drop_model(
+        warehouse.warehouse_id,
+        ns.namespace.namespace_id(),
+        model_name,
+        force,
+        t.transaction(),
+    )
+    .await
+    .map_err(uc_err)?;
+    t.commit().await.map_err(uc_err)?;
+    debug_assert_eq!(dropped_id, info.model_id);
+
+    // Best-effort authorizer cleanup after the commit (mirrors volume drop):
+    // a failure leaves orphaned tuples, not broken authorization.
+    if let Err(e) = state
+        .v1_state
+        .authz
+        .delete_model(warehouse.warehouse_id, dropped_id)
+        .await
+    {
+        tracing::warn!(
+            "Failed to delete model {dropped_id} in warehouse {} from authorizer: {e}",
+            warehouse.warehouse_id
+        );
+    }
+
+    Ok(())
+}
+
+pub(crate) async fn create_model_version<C: CatalogStore, A: Authorizer + Clone, S: SecretStore>(
+    request: CreateModelVersionRequest,
+    state: ApiContext<State<A, C, S>>,
+    request_metadata: RequestMetadata,
+) -> UcResult<uc_v1::ModelVersionInfo> {
+    let CreateModelVersionRequest {
+        model_name,
+        catalog_name,
+        schema_name,
+        source,
+        run_id,
+        comment,
+    } = request;
+
+    let warehouse = resolve_catalog_warehouse::<C>(
+        &request_metadata,
+        &catalog_name,
+        state.v1_state.catalog.clone(),
+    )
+    .await?;
+
+    // ------------------- AUTHZ: CreateVersion on the parent model -------------------
+    let (_ns, model) = load_and_authorize_model::<C, A>(
+        &state.v1_state.authz,
+        &request_metadata,
+        &warehouse,
+        &schema_name,
+        &model_name,
+        CatalogModelAction::CreateVersion,
+        state.v1_state.catalog.clone(),
+    )
+    .await?;
+
+    // ------------------- LOCATION (managed, below the model) -------------------
+    // `<model-location>/versions/<model_version_id>`: the version id (a
+    // fresh UUIDv7) makes the path deterministic and collision-free even for
+    // concurrently created versions (the integer version number is only
+    // assigned inside the insert transaction).
+    let model_version_id = ModelVersionId::new_random();
+    let mut location = model.location.clone();
+    location
+        .push(MODEL_VERSIONS_FOLDER)
+        .push(&model_version_id.to_string());
+    location.without_trailing_slash();
+
+    let creation = ModelVersionCreation {
+        model_version_id,
+        model_id: model.model_id,
+        warehouse_id: warehouse.warehouse_id,
+        source: Some(source),
+        run_id,
+        comment,
+        location,
+    };
+
+    // No authorizer hook: versions have no FGA object of their own.
+    let mut t = C::Transaction::begin_write(state.v1_state.catalog)
+        .await
+        .map_err(uc_err)?;
+    let info = C::create_model_version(creation, t.transaction())
+        .await
+        .map_err(uc_err)?;
+    t.commit().await.map_err(uc_err)?;
+
+    Ok(model_version_response(&catalog_name, &schema_name, &info))
+}
+
+pub(crate) async fn list_model_versions<C: CatalogStore, A: Authorizer + Clone, S: SecretStore>(
+    full_name: String,
