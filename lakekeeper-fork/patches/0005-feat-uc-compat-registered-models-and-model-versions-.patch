+        (ModelVersionOperation::ReadWriteModelVersion, status) => {
+            return Err(UcErrorResponse::invalid_argument(format!(
+                "READ_WRITE_MODEL_VERSION credentials are only available while the model                  version is PENDING_REGISTRATION; version {version} of '{full_name}' is {status}.",
+                status = status.as_str()
+            )));
+        }
+        // READ for pending + ready, never for failed registrations.
+        (ModelVersionOperation::ReadModelVersion, ModelVersionStatus::FailedRegistration) => {
+            return Err(UcErrorResponse::invalid_argument(format!(
+                "Model version {version} of '{full_name}' has status FAILED_REGISTRATION;                  no credentials are available."
+            )));
+        }
+        (ModelVersionOperation::ReadModelVersion, _) => {}
+        (ModelVersionOperation::UnknownModelVersionOperation, _) => unreachable!("rejected above"),
+    }
+
+    // ------------------- VEND -------------------
+    let storage_secret = maybe_get_secret(warehouse.storage_secret_id, &state.v1_state.secrets)
+        .await
+        .map_err(uc_err)?;
+
+    let table_config = warehouse
+        .storage_profile
+        .generate_table_config(
+            DataAccessMode::ServerDelegated(DataAccess {
+                vended_credentials: true,
+                remote_signing: false,
+            }),
+            storage_secret.as_deref(),
+            &info.location,
+            storage_permissions,
+            &request_metadata,
+            &info,
+        )
+        .await
+        .map_err(uc_err)?;
+
+    Ok(temporary_credentials_from_table_config(&table_config))
 }
