diff --git a/crates/lakekeeper/src/server/uc/models.rs b/crates/lakekeeper/src/server/uc/models.rs
new file mode 100644
index 00000000..80f846b8
--- /dev/null
+++ b/crates/lakekeeper/src/server/uc/models.rs
@@ -0,0 +1,1064 @@
+//! UC Registered Models + Model Versions handlers. Models are dedicated
+//! entities (`uc_model`) below a top-level namespace; authorization mirrors
+//! volumes (can-see = `GetMetadata`, 404-masking, `IncludeInList` filtering
+//! on list). Model versions have no authz identity of their own — version
+//! operations authorize on the parent model:
+//! create/finalize/comment-update → `CreateVersion`, delete → `Drop`,
+//! credentials → `ReadData`/`WriteData`.
+//!
+//! `listRegisteredModels` allows omitting `catalog_name`/`schema_name`
+//! (list-all). The unscoped variants have no namespace-level gate; instead
+//! every returned model is individually filtered with an `IncludeInList`
+//! batch check against its own namespace (grouped per warehouse).
+
+use std::{collections::HashMap, sync::Arc};
+
+use crate::{
+    api::{
+        ApiContext,
+        uc::{
+            UcErrorResponse, UcResult, effective_page_size, to_epoch_millis,
+            v1::{
+                self as uc_v1, CreateModelVersionRequest, CreateRegisteredModelRequest,
+                DeleteRegisteredModelQuery, FinalizeModelVersionRequest, ListModelVersionsResponse,
+                ListRegisteredModelsQuery, ListRegisteredModelsResponse, UpdateModelVersionRequest,
+                UpdateRegisteredModelRequest,
+            },
+        },
+    },
+    request_metadata::RequestMetadata,
+    server::{
+        tabular::determine_namespace_location,
+        uc::resolve::{resolve_catalog_warehouse, resolve_schema_namespace, uc_err},
+    },
+    service::{
+        CachePolicy, CatalogModelOps, CatalogNamespaceOps, CatalogStore, CatalogWarehouseOps,
+        LoadModelError, LoadModelVersionError, ModelCreation, ModelId, ModelIdentOrId, ModelInfo,
+        ModelListEntry, ModelVersionCreation, ModelVersionId, ModelVersionInfo, ModelVersionStatus,
+        NamespaceHierarchy, ResolvedWarehouse, SecretStore, State, Transaction, WarehouseId,
+        authz::{
+            ActionOnModel, AuthZModelOps, Authorizer, CatalogModelAction, CatalogNamespaceAction,
+            RequireModelActionError,
+        },
+        events::{AuthorizationFailureSource, context::authz_to_error_no_audit},
+    },
+};
+
+/// Subfolder of the namespace location under which managed model locations
+/// are derived: `<namespace-location>/__uc_models/<model_id>`. Version
+/// artifact locations live below the model:
+/// `<model-location>/versions/<model_version_id>`.
+const MANAGED_MODELS_FOLDER: &str = "__uc_models";
+const MODEL_VERSIONS_FOLDER: &str = "versions";
+
+pub(crate) fn registered_model_response(
+    catalog_name: &str,
+    schema_name: &str,
+    info: &ModelInfo,
+) -> uc_v1::RegisteredModelInfo {
+    uc_v1::RegisteredModelInfo {
+        name: info.name.clone(),
+        catalog_name: catalog_name.to_string(),
+        schema_name: schema_name.to_string(),
+        full_name: format!("{catalog_name}.{schema_name}.{}", info.name),
+        storage_location: info.location.to_string(),
+        id: info.model_id.to_string(),
+        comment: info.comment.clone(),
+        owner: None,
+        created_at: Some(to_epoch_millis(info.created_at)),
+        created_by: None,
+        updated_at: info.updated_at.map(to_epoch_millis),
+        updated_by: None,
+    }
+}
+
+pub(crate) fn model_version_response(
+    catalog_name: &str,
+    schema_name: &str,
+    info: &ModelVersionInfo,
+) -> uc_v1::ModelVersionInfo {
+    uc_v1::ModelVersionInfo {
+        model_name: info.model_name.clone(),
+        catalog_name: catalog_name.to_string(),
+        schema_name: schema_name.to_string(),
+        version: info.version,
+        status: info.status.into(),
+        storage_location: info.location.to_string(),
+        id: info.model_version_id.to_string(),
+        source: info.source.clone(),
+        run_id: info.run_id.clone(),
+        comment: info.comment.clone(),
+        created_at: Some(to_epoch_millis(info.created_at)),
+        created_by: None,
+        updated_at: info.updated_at.map(to_epoch_millis),
+        updated_by: None,
+    }
+}
+
+/// Split a UC model `full_name` (`<catalog>.<schema>.<model>`).
+pub(crate) fn split_model_full_name(full_name: &str) -> UcResult<(&str, &str, &str)> {
+    let parts: Vec<&str> = full_name.split('.').collect();
+    match parts.as_slice() {
+        [catalog, schema, model]
+            if !catalog.is_empty() && !schema.is_empty() && !model.is_empty() =>
+        {
+            Ok((catalog, schema, model))
+        }
+        _ => Err(UcErrorResponse::invalid_argument(format!(
+            "Invalid model full name '{full_name}'. Expected '<catalog>.<schema>.<model>'."
+        ))),
+    }
+}
+
+pub(crate) fn model_not_found(full_name: impl std::fmt::Display) -> UcErrorResponse {
+    UcErrorResponse::not_found(format!("Registered model not found: {full_name}"))
+}
+
+pub(crate) fn model_version_not_found(
+    full_name: impl std::fmt::Display,
+    version: i64,
+) -> UcErrorResponse {
+    UcErrorResponse::not_found(format!(
+        "Model version not found: {full_name} version {version}"
+    ))
+}
+
+pub(crate) fn require_authz_to_uc_err(e: RequireModelActionError) -> UcErrorResponse {
+    UcErrorResponse::from(e.into_error_model())
+}
+
+/// Guard to clean up authorizer state if model creation fails after the
+/// authorizer tuples were written (they are not transactional with Postgres).
+struct ModelCreationGuard<A: Authorizer> {
+    authorizer: A,
+    warehouse_id: WarehouseId,
+    model_id: ModelId,
+    authorizer_created: bool,
+}
+
+impl<A: Authorizer> ModelCreationGuard<A> {
+    fn new(authorizer: A, warehouse_id: WarehouseId, model_id: ModelId) -> Self {
+        Self {
+            authorizer,
+            warehouse_id,
+            model_id,
+            authorizer_created: false,
+        }
+    }
+
+    fn mark_authorizer_created(&mut self) {
+        self.authorizer_created = true;
+    }
+
+    fn success(&mut self) {
+        self.authorizer_created = false;
+    }
+
+    async fn cleanup(&mut self) {
+        if self.authorizer_created
+            && let Err(e) = self
+                .authorizer
+                .delete_model(self.warehouse_id, self.model_id)
+                .await
+        {
+            tracing::warn!(
+                "Failed to cleanup authorizer model {} in warehouse {} after failed transaction: {e}",
+                self.model_id,
+                self.warehouse_id
+            );
+        }
+    }
+}
+
+/// Load `model_name` in the schema namespace and authorize `action` on it.
+/// Missing namespaces, missing models and non-visible models all surface as
+/// `NOT_FOUND` (existence masking).
+pub(crate) async fn load_and_authorize_model<C: CatalogStore, A: Authorizer>(
+    authorizer: &A,
+    request_metadata: &RequestMetadata,
+    warehouse: &Arc<ResolvedWarehouse>,
+    schema_name: &str,
+    model_name: &str,
+    action: CatalogModelAction,
+    catalog_state: C::State,
+) -> UcResult<(NamespaceHierarchy, ModelInfo)> {
+    let warehouse_id = warehouse.warehouse_id;
+    let full_name = format!("{}.{schema_name}.{model_name}", warehouse.name);
+    let namespace_ident = iceberg::NamespaceIdent::new(schema_name.to_string());
+
+    let namespace = C::get_namespace_cache_aware(
+        warehouse_id,
+        namespace_ident.clone(),
+        CachePolicy::Skip,
+        catalog_state.clone(),
+    )
+    .await
+    .map_err(uc_err)?
+    .ok_or_else(|| model_not_found(&full_name))?;
+
+    let mut t = C::Transaction::begin_read(catalog_state)
+        .await
+        .map_err(uc_err)?;
+    let load_result: Result<Option<ModelInfo>, RequireModelActionError> = match C::load_model(
+        warehouse_id,
+        namespace.namespace.namespace_id(),
+        model_name,
+        t.transaction(),
+    )
+    .await
+    {
+        Ok(info) => Ok(Some(info)),
+        Err(LoadModelError::ModelNotFound(_)) => Ok(None),
+        Err(e) => return Err(uc_err(e)),
+    };
+    t.commit().await.map_err(uc_err)?;
+
+    let user_provided = ModelIdentOrId::Ident(iceberg::TableIdent::new(
+        namespace_ident,
+        model_name.to_string(),
+    ));
+    let info = authorizer
+        .require_model_action(
+            request_metadata,
+            warehouse,
+            &namespace,
+            user_provided,
+            load_result,
+            action,
+        )
+        .await
+        .map_err(require_authz_to_uc_err)?;
+
+    Ok((namespace, info))
+}
+
+pub(crate) async fn create_registered_model<
+    C: CatalogStore,
+    A: Authorizer + Clone,
+    S: SecretStore,
+>(
+    request: CreateRegisteredModelRequest,
+    state: ApiContext<State<A, C, S>>,
+    request_metadata: RequestMetadata,
+) -> UcResult<uc_v1::RegisteredModelInfo> {
+    let CreateRegisteredModelRequest {
+        name,
+        catalog_name,
+        schema_name,
+        comment,
+    } = request;
+
+    if name.is_empty() || name.contains('.') || name.contains('/') {
+        return Err(UcErrorResponse::invalid_argument(format!(
+            "Invalid model name '{name}': model names must be non-empty and must not contain '.' or '/'."
+        )));
+    }
+
+    let warehouse = resolve_catalog_warehouse::<C>(
+        &request_metadata,
+        &catalog_name,
+        state.v1_state.catalog.clone(),
+    )
+    .await?;
+    let warehouse_id = warehouse.warehouse_id;
+    let model_id = ModelId::new_random();
+
+    // ------------------- AUTHZ: namespace-level CreateModel -------------------
+    let (warehouse, ns_hierarchy) = resolve_schema_namespace::<C, A>(
+        &state.v1_state.authz,
+        &request_metadata,
+        warehouse_id,
+        &schema_name,
+        CatalogNamespaceAction::CreateModel {
+            name: Some(name.clone()),
+            model_id: Some(model_id),
+        },
+        state.v1_state.catalog.clone(),
+    )
+    .await?;
+
+    // ------------------- LOCATION (always managed) -------------------
+    let mut location =
+        determine_namespace_location(&ns_hierarchy, &warehouse.storage_profile).map_err(uc_err)?;
+    location
+        .push(MANAGED_MODELS_FOLDER)
+        .push(&model_id.to_string());
+    location.without_trailing_slash();
+
+    // ------------------- CREATE (catalog + authorizer with guard) -------------------
+    let authorizer = state.v1_state.authz.clone();
+    let mut guard = ModelCreationGuard::new(authorizer.clone(), warehouse_id, model_id);
+
+    let creation = ModelCreation {
+        model_id,
+        namespace_id: ns_hierarchy.namespace.namespace_id(),
+        warehouse_id,
+        name,
+        location,
+        comment,
+    };
+
+    let result: UcResult<ModelInfo> = async {
+        let mut t = C::Transaction::begin_write(state.v1_state.catalog.clone())
+            .await
+            .map_err(uc_err)?;
+        let info = C::create_model(creation, t.transaction())
+            .await
+            .map_err(uc_err)?;
+
+        // Authorizer tuples are written between the catalog insert and the
+        // commit; the guard removes them again if the commit fails.
+        authorizer
+            .create_model(
+                &request_metadata,
+                warehouse_id,
+                info.model_id,
+                info.namespace_id,
+            )
+            .await
+            .map_err(uc_err)?;
+        guard.mark_authorizer_created();
+
+        t.commit().await.map_err(uc_err)?;
+        Ok(info)
+    }
+    .await;
+
+    match result {
+        Ok(info) => {
+            guard.success();
+            Ok(registered_model_response(
+                &catalog_name,
+                &schema_name,
+                &info,
+            ))
+        }
+        Err(e) => {
+            guard.cleanup().await;
+            Err(e)
+        }
+    }
+}
+
+/// Filter a page of model list entries with per-model `IncludeInList` checks.
+/// Entries are grouped per warehouse (the batch-check API is warehouse
+/// scoped) and joined with their own namespace hierarchies. Entries whose
+/// warehouse or namespace has vanished concurrently are filtered out.
+async fn filter_models_include_in_list<C: CatalogStore, A: Authorizer>(
+    authorizer: &A,
+    request_metadata: &RequestMetadata,
+    entries: &[ModelListEntry],
+    catalog_state: C::State,
+) -> UcResult<Vec<bool>> {
+    let mut masks = vec![false; entries.len()];
+
+    // Group entry indices by warehouse.
+    let mut by_warehouse: HashMap<WarehouseId, Vec<usize>> = HashMap::new();
+    for (idx, entry) in entries.iter().enumerate() {
+        by_warehouse
+            .entry(entry.warehouse_id)
+            .or_default()
+            .push(idx);
+    }
+
+    for (warehouse_id, indices) in by_warehouse {
+        let Some(warehouse) = C::get_active_warehouse_by_id(warehouse_id, catalog_state.clone())
+            .await
+            .map_err(uc_err)?
+        else {
+            // Warehouse vanished concurrently: hide its models.
+            continue;
+        };
+
+        // Fetch the namespace hierarchy for each distinct namespace in the
+        // group.
+        let mut hierarchies: HashMap<crate::service::NamespaceId, NamespaceHierarchy> =
+            HashMap::new();
+        for &idx in &indices {
+            let namespace_id = entries[idx].namespace_id;
+            if hierarchies.contains_key(&namespace_id) {
+                continue;
+            }
+            if let Some(h) = C::get_namespace_cache_aware(
+                warehouse_id,
+                namespace_id,
+                CachePolicy::Skip,
+                catalog_state.clone(),
+            )
+            .await
+            .map_err(uc_err)?
+            {
+                hierarchies.insert(namespace_id, h);
+            }
+        }
+
+        let checkable: Vec<usize> = indices
+            .iter()
+            .copied()
+            .filter(|&idx| hierarchies.contains_key(&entries[idx].namespace_id))
+            .collect();
+        if checkable.is_empty() {
+            continue;
+        }
+
+        let parents: HashMap<_, _> = hierarchies
+            .values()
+            .flat_map(|h| h.parents.iter())
+            .map(|n| (n.namespace_id(), n.clone()))
+            .collect();
+
+        let actions: Vec<_> = checkable
+            .iter()
+            .map(|&idx| {
+                let entry = &entries[idx];
+                (
+                    &hierarchies[&entry.namespace_id].namespace,
+                    ActionOnModel {
+                        info: entry,
+                        action: CatalogModelAction::IncludeInList,
+                        user: None,
+                    },
+                )
+            })
+            .collect();
+
+        let decisions = authorizer
+            .are_allowed_model_actions_vec(request_metadata, &warehouse, &parents, &actions)
+            .await
+            .map_err(|e| uc_err(authz_to_error_no_audit(e)))?
+            .into_allowed();
+
+        for (&idx, allowed) in checkable.iter().zip(decisions) {
+            masks[idx] = allowed;
+        }
+    }
+
+    Ok(masks)
+}
+
+pub(crate) async fn list_registered_models<
+    C: CatalogStore,
+    A: Authorizer + Clone,
+    S: SecretStore,
+>(
+    query: ListRegisteredModelsQuery,
+    state: ApiContext<State<A, C, S>>,
+    request_metadata: RequestMetadata,
+) -> UcResult<ListRegisteredModelsResponse> {
+    let ListRegisteredModelsQuery {
+        catalog_name,
+        schema_name,
+        max_results,
+        page_token,
+    } = query;
+    let page_size = effective_page_size(max_results)?;
+    let project_id = request_metadata.require_project_id(None).map_err(uc_err)?;
+    let authorizer = &state.v1_state.authz;
+
+    if catalog_name.is_none() && schema_name.is_some() {
+        return Err(UcErrorResponse::invalid_argument(
+            "schema_name requires catalog_name in listRegisteredModels.",
+        ));
+    }
+
+    // Resolve the requested scope. With a schema, the namespace-level
+    // ListModels action gates the query (mirroring volumes/functions); the
+    // warehouse-wide and project-wide variants have no coarse gate — results
+    // are filtered per model below.
+    let (warehouse_filter, namespace_filter) = match (&catalog_name, &schema_name) {
+        (Some(catalog_name), Some(schema_name)) => {
+            let warehouse = resolve_catalog_warehouse::<C>(
+                &request_metadata,
+                catalog_name,
+                state.v1_state.catalog.clone(),
+            )
+            .await?;
+            let (warehouse, ns) = resolve_schema_namespace::<C, A>(
+                authorizer,
+                &request_metadata,
+                warehouse.warehouse_id,
+                schema_name,
+                CatalogNamespaceAction::ListModels,
+                state.v1_state.catalog.clone(),
+            )
+            .await?;
+            (
+                Some(warehouse.warehouse_id),
+                Some(ns.namespace.namespace_id()),
+            )
+        }
+        (Some(catalog_name), None) => {
+            let warehouse = resolve_catalog_warehouse::<C>(
+                &request_metadata,
+                catalog_name,
+                state.v1_state.catalog.clone(),
+            )
+            .await?;
+            (Some(warehouse.warehouse_id), None)
+        }
+        (None, _) => (None, None),
+    };
+
+    let mut t = C::Transaction::begin_read(state.v1_state.catalog.clone())
+        .await
+        .map_err(uc_err)?;
+    let (entries, next_page_token) = C::list_models(
+        &project_id,
+        warehouse_filter,
+        namespace_filter,
+        Some(page_size),
+        page_token.as_deref(),
+        t.transaction(),
+    )
+    .await
+    .map_err(uc_err)?;
+    t.commit().await.map_err(uc_err)?;
+
+    // ------------------- AUTHZ: per-entry IncludeInList filtering -------------------
+    let masks = filter_models_include_in_list::<C, A>(
+        authorizer,
+        &request_metadata,
+        &entries,
+        state.v1_state.catalog,
+    )
+    .await?;
+
+    let registered_models = entries
+        .into_iter()
+        .zip(masks)
+        .filter(|(_, allowed)| *allowed)
+        .map(|(entry, _)| {
+            let schema_name = entry.namespace_ident.to_url_string();
+            uc_v1::RegisteredModelInfo {
+                full_name: format!("{}.{schema_name}.{}", entry.warehouse_name, entry.name),
+                catalog_name: entry.warehouse_name,
+                schema_name,
+                storage_location: entry.location.to_string(),
+                id: entry.model_id.to_string(),
+                comment: entry.comment,
+                owner: None,
+                created_at: Some(to_epoch_millis(entry.created_at)),
+                created_by: None,
+                updated_at: entry.updated_at.map(to_epoch_millis),
+                updated_by: None,
+                name: entry.name,
+            }
+        })
+        .collect();
+
+    Ok(ListRegisteredModelsResponse {
+        registered_models,
+        next_page_token,
+    })
+}
