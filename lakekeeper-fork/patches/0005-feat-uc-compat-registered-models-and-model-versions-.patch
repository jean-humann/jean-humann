+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn test_model_version_status_wire_format() {
+        assert_eq!(
+            serde_json::to_string(&ModelVersionStatus::PendingRegistration).unwrap(),
+            "\"PENDING_REGISTRATION\""
+        );
+        assert_eq!(
+            serde_json::to_string(&ModelVersionStatus::Ready).unwrap(),
+            "\"READY\""
+        );
+        assert_eq!(
+            serde_json::to_string(&ModelVersionStatus::ModelVersionStatusUnknown).unwrap(),
+            "\"MODEL_VERSION_STATUS_UNKNOWN\""
+        );
+        assert_eq!(
+            serde_json::from_str::<ModelVersionStatus>("\"FAILED_REGISTRATION\"").unwrap(),
+            ModelVersionStatus::FailedRegistration
+        );
+    }
+
+    #[test]
+    fn test_registered_model_info_serialization_omits_absent_fields() {
+        let info = RegisteredModelInfo {
+            name: "m".to_string(),
+            catalog_name: "cat".to_string(),
+            schema_name: "schema".to_string(),
+            full_name: "cat.schema.m".to_string(),
+            storage_location: "s3://bucket/ns/__uc_models/x".to_string(),
+            id: "0198a1b2-0000-7000-8000-000000000000".to_string(),
+            comment: None,
+            owner: None,
+            created_at: Some(1_727_000_000_000),
+            created_by: None,
+            updated_at: None,
+            updated_by: None,
+        };
+        let json = serde_json::to_value(&info).unwrap();
+        assert_eq!(json["full_name"], "cat.schema.m");
+        assert_eq!(json["id"], "0198a1b2-0000-7000-8000-000000000000");
+        assert_eq!(json["created_at"], 1_727_000_000_000_i64);
+        assert!(json.get("comment").is_none());
+        assert!(json.get("owner").is_none());
+        assert!(json.get("updated_at").is_none());
+        // The wire field is `id`, NOT `model_id`.
+        assert!(json.get("model_id").is_none());
+    }
+
+    #[test]
+    fn test_create_model_version_request_wire_format() {
+        let request: CreateModelVersionRequest = serde_json::from_value(serde_json::json!({
+            "model_name": "m",
+            "catalog_name": "cat",
+            "schema_name": "schema",
+            "source": "uc-e2e://run"
+        }))
+        .unwrap();
+        assert_eq!(request.source, "uc-e2e://run");
+        assert_eq!(request.run_id, None);
+        assert_eq!(request.comment, None);
+    }
+
+    #[test]
+    fn test_finalize_request_requires_full_name_and_version() {
+        let request: FinalizeModelVersionRequest = serde_json::from_value(serde_json::json!({
+            "full_name": "cat.schema.m",
+            "version": 1
+        }))
+        .unwrap();
+        assert_eq!(request.version, 1);
+        assert!(
+            serde_json::from_value::<FinalizeModelVersionRequest>(
+                serde_json::json!({"version": 1})
+            )
+            .is_err()
+        );
+    }
