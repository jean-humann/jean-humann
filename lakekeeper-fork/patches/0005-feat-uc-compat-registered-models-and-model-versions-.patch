+//! Unity Catalog registered model + model version queries (`uc_model`,
+//! `uc_model_version` tables).
+//!
+//! Version numbers are assigned server-side as `MAX(model_version) + 1` per
+//! model; the parent `uc_model` row is locked `FOR UPDATE` inside the insert
+//! CTE, which serializes concurrent version creation (and serializes it
+//! against `drop_model`, which takes the same lock). Version artifact
+//! locations participate in the location-overlap check together with
+//! `tabular` and `uc_volume` (and vice versa — see
+//! `volume::ensure_volume_location_available`).
+//!
+//! Note: the UC integer version lives in the `model_version` column; the
+//! `version` column is the row-version bumped by the shared trigger.
+
+use std::str::FromStr;
+
+use iceberg::TableIdent;
+use lakekeeper::{
+    CONFIG, ProjectId, WarehouseId,
+    service::{
+        CatalogBackendError, CreateModelError, CreateModelVersionError, DropModelError,
+        DropModelVersionError, InvalidModelVersionStatusTransition, ListModelVersionsError,
+        ListModelsError, LoadModelError, LoadModelVersionError, ModelAlreadyExists, ModelCreation,
+        ModelHasVersions, ModelId, ModelInfo, ModelListEntry, ModelNotFound, ModelVersionCreation,
+        ModelVersionId, ModelVersionInfo, ModelVersionNotFound, ModelVersionStatus, NamespaceId,
+        NamespaceVersion, UpdateModelError, UpdateModelVersionError, WarehouseVersion,
+    },
+};
+use lakekeeper_io::Location;
+use uuid::Uuid;
+
+use crate::{
+    dbutils::DBErrorHandler as _,
+    namespace::parse_namespace_identifier_from_vec,
+    pagination::{PaginateToken, V1PaginateToken},
+    tabular::get_partial_fs_locations,
+};
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, sqlx::Type)]
+#[sqlx(type_name = "uc_model_version_status", rename_all = "snake_case")]
+pub(crate) enum DbModelVersionStatus {
+    PendingRegistration,
+    FailedRegistration,
+    Ready,
+}
+
+impl From<ModelVersionStatus> for DbModelVersionStatus {
+    fn from(v: ModelVersionStatus) -> Self {
+        match v {
+            ModelVersionStatus::PendingRegistration => DbModelVersionStatus::PendingRegistration,
+            ModelVersionStatus::FailedRegistration => DbModelVersionStatus::FailedRegistration,
+            ModelVersionStatus::Ready => DbModelVersionStatus::Ready,
+        }
+    }
+}
+
+impl From<DbModelVersionStatus> for ModelVersionStatus {
+    fn from(v: DbModelVersionStatus) -> Self {
+        match v {
+            DbModelVersionStatus::PendingRegistration => ModelVersionStatus::PendingRegistration,
+            DbModelVersionStatus::FailedRegistration => ModelVersionStatus::FailedRegistration,
+            DbModelVersionStatus::Ready => ModelVersionStatus::Ready,
+        }
+    }
+}
+
+struct ModelFullRow {
+    model_id: Uuid,
+    warehouse_id: Uuid,
+    warehouse_version: i64,
+    namespace_id: Uuid,
+    namespace_version: i64,
+    namespace_name: Vec<String>,
+    name: String,
+    location: String,
+    comment: Option<String>,
+    created_at: chrono::DateTime<chrono::Utc>,
+    updated_at: Option<chrono::DateTime<chrono::Utc>>,
+}
+
+struct ModelListRow {
+    model_id: Uuid,
+    warehouse_id: Uuid,
+    warehouse_name: String,
+    namespace_id: Uuid,
+    namespace_name: Vec<String>,
+    name: String,
+    location: String,
+    comment: Option<String>,
+    created_at: chrono::DateTime<chrono::Utc>,
+    updated_at: Option<chrono::DateTime<chrono::Utc>>,
+}
+
+struct ModelVersionFullRow {
+    model_version_id: Uuid,
+    model_id: Uuid,
+    warehouse_id: Uuid,
+    warehouse_version: i64,
+    namespace_id: Uuid,
+    namespace_version: i64,
+    namespace_name: Vec<String>,
+    model_name: String,
+    model_version: i64,
+    status: DbModelVersionStatus,
+    source: Option<String>,
+    run_id: Option<String>,
+    comment: Option<String>,
+    location: String,
+    created_at: chrono::DateTime<chrono::Utc>,
+    updated_at: Option<chrono::DateTime<chrono::Utc>>,
+}
+
+fn parse_model_location(location: &str) -> Result<Location, CatalogBackendError> {
+    Location::from_str(location).map_err(CatalogBackendError::new_unexpected)
+}
+
+fn model_row_to_info(row: ModelFullRow) -> Result<ModelInfo, CatalogBackendError> {
+    let warehouse_id = WarehouseId::from(row.warehouse_id);
+    let namespace_ident = parse_namespace_identifier_from_vec(
+        &row.namespace_name,
+        warehouse_id,
+        Some(row.namespace_id),
+    )
+    .map_err(CatalogBackendError::new_unexpected)?;
+
+    let location = parse_model_location(&row.location)?;
+
+    let name = row.name;
+    let model_ident = TableIdent {
+        namespace: namespace_ident.clone(),
+        name: name.clone(),
+    };
+
+    Ok(ModelInfo {
+        model_id: row.model_id.into(),
+        warehouse_id,
+        warehouse_version: WarehouseVersion::new(row.warehouse_version),
+        namespace_id: row.namespace_id.into(),
+        namespace_version: NamespaceVersion::new(row.namespace_version),
+        namespace_ident,
+        name,
+        model_ident,
+        location,
+        comment: row.comment,
+        created_at: row.created_at,
+        updated_at: row.updated_at,
+    })
+}
+
+fn version_row_to_info(row: ModelVersionFullRow) -> Result<ModelVersionInfo, CatalogBackendError> {
+    let warehouse_id = WarehouseId::from(row.warehouse_id);
+    let namespace_ident = parse_namespace_identifier_from_vec(
+        &row.namespace_name,
+        warehouse_id,
+        Some(row.namespace_id),
+    )
+    .map_err(CatalogBackendError::new_unexpected)?;
+
+    let location = parse_model_location(&row.location)?;
+    let model_ident = TableIdent {
+        namespace: namespace_ident.clone(),
+        name: row.model_name.clone(),
+    };
+
+    Ok(ModelVersionInfo {
+        model_version_id: row.model_version_id.into(),
+        model_id: row.model_id.into(),
+        warehouse_id,
+        warehouse_version: WarehouseVersion::new(row.warehouse_version),
+        namespace_id: row.namespace_id.into(),
+        namespace_version: NamespaceVersion::new(row.namespace_version),
+        namespace_ident,
+        model_name: row.model_name,
+        model_ident,
+        version: row.model_version,
+        status: row.status.into(),
+        source: row.source,
+        run_id: row.run_id,
+        comment: row.comment,
+        location,
+        created_at: row.created_at,
+        updated_at: row.updated_at,
+    })
+}
+
+/// Errors with `LocationAlreadyTaken` if any tabular, volume or other model
+/// version in `warehouse_id` occupies `location` (equal / parent / child
+/// fs_location). Semantics copied from
+/// `volume::ensure_volume_location_available`.
+async fn ensure_model_version_location_available(
+    warehouse_id: Uuid,
+    self_model_version_id: Uuid,
+    location: &Location,
+    transaction: &mut sqlx::Transaction<'_, sqlx::Postgres>,
+) -> Result<(), CreateModelVersionError> {
+    let partial_locations = get_partial_fs_locations(location)?;
+    let fs_location = location.authority_and_path();
+    let taken = sqlx::query_scalar!(
+        r#"SELECT EXISTS (
+               SELECT 1
+               FROM (
+                   SELECT fs_location FROM tabular
+                   WHERE warehouse_id = $1
+                   UNION ALL
+                   SELECT fs_location FROM uc_volume
+                   WHERE warehouse_id = $1 AND deleted_at IS NULL
+                   UNION ALL
+                   SELECT fs_location FROM uc_model_version
+                   WHERE warehouse_id = $1 AND model_version_id != $3 AND deleted_at IS NULL
+               ) locs
+               WHERE fs_location = ANY($2) OR
+                     (length($4) < length(fs_location) AND ((TRIM(TRAILING '/' FROM fs_location) || '/') LIKE $4 || '/%'))
+           ) as "exists!""#,
+        warehouse_id,
+        &partial_locations,
+        self_model_version_id,
+        fs_location,
+    )
+    .fetch_one(&mut **transaction)
+    .await
+    .map_err(|e| {
+        e.into_catalog_backend_error()
+            .append_detail("Error checking for conflicting model version locations")
+    })?;
+    if taken {
+        return Err(lakekeeper::service::LocationAlreadyTaken::new(location.clone()).into());
+    }
+    Ok(())
+}
+
+pub(crate) async fn create_model(
+    creation: ModelCreation,
+    transaction: &mut sqlx::Transaction<'_, sqlx::Postgres>,
+) -> Result<ModelInfo, CreateModelError> {
+    let model_id: Uuid = *creation.model_id;
+    let warehouse_id: Uuid = *creation.warehouse_id;
+    let namespace_id: Uuid = *creation.namespace_id;
+
+    // No location-overlap check: model locations are always server-derived
+    // (`<namespace-location>/__uc_models/<uuidv7>`) and never user-supplied,
+    // so collisions are impossible. Version artifact locations below the
+    // model dir DO participate in the overlap check.
+    let row = sqlx::query_as!(
+        ModelFullRow,
+        r#"
+        WITH inserted AS (
+            INSERT INTO uc_model (warehouse_id, model_id, namespace_id, name, location, comment)
+            SELECT $1, $2, $3, $4, $5, $6
+            FROM namespace n
+            WHERE n.namespace_id = $3 AND n.warehouse_id = $1
+            RETURNING model_id, warehouse_id, namespace_id, name, location, comment, created_at, updated_at
+        )
+        SELECT
+            i.model_id,
+            i.warehouse_id,
+            w.version as "warehouse_version!",
+            i.namespace_id,
+            n.version as "namespace_version!",
+            n.namespace_name as "namespace_name!",
+            i.name,
+            i.location,
+            i.comment,
+            i.created_at,
+            i.updated_at
+        FROM inserted i
+        INNER JOIN warehouse w ON w.warehouse_id = $1 AND w.status = 'active'
+        INNER JOIN namespace n ON n.namespace_id = $3 AND n.warehouse_id = $1
+        "#,
+        warehouse_id,
+        model_id,
+        namespace_id,
+        &creation.name,
+        creation.location.as_str(),
+        creation.comment.as_deref(),
+    )
+    .fetch_optional(&mut **transaction)
+    .await
+    .map_err(|e| match &e {
+        sqlx::Error::Database(db_err)
+            if [
+                Some("uc_model_unique_name_per_namespace_idx"),
+                Some("uc_model_pkey"),
+            ]
+            .contains(&db_err.constraint()) =>
+        {
+            CreateModelError::from(ModelAlreadyExists::new())
+        }
+        _ => e.into_catalog_backend_error().into(),
+    })?
+    .ok_or_else(|| {
+        CreateModelError::from(CatalogBackendError::new_unexpected(
+            lakekeeper::service::InternalErrorMessage(format!(
+                "Namespace {namespace_id} not found in warehouse {warehouse_id} or warehouse not active while creating model"
+            )),
+        ))
+    })?;
+
+    model_row_to_info(row).map_err(CreateModelError::from)
+}
+
+pub(crate) async fn load_model(
+    warehouse_id: WarehouseId,
+    namespace_id: NamespaceId,
+    model_name: &str,
+    transaction: &mut sqlx::Transaction<'_, sqlx::Postgres>,
+) -> Result<ModelInfo, LoadModelError> {
+    let row = sqlx::query_as!(
+        ModelFullRow,
+        r#"
+        SELECT
+            m.model_id,
+            m.warehouse_id,
+            w.version as "warehouse_version!",
+            m.namespace_id,
+            n.version as "namespace_version!",
+            n.namespace_name as "namespace_name!",
+            m.name,
+            m.location,
+            m.comment,
+            m.created_at,
+            m.updated_at
+        FROM uc_model m
+        INNER JOIN warehouse w ON w.warehouse_id = m.warehouse_id AND w.status = 'active'
+        INNER JOIN namespace n ON n.namespace_id = m.namespace_id AND n.warehouse_id = m.warehouse_id
+        WHERE m.warehouse_id = $1
+          AND m.namespace_id = $2
+          AND m.name = $3
+          AND m.deleted_at IS NULL
+        "#,
+        *warehouse_id,
+        *namespace_id,
+        model_name,
+    )
+    .fetch_optional(&mut **transaction)
+    .await
+    .map_err(|e| LoadModelError::from(e.into_catalog_backend_error()))?
+    .ok_or_else(|| LoadModelError::from(ModelNotFound::new()))?;
+
+    model_row_to_info(row).map_err(LoadModelError::from)
+}
+
+/// Load a model by its stable id (TOCTOU-safe follow-up reads after an
+/// authorization check).
+pub(crate) async fn load_model_by_id(
+    warehouse_id: WarehouseId,
+    model_id: ModelId,
+    transaction: &mut sqlx::Transaction<'_, sqlx::Postgres>,
+) -> Result<ModelInfo, LoadModelError> {
+    let row = sqlx::query_as!(
+        ModelFullRow,
+        r#"
+        SELECT
+            m.model_id,
+            m.warehouse_id,
+            w.version as "warehouse_version!",
+            m.namespace_id,
+            n.version as "namespace_version!",
+            n.namespace_name as "namespace_name!",
+            m.name,
+            m.location,
+            m.comment,
+            m.created_at,
+            m.updated_at
+        FROM uc_model m
+        INNER JOIN warehouse w ON w.warehouse_id = m.warehouse_id AND w.status = 'active'
+        INNER JOIN namespace n ON n.namespace_id = m.namespace_id AND n.warehouse_id = m.warehouse_id
+        WHERE m.warehouse_id = $1
+          AND m.model_id = $2
+          AND m.deleted_at IS NULL
+        "#,
+        *warehouse_id,
+        *model_id,
+    )
+    .fetch_optional(&mut **transaction)
+    .await
+    .map_err(|e| LoadModelError::from(e.into_catalog_backend_error()))?
