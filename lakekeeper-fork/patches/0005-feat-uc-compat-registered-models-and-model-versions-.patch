+/// Hierarchy tuples for a registered model: `namespace ↔ model`.
+pub(crate) fn hierarchy_tuples_for_model(
+    warehouse: WarehouseId,
+    model: ModelId,
+    parent_namespace: NamespaceId,
+) -> Vec<TupleKey> {
+    let parent_id = parent_namespace.to_openfga();
+    let this_id = (warehouse, model).to_openfga();
+    vec![
+        tuple(
+            parent_id.clone(),
+            ModelRelation::Parent.to_string(),
+            this_id.clone(),
+        ),
+        tuple(this_id, NamespaceRelation::Child.to_string(), parent_id),
+    ]
+}
+
+/// Ownership tuple for a registered model.
+pub(crate) fn ownership_tuples_for_model(
+    actor: &Actor,
+    warehouse: WarehouseId,
+    model: ModelId,
+) -> Vec<TupleKey> {
+    vec![tuple(
+        actor.to_openfga(),
+        ModelRelation::Ownership.to_string(),
+        (warehouse, model).to_openfga(),
+    )]
+}
