+
+    #[test]
+    fn test_model_version_status_serde_is_uc_wire_format() {
+        assert_eq!(
+            serde_json::to_string(&ModelVersionStatus::PendingRegistration).unwrap(),
+            "\"PENDING_REGISTRATION\""
+        );
+        assert_eq!(
+            serde_json::to_string(&ModelVersionStatus::FailedRegistration).unwrap(),
+            "\"FAILED_REGISTRATION\""
+        );
+        assert_eq!(
+            serde_json::to_string(&ModelVersionStatus::Ready).unwrap(),
+            "\"READY\""
+        );
+        assert_eq!(
+            serde_json::from_str::<ModelVersionStatus>("\"READY\"").unwrap(),
+            ModelVersionStatus::Ready
+        );
+        assert!(serde_json::from_str::<ModelVersionStatus>("\"ready\"").is_err());
+    }
+}
