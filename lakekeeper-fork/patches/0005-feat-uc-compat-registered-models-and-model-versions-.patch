+/// List versions of a model, ordered by ascending version number. The page
+/// token is the last returned version number (versions are unique and
+/// monotonic per model, which makes them a self-sufficient keyset — unlike
+/// `created_at`, which is not guaranteed monotonic across concurrent
+/// transactions).
+pub(crate) async fn list_model_versions(
+    warehouse_id: WarehouseId,
+    model_id: ModelId,
+    page_size: Option<i64>,
+    page_token: Option<&str>,
+    transaction: &mut sqlx::Transaction<'_, sqlx::Postgres>,
+) -> Result<(Vec<ModelVersionInfo>, Option<String>), ListModelVersionsError> {
+    let page_size = CONFIG.page_size_or_pagination_default(page_size);
+
+    let token_version: Option<i64> = page_token
+        .map(str::parse)
+        .transpose()
+        .map_err(|e| ListModelVersionsError::from(CatalogBackendError::new_unexpected(e)))?;
+
+    let rows = sqlx::query_as!(
+        ModelVersionFullRow,
+        r#"
+        SELECT
+            v.model_version_id,
+            v.model_id,
+            v.warehouse_id,
+            w.version as "warehouse_version!",
+            m.namespace_id,
+            n.version as "namespace_version!",
+            n.namespace_name as "namespace_name!",
+            m.name as model_name,
+            v.model_version,
+            v.status as "status: DbModelVersionStatus",
+            v.source,
+            v.run_id,
+            v.comment,
+            v.location,
+            v.created_at,
+            v.updated_at
+        FROM uc_model_version v
+        INNER JOIN uc_model m ON m.warehouse_id = v.warehouse_id AND m.model_id = v.model_id
+        INNER JOIN warehouse w ON w.warehouse_id = v.warehouse_id AND w.status = 'active'
+        INNER JOIN namespace n ON n.namespace_id = m.namespace_id AND n.warehouse_id = v.warehouse_id
+        WHERE v.warehouse_id = $1
+          AND v.deleted_at IS NULL
+          AND v.model_id = $2
+          AND ($3::bigint IS NULL OR v.model_version > $3)
+        ORDER BY v.model_version ASC
+        LIMIT $4
+        "#,
+        *warehouse_id,
+        *model_id,
+        token_version,
+        page_size,
+    )
+    .fetch_all(&mut **transaction)
+    .await
+    .map_err(|e| ListModelVersionsError::from(e.into_catalog_backend_error()))?;
+
+    let mut entries = Vec::with_capacity(rows.len());
+    let mut next_page_token = None;
+
+    for row in rows {
+        next_page_token = Some(row.model_version.to_string());
+        entries.push(version_row_to_info(row).map_err(ListModelVersionsError::from)?);
+    }
+
+    Ok((entries, next_page_token))
+}
+
+/// Transition a version out of `pending_registration` (finalize → `ready`,
+/// or mark `failed_registration`). Errors with
+/// `InvalidModelVersionStatusTransition` if the version exists but is not
+/// pending.
+pub(crate) async fn update_model_version_status(
+    warehouse_id: WarehouseId,
+    model_version_id: ModelVersionId,
+    new_status: ModelVersionStatus,
+    transaction: &mut sqlx::Transaction<'_, sqlx::Postgres>,
+) -> Result<(), UpdateModelVersionError> {
+    let updated = sqlx::query!(
+        r#"
+        UPDATE uc_model_version
+        SET status = $3
+        WHERE warehouse_id = $1
+          AND model_version_id = $2
+          AND deleted_at IS NULL
+          AND status = 'pending_registration'
+        RETURNING model_version_id
+        "#,
+        *warehouse_id,
+        *model_version_id,
+        DbModelVersionStatus::from(new_status) as DbModelVersionStatus,
+    )
+    .fetch_optional(&mut **transaction)
+    .await
+    .map_err(|e| UpdateModelVersionError::from(e.into_catalog_backend_error()))?;
+
+    if updated.is_some() {
+        return Ok(());
+    }
+
+    // Distinguish missing version from invalid transition.
+    let exists = sqlx::query_scalar!(
+        r#"SELECT EXISTS (
+               SELECT 1 FROM uc_model_version
+               WHERE warehouse_id = $1 AND model_version_id = $2 AND deleted_at IS NULL
+           ) as "exists!""#,
+        *warehouse_id,
+        *model_version_id,
+    )
+    .fetch_one(&mut **transaction)
+    .await
+    .map_err(|e| UpdateModelVersionError::from(e.into_catalog_backend_error()))?;
+
+    if exists {
+        Err(UpdateModelVersionError::from(
+            InvalidModelVersionStatusTransition::new(),
+        ))
+    } else {
+        Err(UpdateModelVersionError::from(ModelVersionNotFound::new()))
+    }
+}
