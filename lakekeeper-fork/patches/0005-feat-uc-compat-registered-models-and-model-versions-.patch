+/// Hard delete (UC DELETE semantics in v1).
+pub(crate) async fn drop_model_version(
+    warehouse_id: WarehouseId,
+    model_id: ModelId,
+    version: i64,
+    transaction: &mut sqlx::Transaction<'_, sqlx::Postgres>,
+) -> Result<ModelVersionId, DropModelVersionError> {
+    let row = sqlx::query!(
+        r#"
+        DELETE FROM uc_model_version v
+        USING warehouse w
+        WHERE w.warehouse_id = v.warehouse_id
+          AND w.status = 'active'
+          AND v.warehouse_id = $1
+          AND v.model_id = $2
+          AND v.model_version = $3
+          AND v.deleted_at IS NULL
+        RETURNING v.model_version_id
+        "#,
+        *warehouse_id,
+        *model_id,
+        version,
+    )
+    .fetch_optional(&mut **transaction)
+    .await
+    .map_err(|e| DropModelVersionError::from(e.into_catalog_backend_error()))?
+    .ok_or_else(|| DropModelVersionError::from(ModelVersionNotFound::new()))?;
+
+    Ok(row.model_version_id.into())
+}
