new file mode 100644
index 00000000..a4b425ac
--- /dev/null
+++ b/crates/lakekeeper/src/api/uc/v1/models.rs
@@ -0,0 +1,398 @@
+//! UC Registered Models + Model Versions endpoints. A registered model is a
+//! Lakekeeper-managed entity (`uc_model`) inside a top-level namespace
+//! ("schema") of a warehouse ("catalog"); model versions (`uc_model_version`)
+//! carry the artifact locations and the
+//! PENDING_REGISTRATION → READY lifecycle.
+//!
+//! Path quirks (per contract): `POST /models/versions` is a FLAT path (the
+//! model is identified by body fields), while list/get/update/delete/finalize
+//! are nested under `/models/{full_name}/versions`. `finalize` repeats
+//! `full_name` + `version` in the request body.
+
+use axum::{
+    Extension, Json,
+    extract::{Path, Query, State},
+};
+use serde::{Deserialize, Serialize};
+
+use super::UcCatalogService;
+use crate::{
+    api::{
+        ApiContext,
+        uc::{UcEmptyResponse, UcResult},
+    },
+    request_metadata::RequestMetadata,
+    service,
+};
+
+/// UC `ModelVersionStatus` wire enum. `MODEL_VERSION_STATUS_UNKNOWN` is the
+/// proto zero value; the server never stores or returns it.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "SCREAMING_SNAKE_CASE")]
+pub enum ModelVersionStatus {
+    ModelVersionStatusUnknown,
+    PendingRegistration,
+    FailedRegistration,
+    Ready,
+}
+
+impl From<service::ModelVersionStatus> for ModelVersionStatus {
+    fn from(v: service::ModelVersionStatus) -> Self {
+        match v {
+            service::ModelVersionStatus::PendingRegistration => Self::PendingRegistration,
+            service::ModelVersionStatus::FailedRegistration => Self::FailedRegistration,
+            service::ModelVersionStatus::Ready => Self::Ready,
+        }
+    }
+}
+
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct CreateRegisteredModelRequest {
+    pub name: String,
+    pub catalog_name: String,
+    pub schema_name: String,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub comment: Option<String>,
+}
+
+/// UC `UpdateRegisteredModelRequestContent`: only `comment` and `new_name`
+/// are updatable. The compatibility API supports comment updates only;
+/// `new_name` is rejected with `INVALID_ARGUMENT`.
+#[derive(Debug, Clone, Default, PartialEq, Serialize, Deserialize)]
+pub struct UpdateRegisteredModelRequest {
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub comment: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub new_name: Option<String>,
+}
+
+/// UC `RegisteredModelInfo`. Note the stable id field is called `id` on the
+/// wire (unlike volumes' `volume_id`).
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct RegisteredModelInfo {
+    pub name: String,
+    pub catalog_name: String,
+    pub schema_name: String,
+    /// `<catalog_name>.<schema_name>.<name>`.
+    pub full_name: String,
+    /// Managed storage location; version artifacts live below it.
+    pub storage_location: String,
+    /// Stable model id (UUID string).
+    pub id: String,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub comment: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub owner: Option<String>,
+    /// Epoch milliseconds.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub created_at: Option<i64>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub created_by: Option<String>,
+    /// Epoch milliseconds.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub updated_at: Option<i64>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub updated_by: Option<String>,
+}
+
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct ListRegisteredModelsResponse {
+    #[serde(default)]
+    pub registered_models: Vec<RegisteredModelInfo>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub next_page_token: Option<String>,
+}
+
+/// UC `listRegisteredModels` allows omitting `catalog_name`/`schema_name`
+/// (list-all), unlike volumes/functions where the parent params are required.
+/// `schema_name` without `catalog_name` is rejected.
+#[derive(Debug, Clone, Default, PartialEq, Serialize, Deserialize)]
+pub struct ListRegisteredModelsQuery {
+    #[serde(default)]
+    pub catalog_name: Option<String>,
+    #[serde(default)]
+    pub schema_name: Option<String>,
+    #[serde(default)]
+    pub max_results: Option<i64>,
+    #[serde(default)]
+    pub page_token: Option<String>,
+}
+
+#[derive(Debug, Clone, Default, PartialEq, Serialize, Deserialize)]
+pub struct DeleteRegisteredModelQuery {
