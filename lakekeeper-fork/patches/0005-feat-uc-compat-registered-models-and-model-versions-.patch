+// =================== Model Relations (Unity Catalog compat) ===================
+
+#[derive(
+    Debug, Clone, Copy, Hash, Eq, PartialEq, strum_macros::Display, IntoStaticStr, EnumIter,
+)]
+#[strum(serialize_all = "snake_case")]
+pub enum ModelRelation {
+    // -- Hierarchical relations --
+    Parent,
+    // -- Direct relations --
+    Ownership,
+    PassGrants,
+    ManageGrants,
+    Describe,
+    Select,
+    Modify,
+    // -- Actions --
+    CanDrop,
+    CanWriteData,
+    CanReadData,
+    CanGetMetadata,
+    CanIncludeInList,
+    CanCreateVersion,
+    // -- Read assignments / grant actions --
+    CanReadAssignments,
+    CanGrantPassGrants,
+    CanGrantManageGrants,
+    CanGrantDescribe,
+    CanGrantSelect,
+    CanGrantModify,
+    CanChangeOwnership,
+}
+
+impl ModelAction for ModelRelation {
+    fn is_data_plane(&self) -> bool {
+        matches!(self, Self::CanReadData | Self::CanWriteData)
+    }
+}
+impl CatalogAction for ModelRelation {
+    fn action_descriptor(&self) -> ActionDescriptor {
+        ActionDescriptor::builder().action_name(self.into()).build()
+    }
+}
+impl OpenFgaRelation for ModelRelation {}
+
+impl From<CatalogModelAction> for ModelRelation {
+    fn from(action: CatalogModelAction) -> Self {
+        action.to_openfga()
+    }
+}
+
+impl From<&CatalogModelAction> for ModelRelation {
+    fn from(action: &CatalogModelAction) -> Self {
+        action.to_openfga()
+    }
+}
+
+impl ReducedRelation for CatalogModelAction {
+    type OpenFgaRelation = ModelRelation;
+
+    fn to_openfga(&self) -> Self::OpenFgaRelation {
+        match self {
+            CatalogModelAction::Drop => ModelRelation::CanDrop,
+            CatalogModelAction::WriteData => ModelRelation::CanWriteData,
+            CatalogModelAction::ReadData => ModelRelation::CanReadData,
+            CatalogModelAction::GetMetadata => ModelRelation::CanGetMetadata,
+            CatalogModelAction::IncludeInList => ModelRelation::CanIncludeInList,
+            CatalogModelAction::CreateVersion => ModelRelation::CanCreateVersion,
+        }
+    }
+}
+
+#[derive(Debug, Clone, Deserialize, Copy, Eq, PartialEq, EnumIter)]
+#[cfg_attr(feature = "open-api", derive(utoipa::ToSchema))]
+#[serde(rename_all = "snake_case")]
+#[cfg_attr(feature = "open-api", schema(as=ModelRelation))]
+pub(super) enum APIModelRelation {
+    Ownership,
+    PassGrants,
+    ManageGrants,
+    Describe,
+    Select,
+    Modify,
+}
+
+#[derive(Debug, Clone, Deserialize, Serialize, PartialEq)]
+#[cfg_attr(feature = "open-api", derive(utoipa::ToSchema))]
+#[serde(tag = "type", rename_all = "snake_case")]
+pub(super) enum ModelAssignment {
+    #[cfg_attr(feature = "open-api", schema(title = "ModelAssignmentOwnership"))]
+    Ownership(UserOrRole),
+    #[cfg_attr(feature = "open-api", schema(title = "ModelAssignmentPassGrants"))]
+    PassGrants(UserOrRole),
+    #[cfg_attr(feature = "open-api", schema(title = "ModelAssignmentManageGrants"))]
+    ManageGrants(UserOrRole),
+    #[cfg_attr(feature = "open-api", schema(title = "ModelAssignmentDescribe"))]
+    Describe(UserOrRole),
+    #[cfg_attr(feature = "open-api", schema(title = "ModelAssignmentSelect"))]
+    Select(UserOrRole),
+    #[cfg_attr(feature = "open-api", schema(title = "ModelAssignmentModify"))]
+    Modify(UserOrRole),
+}
+
+impl GrantableRelation for APIModelRelation {
+    fn grant_relation(&self) -> ModelRelation {
+        match self {
+            APIModelRelation::Ownership => ModelRelation::CanChangeOwnership,
+            APIModelRelation::PassGrants => ModelRelation::CanGrantPassGrants,
+            APIModelRelation::ManageGrants => ModelRelation::CanGrantManageGrants,
+            APIModelRelation::Describe => ModelRelation::CanGrantDescribe,
+            APIModelRelation::Select => ModelRelation::CanGrantSelect,
+            APIModelRelation::Modify => ModelRelation::CanGrantModify,
+        }
+    }
+}
+
+impl Assignment for ModelAssignment {
+    type Relation = APIModelRelation;
+
+    fn try_from_user(
+        user: &str,
+        relation: &Self::Relation,
+    ) -> Result<Self, ParseOpenFgaEntityError> {
+        match relation {
+            APIModelRelation::Ownership => {
+                UserOrRole::parse_from_openfga(user).map(ModelAssignment::Ownership)
+            }
+            APIModelRelation::PassGrants => {
+                UserOrRole::parse_from_openfga(user).map(ModelAssignment::PassGrants)
+            }
+            APIModelRelation::ManageGrants => {
+                UserOrRole::parse_from_openfga(user).map(ModelAssignment::ManageGrants)
+            }
+            APIModelRelation::Describe => {
+                UserOrRole::parse_from_openfga(user).map(ModelAssignment::Describe)
+            }
+            APIModelRelation::Select => {
+                UserOrRole::parse_from_openfga(user).map(ModelAssignment::Select)
+            }
+            APIModelRelation::Modify => {
+                UserOrRole::parse_from_openfga(user).map(ModelAssignment::Modify)
+            }
+        }
+    }
+
+    fn openfga_user(&self) -> String {
+        match self {
+            ModelAssignment::Ownership(user)
+            | ModelAssignment::PassGrants(user)
+            | ModelAssignment::ManageGrants(user)
+            | ModelAssignment::Describe(user)
+            | ModelAssignment::Select(user)
+            | ModelAssignment::Modify(user) => user.to_openfga(),
+        }
+    }
+
+    fn relation(&self) -> Self::Relation {
+        match self {
+            ModelAssignment::Ownership(_) => APIModelRelation::Ownership,
+            ModelAssignment::PassGrants(_) => APIModelRelation::PassGrants,
+            ModelAssignment::ManageGrants(_) => APIModelRelation::ManageGrants,
+            ModelAssignment::Describe(_) => APIModelRelation::Describe,
+            ModelAssignment::Select(_) => APIModelRelation::Select,
+            ModelAssignment::Modify(_) => APIModelRelation::Modify,
+        }
+    }
+}
+
+#[derive(Copy, Debug, Clone, Eq, PartialEq, Serialize, Deserialize, EnumIter)]
+#[cfg_attr(feature = "open-api", derive(utoipa::ToSchema))]
+#[serde(rename_all = "snake_case")]
+pub(super) enum OpenFGAModelAction {
+    ReadAssignments,
+    GrantPassGrants,
+    GrantManageGrants,
+    GrantDescribe,
+    GrantSelect,
+    GrantModify,
+    ChangeOwnership,
+}
+
+impl ReducedRelation for APIModelRelation {
+    type OpenFgaRelation = ModelRelation;
+
+    fn to_openfga(&self) -> Self::OpenFgaRelation {
+        match self {
+            APIModelRelation::Ownership => ModelRelation::Ownership,
+            APIModelRelation::PassGrants => ModelRelation::PassGrants,
+            APIModelRelation::ManageGrants => ModelRelation::ManageGrants,
+            APIModelRelation::Describe => ModelRelation::Describe,
+            APIModelRelation::Select => ModelRelation::Select,
+            APIModelRelation::Modify => ModelRelation::Modify,
+        }
+    }
+}
+
+impl ReducedRelation for OpenFGAModelAction {
+    type OpenFgaRelation = ModelRelation;
+
+    fn to_openfga(&self) -> Self::OpenFgaRelation {
+        match self {
+            OpenFGAModelAction::ReadAssignments => ModelRelation::CanReadAssignments,
+            OpenFGAModelAction::GrantPassGrants => ModelRelation::CanGrantPassGrants,
+            OpenFGAModelAction::GrantManageGrants => ModelRelation::CanGrantManageGrants,
+            OpenFGAModelAction::GrantDescribe => ModelRelation::CanGrantDescribe,
+            OpenFGAModelAction::GrantSelect => ModelRelation::CanGrantSelect,
+            OpenFGAModelAction::GrantModify => ModelRelation::CanGrantModify,
+            OpenFGAModelAction::ChangeOwnership => ModelRelation::CanChangeOwnership,
+        }
+    }
+}
