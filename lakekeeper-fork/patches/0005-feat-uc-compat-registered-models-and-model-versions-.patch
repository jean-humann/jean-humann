+/// Load `version` of the model after authorizing `action` on the parent
+/// model. Missing versions surface as plain `NOT_FOUND` (the caller already
+/// proved it may see the model).
+async fn load_and_authorize_model_version<
+    C: CatalogStore,
+    A: Authorizer + Clone,
+    S: SecretStore,
+>(
+    full_name: &str,
+    version: i64,
+    action: CatalogModelAction,
+    state: &ApiContext<State<A, C, S>>,
+    request_metadata: &RequestMetadata,
+) -> UcResult<(Arc<ResolvedWarehouse>, ModelInfo, ModelVersionInfo)> {
+    let (catalog_name, schema_name, model_name) = split_model_full_name(full_name)?;
+    let warehouse = resolve_catalog_warehouse::<C>(
+        request_metadata,
+        catalog_name,
+        state.v1_state.catalog.clone(),
+    )
+    .await?;
+
+    let (_ns, model) = load_and_authorize_model::<C, A>(
+        &state.v1_state.authz,
+        request_metadata,
+        &warehouse,
+        schema_name,
+        model_name,
+        action,
+        state.v1_state.catalog.clone(),
+    )
+    .await?;
+
+    let mut t = C::Transaction::begin_read(state.v1_state.catalog.clone())
+        .await
+        .map_err(uc_err)?;
+    let info = match C::load_model_version(
+        warehouse.warehouse_id,
+        model.model_id,
+        version,
+        t.transaction(),
+    )
+    .await
+    {
+        Ok(info) => info,
+        Err(LoadModelVersionError::ModelVersionNotFound(_)) => {
+            return Err(model_version_not_found(full_name, version));
+        }
+        Err(e) => return Err(uc_err(e)),
+    };
+    t.commit().await.map_err(uc_err)?;
+
+    Ok((warehouse, model, info))
+}
+
+pub(crate) async fn get_model_version<C: CatalogStore, A: Authorizer + Clone, S: SecretStore>(
+    full_name: String,
+    version: i64,
+    state: ApiContext<State<A, C, S>>,
+    request_metadata: RequestMetadata,
+) -> UcResult<uc_v1::ModelVersionInfo> {
+    let (catalog_name, schema_name, _model_name) = split_model_full_name(&full_name)?;
+    let (catalog_name, schema_name) = (catalog_name.to_string(), schema_name.to_string());
+    let (_warehouse, _model, info) = load_and_authorize_model_version::<C, A, S>(
+        &full_name,
+        version,
+        CatalogModelAction::GetMetadata,
+        &state,
+        &request_metadata,
+    )
+    .await?;
+
+    Ok(model_version_response(&catalog_name, &schema_name, &info))
+}
+
+pub(crate) async fn update_model_version<C: CatalogStore, A: Authorizer + Clone, S: SecretStore>(
+    full_name: String,
+    version: i64,
+    request: UpdateModelVersionRequest,
+    state: ApiContext<State<A, C, S>>,
+    request_metadata: RequestMetadata,
+) -> UcResult<uc_v1::ModelVersionInfo> {
+    let (catalog_name, schema_name, _model_name) = split_model_full_name(&full_name)?;
+    let (catalog_name, schema_name) = (catalog_name.to_string(), schema_name.to_string());
+
+    let Some(comment) = request.comment else {
+        // Nothing to change; behave like a get (incl. authorization).
+        return get_model_version::<C, A, S>(full_name, version, state, request_metadata).await;
+    };
+
+    // Version mutations authorize CreateVersion on the parent model.
+    let (warehouse, _model, info) = load_and_authorize_model_version::<C, A, S>(
+        &full_name,
+        version,
+        CatalogModelAction::CreateVersion,
+        &state,
+        &request_metadata,
+    )
+    .await?;
+
+    let mut t = C::Transaction::begin_write(state.v1_state.catalog.clone())
+        .await
+        .map_err(uc_err)?;
+    // By-id (TOCTOU): hit the row the authz check applied to.
+    C::update_model_version_comment(
+        warehouse.warehouse_id,
+        info.model_version_id,
+        Some(&comment),
+        t.transaction(),
+    )
+    .await
+    .map_err(uc_err)?;
+    let info = C::load_model_version_by_id(
+        warehouse.warehouse_id,
+        info.model_version_id,
+        t.transaction(),
+    )
+    .await
+    .map_err(uc_err)?;
+    t.commit().await.map_err(uc_err)?;
+
+    Ok(model_version_response(&catalog_name, &schema_name, &info))
+}
+
+pub(crate) async fn finalize_model_version<
+    C: CatalogStore,
+    A: Authorizer + Clone,
+    S: SecretStore,
+>(
+    full_name: String,
+    version: i64,
+    request: FinalizeModelVersionRequest,
+    state: ApiContext<State<A, C, S>>,
+    request_metadata: RequestMetadata,
+) -> UcResult<uc_v1::ModelVersionInfo> {
+    // The body repeats the path info (UC contract); reject mismatches.
+    if request.full_name != full_name || request.version != version {
+        return Err(UcErrorResponse::invalid_argument(format!(
+            "finalize body must repeat the path: expected full_name '{full_name}' version \
+             {version}, got full_name '{}' version {}.",
+            request.full_name, request.version
+        )));
+    }
+    let (catalog_name, schema_name, _model_name) = split_model_full_name(&full_name)?;
+    let (catalog_name, schema_name) = (catalog_name.to_string(), schema_name.to_string());
+
+    // Finalize authorizes CreateVersion on the parent model (it completes
+    // the version-creation flow).
+    let (warehouse, _model, info) = load_and_authorize_model_version::<C, A, S>(
+        &full_name,
+        version,
+        CatalogModelAction::CreateVersion,
+        &state,
+        &request_metadata,
+    )
+    .await?;
+
+    let mut t = C::Transaction::begin_write(state.v1_state.catalog.clone())
+        .await
+        .map_err(uc_err)?;
+    // Only PENDING_REGISTRATION → READY is valid; anything else (incl. a
+    // second finalize) errors 400.
+    C::update_model_version_status(
+        warehouse.warehouse_id,
+        info.model_version_id,
+        ModelVersionStatus::Ready,
+        t.transaction(),
+    )
+    .await
+    .map_err(uc_err)?;
+    let info = C::load_model_version_by_id(
+        warehouse.warehouse_id,
+        info.model_version_id,
+        t.transaction(),
+    )
+    .await
+    .map_err(uc_err)?;
+    t.commit().await.map_err(uc_err)?;
+
+    Ok(model_version_response(&catalog_name, &schema_name, &info))
+}
+
+pub(crate) async fn delete_model_version<C: CatalogStore, A: Authorizer + Clone, S: SecretStore>(
+    full_name: String,
+    version: i64,
+    state: ApiContext<State<A, C, S>>,
+    request_metadata: RequestMetadata,
+) -> UcResult<()> {
+    // Version deletion is destructive: it requires Drop on the parent model
+    // (not just CreateVersion).
+    let (warehouse, model, info) = load_and_authorize_model_version::<C, A, S>(
+        &full_name,
+        version,
+        CatalogModelAction::Drop,
+        &state,
+        &request_metadata,
+    )
+    .await?;
+
+    let mut t = C::Transaction::begin_write(state.v1_state.catalog)
+        .await
+        .map_err(uc_err)?;
+    let dropped_id = C::drop_model_version(
+        warehouse.warehouse_id,
+        model.model_id,
+        version,
+        t.transaction(),
+    )
+    .await
+    .map_err(uc_err)?;
+    t.commit().await.map_err(uc_err)?;
+    debug_assert_eq!(dropped_id, info.model_version_id);
+
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn test_split_model_full_name() {
+        assert_eq!(
+            split_model_full_name("cat.schema.model").unwrap(),
+            ("cat", "schema", "model")
+        );
+        for bad in [
+            "",
+            "cat",
+            "cat.schema",
+            "cat.schema.model.extra",
+            "..",
+            "a..b",
+        ] {
+            let err = split_model_full_name(bad).unwrap_err();
+            assert_eq!(err.status, 400, "{bad}");
+            assert_eq!(err.error_code, "INVALID_ARGUMENT", "{bad}");
+        }
+    }
+}
