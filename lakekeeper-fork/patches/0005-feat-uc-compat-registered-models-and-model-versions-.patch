+-- Unity Catalog compatibility: registered models + model versions.
+--
+-- Models are a dedicated entity (no `tabular` piggyback). A registered model
+-- carries metadata plus a server-derived managed `location`
+-- (`<namespace-location>/__uc_models/<model_id>`); model versions carry the
+-- artifact `location`/`fs_location`
+-- (`<model-location>/versions/<model_version_id>`) plus the UC lifecycle
+-- status. UC DELETE is a hard delete in v1; `deleted_at` is reserved for
+-- future soft-delete support.
+--
+-- NOTE on column naming: the row-version trigger
+-- (`set_updated_at_and_increment_version`) increments a column literally
+-- named `version`, so the UC model-version *number* lives in
+-- `model_version` instead (the design doc calls it `version`; renamed to
+-- avoid clashing with the trigger convention used by every other entity).
+
+CREATE TYPE uc_model_version_status AS ENUM (
+    'pending_registration',
+    'failed_registration',
+    'ready'
+);
+
+CREATE TABLE uc_model (
+    warehouse_id UUID NOT NULL,
+    model_id     UUID NOT NULL,
+    namespace_id UUID NOT NULL,
+    name         TEXT COLLATE "case_insensitive" NOT NULL,
+    -- Managed storage location (incl. scheme). Model locations are always
+    -- server-derived; they are NOT part of the location-overlap check (the
+    -- per-version locations below them are).
+    location     TEXT NOT NULL,
+    comment      TEXT,
+    created_at   TIMESTAMPTZ NOT NULL DEFAULT now(),
+    updated_at   TIMESTAMPTZ,
+    deleted_at   TIMESTAMPTZ,
+    version      BIGINT NOT NULL DEFAULT 0,
+    PRIMARY KEY (warehouse_id, model_id),
+    -- `unique_namespace_id_per_warehouse` on namespace backs this FK.
+    FOREIGN KEY (warehouse_id, namespace_id)
+        REFERENCES namespace (warehouse_id, namespace_id) ON DELETE CASCADE
+);
+
+SELECT trigger_updated_at_and_version_if_distinct('"uc_model"');
+
+-- Case-insensitive name uniqueness per namespace (name column uses the
+-- `case_insensitive` collation, mirroring uc_volume), scoped to live rows.
+CREATE UNIQUE INDEX uc_model_unique_name_per_namespace_idx
+    ON uc_model (warehouse_id, namespace_id, name)
+    WHERE deleted_at IS NULL;
+
+-- Keyset pagination (created_at, model_id). Not namespace-prefixed:
+-- listRegisteredModels supports namespace-scoped, warehouse-scoped AND
+-- list-all queries (contract: catalog/schema are optional).
+CREATE INDEX uc_model_created_at_model_id_idx
+    ON uc_model (created_at, model_id)
+    WHERE deleted_at IS NULL;
+
+CREATE TABLE uc_model_version (
+    warehouse_id     UUID NOT NULL,
+    model_version_id UUID NOT NULL,
+    model_id         UUID NOT NULL,
+    -- UC model version number, assigned as MAX+1 per model inside the insert
+    -- transaction (the parent uc_model row is locked FOR UPDATE to serialize
+    -- concurrent assignment).
+    model_version    BIGINT NOT NULL,
+    status           uc_model_version_status NOT NULL DEFAULT 'pending_registration',
+    comment          TEXT,
+    source           TEXT,
+    run_id           TEXT,
+    -- Full artifact location incl. scheme (e.g. s3://bucket/path) ...
+    location         TEXT NOT NULL,
+    -- ... and its authority+path part, for overlap checks against
+    -- `tabular` / `uc_volume` / other model versions.
+    fs_location      TEXT NOT NULL,
+    created_at       TIMESTAMPTZ NOT NULL DEFAULT now(),
+    updated_at       TIMESTAMPTZ,
+    deleted_at       TIMESTAMPTZ,
+    version          BIGINT NOT NULL DEFAULT 0,
+    PRIMARY KEY (warehouse_id, model_version_id),
+    UNIQUE (warehouse_id, model_id, model_version),
+    FOREIGN KEY (warehouse_id, model_id)
+        REFERENCES uc_model (warehouse_id, model_id) ON DELETE CASCADE
+);
+
+SELECT trigger_updated_at_and_version_if_distinct('"uc_model_version"');
+
+-- Supports the location-overlap check (equal/parent/child fs_location
+-- conflicts), mirroring `uc_volume_warehouse_id_location_idx`.
+CREATE INDEX uc_model_version_warehouse_id_location_idx
+    ON uc_model_version USING btree (warehouse_id, fs_location);
