@@ -0,0 +1,624 @@
+//! Unity Catalog registered models + model versions: dedicated catalog-store
+//! entities (design D1 — no tabular piggyback). Models live in the `uc_model`
+//! table, versions in `uc_model_version`; both are hard-deleted in v1
+//! (`deleted_at` reserved) and never protected.
+//!
+//! Version lifecycle (design D3): the server assigns the integer `version`
+//! (`MAX+1` per model, serialized inside the insert transaction) and starts
+//! versions in `PENDING_REGISTRATION`; `finalize` moves them to `READY`.
+//! `READ_WRITE` credentials are only vended while a version is pending.
+
+use std::fmt;
+
+use http::StatusCode;
+use iceberg::{NamespaceIdent, TableIdent};
+use iceberg_ext::catalog::rest::ErrorModel;
+use lakekeeper_io::Location;
+use serde::{Deserialize, Serialize};
+
+use super::{
+    BasicTabularInfo, CatalogStore, Transaction, define_simple_error, define_transparent_error,
+    impl_error_stack_methods, impl_from_with_detail,
+};
+use crate::{
+    ProjectId, WarehouseId,
+    service::{
+        CatalogBackendError, GenericTableId, InternalParseLocationError,
+        InvalidNamespaceIdentifier, LocationAlreadyTaken, ModelId, ModelVersionId, NamespaceId,
+        NamespaceVersion, TabularId, WarehouseVersion,
+    },
+};
+
+/// UC `ModelVersionStatus` lifecycle states persisted by the server.
+/// (`MODEL_VERSION_STATUS_UNKNOWN` is a wire-only zero value and is never
+/// stored.)
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, Serialize, Deserialize)]
+#[serde(rename_all = "SCREAMING_SNAKE_CASE")]
+pub enum ModelVersionStatus {
+    PendingRegistration,
+    FailedRegistration,
+    Ready,
+}
+
+impl ModelVersionStatus {
+    #[must_use]
+    pub fn as_str(&self) -> &'static str {
+        match self {
+            ModelVersionStatus::PendingRegistration => "PENDING_REGISTRATION",
+            ModelVersionStatus::FailedRegistration => "FAILED_REGISTRATION",
+            ModelVersionStatus::Ready => "READY",
+        }
+    }
+}
+
+impl fmt::Display for ModelVersionStatus {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str(self.as_str())
+    }
+}
+
+/// Model addressed either by `<namespace>.<name>` identifier or by id.
+/// Used in authorization errors (mirrors `VolumeIdentOrId`).
+#[derive(Hash, Debug, Clone, PartialEq, Eq, derive_more::From)]
+pub enum ModelIdentOrId {
+    Ident(TableIdent),
+    Id(ModelId),
+}
+
+impl fmt::Display for ModelIdentOrId {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            ModelIdentOrId::Ident(ident) => write!(f, "'{ident}'"),
+            ModelIdentOrId::Id(id) => write!(f, "ID '{id}'"),
+        }
+    }
+}
+
+/// The model fields authorization code needs. Mirrors [`AuthZVolumeInfo`];
+/// implemented by [`ModelInfo`] and [`ModelListEntry`]. Model versions have
+/// no authz identity of their own — version operations authorize on the
+/// parent model.
+///
+/// [`AuthZVolumeInfo`]: crate::service::AuthZVolumeInfo
+pub trait AuthZModelInfo: Send + Sync {
+    fn warehouse_id(&self) -> WarehouseId;
+    fn model_ident(&self) -> &TableIdent;
+    fn model_id(&self) -> ModelId;
+    fn namespace_id(&self) -> NamespaceId;
+    fn namespace_ident(&self) -> &NamespaceIdent {
+        self.model_ident().namespace()
+    }
+}
+
+#[derive(Debug, Clone)]
+pub struct ModelInfo {
+    pub model_id: ModelId,
+    pub warehouse_id: WarehouseId,
+    pub warehouse_version: WarehouseVersion,
+    pub namespace_id: NamespaceId,
+    pub namespace_version: NamespaceVersion,
+    pub namespace_ident: NamespaceIdent,
+    pub name: String,
+    /// `<namespace>.<name>` identifier (UC models live in single-level
+    /// namespaces; `TableIdent` is reused as a generic two-part identifier).
+    pub model_ident: TableIdent,
+    /// Managed storage location of the model
+    /// (`<namespace-location>/__uc_models/<model_id>`). Version artifact
+    /// locations are derived below it.
+    pub location: Location,
+    pub comment: Option<String>,
+    pub created_at: chrono::DateTime<chrono::Utc>,
+    pub updated_at: Option<chrono::DateTime<chrono::Utc>>,
+}
+
+impl AuthZModelInfo for ModelInfo {
+    fn warehouse_id(&self) -> WarehouseId {
+        self.warehouse_id
+    }
+
+    fn model_ident(&self) -> &TableIdent {
+        &self.model_ident
+    }
+
+    fn model_id(&self) -> ModelId {
+        self.model_id
+    }
+
+    fn namespace_id(&self) -> NamespaceId {
+        self.namespace_id
+    }
+}
+
+#[derive(Debug, Clone)]
+pub struct ModelCreation {
+    pub model_id: ModelId,
+    pub namespace_id: NamespaceId,
+    pub warehouse_id: WarehouseId,
+    pub name: String,
+    /// Server-derived managed location.
+    pub location: Location,
+    pub comment: Option<String>,
+}
+
+/// List entry for `listRegisteredModels`. Unlike volumes/functions, model
+/// listing supports warehouse-wide and instance-wide queries (UC contract:
+/// `catalog_name`/`schema_name` are optional), so each entry carries its
+/// warehouse (catalog) name and namespace identity.
+#[derive(Debug, Clone)]
+pub struct ModelListEntry {
+    pub model_id: ModelId,
+    pub warehouse_id: WarehouseId,
+    /// Warehouse name == UC `catalog_name`.
+    pub warehouse_name: String,
+    pub namespace_id: NamespaceId,
+    pub name: String,
+    pub model_ident: TableIdent,
+    pub namespace_ident: NamespaceIdent,
+    pub location: Location,
+    pub comment: Option<String>,
+    pub created_at: chrono::DateTime<chrono::Utc>,
+    pub updated_at: Option<chrono::DateTime<chrono::Utc>>,
+}
+
+impl AuthZModelInfo for ModelListEntry {
+    fn warehouse_id(&self) -> WarehouseId {
+        self.warehouse_id
+    }
+
+    fn model_ident(&self) -> &TableIdent {
+        &self.model_ident
+    }
+
+    fn model_id(&self) -> ModelId {
+        self.model_id
+    }
+
+    fn namespace_id(&self) -> NamespaceId {
+        self.namespace_id
+    }
+}
+
+#[derive(Debug, Clone)]
+pub struct ModelVersionInfo {
+    pub model_version_id: ModelVersionId,
+    pub model_id: ModelId,
+    pub warehouse_id: WarehouseId,
+    pub warehouse_version: WarehouseVersion,
+    pub namespace_id: NamespaceId,
+    pub namespace_version: NamespaceVersion,
+    pub namespace_ident: NamespaceIdent,
+    /// Name of the parent model.
+    pub model_name: String,
+    /// `<namespace>.<model-name>` identifier of the parent model.
+    pub model_ident: TableIdent,
+    /// UC integer version number (assigned by the server, `MAX+1` per model).
+    pub version: i64,
+    pub status: ModelVersionStatus,
+    pub source: Option<String>,
+    pub run_id: Option<String>,
+    pub comment: Option<String>,
+    /// Artifact storage location (`<model-location>/versions/<version-id>`).
+    pub location: Location,
+    pub created_at: chrono::DateTime<chrono::Utc>,
+    pub updated_at: Option<chrono::DateTime<chrono::Utc>>,
+}
+
+/// Credential vending (`StorageProfile::generate_table_config`) is
+/// entity-agnostic but keyed on [`BasicTabularInfo`]. Model versions are not
+/// tabulars and `TabularId` must not grow a UC variant (v1), so the model
+/// version id is wrapped as a `GenericTable` tabular id: it is only used as
+/// an opaque unique cache key for short-term credentials and for the
+/// `is_table()` check (correctly `false` — no remote-signing config). Ids are
+/// random UUIDv7, so they cannot collide with real generic-table ids. Using
+/// the *version* id (not the model id) keys the credential cache per version
+/// location.
+impl BasicTabularInfo for ModelVersionInfo {
+    fn warehouse_id(&self) -> WarehouseId {
+        self.warehouse_id
+    }
+
+    fn warehouse_version(&self) -> WarehouseVersion {
+        self.warehouse_version
+    }
+
+    fn tabular_ident(&self) -> &TableIdent {
+        &self.model_ident
+    }
+
+    fn tabular_id(&self) -> TabularId {
+        TabularId::GenericTable(GenericTableId::new(*self.model_version_id))
+    }
+
+    fn namespace_id(&self) -> NamespaceId {
+        self.namespace_id
+    }
+
+    fn namespace_version(&self) -> NamespaceVersion {
+        self.namespace_version
+    }
+}
+
+#[derive(Debug, Clone)]
+pub struct ModelVersionCreation {
+    pub model_version_id: ModelVersionId,
+    pub model_id: ModelId,
+    pub warehouse_id: WarehouseId,
+    pub source: Option<String>,
+    pub run_id: Option<String>,
+    pub comment: Option<String>,
+    /// Server-derived artifact location
+    /// (`<model-location>/versions/<model_version_id>`).
+    pub location: Location,
+}
+
+define_simple_error!(ModelAlreadyExists, "Registered model already exists");
+impl From<ModelAlreadyExists> for ErrorModel {
+    fn from(err: ModelAlreadyExists) -> Self {
+        ErrorModel::builder()
+            .message(err.to_string())
+            .r#type("ModelAlreadyExists")
+            .code(StatusCode::CONFLICT.as_u16())
+            .stack(err.stack)
+            .build()
+    }
+}
+
+define_simple_error!(ModelNotFound, "Registered model not found");
+impl From<ModelNotFound> for ErrorModel {
+    fn from(err: ModelNotFound) -> Self {
+        ErrorModel::builder()
+            .message(err.to_string())
+            .r#type("ModelNotFound")
+            .code(StatusCode::NOT_FOUND.as_u16())
+            .stack(err.stack)
+            .build()
+    }
+}
+
+define_simple_error!(ModelVersionNotFound, "Model version not found");
+impl From<ModelVersionNotFound> for ErrorModel {
+    fn from(err: ModelVersionNotFound) -> Self {
+        ErrorModel::builder()
+            .message(err.to_string())
+            .r#type("ModelVersionNotFound")
+            .code(StatusCode::NOT_FOUND.as_u16())
+            .stack(err.stack)
+            .build()
+    }
+}
+
+define_simple_error!(
+    ModelHasVersions,
+    "Registered model still has model versions; delete all versions first"
+);
+impl From<ModelHasVersions> for ErrorModel {
+    fn from(err: ModelHasVersions) -> Self {
+        // 400 INVALID_ARGUMENT on the UC wire (the e2e contract accepts
+        // 400-or-409 for delete-model-with-versions).
+        ErrorModel::builder()
+            .message(err.to_string())
+            .r#type("ModelHasVersions")
+            .code(StatusCode::BAD_REQUEST.as_u16())
+            .stack(err.stack)
+            .build()
+    }
+}
+
+define_simple_error!(
+    InvalidModelVersionStatusTransition,
+    "Model version is not in PENDING_REGISTRATION status"
+);
+impl From<InvalidModelVersionStatusTransition> for ErrorModel {
+    fn from(err: InvalidModelVersionStatusTransition) -> Self {
+        ErrorModel::builder()
+            .message(err.to_string())
+            .r#type("InvalidModelVersionStatusTransition")
+            .code(StatusCode::BAD_REQUEST.as_u16())
+            .stack(err.stack)
+            .build()
+    }
+}
