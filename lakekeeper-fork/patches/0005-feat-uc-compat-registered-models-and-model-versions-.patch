+#[sqlx::test]
+async fn test_version_lifecycle(pool: PgPool) {
+    let (ctx, catalog, _base) = setup(pool).await;
+    let model = create_model(&ctx, &catalog, SCHEMA, "m").await;
+
+    // Versions auto-increment 1, 2, 3.
+    for expected in 1..=3_i64 {
+        let mv = CatalogServer::create_model_version(
+            version_request(&catalog, SCHEMA, "m"),
+            ctx.clone(),
+            random_request_metadata(),
+        )
+        .await
+        .unwrap();
+        assert_eq!(mv.version, expected);
+        assert_eq!(mv.status, ModelVersionStatus::PendingRegistration);
+        assert_eq!(mv.model_name, "m");
+        assert!(
+            mv.storage_location.starts_with(&model.storage_location),
+            "version location {} must nest under the model location {}",
+            mv.storage_location,
+            model.storage_location
+        );
+        assert!(mv.storage_location.contains("/versions/"));
+        uuid::Uuid::parse_str(&mv.id).expect("version id must be a UUID");
+    }
+
+    // List + get.
+    let listed = CatalogServer::list_model_versions(
+        model.full_name.clone(),
+        lakekeeper::api::uc::UcPaginationQuery::default(),
+        ctx.clone(),
+        random_request_metadata(),
+    )
+    .await
+    .unwrap();
+    assert_eq!(
+        listed
+            .model_versions
+            .iter()
+            .map(|v| v.version)
+            .collect::<Vec<_>>(),
+        [1, 2, 3]
+    );
+
+    let got = CatalogServer::get_model_version(
+        model.full_name.clone(),
+        2,
+        ctx.clone(),
+        random_request_metadata(),
+    )
+    .await
+    .unwrap();
+    assert_eq!(got.version, 2);
+
+    // Version comment update.
+    let updated = CatalogServer::update_model_version(
+        model.full_name.clone(),
+        2,
+        UpdateModelVersionRequest {
+            comment: Some("patched".to_string()),
+        },
+        ctx.clone(),
+        random_request_metadata(),
+    )
+    .await
+    .unwrap();
+    assert_eq!(updated.comment.as_deref(), Some("patched"));
+    assert_eq!(updated.id, got.id);
+
+    // Finalize -> READY.
+    let finalized = CatalogServer::finalize_model_version(
+        model.full_name.clone(),
+        1,
+        FinalizeModelVersionRequest {
+            full_name: model.full_name.clone(),
+            version: 1,
+        },
+        ctx.clone(),
+        random_request_metadata(),
+    )
+    .await
+    .unwrap();
+    assert_eq!(finalized.status, ModelVersionStatus::Ready);
+
+    // Double finalize is a 400.
+    let err = CatalogServer::finalize_model_version(
+        model.full_name.clone(),
+        1,
+        FinalizeModelVersionRequest {
+            full_name: model.full_name.clone(),
+            version: 1,
+        },
+        ctx.clone(),
+        random_request_metadata(),
+    )
+    .await
+    .unwrap_err();
+    assert_eq!(err.status, 400, "{err:?}");
+    assert_eq!(err.error_code, "INVALID_ARGUMENT");
+
+    // Mismatched finalize body is a 400.
+    let err = CatalogServer::finalize_model_version(
+        model.full_name.clone(),
+        2,
+        FinalizeModelVersionRequest {
+            full_name: model.full_name.clone(),
+            version: 3,
+        },
+        ctx.clone(),
+        random_request_metadata(),
+    )
+    .await
+    .unwrap_err();
+    assert_eq!(err.status, 400);
+
+    // Delete version 3; then it 404s.
+    CatalogServer::delete_model_version(
+        model.full_name.clone(),
+        3,
+        ctx.clone(),
+        random_request_metadata(),
+    )
+    .await
+    .unwrap();
+    let err = CatalogServer::get_model_version(
+        model.full_name.clone(),
+        3,
+        ctx.clone(),
+        random_request_metadata(),
+    )
+    .await
+    .unwrap_err();
+    assert_eq!(err.status, 404);
+    assert_eq!(err.error_code, "NOT_FOUND");
+
+    // Deleting the model with live versions fails without force...
+    let err = CatalogServer::delete_registered_model(
+        model.full_name.clone(),
+        DeleteRegisteredModelQuery::default(),
+        ctx.clone(),
+        random_request_metadata(),
+    )
+    .await
+    .unwrap_err();
+    assert!(
+        err.status == 400 || err.status == 409,
+        "expected 400/409, got {err:?}"
+    );
+
+    // ...and succeeds with force=true.
+    CatalogServer::delete_registered_model(
+        model.full_name.clone(),
+        DeleteRegisteredModelQuery { force: Some(true) },
+        ctx.clone(),
+        random_request_metadata(),
+    )
+    .await
+    .unwrap();
+    let err = CatalogServer::get_registered_model(model.full_name, ctx, random_request_metadata())
+        .await
+        .unwrap_err();
+    assert_eq!(err.status, 404);
+    assert_eq!(err.error_code, "NOT_FOUND");
+}
