@@ -0,0 +1,672 @@
+//! Unity Catalog compatibility API (Phase D): Registered Models + Model
+//! Versions + temporary model version credentials, driven through the
+//! `UcCatalogService` trait on `CatalogServer` (same harness as
+//! `server_uc_volumes.rs`).
+
+use std::collections::HashMap;
+
+use lakekeeper::{
+    api::{
+        ApiContext,
+        uc::v1::{
+            CreateModelVersionRequest, CreateRegisteredModelRequest, CreateSchemaRequest,
+            DeleteRegisteredModelQuery, FinalizeModelVersionRequest,
+            GenerateTemporaryModelVersionCredentialsRequest, ListRegisteredModelsQuery,
+            ModelVersionOperation, ModelVersionStatus, UcCatalogService as _,
+            UpdateModelVersionRequest, UpdateRegisteredModelRequest,
+        },
+    },
+    server::CatalogServer,
+    service::{
+        CatalogStore, CatalogWarehouseOps as _, State, Transaction as _,
+        authz::AllowAllAuthorizer,
+        storage::{MemoryProfile, StorageProfile},
+    },
+};
+use lakekeeper_integration_tests::{get_api_context, random_request_metadata};
+use lakekeeper_storage_postgres::{
+    PostgresBackend, SecretsState, warehouse::test::initialize_warehouse,
+};
+use sqlx::PgPool;
+
+type Ctx = ApiContext<State<AllowAllAuthorizer, PostgresBackend, SecretsState>>;
+
+const SCHEMA: &str = "models_schema";
+const SCHEMA2: &str = "models_schema_2";
+
+/// Returns `(ctx, catalog_name, warehouse_base_location)` with the schemas
+/// `SCHEMA` and `SCHEMA2` pre-created.
+async fn setup(pool: PgPool) -> (Ctx, String, String) {
+    lakekeeper_storage_postgres::migrations::migrate_core_only(&pool)
+        .await
+        .unwrap();
+    let api_context = get_api_context(&pool, AllowAllAuthorizer::default()).await;
+    let state = api_context.v1_state.catalog.clone();
+
+    let profile = StorageProfile::Memory(MemoryProfile::default());
+    let base_location = profile.base_location().unwrap().to_string();
+    let (_project_id, warehouse_id) =
+        initialize_warehouse(state.clone(), Some(profile), None, None, true).await;
+
+    // Unique warehouse name: the name→id cache is process-global while each
+    // `#[sqlx::test]` runs against its own database.
+    let catalog_name = format!("uc_wh_{}", uuid::Uuid::now_v7().simple());
+    let mut t = <PostgresBackend as CatalogStore>::Transaction::begin_write(state)
+        .await
+        .unwrap();
+    PostgresBackend::rename_warehouse(warehouse_id, &catalog_name, t.transaction())
+        .await
+        .unwrap();
+    t.commit().await.unwrap();
+
+    for schema in [SCHEMA, SCHEMA2] {
+        CatalogServer::create_schema(
+            CreateSchemaRequest {
+                name: schema.to_string(),
+                catalog_name: catalog_name.clone(),
+                comment: None,
+                properties: HashMap::new(),
+                storage_root: None,
+            },
+            api_context.clone(),
+            random_request_metadata(),
+        )
+        .await
+        .unwrap();
+    }
+
+    (api_context, catalog_name, base_location)
+}
+
+fn create_request(catalog: &str, schema: &str, name: &str) -> CreateRegisteredModelRequest {
+    CreateRegisteredModelRequest {
+        name: name.to_string(),
+        catalog_name: catalog.to_string(),
+        schema_name: schema.to_string(),
+        comment: Some("a model".to_string()),
+    }
+}
+
+fn version_request(catalog: &str, schema: &str, model: &str) -> CreateModelVersionRequest {
+    CreateModelVersionRequest {
+        model_name: model.to_string(),
+        catalog_name: catalog.to_string(),
+        schema_name: schema.to_string(),
+        source: "uc-test://training-run".to_string(),
+        run_id: Some("run-1".to_string()),
+        comment: Some("v".to_string()),
+    }
+}
+
+async fn create_model(
+    ctx: &Ctx,
+    catalog: &str,
+    schema: &str,
+    name: &str,
+) -> lakekeeper::api::uc::v1::RegisteredModelInfo {
+    CatalogServer::create_registered_model(
+        create_request(catalog, schema, name),
+        ctx.clone(),
+        random_request_metadata(),
+    )
+    .await
+    .unwrap()
+}
+
+#[sqlx::test]
+async fn test_create_model_and_get(pool: PgPool) {
+    let (ctx, catalog, base) = setup(pool).await;
+
+    let created = create_model(&ctx, &catalog, SCHEMA, "m1").await;
+    assert_eq!(created.name, "m1");
+    assert_eq!(created.catalog_name, catalog);
+    assert_eq!(created.schema_name, SCHEMA);
+    assert_eq!(created.full_name, format!("{catalog}.{SCHEMA}.m1"));
+    assert_eq!(created.comment.as_deref(), Some("a model"));
+    assert!(created.created_at.is_some());
+    let model_id = uuid::Uuid::parse_str(&created.id).expect("id must be a UUID");
+    assert!(
+        created.storage_location.starts_with(&base),
+        "managed model location {} must live under the warehouse base {base}",
+        created.storage_location
+    );
+    assert!(
+        created
+            .storage_location
+            .contains(&format!("__uc_models/{model_id}")),
+        "managed model location {} must contain __uc_models/<model_id>",
+        created.storage_location
+    );
+
+    let fetched = CatalogServer::get_registered_model(
+        created.full_name.clone(),
+        ctx.clone(),
+        random_request_metadata(),
+    )
+    .await
+    .unwrap();
+    assert_eq!(fetched, created);
+}
+
+#[sqlx::test]
+async fn test_update_model_comment(pool: PgPool) {
+    let (ctx, catalog, _base) = setup(pool).await;
+    let created = create_model(&ctx, &catalog, SCHEMA, "m").await;
+
+    let updated = CatalogServer::update_registered_model(
+        created.full_name.clone(),
+        UpdateRegisteredModelRequest {
+            comment: Some("patched".to_string()),
+            new_name: None,
+        },
+        ctx.clone(),
+        random_request_metadata(),
+    )
+    .await
+    .unwrap();
+    assert_eq!(updated.comment.as_deref(), Some("patched"));
+    assert_eq!(updated.id, created.id);
+    assert!(updated.updated_at.is_some());
+
+    // Empty update behaves like a get.
+    let noop = CatalogServer::update_registered_model(
+        created.full_name.clone(),
+        UpdateRegisteredModelRequest::default(),
+        ctx.clone(),
+        random_request_metadata(),
+    )
+    .await
+    .unwrap();
+    assert_eq!(noop.comment.as_deref(), Some("patched"));
+
+    // Renames are rejected.
+    let err = CatalogServer::update_registered_model(
+        created.full_name,
+        UpdateRegisteredModelRequest {
+            comment: None,
+            new_name: Some("renamed".to_string()),
+        },
+        ctx,
+        random_request_metadata(),
+    )
+    .await
+    .unwrap_err();
+    assert_eq!(err.status, 400);
+    assert_eq!(err.error_code, "INVALID_ARGUMENT");
+}
+
+#[sqlx::test]
+async fn test_name_conflict_is_409(pool: PgPool) {
+    let (ctx, catalog, _base) = setup(pool).await;
+    create_model(&ctx, &catalog, SCHEMA, "dup").await;
+
+    let err = CatalogServer::create_registered_model(
+        create_request(&catalog, SCHEMA, "DUP"),
+        ctx,
+        random_request_metadata(),
+    )
+    .await
+    .unwrap_err();
+    assert_eq!(err.status, 409, "{err:?}");
+    assert_eq!(err.error_code, "ALREADY_EXISTS");
+}
+
+#[sqlx::test]
+async fn test_404_masking_for_missing_model(pool: PgPool) {
+    let (ctx, catalog, _base) = setup(pool).await;
+
+    for full_name in [
+        format!("{catalog}.{SCHEMA}.ghost"),
+        format!("{catalog}.no_such_schema.ghost"),
+        "no_such_catalog.schema.ghost".to_string(),
+    ] {
+        let err = CatalogServer::get_registered_model(
+            full_name.clone(),
+            ctx.clone(),
+            random_request_metadata(),
+        )
+        .await
+        .unwrap_err();
+        assert_eq!(err.status, 404, "{full_name}");
+        assert_eq!(err.error_code, "NOT_FOUND", "{full_name}");
+    }
+
+    // Malformed names are 400.
+    for bad in ["", "cat", "cat.schema", "cat.schema.m.extra", "a..b"] {
+        let err = CatalogServer::get_registered_model(
+            bad.to_string(),
+            ctx.clone(),
+            random_request_metadata(),
+        )
+        .await
+        .unwrap_err();
+        assert_eq!(err.status, 400, "{bad}");
+        assert_eq!(err.error_code, "INVALID_ARGUMENT", "{bad}");
+    }
+}
+
+#[sqlx::test]
+async fn test_list_all_models_across_schemas(pool: PgPool) {
+    let (ctx, catalog, _base) = setup(pool).await;
+    let m1 = create_model(&ctx, &catalog, SCHEMA, "m1").await;
+    let m2 = create_model(&ctx, &catalog, SCHEMA2, "m2").await;
+
+    // Schema-scoped list sees only its schema's model.
+    let scoped = CatalogServer::list_registered_models(
+        ListRegisteredModelsQuery {
+            catalog_name: Some(catalog.clone()),
+            schema_name: Some(SCHEMA.to_string()),
+            max_results: None,
+            page_token: None,
+        },
+        ctx.clone(),
+        random_request_metadata(),
+    )
+    .await
+    .unwrap();
+    let names: Vec<_> = scoped
+        .registered_models
+        .iter()
+        .map(|m| m.full_name.clone())
+        .collect();
+    assert!(names.contains(&m1.full_name), "{names:?}");
+    assert!(!names.contains(&m2.full_name), "{names:?}");
+
+    // Catalog-scoped list (no schema) sees both.
+    let warehouse_wide = CatalogServer::list_registered_models(
+        ListRegisteredModelsQuery {
+            catalog_name: Some(catalog.clone()),
+            schema_name: None,
+            max_results: None,
+            page_token: None,
+        },
+        ctx.clone(),
+        random_request_metadata(),
+    )
+    .await
+    .unwrap();
+    let names: Vec<_> = warehouse_wide
+        .registered_models
+        .iter()
+        .map(|m| m.full_name.clone())
+        .collect();
+    assert!(names.contains(&m1.full_name), "{names:?}");
+    assert!(names.contains(&m2.full_name), "{names:?}");
+
+    // List-all (no catalog, no schema) sees both too, with correct
+    // catalog/schema fields.
+    let all = CatalogServer::list_registered_models(
+        ListRegisteredModelsQuery::default(),
+        ctx.clone(),
+        random_request_metadata(),
+    )
+    .await
+    .unwrap();
+    let m2_entry = all
+        .registered_models
+        .iter()
+        .find(|m| m.full_name == m2.full_name)
+        .expect("m2 must be in the list-all result");
+    assert_eq!(m2_entry.catalog_name, catalog);
+    assert_eq!(m2_entry.schema_name, SCHEMA2);
+    assert!(
+        all.registered_models
+            .iter()
+            .any(|m| m.full_name == m1.full_name)
+    );
+
+    // schema_name without catalog_name is rejected.
+    let err = CatalogServer::list_registered_models(
+        ListRegisteredModelsQuery {
+            catalog_name: None,
+            schema_name: Some(SCHEMA.to_string()),
+            max_results: None,
+            page_token: None,
+        },
+        ctx,
+        random_request_metadata(),
+    )
+    .await
+    .unwrap_err();
+    assert_eq!(err.status, 400);
+    assert_eq!(err.error_code, "INVALID_ARGUMENT");
+}
