+
+    model_row_to_info(row).map_err(LoadModelError::from)
+}
+
+/// List registered models. `warehouse_id: None` lists across all active
+/// warehouses of `project_id` (UC list-all); `namespace_id: None` lists
+/// across all namespaces of the selected warehouse(s).
+pub(crate) async fn list_models(
+    project_id: &ProjectId,
+    warehouse_id: Option<WarehouseId>,
+    namespace_id: Option<NamespaceId>,
+    page_size: Option<i64>,
+    page_token: Option<&str>,
+    transaction: &mut sqlx::Transaction<'_, sqlx::Postgres>,
+) -> Result<(Vec<ModelListEntry>, Option<String>), ListModelsError> {
+    let page_size = CONFIG.page_size_or_pagination_default(page_size);
+
+    let token = page_token
+        .map(PaginateToken::<Uuid>::try_from)
+        .transpose()
+        .map_err(|e| ListModelsError::from(CatalogBackendError::new_unexpected(e)))?;
+
+    let (token_ts, token_id) = token
+        .as_ref()
+        .map(
+            |PaginateToken::V1(V1PaginateToken { created_at, id }): &PaginateToken<Uuid>| {
+                (created_at, id)
+            },
+        )
+        .map_or((None, None), |(ts, id)| (Some(*ts), Some(*id)));
+
+    let rows = sqlx::query_as!(
+        ModelListRow,
+        r#"
+        SELECT
+            m.model_id,
+            m.warehouse_id,
+            w.warehouse_name,
+            m.namespace_id,
+            n.namespace_name as "namespace_name!",
+            m.name,
+            m.location,
+            m.comment,
+            m.created_at,
+            m.updated_at
+        FROM uc_model m
+        INNER JOIN warehouse w
+            ON w.warehouse_id = m.warehouse_id AND w.status = 'active' AND w.project_id = $1
+        INNER JOIN namespace n
+            ON n.namespace_id = m.namespace_id AND n.warehouse_id = m.warehouse_id
+        WHERE ($2::uuid IS NULL OR m.warehouse_id = $2)
+          AND ($3::uuid IS NULL OR m.namespace_id = $3)
+          AND m.deleted_at IS NULL
+          AND (
+            ($4::timestamptz IS NULL)
+            OR (m.created_at, m.model_id) > ($4, $5)
+          )
+        ORDER BY m.created_at ASC, m.model_id ASC
+        LIMIT $6
+        "#,
+        project_id,
+        warehouse_id.map(|w| *w),
+        namespace_id.map(|n| *n),
+        token_ts,
+        token_id,
+        page_size,
+    )
+    .fetch_all(&mut **transaction)
+    .await
+    .map_err(|e| ListModelsError::from(e.into_catalog_backend_error()))?;
+
+    let mut entries = Vec::with_capacity(rows.len());
+    let mut next_page_token = None;
+
+    for row in rows {
+        next_page_token = Some(
+            PaginateToken::V1(V1PaginateToken {
+                created_at: row.created_at,
+                id: row.model_id,
+            })
+            .to_string(),
+        );
+
+        let warehouse_id = WarehouseId::from(row.warehouse_id);
+        let namespace_ident = parse_namespace_identifier_from_vec(
+            &row.namespace_name,
+            warehouse_id,
+            Some(row.namespace_id),
+        )
+        .map_err(|e| ListModelsError::from(CatalogBackendError::new_unexpected(e)))?;
+        let location = parse_model_location(&row.location).map_err(ListModelsError::from)?;
+        let model_ident = TableIdent::new(namespace_ident.clone(), row.name.clone());
+        entries.push(ModelListEntry {
+            model_id: row.model_id.into(),
+            warehouse_id,
+            warehouse_name: row.warehouse_name,
+            namespace_id: row.namespace_id.into(),
+            name: row.name,
+            model_ident,
+            namespace_ident,
+            location,
+            comment: row.comment,
+            created_at: row.created_at,
+            updated_at: row.updated_at,
+        });
+    }
+
+    Ok((entries, next_page_token))
+}
+
+pub(crate) async fn update_model_comment(
+    warehouse_id: WarehouseId,
+    model_id: ModelId,
+    comment: Option<&str>,
+    transaction: &mut sqlx::Transaction<'_, sqlx::Postgres>,
+) -> Result<(), UpdateModelError> {
+    sqlx::query!(
+        r#"
+        UPDATE uc_model
+        SET comment = $3
+        WHERE warehouse_id = $1 AND model_id = $2 AND deleted_at IS NULL
+        RETURNING model_id
+        "#,
+        *warehouse_id,
+        *model_id,
+        comment,
+    )
+    .fetch_optional(&mut **transaction)
+    .await
+    .map_err(|e| UpdateModelError::from(e.into_catalog_backend_error()))?
+    .ok_or_else(|| UpdateModelError::from(ModelNotFound::new()))?;
+    Ok(())
+}
+
+/// Hard delete (UC DELETE semantics in v1). Unless `force`, fails with
+/// `ModelHasVersions` if any live versions exist; with `force`, versions are
+/// removed via the FK cascade. The model row is locked first, which
+/// serializes the versions check against concurrent `create_model_version`
+/// (same lock).
+pub(crate) async fn drop_model(
+    warehouse_id: WarehouseId,
+    namespace_id: NamespaceId,
+    model_name: &str,
+    force: bool,
+    transaction: &mut sqlx::Transaction<'_, sqlx::Postgres>,
+) -> Result<ModelId, DropModelError> {
+    let row = sqlx::query!(
+        r#"
+        SELECT m.model_id
+        FROM uc_model m
+        INNER JOIN warehouse w ON w.warehouse_id = m.warehouse_id AND w.status = 'active'
+        WHERE m.warehouse_id = $1
+          AND m.namespace_id = $2
+          AND m.name = $3
+          AND m.deleted_at IS NULL
+        FOR UPDATE OF m
+        "#,
+        *warehouse_id,
+        *namespace_id,
+        model_name,
+    )
+    .fetch_optional(&mut **transaction)
+    .await
+    .map_err(|e| DropModelError::from(e.into_catalog_backend_error()))?
+    .ok_or_else(|| DropModelError::from(ModelNotFound::new()))?;
+    let model_id = row.model_id;
+
+    if !force {
+        let has_versions = sqlx::query_scalar!(
+            r#"SELECT EXISTS (
+                   SELECT 1 FROM uc_model_version
+                   WHERE warehouse_id = $1 AND model_id = $2 AND deleted_at IS NULL
+               ) as "exists!""#,
+            *warehouse_id,
+            model_id,
+        )
+        .fetch_one(&mut **transaction)
+        .await
+        .map_err(|e| DropModelError::from(e.into_catalog_backend_error()))?;
+        if has_versions {
+            return Err(DropModelError::from(ModelHasVersions::new()));
+        }
+    }
+
+    sqlx::query!(
+        r#"DELETE FROM uc_model WHERE warehouse_id = $1 AND model_id = $2"#,
+        *warehouse_id,
+        model_id,
+    )
+    .execute(&mut **transaction)
+    .await
+    .map_err(|e| DropModelError::from(e.into_catalog_backend_error()))?;
+
+    Ok(model_id.into())
+}
+
+/// Create a model version. The integer version is assigned as
+/// `MAX(model_version) + 1` for the model inside this statement; the parent
+/// `uc_model` row is locked `FOR UPDATE` in the CTE, which serializes
+/// concurrent assignment (the second transaction blocks on the lock and sees
+/// the first one's row after it commits).
+pub(crate) async fn create_model_version(
+    creation: ModelVersionCreation,
+    transaction: &mut sqlx::Transaction<'_, sqlx::Postgres>,
+) -> Result<ModelVersionInfo, CreateModelVersionError> {
+    let model_version_id: Uuid = *creation.model_version_id;
+    let model_id: Uuid = *creation.model_id;
+    let warehouse_id: Uuid = *creation.warehouse_id;
+    let fs_location = creation.location.authority_and_path();
+
+    // Lock the model row FIRST so both the overlap check and MAX+1 run
+    // serialized with concurrent version creations for the same model.
+    let locked = sqlx::query_scalar!(
+        r#"
+        SELECT m.model_id FROM uc_model m
+        WHERE m.warehouse_id = $1 AND m.model_id = $2 AND m.deleted_at IS NULL
+        FOR UPDATE
+        "#,
+        warehouse_id,
+        model_id,
+    )
+    .fetch_optional(&mut **transaction)
+    .await
+    .map_err(|e| CreateModelVersionError::from(e.into_catalog_backend_error()))?;
+    if locked.is_none() {
+        return Err(CreateModelVersionError::from(ModelNotFound::new()));
+    }
+
+    ensure_model_version_location_available(
+        warehouse_id,
+        model_version_id,
+        &creation.location,
+        transaction,
+    )
+    .await?;
+
+    let row = sqlx::query_as!(
+        ModelVersionFullRow,
+        r#"
+        WITH inserted AS (
+            INSERT INTO uc_model_version (
+                warehouse_id, model_version_id, model_id, model_version,
+                source, run_id, comment, location, fs_location
+            )
+            SELECT
+                m.warehouse_id, $3, m.model_id,
+                COALESCE((
+                    SELECT MAX(v.model_version) FROM uc_model_version v
+                    WHERE v.warehouse_id = m.warehouse_id
+                      AND v.model_id = m.model_id
+                      AND v.deleted_at IS NULL
+                ), 0) + 1,
+                $4, $5, $6, $7, $8
+            FROM uc_model m
+            WHERE m.warehouse_id = $1 AND m.model_id = $2 AND m.deleted_at IS NULL
+            RETURNING model_version_id, model_id, warehouse_id, model_version,
+                      status, source, run_id, comment, location, created_at, updated_at
+        )
+        SELECT
+            i.model_version_id,
+            i.model_id,
+            i.warehouse_id,
+            w.version as "warehouse_version!",
+            m.namespace_id,
+            n.version as "namespace_version!",
+            n.namespace_name as "namespace_name!",
+            m.name as model_name,
+            i.model_version,
+            i.status as "status: DbModelVersionStatus",
+            i.source,
+            i.run_id,
+            i.comment,
+            i.location,
+            i.created_at,
+            i.updated_at
+        FROM inserted i
+        INNER JOIN uc_model m ON m.warehouse_id = i.warehouse_id AND m.model_id = i.model_id
+        INNER JOIN warehouse w ON w.warehouse_id = $1 AND w.status = 'active'
+        INNER JOIN namespace n ON n.namespace_id = m.namespace_id AND n.warehouse_id = $1
+        "#,
+        warehouse_id,
+        model_id,
+        model_version_id,
+        creation.source.as_deref(),
+        creation.run_id.as_deref(),
+        creation.comment.as_deref(),
+        creation.location.as_str(),
+        fs_location,
+    )
+    .fetch_optional(&mut **transaction)
+    .await
+    .map_err(|e| CreateModelVersionError::from(e.into_catalog_backend_error()))?
+    .ok_or_else(|| CreateModelVersionError::from(ModelNotFound::new()))?;
+
+    version_row_to_info(row).map_err(CreateModelVersionError::from)
+}
