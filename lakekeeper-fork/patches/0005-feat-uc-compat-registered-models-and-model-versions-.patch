+#[sqlx::test]
+async fn test_temporary_model_version_credentials(pool: PgPool) {
+    let (ctx, catalog, _base) = setup(pool).await;
+    let model = create_model(&ctx, &catalog, SCHEMA, "m").await;
+    let mv = CatalogServer::create_model_version(
+        version_request(&catalog, SCHEMA, "m"),
+        ctx.clone(),
+        random_request_metadata(),
+    )
+    .await
+    .unwrap();
+
+    // While PENDING: both READ and READ_WRITE are vended. The in-memory
+    // test profile vends no credentials, so the envelope is empty — which
+    // asserts the vending path runs end-to-end without error (consistent
+    // with the volume credentials test).
+    for operation in [
+        ModelVersionOperation::ReadModelVersion,
+        ModelVersionOperation::ReadWriteModelVersion,
+    ] {
+        let creds = CatalogServer::generate_temporary_model_version_credentials(
+            creds_request(&catalog, SCHEMA, "m", mv.version, operation),
+            ctx.clone(),
+            random_request_metadata(),
+        )
+        .await
+        .unwrap();
+        assert!(creds.aws_temp_credentials.is_none());
+        assert!(creds.azure_user_delegation_sas.is_none());
+        assert!(creds.gcp_oauth_token.is_none());
+        assert!(creds.expiration_time.is_none());
+    }
+
+    // Finalize -> READY.
+    CatalogServer::finalize_model_version(
+        model.full_name.clone(),
+        mv.version,
+        FinalizeModelVersionRequest {
+            full_name: model.full_name.clone(),
+            version: mv.version,
+        },
+        ctx.clone(),
+        random_request_metadata(),
+    )
+    .await
+    .unwrap();
+
+    // READ_WRITE after READY is rejected (400)...
+    let err = CatalogServer::generate_temporary_model_version_credentials(
+        creds_request(
+            &catalog,
+            SCHEMA,
+            "m",
+            mv.version,
+            ModelVersionOperation::ReadWriteModelVersion,
+        ),
+        ctx.clone(),
+        random_request_metadata(),
+    )
+    .await
+    .unwrap_err();
+    assert!(
+        err.status == 400 || err.status == 409,
+        "expected 400/409, got {err:?}"
+    );
+    assert_eq!(err.error_code, "INVALID_ARGUMENT");
+
+    // ...but READ still works.
+    CatalogServer::generate_temporary_model_version_credentials(
+        creds_request(
+            &catalog,
+            SCHEMA,
+            "m",
+            mv.version,
+            ModelVersionOperation::ReadModelVersion,
+        ),
+        ctx.clone(),
+        random_request_metadata(),
+    )
+    .await
+    .unwrap();
+
+    // Unknown operation is INVALID_ARGUMENT.
+    let err = CatalogServer::generate_temporary_model_version_credentials(
+        creds_request(
+            &catalog,
+            SCHEMA,
+            "m",
+            mv.version,
+            ModelVersionOperation::UnknownModelVersionOperation,
+        ),
+        ctx.clone(),
+        random_request_metadata(),
+    )
+    .await
+    .unwrap_err();
+    assert_eq!(err.status, 400);
+    assert_eq!(err.error_code, "INVALID_ARGUMENT");
+
+    // Missing version is a 404 (contract allows 400/404).
+    let err = CatalogServer::generate_temporary_model_version_credentials(
+        creds_request(
+            &catalog,
+            SCHEMA,
+            "m",
+            999,
+            ModelVersionOperation::ReadModelVersion,
+        ),
+        ctx.clone(),
+        random_request_metadata(),
+    )
+    .await
+    .unwrap_err();
+    assert!(
+        err.status == 400 || err.status == 404,
+        "expected 400/404, got {err:?}"
+    );
+
+    // Missing model is a masked 404.
+    let err = CatalogServer::generate_temporary_model_version_credentials(
+        creds_request(
+            &catalog,
+            SCHEMA,
+            "ghost",
+            1,
+            ModelVersionOperation::ReadModelVersion,
+        ),
+        ctx,
+        random_request_metadata(),
+    )
+    .await
+    .unwrap_err();
+    assert_eq!(err.status, 404);
+    assert_eq!(err.error_code, "NOT_FOUND");
+}
