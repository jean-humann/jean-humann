+#[sqlx::test]
+async fn test_create_managed_volume_derives_location(pool: PgPool) {
+    let (ctx, catalog, base) = setup(pool).await;
+
+    let created = CatalogServer::create_volume(
+        managed_request(&catalog, "managed1"),
+        ctx.clone(),
+        random_request_metadata(),
+    )
+    .await
+    .unwrap();
+    assert_eq!(created.volume_type, VolumeType::Managed);
+    assert!(
+        created.storage_location.starts_with(&base),
+        "managed location {} must live under the warehouse base {base}",
+        created.storage_location
+    );
+    assert!(
+        created
+            .storage_location
+            .contains(&format!("__uc_volumes/{}", created.volume_id)),
+        "managed location {} must contain __uc_volumes/<volume_id>",
+        created.storage_location
+    );
+
+    // MANAGED + storage_location is rejected.
+    let mut bad = managed_request(&catalog, "managed2");
+    bad.storage_location = Some(format!("{base}/vols/managed2"));
+    let err = CatalogServer::create_volume(bad, ctx.clone(), random_request_metadata())
+        .await
+        .unwrap_err();
+    assert_eq!(err.status, 400);
+    assert_eq!(err.error_code, "INVALID_ARGUMENT");
+
+    // EXTERNAL without storage_location is rejected.
+    let mut bad = external_request(&catalog, "ext-missing", "unused");
+    bad.storage_location = None;
+    let err = CatalogServer::create_volume(bad, ctx, random_request_metadata())
+        .await
+        .unwrap_err();
+    assert_eq!(err.status, 400);
+    assert_eq!(err.error_code, "INVALID_ARGUMENT");
+}
