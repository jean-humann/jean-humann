diff --git a/authz/openfga/README.md b/authz/openfga/README.md
index 36e6f29b..cfd67977 100644
--- a/authz/openfga/README.md
+++ b/authz/openfga/README.md
@@ -4,6 +4,26 @@
 
 `ADDS_TUPLES` indicates whether new tuples are added to the store during the migration.
 
+## `v4.8`
+
+```
+MODIFIES_TUPLES: FALSE
+ADDS_TUPLES:     FALSE
+```
+
+Backwards-compatible additions for the Unity Catalog compatibility API. No tuple rewrites needed.
+
+Types:
+
+- Add `lakekeeper_volume` type (UC volumes): `parent: [namespace]`, `ownership`, `pass_grants`, `manage_grants`, `describe`, `select`, `modify` (all patterned on `lakekeeper_generic_table`); actions `can_drop`/`can_write_data` (modify), `can_read_data` (select), `can_get_metadata`/`can_include_in_list` (describe) plus the standard grant set.
+- Add `lakekeeper_function` type (UC functions): same base relations plus `execute: [user, role#assignee] or ownership or modify or select from parent` (namespace has no `execute` relation, so execute inherits `select` from the parent namespace) with `can_execute: execute` and `can_grant_execute`.
+- Add `lakekeeper_model` type (UC registered models): same base relations; actions like `lakekeeper_volume` plus `can_create_version: modify`.
+
+`namespace`:
+
+- Add `lakekeeper_volume`, `lakekeeper_function` and `lakekeeper_model` to the `child` relation type set.
+- Add `can_create_volume`, `can_create_function`, `can_create_model` (create) and `can_list_volumes`, `can_list_functions`, `can_list_models` (`can_get_metadata`).
+
 ## `v4.7`
 
 ```
diff --git a/authz/openfga/v4.8/components/lakekeeper_function.fga b/authz/openfga/v4.8/components/lakekeeper_function.fga
new file mode 100644
index 00000000..f9357af0
--- /dev/null
+++ b/authz/openfga/v4.8/components/lakekeeper_function.fga
@@ -0,0 +1,37 @@
+module lakekeeper-lakekeeper_function
+
+type lakekeeper_function
+  relations
+    # ------------------ Relation Hierarchies ------------------
+    define parent: [namespace]
+
+    # ------------------ Special roles ------------------
+    define ownership: [user, role#assignee]
+
+    # ------------------ Assignable Privileges ------------------
+    define pass_grants: [user, role#assignee]
+    define manage_grants: [user, role#assignee] or (ownership but not managed_access_inheritance from parent) or manage_grants from parent
+    define describe: [user, role#assignee] or ownership or select or describe from parent
+    define select: [user, role#assignee] or ownership or modify or select from parent
+    define modify: [user, role#assignee] or ownership or modify from parent
+    # Functions are executable: `execute` gates retrieving the routine body
+    # for execution (UC execution is client-side). `execute from parent` is
+    # not expressible (namespace has no `execute` relation), so execute
+    # inherits `select` from the parent namespace instead.
+    define execute: [user, role#assignee] or ownership or modify or select from parent
+
+    # ------------------ Actions ------------------
+    define can_drop: modify
+    define can_get_metadata: describe
+    define can_include_in_list: can_get_metadata
+    define can_execute: execute
+    define can_read_assignments: can_grant_pass_grants or can_grant_manage_grants or can_grant_describe or can_grant_select or can_grant_modify or can_grant_execute or can_change_ownership
+
+    # GRANT Permissions
+    define can_grant_pass_grants: manage_grants
+    define can_grant_manage_grants: manage_grants
+    define can_grant_describe: manage_grants or (describe and pass_grants)
+    define can_grant_select: manage_grants or (select and pass_grants)
+    define can_grant_modify: manage_grants or (modify and pass_grants)
+    define can_grant_execute: manage_grants or (execute and pass_grants)
+    define can_change_ownership: manage_grants
