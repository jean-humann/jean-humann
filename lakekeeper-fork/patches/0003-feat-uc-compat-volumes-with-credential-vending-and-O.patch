+//! UC temporary volume credentials: vends short-term storage credentials for
+//! a volume's location via `StorageProfile::generate_table_config`, exactly
+//! like `server/generic_tables/credentials.rs` (vended-credentials mode).
+
+use iceberg_ext::configs::{
+    ConfigProperty as _,
+    table::{gcs, s3},
+};
+
+use crate::{
+    api::{
+        ApiContext,
+        iceberg::v1::{DataAccess, DataAccessMode},
+        uc::{
+            UcErrorResponse, UcResult,
+            v1::{
+                AwsTempCredentials, AzureUserDelegationSas, GcpOauthToken,
+                GenerateTemporaryVolumeCredentialsRequest, TemporaryCredentials, VolumeOperation,
+            },
+        },
+    },
+    request_metadata::RequestMetadata,
+    server::{
+        maybe_get_secret,
+        uc::{resolve::uc_err, volumes},
+    },
+    service::{
+        CachePolicy, CatalogNamespaceOps, CatalogStore, CatalogVolumeOps, CatalogWarehouseOps,
+        LoadVolumeError, SecretStore, State, Transaction, VolumeId,
+        authz::{AuthZVolumeOps, Authorizer, CatalogVolumeAction},
+        storage::StoragePermissions,
+    },
+};
+
+/// ADLS SAS tokens are emitted per storage account under
+/// `adls.sas-token.<account>.<endpoint-suffix>` keys.
+const ADLS_SAS_TOKEN_PREFIX: &str = "adls.sas-token.";
+const ADLS_SAS_TOKEN_EXPIRY_PREFIX: &str = "adls.sas-token-expires-at-ms.";
+
+pub(crate) async fn generate_temporary_volume_credentials<
+    C: CatalogStore,
+    A: Authorizer + Clone,
+    S: SecretStore,
+>(
+    request: GenerateTemporaryVolumeCredentialsRequest,
+    state: ApiContext<State<A, C, S>>,
+    request_metadata: RequestMetadata,
+) -> UcResult<TemporaryCredentials> {
+    let GenerateTemporaryVolumeCredentialsRequest {
+        volume_id,
+        operation,
+    } = request;
+    let volume_id: VolumeId = VolumeId::from_str_or_bad_request(&volume_id).map_err(uc_err)?;
+
+    let storage_permissions = match operation {
+        VolumeOperation::ReadVolume => StoragePermissions::Read,
+        VolumeOperation::WriteVolume => StoragePermissions::ReadWriteDelete,
+        VolumeOperation::UnknownVolumeOperation => {
+            return Err(UcErrorResponse::invalid_argument(
+                "operation must be READ_VOLUME or WRITE_VOLUME.",
+            ));
+        }
+    };
+
+    // ------------------- LOAD (by id — the request carries no names) -------------------
+    let mut t = C::Transaction::begin_read(state.v1_state.catalog.clone())
+        .await
+        .map_err(uc_err)?;
+    let info = match C::load_volume_by_id(None, volume_id, t.transaction()).await {
+        Ok(info) => info,
+        Err(LoadVolumeError::VolumeNotFound(_)) => {
+            return Err(volumes::volume_not_found(volume_id));
+        }
+        Err(e) => return Err(uc_err(e)),
+    };
+    t.commit().await.map_err(uc_err)?;
+
+    let warehouse =
+        C::get_active_warehouse_by_id(info.warehouse_id, state.v1_state.catalog.clone())
+            .await
+            .map_err(uc_err)?
+            .ok_or_else(|| volumes::volume_not_found(volume_id))?;
+
+    let namespace = C::get_namespace_cache_aware(
+        info.warehouse_id,
+        info.namespace_id,
+        CachePolicy::RequireMinimumVersion(*info.namespace_version),
+        state.v1_state.catalog.clone(),
+    )
+    .await
+    .map_err(uc_err)?
+    .ok_or_else(|| volumes::volume_not_found(volume_id))?;
+
+    // ------------------- AUTHZ -------------------
+    // READ_VOLUME requires ReadData; WRITE_VOLUME requires ReadData AND
+    // WriteData (write credentials also allow reads). GetMetadata gating and
+    // 404-masking happen inside `require_volume_action`.
+    let authorizer = &state.v1_state.authz;
+    let info = authorizer
+        .require_volume_action(
+            &request_metadata,
+            &warehouse,
+            &namespace,
+            volume_id,
+            Ok::<_, crate::service::authz::RequireVolumeActionError>(Some(info)),
+            CatalogVolumeAction::ReadData,
+        )
+        .await
+        .map_err(volumes::require_authz_to_uc_err)?;
+    if operation == VolumeOperation::WriteVolume {
+        authorizer
+            .require_volume_action(
+                &request_metadata,
+                &warehouse,
+                &namespace,
+                volume_id,
+                Ok::<_, crate::service::authz::RequireVolumeActionError>(Some(info.clone())),
+                CatalogVolumeAction::WriteData,
+            )
+            .await
+            .map_err(volumes::require_authz_to_uc_err)?;
+    }
+
+    // ------------------- VEND -------------------
+    let storage_secret = maybe_get_secret(warehouse.storage_secret_id, &state.v1_state.secrets)
+        .await
+        .map_err(uc_err)?;
+
+    let table_config = warehouse
+        .storage_profile
+        .generate_table_config(
+            DataAccessMode::ServerDelegated(DataAccess {
+                vended_credentials: true,
+                remote_signing: false,
+            }),
+            storage_secret.as_deref(),
+            &info.location,
+            storage_permissions,
+            &request_metadata,
+            &info,
+        )
+        .await
+        .map_err(uc_err)?;
+
+    // The actual expiry of the vended credentials, when they expire (e.g.
+    // static S3 keys or the in-memory test profile vend non-expiring creds).
+    let expiration_time = table_config.credentials_expiration_ms;
+    let creds = table_config.creds.inner();
+
+    let mut response = TemporaryCredentials {
+        expiration_time,
+        ..TemporaryCredentials::default()
+    };
+
+    if let Some(access_key_id) = creds.get(s3::AccessKeyId::KEY) {
+        response.aws_temp_credentials = Some(AwsTempCredentials {
+            access_key_id: access_key_id.clone(),
+            secret_access_key: creds
+                .get(s3::SecretAccessKey::KEY)
+                .cloned()
+                .unwrap_or_default(),
+            session_token: creds
+                .get(s3::SessionToken::KEY)
+                .cloned()
+                .unwrap_or_default(),
+        });
+    } else if let Some((_, sas_token)) = creds.iter().find(|(k, _)| {
+        k.starts_with(ADLS_SAS_TOKEN_PREFIX) && !k.starts_with(ADLS_SAS_TOKEN_EXPIRY_PREFIX)
+    }) {
+        response.azure_user_delegation_sas = Some(AzureUserDelegationSas {
+            sas_token: sas_token.clone(),
+        });
+    } else if let Some(oauth_token) = creds.get(gcs::Token::KEY) {
+        response.gcp_oauth_token = Some(GcpOauthToken {
+            oauth_token: oauth_token.clone(),
+        });
+    }
+    // No credentials (e.g. the in-memory test profile): return an empty
+    // envelope — the storage is accessible without credentials.
+
+    Ok(response)
+}
