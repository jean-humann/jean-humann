+
+    #[sqlx::test]
+    async fn test_name_conflict(pool: PgPool) {
+        let (_state, pool, warehouse_id, namespace_id) = setup(pool).await;
+
+        let mut t = pool.begin().await.unwrap();
+        create_volume(test_creation(warehouse_id, namespace_id, "dup"), &mut t)
+            .await
+            .unwrap();
+        t.commit().await.unwrap();
+
+        // Distinct location so the name-uniqueness check is isolated from the
+        // location-collision check (which runs first). Case-insensitive.
+        let mut second = test_creation(warehouse_id, namespace_id, "DUP");
+        second.location = "s3://bucket/other/dup".parse().unwrap();
+
+        let mut t = pool.begin().await.unwrap();
+        let err = create_volume(second, &mut t)
+            .await
+            .expect_err("duplicate name should fail");
+        t.rollback().await.ok();
+
+        assert!(
+            matches!(err, CreateVolumeError::VolumeAlreadyExists(_)),
+            "expected AlreadyExists, got: {err:?}"
+        );
+    }
+
+    #[sqlx::test]
+    async fn test_location_overlap_conflict(pool: PgPool) {
+        let (_state, pool, warehouse_id, namespace_id) = setup(pool).await;
+
+        let mut t = pool.begin().await.unwrap();
