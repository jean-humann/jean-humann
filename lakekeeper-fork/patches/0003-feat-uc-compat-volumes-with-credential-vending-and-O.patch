+//! UC Volumes handlers. Volumes are dedicated entities (`uc_volume`) below a
+//! top-level namespace; authorization mirrors generic tables (can-see =
+//! `GetMetadata`, 404-masking, `IncludeInList` filtering on list).
+
+use std::{collections::HashMap, sync::Arc};
+
+use crate::{
+    api::{
+        ApiContext,
+        uc::{
+            UcErrorResponse, UcResult, effective_page_size, to_epoch_millis,
+            v1::{
+                self as uc_v1, CreateVolumeRequest, ListVolumesQuery, ListVolumesResponse,
+                UpdateVolumeRequest,
+            },
+        },
+    },
+    request_metadata::RequestMetadata,
+    server::{
+        tables::parse_location,
+        tabular::determine_namespace_location,
+        uc::resolve::{resolve_catalog_warehouse, resolve_schema_namespace, uc_err},
+    },
+    service::{
+        CachePolicy, CatalogNamespaceOps, CatalogStore, CatalogVolumeOps, LoadVolumeError,
+        NamespaceHierarchy, ResolvedWarehouse, SecretStore, State, Transaction, VolumeCreation,
+        VolumeId, VolumeIdentOrId, VolumeInfo, VolumeType,
+        authz::{
+            ActionOnVolume, AuthZVolumeOps, Authorizer, AuthzNamespaceOps, CatalogNamespaceAction,
+            CatalogVolumeAction, RequireVolumeActionError,
+        },
+        events::{AuthorizationFailureSource, context::authz_to_error_no_audit},
+    },
+};
+
+/// Subfolder of the namespace location under which MANAGED volume locations
+/// are derived: `<namespace-location>/__uc_volumes/<volume_id>`.
+const MANAGED_VOLUMES_FOLDER: &str = "__uc_volumes";
+
+pub(crate) fn volume_info_response(
+    catalog_name: &str,
+    schema_name: &str,
+    info: &VolumeInfo,
+) -> uc_v1::VolumeInfo {
+    uc_v1::VolumeInfo {
+        catalog_name: catalog_name.to_string(),
+        schema_name: schema_name.to_string(),
+        name: info.name.clone(),
+        full_name: format!("{catalog_name}.{schema_name}.{}", info.name),
+        volume_type: info.volume_type,
+        storage_location: info.location.to_string(),
+        volume_id: info.volume_id.to_string(),
+        comment: info.comment.clone(),
+        owner: None,
+        created_at: Some(to_epoch_millis(info.created_at)),
+        created_by: None,
+        updated_at: info.updated_at.map(to_epoch_millis),
+        updated_by: None,
+    }
+}
+
+/// Split a UC volume `full_name` (`<catalog>.<schema>.<volume>`).
+pub(crate) fn split_volume_full_name(full_name: &str) -> UcResult<(&str, &str, &str)> {
+    let parts: Vec<&str> = full_name.split('.').collect();
+    match parts.as_slice() {
+        [catalog, schema, volume]
+            if !catalog.is_empty() && !schema.is_empty() && !volume.is_empty() =>
+        {
+            Ok((catalog, schema, volume))
+        }
+        _ => Err(UcErrorResponse::invalid_argument(format!(
+            "Invalid volume full name '{full_name}'. Expected '<catalog>.<schema>.<volume>'."
+        ))),
+    }
+}
+
+pub(crate) fn volume_not_found(full_name: impl std::fmt::Display) -> UcErrorResponse {
+    UcErrorResponse::not_found(format!("Volume not found: {full_name}"))
+}
+
+pub(crate) fn require_authz_to_uc_err(e: RequireVolumeActionError) -> UcErrorResponse {
+    UcErrorResponse::from(e.into_error_model())
+}
+
+/// Guard to clean up authorizer state if volume creation fails after the
+/// authorizer tuples were written (they are not transactional with Postgres).
+struct VolumeCreationGuard<A: Authorizer> {
+    authorizer: A,
+    warehouse_id: crate::WarehouseId,
+    volume_id: VolumeId,
+    authorizer_created: bool,
+}
+
+impl<A: Authorizer> VolumeCreationGuard<A> {
+    fn new(authorizer: A, warehouse_id: crate::WarehouseId, volume_id: VolumeId) -> Self {
+        Self {
+            authorizer,
+            warehouse_id,
+            volume_id,
+            authorizer_created: false,
+        }
+    }
+
+    fn mark_authorizer_created(&mut self) {
+        self.authorizer_created = true;
+    }
+
+    fn success(&mut self) {
+        self.authorizer_created = false;
+    }
+
+    async fn cleanup(&mut self) {
+        if self.authorizer_created
+            && let Err(e) = self
+                .authorizer
+                .delete_volume(self.warehouse_id, self.volume_id)
+                .await
+        {
+            tracing::warn!(
+                "Failed to cleanup authorizer volume {} in warehouse {} after failed transaction: {e}",
+                self.volume_id,
+                self.warehouse_id
+            );
+        }
+    }
+}
+
+/// Load `volume_name` in the schema namespace and authorize `action` on it.
+/// Missing namespaces, missing volumes and non-visible volumes all surface as
+/// `NOT_FOUND` (existence masking).
+pub(crate) async fn load_and_authorize_volume<C: CatalogStore, A: Authorizer>(
+    authorizer: &A,
+    request_metadata: &RequestMetadata,
+    warehouse: &Arc<ResolvedWarehouse>,
+    schema_name: &str,
+    volume_name: &str,
+    action: CatalogVolumeAction,
+    catalog_state: C::State,
+) -> UcResult<(NamespaceHierarchy, VolumeInfo)> {
+    let warehouse_id = warehouse.warehouse_id;
+    let full_name = format!("{}.{schema_name}.{volume_name}", warehouse.name);
+    let namespace_ident = iceberg::NamespaceIdent::new(schema_name.to_string());
+
+    let namespace = C::get_namespace_cache_aware(
+        warehouse_id,
+        namespace_ident.clone(),
+        CachePolicy::Skip,
+        catalog_state.clone(),
+    )
+    .await
+    .map_err(uc_err)?
+    .ok_or_else(|| volume_not_found(&full_name))?;
+
+    let mut t = C::Transaction::begin_read(catalog_state)
+        .await
+        .map_err(uc_err)?;
+    let load_result: Result<Option<VolumeInfo>, RequireVolumeActionError> = match C::load_volume(
+        warehouse_id,
+        namespace.namespace.namespace_id(),
+        volume_name,
+        t.transaction(),
+    )
+    .await
+    {
+        Ok(info) => Ok(Some(info)),
+        Err(LoadVolumeError::VolumeNotFound(_)) => Ok(None),
+        Err(e) => return Err(uc_err(e)),
+    };
+    t.commit().await.map_err(uc_err)?;
+
+    let user_provided = VolumeIdentOrId::Ident(iceberg::TableIdent::new(
+        namespace_ident,
+        volume_name.to_string(),
+    ));
+    let info = authorizer
+        .require_volume_action(
+            request_metadata,
+            warehouse,
+            &namespace,
+            user_provided,
+            load_result,
+            action,
+        )
+        .await
+        .map_err(require_authz_to_uc_err)?;
+
+    Ok((namespace, info))
+}
+
+pub(crate) async fn create_volume<C: CatalogStore, A: Authorizer + Clone, S: SecretStore>(
+    request: CreateVolumeRequest,
+    state: ApiContext<State<A, C, S>>,
+    request_metadata: RequestMetadata,
+) -> UcResult<uc_v1::VolumeInfo> {
+    let CreateVolumeRequest {
+        catalog_name,
+        schema_name,
+        name,
+        volume_type,
+        storage_location,
+        comment,
+    } = request;
+
+    if name.is_empty() || name.contains('.') || name.contains('/') {
+        return Err(UcErrorResponse::invalid_argument(format!(
+            "Invalid volume name '{name}': volume names must be non-empty and must not contain '.' or '/'."
+        )));
+    }
+    match volume_type {
+        VolumeType::External if storage_location.is_none() => {
+            return Err(UcErrorResponse::invalid_argument(
+                "storage_location is required for EXTERNAL volumes.",
+            ));
+        }
+        VolumeType::Managed if storage_location.is_some() => {
+            return Err(UcErrorResponse::invalid_argument(
+                "storage_location must not be set for MANAGED volumes; the server derives it.",
+            ));
+        }
+        _ => {}
+    }
+
+    let warehouse = resolve_catalog_warehouse::<C>(
+        &request_metadata,
+        &catalog_name,
+        state.v1_state.catalog.clone(),
+    )
+    .await?;
+    let warehouse_id = warehouse.warehouse_id;
+    let volume_id = VolumeId::new_random();
+
+    // ------------------- AUTHZ: namespace-level CreateVolume -------------------
+    let (warehouse, ns_hierarchy) = resolve_schema_namespace::<C, A>(
+        &state.v1_state.authz,
+        &request_metadata,
+        warehouse_id,
+        &schema_name,
+        CatalogNamespaceAction::CreateVolume {
+            name: Some(name.clone()),
+            volume_id: Some(volume_id),
+            volume_type: Some(volume_type.as_str().to_string()),
+            location: storage_location.clone(),
+        },
+        state.v1_state.catalog.clone(),
+    )
+    .await?;
+
+    // ------------------- LOCATION -------------------
+    let mut location = match volume_type {
+        VolumeType::External => {
+            let location = parse_location(
+                storage_location.as_deref().unwrap_or_default(),
+                http::StatusCode::BAD_REQUEST,
+            )
+            .map_err(uc_err)?;
+            warehouse
+                .storage_profile
+                .require_allowed_location(&location)
+                .map_err(uc_err)?;
+            location
+        }
+        VolumeType::Managed => {
+            let mut location =
+                determine_namespace_location(&ns_hierarchy, &warehouse.storage_profile)
+                    .map_err(uc_err)?;
+            location
+                .push(MANAGED_VOLUMES_FOLDER)
+                .push(&volume_id.to_string());
+            location
+        }
+    };
+    location.without_trailing_slash();
+
+    // ------------------- CREATE (catalog + authorizer with guard) -------------------
+    let authorizer = state.v1_state.authz.clone();
+    let mut guard = VolumeCreationGuard::new(authorizer.clone(), warehouse_id, volume_id);
+
+    let creation = VolumeCreation {
+        volume_id,
+        namespace_id: ns_hierarchy.namespace.namespace_id(),
+        warehouse_id,
+        name,
+        volume_type,
+        location,
+        comment,
+    };
+
+    let result: UcResult<VolumeInfo> = async {
+        let mut t = C::Transaction::begin_write(state.v1_state.catalog.clone())
+            .await
+            .map_err(uc_err)?;
+        let info = C::create_volume(creation, t.transaction())
+            .await
+            .map_err(uc_err)?;
+
+        // Authorizer tuples are written between the catalog insert and the
+        // commit; the guard removes them again if the commit fails.
+        authorizer
+            .create_volume(
+                &request_metadata,
+                warehouse_id,
+                info.volume_id,
+                info.namespace_id,
+            )
+            .await
+            .map_err(uc_err)?;
+        guard.mark_authorizer_created();
+
+        t.commit().await.map_err(uc_err)?;
+        Ok(info)
+    }
+    .await;
+
+    match result {
+        Ok(info) => {
+            guard.success();
+            Ok(volume_info_response(&catalog_name, &schema_name, &info))
+        }
+        Err(e) => {
+            guard.cleanup().await;
+            Err(e)
+        }
+    }
+}
+
+pub(crate) async fn list_volumes<C: CatalogStore, A: Authorizer + Clone, S: SecretStore>(
+    query: ListVolumesQuery,
+    state: ApiContext<State<A, C, S>>,
+    request_metadata: RequestMetadata,
+) -> UcResult<ListVolumesResponse> {
+    let ListVolumesQuery {
+        catalog_name,
+        schema_name,
+        max_results,
+        page_token,
+        include_browse: _,
+    } = query;
+    let page_size = effective_page_size(max_results)?;
+
+    let warehouse = resolve_catalog_warehouse::<C>(
+        &request_metadata,
+        &catalog_name,
+        state.v1_state.catalog.clone(),
+    )
+    .await?;
+    let authorizer = &state.v1_state.authz;
+
+    // ------------------- AUTHZ: namespace-level ListVolumes -------------------
+    let (warehouse, ns) = resolve_schema_namespace::<C, A>(
+        authorizer,
+        &request_metadata,
+        warehouse.warehouse_id,
+        &schema_name,
+        CatalogNamespaceAction::ListVolumes,
+        state.v1_state.catalog.clone(),
+    )
+    .await?;
+    let warehouse_id = warehouse.warehouse_id;
+    let namespace_ident = iceberg::NamespaceIdent::new(schema_name.clone());
+
+    let mut t = C::Transaction::begin_read(state.v1_state.catalog)
+        .await
+        .map_err(uc_err)?;
+    let (entries, next_page_token) = C::list_volumes(
+        warehouse_id,
+        ns.namespace.namespace_id(),
+        &namespace_ident,
+        Some(page_size),
+        page_token.as_deref(),
+        t.transaction(),
+    )
+    .await
+    .map_err(uc_err)?;
+    t.commit().await.map_err(uc_err)?;
+
+    // ------------------- AUTHZ: per-entry IncludeInList filtering -------------------
+    let can_list_everything = authorizer
+        .is_allowed_namespace_action(
+            &request_metadata,
+            None,
+            &warehouse,
+            &ns.parents,
+            &ns.namespace,
+            CatalogNamespaceAction::ListEverything,
+        )
+        .await
+        .map_err(|e| uc_err(authz_to_error_no_audit(e)))?
+        .into_inner();
+
+    let masks = if can_list_everything {
+        vec![true; entries.len()]
+    } else {
+        let actions: Vec<_> = entries
+            .iter()
+            .map(|entry| {
+                (
+                    &ns.namespace,
+                    ActionOnVolume {
+                        info: entry,
+                        action: CatalogVolumeAction::IncludeInList,
+                        user: None,
+                    },
+                )
+            })
+            .collect();
+
+        let parents: HashMap<_, _> = ns
+            .parents
+            .iter()
+            .map(|n| (n.namespace_id(), n.clone()))
+            .collect();
+        authorizer
+            .are_allowed_volume_actions_vec(&request_metadata, &warehouse, &parents, &actions)
+            .await
+            .map_err(|e| uc_err(authz_to_error_no_audit(e)))?
+            .into_allowed()
+    };
+
+    let volumes = entries
+        .into_iter()
+        .zip(masks)
+        .filter(|(_, allowed)| *allowed)
+        .map(|(entry, _)| uc_v1::VolumeInfo {
+            catalog_name: catalog_name.clone(),
+            schema_name: schema_name.clone(),
+            full_name: format!("{catalog_name}.{schema_name}.{}", entry.name),
+            volume_type: entry.volume_type,
+            storage_location: entry.location.to_string(),
+            volume_id: entry.volume_id.to_string(),
+            comment: entry.comment,
+            owner: None,
+            created_at: Some(to_epoch_millis(entry.created_at)),
+            created_by: None,
+            updated_at: entry.updated_at.map(to_epoch_millis),
+            updated_by: None,
+            name: entry.name,
+        })
+        .collect();
+
+    Ok(ListVolumesResponse {
+        volumes,
+        next_page_token,
+    })
+}
+
+pub(crate) async fn get_volume<C: CatalogStore, A: Authorizer + Clone, S: SecretStore>(
+    full_name: String,
+    state: ApiContext<State<A, C, S>>,
+    request_metadata: RequestMetadata,
+) -> UcResult<uc_v1::VolumeInfo> {
+    let (catalog_name, schema_name, volume_name) = split_volume_full_name(&full_name)?;
+    let warehouse = resolve_catalog_warehouse::<C>(
+        &request_metadata,
+        catalog_name,
+        state.v1_state.catalog.clone(),
+    )
+    .await?;
+
+    let (_ns, info) = load_and_authorize_volume::<C, A>(
+        &state.v1_state.authz,
+        &request_metadata,
+        &warehouse,
+        schema_name,
+        volume_name,
+        CatalogVolumeAction::GetMetadata,
+        state.v1_state.catalog,
+    )
+    .await?;
+
+    Ok(volume_info_response(catalog_name, schema_name, &info))
+}
+
+pub(crate) async fn update_volume<C: CatalogStore, A: Authorizer + Clone, S: SecretStore>(
+    full_name: String,
+    request: UpdateVolumeRequest,
+    state: ApiContext<State<A, C, S>>,
+    request_metadata: RequestMetadata,
+) -> UcResult<uc_v1::VolumeInfo> {
+    let UpdateVolumeRequest { comment, new_name } = request;
+    if new_name.is_some() {
+        return Err(UcErrorResponse::invalid_argument(
+            "Renaming volumes is not supported by the Unity Catalog compatibility API.",
+        ));
+    }
+    let (catalog_name, schema_name, volume_name) = split_volume_full_name(&full_name)?;
+    let warehouse = resolve_catalog_warehouse::<C>(
+        &request_metadata,
+        catalog_name,
+        state.v1_state.catalog.clone(),
+    )
+    .await?;
+
+    let Some(comment) = comment else {
+        // Nothing to change; behave like a get (incl. authorization).
+        return get_volume::<C, A, S>(full_name, state, request_metadata).await;
+    };
+
+    // The v1 volume action set has no dedicated Update action; comment
+    // updates authorize `Drop`, the metadata-mutation privilege (FGA
+    // `modify`, same relation `can_write_data` derives from — but Drop is not
+    // a data-plane action, so instance admins retain it).
+    let (_ns, info) = load_and_authorize_volume::<C, A>(
+        &state.v1_state.authz,
+        &request_metadata,
+        &warehouse,
+        schema_name,
+        volume_name,
+        CatalogVolumeAction::Drop,
+        state.v1_state.catalog.clone(),
+    )
+    .await?;
+
+    let mut t = C::Transaction::begin_write(state.v1_state.catalog.clone())
+        .await
+        .map_err(uc_err)?;
+    // By-id (TOCTOU): the update must hit the row the authz check applied to,
+    // not whatever row currently carries the name.
+    C::update_volume_comment(
+        warehouse.warehouse_id,
+        info.volume_id,
+        Some(&comment),
+        t.transaction(),
+    )
+    .await
+    .map_err(uc_err)?;
+    let info = C::load_volume_by_id(
+        Some(warehouse.warehouse_id),
+        info.volume_id,
+        t.transaction(),
+    )
+    .await
+    .map_err(uc_err)?;
+    t.commit().await.map_err(uc_err)?;
+
+    Ok(volume_info_response(catalog_name, schema_name, &info))
+}
+
+pub(crate) async fn delete_volume<C: CatalogStore, A: Authorizer + Clone, S: SecretStore>(
+    full_name: String,
+    state: ApiContext<State<A, C, S>>,
+    request_metadata: RequestMetadata,
+) -> UcResult<()> {
+    let (catalog_name, schema_name, volume_name) = split_volume_full_name(&full_name)?;
+    let warehouse = resolve_catalog_warehouse::<C>(
+        &request_metadata,
+        catalog_name,
+        state.v1_state.catalog.clone(),
+    )
+    .await?;
+
+    let (ns, info) = load_and_authorize_volume::<C, A>(
+        &state.v1_state.authz,
+        &request_metadata,
+        &warehouse,
+        schema_name,
+        volume_name,
+        CatalogVolumeAction::Drop,
+        state.v1_state.catalog.clone(),
+    )
+    .await?;
+
+    let mut t = C::Transaction::begin_write(state.v1_state.catalog)
+        .await
+        .map_err(uc_err)?;
+    let dropped_id = C::drop_volume(
+        warehouse.warehouse_id,
+        ns.namespace.namespace_id(),
+        volume_name,
+        t.transaction(),
+    )
+    .await
+    .map_err(uc_err)?;
+    t.commit().await.map_err(uc_err)?;
+    debug_assert_eq!(dropped_id, info.volume_id);
+
+    // Best-effort authorizer cleanup after the commit (mirrors generic-table
+    // drop): a failure leaves orphaned tuples, not broken authorization.
+    if let Err(e) = state
+        .v1_state
+        .authz
+        .delete_volume(warehouse.warehouse_id, dropped_id)
+        .await
+    {
+        tracing::warn!(
+            "Failed to delete volume {dropped_id} in warehouse {} from authorizer: {e}",
+            warehouse.warehouse_id
+        );
+    }
+
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn test_split_volume_full_name() {
+        assert_eq!(
+            split_volume_full_name("cat.schema.vol").unwrap(),
+            ("cat", "schema", "vol")
+        );
+        for bad in [
+            "",
+            "cat",
+            "cat.schema",
+            "cat.schema.vol.extra",
+            "..",
+            "a..b",
+        ] {
+            let err = split_volume_full_name(bad).unwrap_err();
+            assert_eq!(err.status, 400, "{bad}");
+            assert_eq!(err.error_code, "INVALID_ARGUMENT", "{bad}");
+        }
+    }
+}
