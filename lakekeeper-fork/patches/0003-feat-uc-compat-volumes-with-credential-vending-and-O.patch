@@ -0,0 +1,433 @@
+//! Authorization for Unity Catalog volumes. Mirrors
+//! `service::authz::generic_table` (can-see = `GetMetadata`, 404-masking,
+//! data-plane exclusion from the instance-admin bypass).
+
+use std::collections::HashMap;
+
+use iceberg_ext::catalog::rest::ErrorModel;
+
+use crate::{
+    WarehouseId,
+    api::RequestMetadata,
+    service::{
+        AuthZVolumeInfo, CatalogBackendError, NamespaceHierarchy, NamespaceId, NamespaceWithParent,
+        ResolvedWarehouse, VolumeIdentOrId,
+        authz::{
+            AuthorizationBackendUnavailable, AuthorizationCountMismatch, AuthorizationDecision,
+            Authorizer, AuthzBadRequest, CannotInspectPermissions, CatalogAction,
+            CatalogVolumeAction, IsAllowedActionError, MustUse, UserOrRole,
+        },
+        events::{
+            AuthorizationFailureReason, AuthorizationFailureSource,
+            delegate_authorization_failure_source,
+        },
+    },
+};
+
+const CAN_SEE_PERMISSION: CatalogVolumeAction = CatalogVolumeAction::GetMetadata;
+
+pub trait VolumeAction
+where
+    Self: CatalogAction + Clone + PartialEq + Eq + From<CatalogVolumeAction>,
+{
+    /// Whether this action reads or writes volume file data (as opposed to
+    /// metadata or catalog operations). Used to exclude data-plane actions
+    /// from the instance-admin bypass.
+    fn is_data_plane(&self) -> bool;
+}
+
+impl VolumeAction for CatalogVolumeAction {
+    fn is_data_plane(&self) -> bool {
+        matches!(self, Self::ReadData | Self::WriteData)
+    }
+}
+
+// ------------------ Cannot See Error ------------------
+#[derive(Debug, PartialEq, Eq)]
+pub struct AuthZCannotSeeVolume {
+    warehouse_id: WarehouseId,
+    volume: VolumeIdentOrId,
+    internal_resource_not_found: bool,
+}
+
+impl AuthZCannotSeeVolume {
+    #[must_use]
+    pub fn new(
+        warehouse_id: WarehouseId,
+        volume: impl Into<VolumeIdentOrId>,
+        resource_not_found: bool,
+    ) -> Self {
+        Self {
+            warehouse_id,
+            volume: volume.into(),
+            internal_resource_not_found: resource_not_found,
+        }
+    }
+
+    #[must_use]
+    pub fn new_not_found(warehouse_id: WarehouseId, volume: impl Into<VolumeIdentOrId>) -> Self {
+        Self::new(warehouse_id, volume, true)
+    }
+
+    #[must_use]
+    pub fn new_forbidden(warehouse_id: WarehouseId, volume: impl Into<VolumeIdentOrId>) -> Self {
+        Self::new(warehouse_id, volume, false)
+    }
+}
+
+impl AuthorizationFailureSource for AuthZCannotSeeVolume {
+    fn into_error_model(self) -> ErrorModel {
+        let AuthZCannotSeeVolume {
+            warehouse_id,
+            volume,
+            internal_resource_not_found: _,
+        } = self;
+        // 404 for both not-found and cannot-see: hide existence.
+        ErrorModel::not_found(
+            format!("Volume {volume} not found in warehouse `{warehouse_id}`"),
+            "VolumeNotFound",
+            None,
+        )
+    }
+
+    fn to_failure_reason(&self) -> AuthorizationFailureReason {
+        if self.internal_resource_not_found {
+            AuthorizationFailureReason::ResourceNotFound
+        } else {
+            AuthorizationFailureReason::CannotSeeResource
+        }
+    }
+}
+
+// ------------------ Action Forbidden Error ------------------
+#[derive(Debug, PartialEq, Eq)]
+pub struct AuthZVolumeActionForbidden {
+    warehouse_id: WarehouseId,
+    volume: VolumeIdentOrId,
+    action: String,
+}
+
+impl AuthZVolumeActionForbidden {
+    #[must_use]
+    pub fn new(
+        warehouse_id: WarehouseId,
+        volume: impl Into<VolumeIdentOrId>,
+        action: &impl VolumeAction,
+    ) -> Self {
+        Self {
+            warehouse_id,
+            volume: volume.into(),
+            action: action.as_log_str(),
+        }
+    }
+}
+
+impl AuthorizationFailureSource for AuthZVolumeActionForbidden {
+    fn into_error_model(self) -> ErrorModel {
+        let AuthZVolumeActionForbidden {
+            warehouse_id,
+            volume,
+            action,
+        } = self;
+        ErrorModel::forbidden(
+            format!(
+                "Volume action `{action}` forbidden on volume {volume} in warehouse `{warehouse_id}`"
+            ),
+            "VolumeActionForbidden",
+            None,
+        )
+    }
+
+    fn to_failure_reason(&self) -> AuthorizationFailureReason {
+        AuthorizationFailureReason::ActionForbidden
+    }
+}
+
+#[derive(Debug, derive_more::From)]
+pub enum RequireVolumeActionError {
+    AuthZVolumeActionForbidden(AuthZVolumeActionForbidden),
+    AuthorizationBackendUnavailable(AuthorizationBackendUnavailable),
+    AuthorizationCountMismatch(AuthorizationCountMismatch),
+    CannotInspectPermissions(CannotInspectPermissions),
+    AuthorizerValidationFailed(AuthzBadRequest),
+    AuthZCannotSeeVolume(AuthZCannotSeeVolume),
+    CatalogBackendError(CatalogBackendError),
+}
+
+impl From<IsAllowedActionError> for RequireVolumeActionError {
+    fn from(err: IsAllowedActionError) -> Self {
+        match err {
+            IsAllowedActionError::AuthorizationBackendUnavailable(e) => e.into(),
+            IsAllowedActionError::CannotInspectPermissions(e) => e.into(),
+            IsAllowedActionError::BadRequest(e) => e.into(),
+            IsAllowedActionError::CountMismatch(e) => e.into(),
+        }
+    }
+}
+
+delegate_authorization_failure_source!(RequireVolumeActionError => {
+    AuthZVolumeActionForbidden,
+    AuthorizationBackendUnavailable,
+    AuthorizationCountMismatch,
+    CannotInspectPermissions,
+    AuthZCannotSeeVolume,
+    CatalogBackendError,
+    AuthorizerValidationFailed
+});
+
+/// An action on a volume with authorization context. Volumes are not part of
+/// DEFINER view chains, so there is no delegated-execution flag.
+pub struct ActionOnVolume<'a, 'u, I: AuthZVolumeInfo, A> {
+    pub info: &'a I,
+    pub action: A,
+    pub user: Option<&'u UserOrRole>,
+}
+
+impl<I: AuthZVolumeInfo, A: Clone> Clone for ActionOnVolume<'_, '_, I, A> {
+    fn clone(&self) -> Self {
+        Self {
+            info: self.info,
+            action: self.action.clone(),
+            user: self.user,
+        }
+    }
+}
+
+impl<I: AuthZVolumeInfo, A> std::fmt::Debug for ActionOnVolume<'_, '_, I, A> {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("ActionOnVolume")
+            .field("info", &format!("<{}>", std::any::type_name::<I>()))
+            .field("action", &std::any::type_name::<A>())
+            .field("user", &self.user)
+            .finish()
+    }
+}
+
+#[async_trait::async_trait]
+pub trait AuthZVolumeOps: Authorizer {
+    fn require_volume_presence<T: AuthZVolumeInfo>(
+        &self,
+        warehouse_id: WarehouseId,
+        user_provided: impl Into<VolumeIdentOrId> + Send,
+        result: Result<Option<T>, impl Into<RequireVolumeActionError> + Send>,
+    ) -> Result<T, RequireVolumeActionError> {
+        let info = result.map_err(Into::into)?;
+        let Some(info) = info else {
+            return Err(AuthZCannotSeeVolume::new_not_found(warehouse_id, user_provided).into());
+        };
+        Ok(info)
+    }
+
+    async fn require_volume_action<T: AuthZVolumeInfo>(
+        &self,
+        metadata: &RequestMetadata,
+        warehouse: &ResolvedWarehouse,
+        namespace: &NamespaceHierarchy,
+        user_provided: impl Into<VolumeIdentOrId> + Send,
+        result: Result<Option<T>, impl Into<RequireVolumeActionError> + Send>,
+        action: impl Into<Self::VolumeAction> + Send,
+    ) -> Result<T, RequireVolumeActionError> {
+        let warehouse_id = warehouse.warehouse_id;
+        let user_provided = user_provided.into();
+        let info = self.require_volume_presence(warehouse_id, user_provided.clone(), result)?;
+        let ident = info.volume_ident().clone();
+
+        let cant_see_err = AuthZCannotSeeVolume::new_forbidden(warehouse_id, user_provided).into();
+        let action = action.into();
+
+        if action == CAN_SEE_PERMISSION.into() {
+            let is_allowed = self
+                .is_allowed_volume_action(metadata, None, warehouse, namespace, &info, action)
+                .await?
+                .into_inner();
+            is_allowed.then_some(info).ok_or(cant_see_err)
+        } else {
+            let [can_see, is_allowed] = self
+                .are_allowed_volume_actions_arr(
+                    metadata,
+                    None,
+                    warehouse,
+                    namespace,
+                    &info,
+                    &[CAN_SEE_PERMISSION.into(), action.clone()],
+                )
+                .await?
+                .into_inner();
+            if can_see {
+                is_allowed.then_some(info).ok_or_else(|| {
+                    AuthZVolumeActionForbidden::new(warehouse_id, ident.clone(), &action).into()
+                })
+            } else {
+                Err(cant_see_err)
+            }
+        }
+    }
+
+    async fn is_allowed_volume_action(
+        &self,
+        metadata: &RequestMetadata,
+        for_user: Option<&UserOrRole>,
+        warehouse: &ResolvedWarehouse,
+        namespace: &NamespaceHierarchy,
+        info: &impl AuthZVolumeInfo,
+        action: impl Into<Self::VolumeAction> + Send,
+    ) -> Result<MustUse<bool>, IsAllowedActionError> {
+        let [decision] = self
+            .are_allowed_volume_actions_arr(
+                metadata,
+                for_user,
+                warehouse,
+                namespace,
+                info,
+                &[action.into()],
+            )
+            .await?
+            .into_inner();
+        Ok(decision.into())
+    }
+
+    async fn are_allowed_volume_actions_arr<
+        const N: usize,
+        A: VolumeAction + Into<Self::VolumeAction> + Send + Clone + Sync,
+    >(
+        &self,
+        metadata: &RequestMetadata,
+        for_user: Option<&UserOrRole>,
+        warehouse: &ResolvedWarehouse,
+        namespace_hierarchy: &NamespaceHierarchy,
+        info: &impl AuthZVolumeInfo,
+        actions: &[A; N],
+    ) -> Result<MustUse<[bool; N]>, IsAllowedActionError> {
+        let wrapped = actions
+            .iter()
+            .map(|a| {
+                (
+                    &namespace_hierarchy.namespace,
+                    ActionOnVolume {
+                        info,
+                        action: a.clone(),
+                        user: for_user,
+                    },
+                )
+            })
+            .collect::<Vec<_>>();
+        let result = self
+            .are_allowed_volume_actions_vec(
+                metadata,
+                warehouse,
+                &namespace_hierarchy
+                    .parents
+                    .iter()
+                    .map(|ns| (ns.namespace_id(), ns.clone()))
+                    .collect(),
+                &wrapped,
+            )
+            .await?
+            .into_allowed();
+        let n_returned = result.len();
+        let arr: [bool; N] = result
+            .try_into()
+            .map_err(|_| AuthorizationCountMismatch::new(N, n_returned, "volume"))?;
+        Ok(MustUse::from(arr))
+    }
+
+    async fn are_allowed_volume_actions_vec<
+        A: VolumeAction + Into<Self::VolumeAction> + Send + Clone + Sync,
+    >(
+        &self,
+        metadata: &RequestMetadata,
+        warehouse: &ResolvedWarehouse,
+        parent_namespaces: &HashMap<NamespaceId, NamespaceWithParent>,
+        actions: &[(
+            &NamespaceWithParent,
+            ActionOnVolume<'_, '_, impl AuthZVolumeInfo, A>,
+        )],
+    ) -> Result<MustUse<Vec<AuthorizationDecision>>, IsAllowedActionError> {
+        #[cfg(debug_assertions)]
+        {
+            let namespaces: Vec<&NamespaceWithParent> = actions.iter().map(|(ns, _)| *ns).collect();
+            super::table::validate_namespace_hierarchy(&namespaces, parent_namespaces);
+        }
+
+        let internal = metadata.is_lakekeeper_internal();
+
+        let mut auto_approved: Vec<Option<bool>> = Vec::with_capacity(actions.len());
+        let mut actions_to_check = Vec::new();
+
+        for (ns, action) in actions {
+            let same_warehouse = action.info.warehouse_id() == warehouse.warehouse_id;
+            if !same_warehouse {
+                tracing::warn!(
+                    "Volume warehouse_id `{}` does not match provided warehouse_id `{}`. Denying access.",
+                    action.info.warehouse_id(),
+                    warehouse.warehouse_id
+                );
+                auto_approved.push(Some(false));
+                continue;
+            }
+
+            // Normalize user: if it's the actor itself, treat as None (acting as self).
+            let normalized_user = if metadata.actor().to_user_or_role().as_ref() == action.user {
+                None
+            } else {
+                action.user
+            };
+
+            // `LakekeeperInternal` bypasses all actions including data-plane.
+            // Instance admins bypass only non-data-plane actions.
+            let bypass = metadata.bypasses_control_plane_authz(normalized_user)
+                && (internal || !action.action.is_data_plane());
+            if bypass {
+                auto_approved.push(Some(true));
+            } else {
+                auto_approved.push(None);
+                let mut normalized_action = action.clone();
+                normalized_action.user = normalized_user;
+                actions_to_check.push((*ns, normalized_action));
+            }
+        }
+
+        if actions_to_check.is_empty() {
+            Ok(auto_approved
+                .into_iter()
+                .map(|v| AuthorizationDecision::from(v.unwrap()))
+                .collect())
+        } else {
+            let decisions = self
+                .are_allowed_volume_actions_impl(
+                    metadata,
+                    warehouse,
+                    parent_namespaces,
+                    &actions_to_check,
+                )
+                .await?;
+
+            if decisions.len() != actions_to_check.len() {
+                return Err(AuthorizationCountMismatch::new(
+                    actions_to_check.len(),
+                    decisions.len(),
+                    "volume",
+                )
+                .into());
+            }
+
+            // Merge auto-approved decisions (warehouse-mismatch / bypass) with
+            // the authorizer's checked decisions.
+            let mut decision_iter = decisions.into_iter();
+            let final_decisions: Vec<AuthorizationDecision> = auto_approved
+                .into_iter()
+                .map(|auto| {
+                    auto.map_or_else(
+                        || decision_iter.next().unwrap(),
+                        AuthorizationDecision::from,
+                    )
+                })
+                .collect();
+
+            Ok(final_decisions)
+        }
+        .map(MustUse::from)
+    }
+}
+
+impl<T> AuthZVolumeOps for T where T: Authorizer {}
