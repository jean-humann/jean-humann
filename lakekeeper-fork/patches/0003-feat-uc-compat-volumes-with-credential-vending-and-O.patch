+//! Unity Catalog compatibility API (Phase B): Volumes + temporary volume
+//! credentials, driven through the `UcCatalogService` trait on
+//! `CatalogServer` (same harness as `server_uc_catalogs_schemas.rs`).
+
+use std::collections::HashMap;
+
+use lakekeeper::{
+    api::{
+        ApiContext,
+        uc::v1::{
+            CreateSchemaRequest, CreateVolumeRequest, GenerateTemporaryVolumeCredentialsRequest,
+            ListVolumesQuery, UcCatalogService as _, UpdateVolumeRequest, VolumeOperation,
+            VolumeType,
+        },
+    },
+    server::CatalogServer,
+    service::{
+        CatalogStore, CatalogWarehouseOps as _, State, Transaction as _,
+        authz::AllowAllAuthorizer,
+        storage::{MemoryProfile, StorageProfile},
+    },
+};
+use lakekeeper_integration_tests::{get_api_context, random_request_metadata};
+use lakekeeper_storage_postgres::{
+    PostgresBackend, SecretsState, warehouse::test::initialize_warehouse,
+};
+use sqlx::PgPool;
+
+type Ctx = ApiContext<State<AllowAllAuthorizer, PostgresBackend, SecretsState>>;
+
+const SCHEMA: &str = "vols_schema";
+
+/// Returns `(ctx, catalog_name, warehouse_base_location)` with the schema
+/// `SCHEMA` pre-created.
+async fn setup(pool: PgPool) -> (Ctx, String, String) {
+    lakekeeper_storage_postgres::migrations::migrate_core_only(&pool)
+        .await
+        .unwrap();
+    let api_context = get_api_context(&pool, AllowAllAuthorizer::default()).await;
+    let state = api_context.v1_state.catalog.clone();
+
+    let profile = StorageProfile::Memory(MemoryProfile::default());
+    let base_location = profile.base_location().unwrap().to_string();
+    let (_project_id, warehouse_id) =
+        initialize_warehouse(state.clone(), Some(profile), None, None, true).await;
+
+    // Unique warehouse name: the name→id cache is process-global while each
+    // `#[sqlx::test]` runs against its own database.
+    let catalog_name = format!("uc_wh_{}", uuid::Uuid::now_v7().simple());
+    let mut t = <PostgresBackend as CatalogStore>::Transaction::begin_write(state)
+        .await
+        .unwrap();
+    PostgresBackend::rename_warehouse(warehouse_id, &catalog_name, t.transaction())
+        .await
+        .unwrap();
+    t.commit().await.unwrap();
+
+    CatalogServer::create_schema(
+        CreateSchemaRequest {
+            name: SCHEMA.to_string(),
+            catalog_name: catalog_name.clone(),
+            comment: None,
+            properties: HashMap::new(),
+            storage_root: None,
+        },
+        api_context.clone(),
+        random_request_metadata(),
+    )
+    .await
+    .unwrap();
+
+    (api_context, catalog_name, base_location)
+}
+
+fn external_request(catalog: &str, name: &str, location: &str) -> CreateVolumeRequest {
+    CreateVolumeRequest {
+        catalog_name: catalog.to_string(),
+        schema_name: SCHEMA.to_string(),
+        name: name.to_string(),
+        volume_type: VolumeType::External,
+        storage_location: Some(location.to_string()),
+        comment: Some("an external volume".to_string()),
+    }
+}
+
+fn managed_request(catalog: &str, name: &str) -> CreateVolumeRequest {
+    CreateVolumeRequest {
+        catalog_name: catalog.to_string(),
+        schema_name: SCHEMA.to_string(),
+        name: name.to_string(),
+        volume_type: VolumeType::Managed,
+        storage_location: None,
+        comment: None,
+    }
+}
+
+#[sqlx::test]
+async fn test_create_external_volume_and_get(pool: PgPool) {
+    let (ctx, catalog, base) = setup(pool).await;
+    let location = format!("{base}/vols/ext1");
+
+    let created = CatalogServer::create_volume(
+        external_request(&catalog, "ext1", &location),
+        ctx.clone(),
+        random_request_metadata(),
+    )
+    .await
+    .unwrap();
+    assert_eq!(created.name, "ext1");
+    assert_eq!(created.catalog_name, catalog);
+    assert_eq!(created.schema_name, SCHEMA);
+    assert_eq!(created.full_name, format!("{catalog}.{SCHEMA}.ext1"));
+    assert_eq!(created.volume_type, VolumeType::External);
+    assert_eq!(created.storage_location, location);
+    assert_eq!(created.comment.as_deref(), Some("an external volume"));
+    assert!(created.created_at.is_some());
+    uuid::Uuid::parse_str(&created.volume_id).expect("volume_id must be a UUID");
+
+    let fetched = CatalogServer::get_volume(
+        created.full_name.clone(),
+        ctx.clone(),
+        random_request_metadata(),
+    )
+    .await
+    .unwrap();
+    assert_eq!(fetched, created);
+}
