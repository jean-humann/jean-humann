+#[sqlx::test]
+async fn test_list_volumes_with_pagination(pool: PgPool) {
+    let (ctx, catalog, base) = setup(pool).await;
+    for name in ["a", "b", "c"] {
+        CatalogServer::create_volume(
+            external_request(&catalog, name, &format!("{base}/vols/{name}")),
+            ctx.clone(),
+            random_request_metadata(),
+        )
+        .await
+        .unwrap();
+    }
+
+    let query = |max_results, page_token| ListVolumesQuery {
+        catalog_name: catalog.clone(),
+        schema_name: SCHEMA.to_string(),
+        max_results,
+        page_token,
+        include_browse: None,
+    };
+
+    let all =
+        CatalogServer::list_volumes(query(None, None), ctx.clone(), random_request_metadata())
+            .await
+            .unwrap();
+    assert_eq!(all.volumes.len(), 3);
+
+    let page1 =
+        CatalogServer::list_volumes(query(Some(2), None), ctx.clone(), random_request_metadata())
+            .await
+            .unwrap();
+    assert_eq!(page1.volumes.len(), 2);
+    let token = page1.next_page_token.expect("more pages");
+
+    let page2 = CatalogServer::list_volumes(
+        query(Some(2), Some(token)),
+        ctx.clone(),
+        random_request_metadata(),
+    )
+    .await
+    .unwrap();
+    assert_eq!(page2.volumes.len(), 1);
+
+    let names: Vec<_> = page1
+        .volumes
+        .iter()
+        .chain(page2.volumes.iter())
+        .map(|v| v.name.clone())
+        .collect();
+    assert_eq!(names, ["a", "b", "c"]);
+
+    // Negative max_results is INVALID_ARGUMENT.
+    let err = CatalogServer::list_volumes(query(Some(-1), None), ctx, random_request_metadata())
+        .await
+        .unwrap_err();
+    assert_eq!(err.status, 400);
+    assert_eq!(err.error_code, "INVALID_ARGUMENT");
+}
