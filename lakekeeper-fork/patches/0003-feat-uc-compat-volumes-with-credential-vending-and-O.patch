+//! UC temporary credentials endpoints. Phase B implements
+//! `POST /temporary-volume-credentials`; `POST /temporary-path-credentials`
+//! is not supported in v1 and answers `INVALID_ARGUMENT`.
+
+use axum::{Extension, Json, extract::State};
+use serde::{Deserialize, Serialize};
+
+use super::UcCatalogService;
+use crate::{
+    api::{
+        ApiContext,
+        uc::{UcErrorResponse, UcResult},
+    },
+    request_metadata::RequestMetadata,
+};
+
+/// UC `VolumeOperation`.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "SCREAMING_SNAKE_CASE")]
+pub enum VolumeOperation {
+    UnknownVolumeOperation,
+    ReadVolume,
+    WriteVolume,
+}
+
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct GenerateTemporaryVolumeCredentialsRequest {
+    /// The `volume_id` UUID from `VolumeInfo` (NOT the name).
+    pub volume_id: String,
+    pub operation: VolumeOperation,
+}
+
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct AwsTempCredentials {
+    pub access_key_id: String,
+    pub secret_access_key: String,
+    pub session_token: String,
+}
+
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct AzureUserDelegationSas {
+    pub sas_token: String,
+}
+
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct GcpOauthToken {
+    pub oauth_token: String,
+}
+
+/// UC `TemporaryCredentials` envelope: at most one of the cloud-specific
+/// members is present; `expiration_time` is top-level epoch milliseconds.
+#[derive(Debug, Clone, Default, PartialEq, Serialize, Deserialize)]
+pub struct TemporaryCredentials {
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub aws_temp_credentials: Option<AwsTempCredentials>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub azure_user_delegation_sas: Option<AzureUserDelegationSas>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub gcp_oauth_token: Option<GcpOauthToken>,
+    /// Epoch milliseconds.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub expiration_time: Option<i64>,
+}
+
+impl axum::response::IntoResponse for TemporaryCredentials {
+    fn into_response(self) -> axum::response::Response {
+        Json(self).into_response()
+    }
+}
+
+pub(crate) async fn generate_temporary_volume_credentials<
+    I: UcCatalogService<S>,
+    S: crate::api::ThreadSafe,
+>(
+    State(api_context): State<ApiContext<S>>,
+    Extension(metadata): Extension<RequestMetadata>,
+    Json(request): Json<GenerateTemporaryVolumeCredentialsRequest>,
+) -> UcResult<TemporaryCredentials> {
+    I::generate_temporary_volume_credentials(request, api_context, metadata).await
+}
+
+/// `temporary-path-credentials` is not part of the v1 compatibility surface.
+pub(crate) async fn generate_temporary_path_credentials_unsupported()
+-> UcResult<TemporaryCredentials> {
+    Err(UcErrorResponse::invalid_argument(
+        "temporary-path-credentials is not supported by the Unity Catalog compatibility API. \
+         Use temporary-volume-credentials with a volume_id instead.",
+    ))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn test_volume_operation_wire_format() {
+        assert_eq!(
+            serde_json::from_str::<VolumeOperation>("\"READ_VOLUME\"").unwrap(),
+            VolumeOperation::ReadVolume
+        );
+        assert_eq!(
+            serde_json::from_str::<VolumeOperation>("\"WRITE_VOLUME\"").unwrap(),
+            VolumeOperation::WriteVolume
+        );
+        assert_eq!(
+            serde_json::from_str::<VolumeOperation>("\"UNKNOWN_VOLUME_OPERATION\"").unwrap(),
+            VolumeOperation::UnknownVolumeOperation
+        );
+    }
+
+    #[test]
+    fn test_temporary_credentials_serialization() {
+        let creds = TemporaryCredentials {
+            aws_temp_credentials: Some(AwsTempCredentials {
+                access_key_id: "AKIA".to_string(),
+                secret_access_key: "SECRET".to_string(),
+                session_token: "TOKEN".to_string(),
+            }),
+            azure_user_delegation_sas: None,
+            gcp_oauth_token: None,
+            expiration_time: Some(1_727_000_000_000),
+        };
+        let json = serde_json::to_value(&creds).unwrap();
+        assert_eq!(
+            json,
+            serde_json::json!({
+                "aws_temp_credentials": {
+                    "access_key_id": "AKIA",
+                    "secret_access_key": "SECRET",
+                    "session_token": "TOKEN"
+                },
+                "expiration_time": 1_727_000_000_000_i64
+            })
+        );
+
+        // Empty envelope serializes to `{}` (e.g. memory profile — no creds).
+        assert_eq!(
+            serde_json::to_string(&TemporaryCredentials::default()).unwrap(),
+            "{}"
+        );
+    }
+}
