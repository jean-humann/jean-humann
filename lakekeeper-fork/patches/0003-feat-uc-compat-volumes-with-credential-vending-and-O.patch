@@ -0,0 +1,50 @@
+-- Unity Catalog compatibility: volumes.
+--
+-- Volumes are a dedicated entity (no `tabular` piggyback): no `tabular_type` /
+-- `entity_type` enum surgery, no task-queue integration. UC DELETE is a hard
+-- delete in v1; `deleted_at` is reserved for future soft-delete support.
+-- No `api_endpoints` / `idempotency_record` changes: the UC router is mounted
+-- outside the endpoint-statistics middleware and does not use idempotency
+-- records (design D7).
+
+CREATE TYPE uc_volume_type AS ENUM ('external', 'managed');
+
+CREATE TABLE uc_volume (
+    warehouse_id UUID NOT NULL,
+    volume_id    UUID NOT NULL,
+    namespace_id UUID NOT NULL,
+    name         TEXT COLLATE "case_insensitive" NOT NULL,
+    volume_type  uc_volume_type NOT NULL,
+    -- Full location incl. scheme (e.g. s3://bucket/path) ...
+    location     TEXT NOT NULL,
+    -- ... and its authority+path part, for overlap checks against `tabular`.
+    fs_location  TEXT NOT NULL,
+    comment      TEXT,
+    created_at   TIMESTAMPTZ NOT NULL DEFAULT now(),
+    updated_at   TIMESTAMPTZ,
+    deleted_at   TIMESTAMPTZ,
+    version      BIGINT NOT NULL DEFAULT 0,
+    PRIMARY KEY (warehouse_id, volume_id),
+    -- `unique_namespace_id_per_warehouse` on namespace backs this FK.
+    FOREIGN KEY (warehouse_id, namespace_id)
+        REFERENCES namespace (warehouse_id, namespace_id) ON DELETE CASCADE
+);
+
+SELECT trigger_updated_at_and_version_if_distinct('"uc_volume"');
+
+-- Case-insensitive name uniqueness per namespace (name column uses the
+-- `case_insensitive` collation, mirroring tabular's
+-- `unique_name_per_namespace_id`), scoped to live rows.
+CREATE UNIQUE INDEX uc_volume_unique_name_per_namespace_idx
+    ON uc_volume (warehouse_id, namespace_id, name)
+    WHERE deleted_at IS NULL;
+
+-- Supports the location-overlap check (equal/parent/child fs_location
+-- conflicts), mirroring `tabular_warehouse_id_location_idx`.
+CREATE INDEX uc_volume_warehouse_id_location_idx
+    ON uc_volume USING btree (warehouse_id, fs_location);
+
+-- Keyset pagination (created_at, volume_id).
+CREATE INDEX uc_volume_created_at_volume_id_idx
+    ON uc_volume (warehouse_id, namespace_id, created_at, volume_id)
+    WHERE deleted_at IS NULL;
