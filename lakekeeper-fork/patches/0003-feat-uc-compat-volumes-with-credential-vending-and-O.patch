+    ManageGrants(UserOrRole),
+    #[cfg_attr(feature = "open-api", schema(title = "VolumeAssignmentDescribe"))]
+    Describe(UserOrRole),
+    #[cfg_attr(feature = "open-api", schema(title = "VolumeAssignmentSelect"))]
+    Select(UserOrRole),
+    #[cfg_attr(feature = "open-api", schema(title = "VolumeAssignmentModify"))]
+    Modify(UserOrRole),
+}
+
+impl GrantableRelation for APIVolumeRelation {
+    fn grant_relation(&self) -> VolumeRelation {
+        match self {
+            APIVolumeRelation::Ownership => VolumeRelation::CanChangeOwnership,
+            APIVolumeRelation::PassGrants => VolumeRelation::CanGrantPassGrants,
+            APIVolumeRelation::ManageGrants => VolumeRelation::CanGrantManageGrants,
+            APIVolumeRelation::Describe => VolumeRelation::CanGrantDescribe,
+            APIVolumeRelation::Select => VolumeRelation::CanGrantSelect,
+            APIVolumeRelation::Modify => VolumeRelation::CanGrantModify,
+        }
+    }
+}
+
+impl Assignment for VolumeAssignment {
+    type Relation = APIVolumeRelation;
+
+    fn try_from_user(
+        user: &str,
+        relation: &Self::Relation,
+    ) -> Result<Self, ParseOpenFgaEntityError> {
+        match relation {
+            APIVolumeRelation::Ownership => {
+                UserOrRole::parse_from_openfga(user).map(VolumeAssignment::Ownership)
+            }
+            APIVolumeRelation::PassGrants => {
+                UserOrRole::parse_from_openfga(user).map(VolumeAssignment::PassGrants)
+            }
+            APIVolumeRelation::ManageGrants => {
+                UserOrRole::parse_from_openfga(user).map(VolumeAssignment::ManageGrants)
+            }
+            APIVolumeRelation::Describe => {
+                UserOrRole::parse_from_openfga(user).map(VolumeAssignment::Describe)
+            }
+            APIVolumeRelation::Select => {
+                UserOrRole::parse_from_openfga(user).map(VolumeAssignment::Select)
+            }
+            APIVolumeRelation::Modify => {
+                UserOrRole::parse_from_openfga(user).map(VolumeAssignment::Modify)
+            }
+        }
+    }
+
+    fn openfga_user(&self) -> String {
+        match self {
+            VolumeAssignment::Ownership(user)
+            | VolumeAssignment::PassGrants(user)
+            | VolumeAssignment::ManageGrants(user)
+            | VolumeAssignment::Describe(user)
+            | VolumeAssignment::Select(user)
+            | VolumeAssignment::Modify(user) => user.to_openfga(),
+        }
+    }
+
+    fn relation(&self) -> Self::Relation {
+        match self {
+            VolumeAssignment::Ownership(_) => APIVolumeRelation::Ownership,
+            VolumeAssignment::PassGrants(_) => APIVolumeRelation::PassGrants,
+            VolumeAssignment::ManageGrants(_) => APIVolumeRelation::ManageGrants,
+            VolumeAssignment::Describe(_) => APIVolumeRelation::Describe,
+            VolumeAssignment::Select(_) => APIVolumeRelation::Select,
+            VolumeAssignment::Modify(_) => APIVolumeRelation::Modify,
+        }
+    }
+}
+
+#[derive(Copy, Debug, Clone, Eq, PartialEq, Serialize, Deserialize, EnumIter)]
+#[cfg_attr(feature = "open-api", derive(utoipa::ToSchema))]
+#[serde(rename_all = "snake_case")]
+pub(super) enum OpenFGAVolumeAction {
+    ReadAssignments,
+    GrantPassGrants,
+    GrantManageGrants,
+    GrantDescribe,
+    GrantSelect,
+    GrantModify,
+    ChangeOwnership,
+}
+
+impl ReducedRelation for APIVolumeRelation {
+    type OpenFgaRelation = VolumeRelation;
+
+    fn to_openfga(&self) -> Self::OpenFgaRelation {
+        match self {
+            APIVolumeRelation::Ownership => VolumeRelation::Ownership,
+            APIVolumeRelation::PassGrants => VolumeRelation::PassGrants,
+            APIVolumeRelation::ManageGrants => VolumeRelation::ManageGrants,
+            APIVolumeRelation::Describe => VolumeRelation::Describe,
+            APIVolumeRelation::Select => VolumeRelation::Select,
+            APIVolumeRelation::Modify => VolumeRelation::Modify,
+        }
+    }
+}
+
+impl ReducedRelation for OpenFGAVolumeAction {
+    type OpenFgaRelation = VolumeRelation;
+
+    fn to_openfga(&self) -> Self::OpenFgaRelation {
+        match self {
+            OpenFGAVolumeAction::ReadAssignments => VolumeRelation::CanReadAssignments,
+            OpenFGAVolumeAction::GrantPassGrants => VolumeRelation::CanGrantPassGrants,
+            OpenFGAVolumeAction::GrantManageGrants => VolumeRelation::CanGrantManageGrants,
+            OpenFGAVolumeAction::GrantDescribe => VolumeRelation::CanGrantDescribe,
+            OpenFGAVolumeAction::GrantSelect => VolumeRelation::CanGrantSelect,
+            OpenFGAVolumeAction::GrantModify => VolumeRelation::CanGrantModify,
+            OpenFGAVolumeAction::ChangeOwnership => VolumeRelation::CanChangeOwnership,
+        }
+    }
+}
