--- /dev/null
+++ b/crates/lakekeeper/src/service/catalog_store/volume.rs
@@ -0,0 +1,399 @@
+//! Unity Catalog volumes: dedicated catalog-store entity (design D1 — no
+//! tabular piggyback). Volumes live in the `uc_volume` table, are hard-deleted
+//! in v1 (`deleted_at` column reserved) and are never protected.
+
+use std::fmt;
+
+use http::StatusCode;
+use iceberg::{NamespaceIdent, TableIdent};
+use iceberg_ext::catalog::rest::ErrorModel;
+use lakekeeper_io::Location;
+use serde::{Deserialize, Serialize};
+
+use super::{
+    BasicTabularInfo, CatalogStore, Transaction, define_simple_error, define_transparent_error,
+    impl_error_stack_methods, impl_from_with_detail,
+};
+use crate::{
+    WarehouseId,
+    service::{
+        CatalogBackendError, GenericTableId, InternalParseLocationError,
+        InvalidNamespaceIdentifier, LocationAlreadyTaken, NamespaceId, NamespaceVersion, TabularId,
+        VolumeId, WarehouseVersion,
+    },
+};
+
+/// Unity Catalog volume type. UC wire values are `EXTERNAL` / `MANAGED`.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, Serialize, Deserialize)]
+#[serde(rename_all = "SCREAMING_SNAKE_CASE")]
+pub enum VolumeType {
+    External,
+    Managed,
+}
+
+impl VolumeType {
+    #[must_use]
+    pub fn as_str(&self) -> &'static str {
+        match self {
+            VolumeType::External => "EXTERNAL",
+            VolumeType::Managed => "MANAGED",
+        }
+    }
+}
+
+impl fmt::Display for VolumeType {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str(self.as_str())
+    }
+}
+
+#[derive(Debug, Clone, thiserror::Error, PartialEq, Eq)]
+#[error("volume type must be EXTERNAL or MANAGED")]
+pub struct ParseVolumeTypeError;
+
+impl std::str::FromStr for VolumeType {
+    type Err = ParseVolumeTypeError;
+
+    fn from_str(s: &str) -> Result<Self, Self::Err> {
+        match s {
+            "EXTERNAL" | "external" => Ok(VolumeType::External),
+            "MANAGED" | "managed" => Ok(VolumeType::Managed),
+            _ => Err(ParseVolumeTypeError),
+        }
+    }
+}
+
+/// Volume addressed either by `<namespace>.<name>` identifier or by id.
+/// Used in authorization errors (mirrors `GenericTableIdentOrId`, but volumes
+/// are not tabulars, so there is no `TabularIdentOrId` conversion).
+#[derive(Hash, Debug, Clone, PartialEq, Eq, derive_more::From)]
+pub enum VolumeIdentOrId {
+    Ident(TableIdent),
+    Id(VolumeId),
+}
+
+impl fmt::Display for VolumeIdentOrId {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            VolumeIdentOrId::Ident(ident) => write!(f, "'{ident}'"),
+            VolumeIdentOrId::Id(id) => write!(f, "ID '{id}'"),
+        }
+    }
+}
+
+/// The volume fields authorization code needs. Mirrors
+/// `AuthZGenericTableInfo`; implemented by [`VolumeInfo`] and
+/// [`VolumeListEntry`].
+pub trait AuthZVolumeInfo: Send + Sync {
+    fn warehouse_id(&self) -> WarehouseId;
+    fn volume_ident(&self) -> &TableIdent;
+    fn volume_id(&self) -> VolumeId;
+    fn namespace_id(&self) -> NamespaceId;
+    fn namespace_ident(&self) -> &NamespaceIdent {
+        self.volume_ident().namespace()
+    }
+}
+
+#[derive(Debug, Clone)]
+pub struct VolumeInfo {
+    pub volume_id: VolumeId,
+    pub warehouse_id: WarehouseId,
+    pub warehouse_version: WarehouseVersion,
+    pub namespace_id: NamespaceId,
+    pub namespace_version: NamespaceVersion,
+    pub namespace_ident: NamespaceIdent,
+    pub name: String,
+    /// `<namespace>.<name>` identifier (UC volumes live in single-level
+    /// namespaces; `TableIdent` is reused as a generic two-part identifier).
+    pub volume_ident: TableIdent,
+    pub volume_type: VolumeType,
+    pub location: Location,
+    pub comment: Option<String>,
+    pub created_at: chrono::DateTime<chrono::Utc>,
+    pub updated_at: Option<chrono::DateTime<chrono::Utc>>,
+    /// Volumes have no protection support in v1; always `false`.
+    pub protected: bool,
+}
+
+impl AuthZVolumeInfo for VolumeInfo {
+    fn warehouse_id(&self) -> WarehouseId {
+        self.warehouse_id
+    }
+
+    fn volume_ident(&self) -> &TableIdent {
+        &self.volume_ident
+    }
+
+    fn volume_id(&self) -> VolumeId {
+        self.volume_id
+    }
+
+    fn namespace_id(&self) -> NamespaceId {
+        self.namespace_id
+    }
+}
+
+/// Credential vending (`StorageProfile::generate_table_config`) is
+/// entity-agnostic but keyed on [`BasicTabularInfo`]. Volumes are not
+/// tabulars and `TabularId` must not grow a `Volume` variant (v1), so the
+/// volume id is wrapped as a `GenericTable` tabular id: it is only used as an
+/// opaque unique cache key for short-term credentials and for the
+/// `is_table()` check (correctly `false` — no remote-signing config for
+/// volumes). Volume ids are random UUIDv7, so they cannot collide with real
+/// generic-table ids.
+impl BasicTabularInfo for VolumeInfo {
+    fn warehouse_id(&self) -> WarehouseId {
+        self.warehouse_id
+    }
+
+    fn warehouse_version(&self) -> WarehouseVersion {
+        self.warehouse_version
+    }
+
+    fn tabular_ident(&self) -> &TableIdent {
+        &self.volume_ident
+    }
+
+    fn tabular_id(&self) -> TabularId {
+        TabularId::GenericTable(GenericTableId::new(*self.volume_id))
+    }
+
+    fn namespace_id(&self) -> NamespaceId {
+        self.namespace_id
+    }
+
+    fn namespace_version(&self) -> NamespaceVersion {
+        self.namespace_version
+    }
+}
+
+#[derive(Debug, Clone)]
+pub struct VolumeCreation {
+    pub volume_id: VolumeId,
+    pub namespace_id: NamespaceId,
+    pub warehouse_id: WarehouseId,
+    pub name: String,
+    pub volume_type: VolumeType,
+    pub location: Location,
+    pub comment: Option<String>,
+}
+
+#[derive(Debug, Clone)]
+pub struct VolumeListEntry {
+    pub volume_id: VolumeId,
+    pub warehouse_id: WarehouseId,
+    pub namespace_id: NamespaceId,
+    pub name: String,
+    pub volume_ident: TableIdent,
+    pub namespace_ident: NamespaceIdent,
+    pub volume_type: VolumeType,
+    pub location: Location,
+    pub comment: Option<String>,
+    pub created_at: chrono::DateTime<chrono::Utc>,
+    pub updated_at: Option<chrono::DateTime<chrono::Utc>>,
+}
+
+impl AuthZVolumeInfo for VolumeListEntry {
+    fn warehouse_id(&self) -> WarehouseId {
+        self.warehouse_id
+    }
+
+    fn volume_ident(&self) -> &TableIdent {
+        &self.volume_ident
+    }
+
+    fn volume_id(&self) -> VolumeId {
+        self.volume_id
+    }
+
+    fn namespace_id(&self) -> NamespaceId {
+        self.namespace_id
+    }
+}
+
+define_simple_error!(VolumeAlreadyExists, "Volume already exists");
+impl From<VolumeAlreadyExists> for ErrorModel {
+    fn from(err: VolumeAlreadyExists) -> Self {
+        ErrorModel::builder()
+            .message(err.to_string())
+            .r#type("VolumeAlreadyExists")
+            .code(StatusCode::CONFLICT.as_u16())
+            .stack(err.stack)
+            .build()
+    }
+}
+
+define_simple_error!(VolumeNotFound, "Volume not found");
+impl From<VolumeNotFound> for ErrorModel {
+    fn from(err: VolumeNotFound) -> Self {
+        ErrorModel::builder()
+            .message(err.to_string())
+            .r#type("VolumeNotFound")
+            .code(StatusCode::NOT_FOUND.as_u16())
+            .stack(err.stack)
+            .build()
+    }
+}
+
+define_transparent_error! {
+    pub enum CreateVolumeError,
+    stack_message: "Error creating volume",
+    variants: [
+        VolumeAlreadyExists,
+        CatalogBackendError,
+        InternalParseLocationError,
+        LocationAlreadyTaken,
+        InvalidNamespaceIdentifier,
+    ]
+}
+
+define_transparent_error! {
+    pub enum LoadVolumeError,
+    stack_message: "Error loading volume",
+    variants: [
+        VolumeNotFound,
+        CatalogBackendError,
+        InternalParseLocationError,
+        InvalidNamespaceIdentifier,
+    ]
+}
+
+define_transparent_error! {
+    pub enum ListVolumesError,
+    stack_message: "Error listing volumes",
+    variants: [
+        CatalogBackendError,
+        InternalParseLocationError,
+    ]
+}
+
+define_transparent_error! {
+    pub enum UpdateVolumeError,
+    stack_message: "Error updating volume",
+    variants: [
+        VolumeNotFound,
+        CatalogBackendError,
+    ]
+}
+
+define_transparent_error! {
+    pub enum DropVolumeError,
+    stack_message: "Error dropping volume",
+    variants: [
+        VolumeNotFound,
+        CatalogBackendError,
+    ]
+}
+
+#[async_trait::async_trait]
+pub trait CatalogVolumeOps
+where
+    Self: CatalogStore,
+{
+    async fn create_volume<'a>(
+        creation: VolumeCreation,
+        transaction: <Self::Transaction as Transaction<Self::State>>::Transaction<'a>,
+    ) -> std::result::Result<VolumeInfo, CreateVolumeError> {
+        Self::create_volume_impl(creation, transaction).await
+    }
+
+    async fn load_volume<'a>(
+        warehouse_id: WarehouseId,
+        namespace_id: NamespaceId,
+        volume_name: &str,
+        transaction: <Self::Transaction as Transaction<Self::State>>::Transaction<'a>,
+    ) -> std::result::Result<VolumeInfo, LoadVolumeError> {
+        Self::load_volume_impl(warehouse_id, namespace_id, volume_name, transaction).await
+    }
+
+    /// Load a volume by its stable id. Prefer this over [`Self::load_volume`]
+    /// after a successful authz check (TOCTOU: rename/create races cannot
+    /// substitute a different row). `warehouse_id: None` looks the volume up
+    /// across warehouses — required by the UC temporary-volume-credentials
+    /// endpoint, whose request carries only the `volume_id`.
+    async fn load_volume_by_id<'a>(
+        warehouse_id: Option<WarehouseId>,
+        volume_id: VolumeId,
+        transaction: <Self::Transaction as Transaction<Self::State>>::Transaction<'a>,
+    ) -> std::result::Result<VolumeInfo, LoadVolumeError> {
+        Self::load_volume_by_id_impl(warehouse_id, volume_id, transaction).await
+    }
+
+    async fn list_volumes<'a>(
+        warehouse_id: WarehouseId,
+        namespace_id: NamespaceId,
+        namespace_ident: &iceberg::NamespaceIdent,
+        page_size: Option<i64>,
+        page_token: Option<&str>,
+        transaction: <Self::Transaction as Transaction<Self::State>>::Transaction<'a>,
+    ) -> std::result::Result<(Vec<VolumeListEntry>, Option<String>), ListVolumesError> {
+        Self::list_volumes_impl(
+            warehouse_id,
+            namespace_id,
+            namespace_ident,
+            page_size,
+            page_token,
+            transaction,
+        )
+        .await
+    }
+
+    /// Set (or clear) the volume comment. The only supported volume update in
+    /// v1 (UC `PATCH /volumes` supports `comment` and `new_name`; renames are
+    /// rejected at the API layer).
+    async fn update_volume_comment<'a>(
+        warehouse_id: WarehouseId,
+        volume_id: VolumeId,
+        comment: Option<&str>,
+        transaction: <Self::Transaction as Transaction<Self::State>>::Transaction<'a>,
+    ) -> std::result::Result<(), UpdateVolumeError> {
+        Self::update_volume_comment_impl(warehouse_id, volume_id, comment, transaction).await
+    }
+
+    /// Hard-delete a volume (UC DELETE semantics; no soft delete in v1).
+    async fn drop_volume<'a>(
+        warehouse_id: WarehouseId,
+        namespace_id: NamespaceId,
+        volume_name: &str,
+        transaction: <Self::Transaction as Transaction<Self::State>>::Transaction<'a>,
+    ) -> std::result::Result<VolumeId, DropVolumeError> {
+        Self::drop_volume_impl(warehouse_id, namespace_id, volume_name, transaction).await
+    }
+}
+
+impl<T> CatalogVolumeOps for T where T: CatalogStore {}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn test_volume_type_serde_is_uc_wire_format() {
+        assert_eq!(
+            serde_json::to_string(&VolumeType::External).unwrap(),
+            "\"EXTERNAL\""
+        );
+        assert_eq!(
+            serde_json::to_string(&VolumeType::Managed).unwrap(),
+            "\"MANAGED\""
+        );
+        assert_eq!(
+            serde_json::from_str::<VolumeType>("\"EXTERNAL\"").unwrap(),
+            VolumeType::External
+        );
+        assert!(serde_json::from_str::<VolumeType>("\"external\"").is_err());
+    }
+
+    #[test]
+    fn test_volume_type_from_str() {
+        assert_eq!(
+            "EXTERNAL".parse::<VolumeType>().unwrap(),
+            VolumeType::External
+        );
+        assert_eq!(
+            "managed".parse::<VolumeType>().unwrap(),
+            VolumeType::Managed
+        );
+        assert!("SOMETHING".parse::<VolumeType>().is_err());
+    }
+}
