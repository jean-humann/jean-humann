+
+    // Malformed volume id is INVALID_ARGUMENT (400).
+    let err = CatalogServer::generate_temporary_volume_credentials(
+        GenerateTemporaryVolumeCredentialsRequest {
+            volume_id: "not-a-uuid".to_string(),
+            operation: VolumeOperation::ReadVolume,
+        },
+        ctx,
+        random_request_metadata(),
+    )
+    .await
+    .unwrap_err();
+    assert_eq!(err.status, 400);
+    assert_eq!(err.error_code, "INVALID_ARGUMENT");
+}
