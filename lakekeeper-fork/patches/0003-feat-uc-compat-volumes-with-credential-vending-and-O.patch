+        assert_eq!(info.comment, Some("test volume".to_string()));
+        assert_eq!(info.location.as_str(), "s3://bucket/volumes/test-vol");
+        assert!(!info.protected);
+
+        // Load by name
+        let mut t = pool.begin().await.unwrap();
+        let loaded = load_volume(warehouse_id, namespace_id, "test-vol", &mut t)
+            .await
+            .unwrap();
+        t.commit().await.unwrap();
+        assert_eq!(loaded.volume_id, info.volume_id);
+        assert_eq!(loaded.name, "test-vol");
+
+        // Load by id, with and without warehouse scope
+        let mut t = pool.begin().await.unwrap();
+        let by_id = load_volume_by_id(Some(warehouse_id), info.volume_id, &mut t)
+            .await
+            .unwrap();
+        let by_id_global = load_volume_by_id(None, info.volume_id, &mut t)
+            .await
+            .unwrap();
+        t.commit().await.unwrap();
+        assert_eq!(by_id.volume_id, info.volume_id);
+        assert_eq!(by_id_global.warehouse_id, warehouse_id);
