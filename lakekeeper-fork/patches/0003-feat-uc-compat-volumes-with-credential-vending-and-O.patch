+    .await
+    .unwrap();
+
+    // The in-memory test profile vends no credentials: the envelope is empty
+    // (no cloud member, no expiration), which asserts the vending path runs
+    // end-to-end without error.
+    for operation in [VolumeOperation::ReadVolume, VolumeOperation::WriteVolume] {
+        let creds = CatalogServer::generate_temporary_volume_credentials(
+            GenerateTemporaryVolumeCredentialsRequest {
+                volume_id: created.volume_id.clone(),
+                operation,
+            },
+            ctx.clone(),
+            random_request_metadata(),
