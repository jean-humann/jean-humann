+//! UC Volumes endpoints. A UC volume is a Lakekeeper-managed storage
+//! location (`uc_volume` entity) inside a top-level namespace ("schema") of a
+//! warehouse ("catalog").
+
+use axum::{
+    Extension, Json,
+    extract::{Path, Query, State},
+};
+use serde::{Deserialize, Serialize};
+
+use super::UcCatalogService;
+pub use crate::service::VolumeType;
+use crate::{
+    api::{
+        ApiContext,
+        uc::{UcEmptyResponse, UcResult},
+    },
+    request_metadata::RequestMetadata,
+};
+
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct CreateVolumeRequest {
+    pub catalog_name: String,
+    pub schema_name: String,
+    pub name: String,
+    pub volume_type: VolumeType,
+    /// Required for `EXTERNAL` volumes; must be absent for `MANAGED` volumes
+    /// (the server derives the location).
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub storage_location: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub comment: Option<String>,
+}
+
+/// UC `UpdateVolumeRequestContent`: only `comment` and `new_name` are
+/// updatable. The compatibility API supports comment updates only; `new_name`
+/// is rejected with `INVALID_ARGUMENT`.
+#[derive(Debug, Clone, Default, PartialEq, Serialize, Deserialize)]
+pub struct UpdateVolumeRequest {
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub comment: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub new_name: Option<String>,
+}
+
+/// UC `VolumeInfo`. UC DTOs use snake_case field names (serde default).
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct VolumeInfo {
+    pub catalog_name: String,
+    pub schema_name: String,
+    pub name: String,
+    /// `<catalog_name>.<schema_name>.<name>`.
+    pub full_name: String,
+    pub volume_type: VolumeType,
+    pub storage_location: String,
+    /// Stable volume id (UUID string) — input to
+    /// `POST /temporary-volume-credentials`.
+    pub volume_id: String,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub comment: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub owner: Option<String>,
+    /// Epoch milliseconds.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub created_at: Option<i64>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub created_by: Option<String>,
+    /// Epoch milliseconds.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub updated_at: Option<i64>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub updated_by: Option<String>,
+}
+
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct ListVolumesResponse {
+    #[serde(default)]
+    pub volumes: Vec<VolumeInfo>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub next_page_token: Option<String>,
+}
+
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct ListVolumesQuery {
+    pub catalog_name: String,
+    pub schema_name: String,
+    #[serde(default)]
+    pub max_results: Option<i64>,
+    #[serde(default)]
+    pub page_token: Option<String>,
+    /// Accepted for wire compatibility; ignored (no browse-only support).
+    #[serde(default)]
+    pub include_browse: Option<bool>,
+}
+
+impl axum::response::IntoResponse for VolumeInfo {
+    fn into_response(self) -> axum::response::Response {
+        Json(self).into_response()
+    }
+}
+
+impl axum::response::IntoResponse for ListVolumesResponse {
+    fn into_response(self) -> axum::response::Response {
+        Json(self).into_response()
+    }
+}
+
+pub(crate) async fn create_volume<I: UcCatalogService<S>, S: crate::api::ThreadSafe>(
+    State(api_context): State<ApiContext<S>>,
+    Extension(metadata): Extension<RequestMetadata>,
+    Json(request): Json<CreateVolumeRequest>,
+) -> UcResult<VolumeInfo> {
+    I::create_volume(request, api_context, metadata).await
+}
+
+pub(crate) async fn list_volumes<I: UcCatalogService<S>, S: crate::api::ThreadSafe>(
+    Query(query): Query<ListVolumesQuery>,
+    State(api_context): State<ApiContext<S>>,
+    Extension(metadata): Extension<RequestMetadata>,
+) -> UcResult<ListVolumesResponse> {
+    I::list_volumes(query, api_context, metadata).await
+}
+
+pub(crate) async fn get_volume<I: UcCatalogService<S>, S: crate::api::ThreadSafe>(
+    Path(full_name): Path<String>,
+    State(api_context): State<ApiContext<S>>,
+    Extension(metadata): Extension<RequestMetadata>,
+) -> UcResult<VolumeInfo> {
+    I::get_volume(full_name, api_context, metadata).await
+}
+
+pub(crate) async fn update_volume<I: UcCatalogService<S>, S: crate::api::ThreadSafe>(
+    Path(full_name): Path<String>,
+    State(api_context): State<ApiContext<S>>,
+    Extension(metadata): Extension<RequestMetadata>,
+    Json(request): Json<UpdateVolumeRequest>,
+) -> UcResult<VolumeInfo> {
+    I::update_volume(full_name, request, api_context, metadata).await
+}
+
+pub(crate) async fn delete_volume<I: UcCatalogService<S>, S: crate::api::ThreadSafe>(
+    Path(full_name): Path<String>,
+    State(api_context): State<ApiContext<S>>,
+    Extension(metadata): Extension<RequestMetadata>,
+) -> UcResult<UcEmptyResponse> {
+    I::delete_volume(full_name, api_context, metadata)
+        .await
+        .map(|()| UcEmptyResponse {})
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn test_create_volume_request_wire_format() {
+        let request: CreateVolumeRequest = serde_json::from_value(serde_json::json!({
+            "catalog_name": "cat",
+            "schema_name": "schema",
+            "name": "vol",
+            "volume_type": "EXTERNAL",
+            "storage_location": "s3://bucket/path"
+        }))
+        .unwrap();
+        assert_eq!(request.volume_type, VolumeType::External);
+        assert_eq!(request.comment, None);
+
+        let managed: CreateVolumeRequest = serde_json::from_value(serde_json::json!({
+            "catalog_name": "cat",
+            "schema_name": "schema",
+            "name": "vol",
+            "volume_type": "MANAGED"
+        }))
+        .unwrap();
+        assert_eq!(managed.volume_type, VolumeType::Managed);
+        assert_eq!(managed.storage_location, None);
+    }
+
+    #[test]
+    fn test_volume_info_serialization_omits_absent_fields() {
+        let info = VolumeInfo {
+            catalog_name: "cat".to_string(),
+            schema_name: "schema".to_string(),
+            name: "vol".to_string(),
+            full_name: "cat.schema.vol".to_string(),
+            volume_type: VolumeType::Managed,
+            storage_location: "s3://bucket/path".to_string(),
+            volume_id: "0198a1b2-0000-7000-8000-000000000000".to_string(),
+            comment: None,
+            owner: None,
+            created_at: Some(1_727_000_000_000),
+            created_by: None,
+            updated_at: None,
+            updated_by: None,
+        };
+        let json = serde_json::to_value(&info).unwrap();
+        assert_eq!(json["volume_type"], "MANAGED");
+        assert_eq!(json["full_name"], "cat.schema.vol");
+        assert_eq!(json["created_at"], 1_727_000_000_000_i64);
+        assert!(json.get("comment").is_none());
+        assert!(json.get("owner").is_none());
+        assert!(json.get("updated_at").is_none());
+    }
+}
