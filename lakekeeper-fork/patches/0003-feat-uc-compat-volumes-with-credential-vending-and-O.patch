+{
+  "db_name": "PostgreSQL",
+  "query": "SELECT EXISTS (\n               SELECT 1\n               FROM (\n                   SELECT fs_location FROM tabular\n                   WHERE warehouse_id = $1\n                   UNION ALL\n                   SELECT fs_location FROM uc_volume\n                   WHERE warehouse_id = $1 AND volume_id != $3 AND deleted_at IS NULL\n               ) locs\n               WHERE fs_location = ANY($2) OR\n                     (length($4) < length(fs_location) AND ((TRIM(TRAILING '/' FROM fs_location) || '/') LIKE $4 || '/%'))\n           ) as \"exists!\"",
+  "describe": {
+    "columns": [
+      {
+        "ordinal": 0,
+        "name": "exists!",
+        "type_info": "Bool",
+        "origin": "Expression"
+      }
+    ],
+    "parameters": {
+      "Left": [
+        "Uuid",
+        "TextArray",
+        "Uuid",
+        "Text"
+      ]
+    },
+    "nullable": [
+      null
+    ]
+  },
+  "hash": "32b12d96997c817fb867cc3d608151fdcf72d61de23eeeddc40f7f97c3629273"
+}
