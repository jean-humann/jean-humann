diff --git a/crates/lakekeeper-storage-postgres/src/uc/volume.rs b/crates/lakekeeper-storage-postgres/src/uc/volume.rs
new file mode 100644
index 00000000..40f0ae8b
--- /dev/null
+++ b/crates/lakekeeper-storage-postgres/src/uc/volume.rs
@@ -0,0 +1,777 @@
+//! Unity Catalog volume queries (`uc_volume` table).
+//!
+//! Volumes are a dedicated entity: name uniqueness (case-insensitive per
+//! namespace) and the location-overlap check are enforced here, not via
+//! `tabular`. The overlap check scans BOTH `tabular` and `uc_volume` so a new
+//! volume can neither shadow nor nest inside an existing table/view/volume
+//! location. The reverse direction is out of scope in v1: `create_tabular`'s
+//! `ensure_location_available` does not scan `uc_volume`, so creating a
+//! tabular inside an existing volume location is not blocked (documented
+//! scope cut).
+
+use std::str::FromStr;
+
+use iceberg::TableIdent;
+use lakekeeper::{
+    CONFIG, WarehouseId,
+    service::{
+        CatalogBackendError, CreateVolumeError, DropVolumeError, ListVolumesError, LoadVolumeError,
+        NamespaceId, NamespaceVersion, UpdateVolumeError, VolumeAlreadyExists, VolumeCreation,
+        VolumeId, VolumeInfo, VolumeListEntry, VolumeNotFound, VolumeType, WarehouseVersion,
+    },
+};
+use lakekeeper_io::Location;
+use uuid::Uuid;
+
+use crate::{
+    dbutils::DBErrorHandler as _,
+    namespace::parse_namespace_identifier_from_vec,
+    pagination::{PaginateToken, V1PaginateToken},
+    tabular::get_partial_fs_locations,
+};
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, sqlx::Type)]
+#[sqlx(type_name = "uc_volume_type", rename_all = "lowercase")]
+pub(crate) enum DbVolumeType {
+    External,
+    Managed,
+}
+
+impl From<VolumeType> for DbVolumeType {
+    fn from(v: VolumeType) -> Self {
+        match v {
+            VolumeType::External => DbVolumeType::External,
+            VolumeType::Managed => DbVolumeType::Managed,
+        }
+    }
+}
+
+impl From<DbVolumeType> for VolumeType {
+    fn from(v: DbVolumeType) -> Self {
+        match v {
+            DbVolumeType::External => VolumeType::External,
+            DbVolumeType::Managed => VolumeType::Managed,
+        }
+    }
+}
+
+struct VolumeFullRow {
+    volume_id: Uuid,
+    warehouse_id: Uuid,
+    warehouse_version: i64,
+    namespace_id: Uuid,
+    namespace_version: i64,
+    namespace_name: Vec<String>,
+    name: String,
+    volume_type: DbVolumeType,
+    location: String,
+    comment: Option<String>,
+    created_at: chrono::DateTime<chrono::Utc>,
+    updated_at: Option<chrono::DateTime<chrono::Utc>>,
+}
+
+struct VolumeListRow {
+    volume_id: Uuid,
+    warehouse_id: Uuid,
+    namespace_id: Uuid,
+    name: String,
+    volume_type: DbVolumeType,
+    location: String,
+    comment: Option<String>,
+    created_at: chrono::DateTime<chrono::Utc>,
+    updated_at: Option<chrono::DateTime<chrono::Utc>>,
+}
+
+fn parse_volume_location(location: &str) -> Result<Location, CatalogBackendError> {
+    Location::from_str(location).map_err(CatalogBackendError::new_unexpected)
+}
+
+fn full_row_to_info(row: VolumeFullRow) -> Result<VolumeInfo, CatalogBackendError> {
+    let warehouse_id = WarehouseId::from(row.warehouse_id);
+    let namespace_ident = parse_namespace_identifier_from_vec(
+        &row.namespace_name,
+        warehouse_id,
+        Some(row.namespace_id),
+    )
+    .map_err(CatalogBackendError::new_unexpected)?;
+
+    let location = parse_volume_location(&row.location)?;
+
+    let name = row.name;
+    let volume_ident = TableIdent {
+        namespace: namespace_ident.clone(),
+        name: name.clone(),
+    };
+
+    Ok(VolumeInfo {
+        volume_id: row.volume_id.into(),
+        warehouse_id,
+        warehouse_version: WarehouseVersion::new(row.warehouse_version),
+        namespace_id: row.namespace_id.into(),
+        namespace_version: NamespaceVersion::new(row.namespace_version),
+        namespace_ident,
+        name,
+        volume_ident,
+        volume_type: row.volume_type.into(),
+        location,
+        comment: row.comment,
+        created_at: row.created_at,
+        updated_at: row.updated_at,
+        // No protection support for volumes in v1.
+        protected: false,
+    })
+}
+
+/// Errors with `LocationAlreadyTaken` if any tabular or any other volume in
+/// `warehouse_id` occupies `location` (equal / parent / child fs_location).
+/// Semantics copied from `tabular::ensure_location_available`.
+async fn ensure_volume_location_available(
+    warehouse_id: Uuid,
+    self_volume_id: Uuid,
+    location: &Location,
+    transaction: &mut sqlx::Transaction<'_, sqlx::Postgres>,
+) -> Result<(), CreateVolumeError> {
+    let partial_locations = get_partial_fs_locations(location)?;
+    let fs_location = location.authority_and_path();
+    let taken = sqlx::query_scalar!(
+        r#"SELECT EXISTS (
+               SELECT 1
+               FROM (
+                   SELECT fs_location FROM tabular
+                   WHERE warehouse_id = $1
+                   UNION ALL
+                   SELECT fs_location FROM uc_volume
+                   WHERE warehouse_id = $1 AND volume_id != $3 AND deleted_at IS NULL
+               ) locs
+               WHERE fs_location = ANY($2) OR
+                     (length($4) < length(fs_location) AND ((TRIM(TRAILING '/' FROM fs_location) || '/') LIKE $4 || '/%'))
+           ) as "exists!""#,
+        warehouse_id,
+        &partial_locations,
+        self_volume_id,
+        fs_location,
+    )
+    .fetch_one(&mut **transaction)
+    .await
+    .map_err(|e| {
+        e.into_catalog_backend_error()
+            .append_detail("Error checking for conflicting volume locations")
+    })?;
+    if taken {
+        return Err(lakekeeper::service::LocationAlreadyTaken::new(location.clone()).into());
+    }
+    Ok(())
+}
+
+pub(crate) async fn create_volume(
+    creation: VolumeCreation,
+    transaction: &mut sqlx::Transaction<'_, sqlx::Postgres>,
+) -> Result<VolumeInfo, CreateVolumeError> {
+    let volume_id: Uuid = *creation.volume_id;
+    let warehouse_id: Uuid = *creation.warehouse_id;
+    let namespace_id: Uuid = *creation.namespace_id;
+    let fs_location = creation.location.authority_and_path();
+    let db_volume_type = DbVolumeType::from(creation.volume_type);
+
+    // Check location availability before the INSERT so a collision raises
+    // `LocationAlreadyTaken` cleanly.
+    ensure_volume_location_available(warehouse_id, volume_id, &creation.location, transaction)
+        .await?;
+
+    let row = sqlx::query_as!(
+        VolumeFullRow,
+        r#"
+        WITH inserted AS (
+            INSERT INTO uc_volume (warehouse_id, volume_id, namespace_id, name, volume_type, location, fs_location, comment)
+            SELECT $1, $2, $3, $4, $5, $6, $7, $8
+            FROM namespace n
+            WHERE n.namespace_id = $3 AND n.warehouse_id = $1
+            RETURNING volume_id, warehouse_id, namespace_id, name, volume_type, location, comment, created_at, updated_at
+        )
+        SELECT
+            i.volume_id,
+            i.warehouse_id,
+            w.version as "warehouse_version!",
+            i.namespace_id,
+            n.version as "namespace_version!",
+            n.namespace_name as "namespace_name!",
+            i.name,
+            i.volume_type as "volume_type: DbVolumeType",
+            i.location,
+            i.comment,
+            i.created_at,
+            i.updated_at
+        FROM inserted i
+        INNER JOIN warehouse w ON w.warehouse_id = $1 AND w.status = 'active'
+        INNER JOIN namespace n ON n.namespace_id = $3 AND n.warehouse_id = $1
+        "#,
+        warehouse_id,
+        volume_id,
+        namespace_id,
+        &creation.name,
+        db_volume_type as DbVolumeType,
+        creation.location.as_str(),
+        fs_location,
+        creation.comment.as_deref(),
+    )
+    .fetch_optional(&mut **transaction)
+    .await
+    .map_err(|e| match &e {
+        sqlx::Error::Database(db_err)
+            if [
+                Some("uc_volume_unique_name_per_namespace_idx"),
+                Some("uc_volume_pkey"),
+            ]
+            .contains(&db_err.constraint()) =>
+        {
+            CreateVolumeError::from(VolumeAlreadyExists::new())
+        }
+        _ => e.into_catalog_backend_error().into(),
+    })?
+    .ok_or_else(|| {
+        CreateVolumeError::from(CatalogBackendError::new_unexpected(
+            lakekeeper::service::InternalErrorMessage(format!(
+                "Namespace {namespace_id} not found in warehouse {warehouse_id} or warehouse not active while creating volume"
+            )),
+        ))
+    })?;
+
+    full_row_to_info(row).map_err(CreateVolumeError::from)
+}
+
+pub(crate) async fn load_volume(
+    warehouse_id: WarehouseId,
+    namespace_id: NamespaceId,
+    volume_name: &str,
+    transaction: &mut sqlx::Transaction<'_, sqlx::Postgres>,
+) -> Result<VolumeInfo, LoadVolumeError> {
+    let row = sqlx::query_as!(
+        VolumeFullRow,
+        r#"
+        SELECT
+            v.volume_id,
+            v.warehouse_id,
+            w.version as "warehouse_version!",
+            v.namespace_id,
+            n.version as "namespace_version!",
+            n.namespace_name as "namespace_name!",
+            v.name,
+            v.volume_type as "volume_type: DbVolumeType",
+            v.location,
+            v.comment,
+            v.created_at,
+            v.updated_at
+        FROM uc_volume v
+        INNER JOIN warehouse w ON w.warehouse_id = v.warehouse_id AND w.status = 'active'
+        INNER JOIN namespace n ON n.namespace_id = v.namespace_id AND n.warehouse_id = v.warehouse_id
+        WHERE v.warehouse_id = $1
+          AND v.namespace_id = $2
+          AND v.name = $3
+          AND v.deleted_at IS NULL
+        "#,
+        *warehouse_id,
+        *namespace_id,
+        volume_name,
+    )
+    .fetch_optional(&mut **transaction)
+    .await
+    .map_err(|e| LoadVolumeError::from(e.into_catalog_backend_error()))?
+    .ok_or_else(|| LoadVolumeError::from(VolumeNotFound::new()))?;
+
+    full_row_to_info(row).map_err(LoadVolumeError::from)
+}
+
+/// Load a volume by its stable id. `warehouse_id: None` looks the volume up
+/// across warehouses (UC temporary-volume-credentials requests only carry the
+/// `volume_id`; ids are random UUIDv7, so they are unique in practice).
+pub(crate) async fn load_volume_by_id(
+    warehouse_id: Option<WarehouseId>,
+    volume_id: VolumeId,
+    transaction: &mut sqlx::Transaction<'_, sqlx::Postgres>,
+) -> Result<VolumeInfo, LoadVolumeError> {
+    let row = sqlx::query_as!(
+        VolumeFullRow,
+        r#"
+        SELECT
+            v.volume_id,
+            v.warehouse_id,
+            w.version as "warehouse_version!",
+            v.namespace_id,
+            n.version as "namespace_version!",
+            n.namespace_name as "namespace_name!",
+            v.name,
+            v.volume_type as "volume_type: DbVolumeType",
+            v.location,
+            v.comment,
+            v.created_at,
+            v.updated_at
+        FROM uc_volume v
+        INNER JOIN warehouse w ON w.warehouse_id = v.warehouse_id AND w.status = 'active'
+        INNER JOIN namespace n ON n.namespace_id = v.namespace_id AND n.warehouse_id = v.warehouse_id
+        WHERE ($1::uuid IS NULL OR v.warehouse_id = $1)
+          AND v.volume_id = $2
+          AND v.deleted_at IS NULL
+        "#,
+        warehouse_id.map(|w| *w),
+        *volume_id,
+    )
+    .fetch_optional(&mut **transaction)
+    .await
+    .map_err(|e| LoadVolumeError::from(e.into_catalog_backend_error()))?
+    .ok_or_else(|| LoadVolumeError::from(VolumeNotFound::new()))?;
+
+    full_row_to_info(row).map_err(LoadVolumeError::from)
+}
+
+pub(crate) async fn list_volumes(
+    warehouse_id: WarehouseId,
+    namespace_id: NamespaceId,
+    namespace_ident: &iceberg::NamespaceIdent,
+    page_size: Option<i64>,
+    page_token: Option<&str>,
+    transaction: &mut sqlx::Transaction<'_, sqlx::Postgres>,
+) -> Result<(Vec<VolumeListEntry>, Option<String>), ListVolumesError> {
+    let page_size = CONFIG.page_size_or_pagination_default(page_size);
+
+    let token = page_token
+        .map(PaginateToken::<Uuid>::try_from)
+        .transpose()
+        .map_err(|e| ListVolumesError::from(CatalogBackendError::new_unexpected(e)))?;
+
+    let (token_ts, token_id) = token
+        .as_ref()
+        .map(
+            |PaginateToken::V1(V1PaginateToken { created_at, id }): &PaginateToken<Uuid>| {
+                (created_at, id)
+            },
+        )
+        .map_or((None, None), |(ts, id)| (Some(*ts), Some(*id)));
+
+    let rows = sqlx::query_as!(
+        VolumeListRow,
+        r#"
+        SELECT
+            v.volume_id,
+            v.warehouse_id,
+            v.namespace_id,
+            v.name,
+            v.volume_type as "volume_type: DbVolumeType",
+            v.location,
+            v.comment,
+            v.created_at,
+            v.updated_at
+        FROM uc_volume v
+        INNER JOIN warehouse w ON w.warehouse_id = v.warehouse_id AND w.status = 'active'
+        WHERE v.warehouse_id = $1
+          AND v.namespace_id = $2
+          AND v.deleted_at IS NULL
+          AND (
+            ($3::timestamptz IS NULL)
+            OR (v.created_at, v.volume_id) > ($3, $4)
+          )
+        ORDER BY v.created_at ASC, v.volume_id ASC
+        LIMIT $5
+        "#,
+        *warehouse_id,
+        *namespace_id,
+        token_ts,
+        token_id,
+        page_size,
+    )
+    .fetch_all(&mut **transaction)
+    .await
+    .map_err(|e| ListVolumesError::from(e.into_catalog_backend_error()))?;
+
+    let mut entries = Vec::with_capacity(rows.len());
+    let mut next_page_token = None;
+
+    for row in rows {
+        next_page_token = Some(
+            PaginateToken::V1(V1PaginateToken {
+                created_at: row.created_at,
+                id: row.volume_id,
+            })
+            .to_string(),
+        );
+
+        let location = parse_volume_location(&row.location).map_err(ListVolumesError::from)?;
+        let volume_ident = TableIdent::new(namespace_ident.clone(), row.name.clone());
+        entries.push(VolumeListEntry {
+            volume_id: row.volume_id.into(),
+            warehouse_id: row.warehouse_id.into(),
+            namespace_id: row.namespace_id.into(),
+            name: row.name,
+            volume_ident,
+            namespace_ident: namespace_ident.clone(),
+            volume_type: row.volume_type.into(),
+            location,
+            comment: row.comment,
+            created_at: row.created_at,
+            updated_at: row.updated_at,
+        });
+    }
+
+    Ok((entries, next_page_token))
+}
+
+pub(crate) async fn update_volume_comment(
+    warehouse_id: WarehouseId,
+    volume_id: VolumeId,
+    comment: Option<&str>,
+    transaction: &mut sqlx::Transaction<'_, sqlx::Postgres>,
+) -> Result<(), UpdateVolumeError> {
+    sqlx::query!(
+        r#"
+        UPDATE uc_volume
+        SET comment = $3
+        WHERE warehouse_id = $1 AND volume_id = $2 AND deleted_at IS NULL
+        RETURNING volume_id
+        "#,
+        *warehouse_id,
+        *volume_id,
+        comment,
+    )
+    .fetch_optional(&mut **transaction)
+    .await
+    .map_err(|e| UpdateVolumeError::from(e.into_catalog_backend_error()))?
+    .ok_or_else(|| UpdateVolumeError::from(VolumeNotFound::new()))?;
+    Ok(())
+}
+
+/// Hard delete (UC DELETE semantics in v1).
+pub(crate) async fn drop_volume(
+    warehouse_id: WarehouseId,
+    namespace_id: NamespaceId,
+    volume_name: &str,
+    transaction: &mut sqlx::Transaction<'_, sqlx::Postgres>,
+) -> Result<VolumeId, DropVolumeError> {
+    let row = sqlx::query!(
+        r#"
+        DELETE FROM uc_volume v
+        USING warehouse w
+        WHERE w.warehouse_id = v.warehouse_id
+          AND w.status = 'active'
+          AND v.warehouse_id = $1
+          AND v.namespace_id = $2
+          AND v.name = $3
+          AND v.deleted_at IS NULL
+        RETURNING v.volume_id
+        "#,
+        *warehouse_id,
+        *namespace_id,
+        volume_name,
+    )
+    .fetch_optional(&mut **transaction)
+    .await
+    .map_err(|e| DropVolumeError::from(e.into_catalog_backend_error()))?
+    .ok_or_else(|| DropVolumeError::from(VolumeNotFound::new()))?;
+
+    Ok(row.volume_id.into())
+}
