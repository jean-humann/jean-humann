--- /dev/null
+++ b/tests/uc-compat/oidc_stub.py
@@ -0,0 +1,236 @@
+"""Tiny offline OIDC identity-provider stub for the uc-compat e2e suite.
+
+Lakekeeper's OIDC authentication (limes ``JWKSWebAuthenticator``) only needs
+three things from an IdP:
+
+  * ``{issuer}/.well-known/openid-configuration`` with ``issuer`` + ``jwks_uri``
+    (fetched once at server startup, ``require_connected_on_startup=true``);
+  * the JWKS document with the RS256 public key (matched by ``kid``);
+  * RS256-signed JWTs carrying ``iss``/``aud``/``exp`` and a subject claim
+    (Lakekeeper prefers ``oid``, falls back to ``sub``).
+
+This stub serves exactly that from a threaded stdlib HTTP server with an RSA
+keypair generated at startup — no docker image, no network egress, no
+keycloak. Machine users are minted via the standard ``client_credentials``
+grant: ``POST /token`` with ``client_id=<sub>`` returns a Bearer JWT whose
+``sub`` is the client id (Lakekeeper user id ``oidc~<sub>``).
+
+Usage:
+  * standalone:  python oidc_stub.py [--port 8899] [--audience lakekeeper]
+    (prints a ready line; SIGTERM/SIGINT to stop — run.sh backgrounds it and
+    health-checks the discovery endpoint);
+  * from tests:  ``from oidc_stub import mint_token`` — requests a token from
+    a *running* stub over HTTP, so tests and the run.sh-launched stub share
+    one signing key without persisting it anywhere.
+
+Dependencies: ``pyjwt`` + ``cryptography`` (pip-installed into the e2e venv).
+"""
+
+from __future__ import annotations
+
+import argparse
+import base64
+import json
+import os
+import signal
+import sys
+import threading
+import time
+import urllib.parse
+import urllib.request
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+
+DEFAULT_PORT = int(os.environ.get("OIDC_STUB_PORT", "8899"))
+DEFAULT_AUDIENCE = os.environ.get("OIDC_STUB_AUDIENCE", "lakekeeper")
+KEY_ID = "uc-e2e-rs256-key"
+TOKEN_TTL_SECONDS = 3600
+
+
+def _b64url_uint(n: int) -> str:
+    raw = n.to_bytes((n.bit_length() + 7) // 8, "big")
+    return base64.urlsafe_b64encode(raw).rstrip(b"=").decode("ascii")
+
+
+class OidcStub:
+    """RSA keypair + JWT minting + the three OIDC documents."""
+
+    def __init__(self, issuer: str, default_audience: str = DEFAULT_AUDIENCE):
+        from cryptography.hazmat.primitives import serialization
+        from cryptography.hazmat.primitives.asymmetric import rsa
+
+        self.issuer = issuer.rstrip("/")
+        self.default_audience = default_audience
+        self._private_key = rsa.generate_private_key(
+            public_exponent=65537, key_size=2048
+        )
+        self._private_pem = self._private_key.private_bytes(
+            serialization.Encoding.PEM,
+            serialization.PrivateFormat.PKCS8,
+            serialization.NoEncryption(),
+        )
+        public_numbers = self._private_key.public_key().public_numbers()
+        self.jwks = {
+            "keys": [
+                {
+                    "kty": "RSA",
+                    "use": "sig",
+                    "alg": "RS256",
+                    "kid": KEY_ID,
+                    "n": _b64url_uint(public_numbers.n),
+                    "e": _b64url_uint(public_numbers.e),
+                }
+            ]
+        }
+
+    @property
+    def discovery(self) -> dict:
+        return {
+            "issuer": self.issuer,
+            "jwks_uri": f"{self.issuer}/jwks",
+            "token_endpoint": f"{self.issuer}/token",
+            "response_types_supported": ["token"],
+            "grant_types_supported": ["client_credentials"],
+            "id_token_signing_alg_values_supported": ["RS256"],
+        }
+
+    def mint(
+        self,
+        sub: str,
+        aud: str | None = None,
+        oid: str | None = None,
+        ttl: int = TOKEN_TTL_SECONDS,
+    ) -> str:
+        """RS256 JWT for machine user ``sub`` (Lakekeeper user id ``oidc~<sub>``)."""
+        import jwt as pyjwt
+
+        now = int(time.time())
+        claims = {
+            "iss": self.issuer,
+            "sub": sub,
+            "aud": aud or self.default_audience,
+            "iat": now,
+            "exp": now + ttl,
+            # Cosmetic claims so self-provisioning picks up a display name.
+            "name": sub,
+            "preferred_username": sub,
+        }
+        if oid is not None:
+            claims["oid"] = oid
+        return pyjwt.encode(
+            claims, self._private_pem, algorithm="RS256", headers={"kid": KEY_ID}
+        )
+
+
+def _make_handler(stub: OidcStub):
+    class Handler(BaseHTTPRequestHandler):
+        def _json(self, status: int, body: dict):
+            data = json.dumps(body).encode()
+            self.send_response(status)
+            self.send_header("Content-Type", "application/json")
+            self.send_header("Content-Length", str(len(data)))
+            self.end_headers()
+            self.wfile.write(data)
+
+        def do_GET(self):  # noqa: N802 (http.server API)
+            path = self.path.split("?", 1)[0].rstrip("/")
+            if path == "/.well-known/openid-configuration":
+                self._json(200, stub.discovery)
+            elif path == "/jwks":
+                self._json(200, stub.jwks)
+            else:
+                self._json(404, {"error": "not_found", "path": self.path})
+
+        def do_POST(self):  # noqa: N802
+            path = self.path.split("?", 1)[0].rstrip("/")
+            if path != "/token":
+                self._json(404, {"error": "not_found", "path": self.path})
+                return
+            length = int(self.headers.get("Content-Length") or 0)
+            form = urllib.parse.parse_qs(self.rfile.read(length).decode())
+            grant_type = form.get("grant_type", [""])[0]
+            client_id = form.get("client_id", [""])[0]
+            if grant_type != "client_credentials":
+                self._json(400, {"error": "unsupported_grant_type"})
+                return
+            if not client_id:
+                self._json(400, {"error": "invalid_request",
+                                 "error_description": "client_id is required"})
+                return
+            token = stub.mint(
+                sub=client_id,
+                aud=form.get("audience", [None])[0],
+                oid=form.get("oid", [None])[0],
+            )
+            self._json(200, {
+                "access_token": token,
+                "token_type": "Bearer",
+                "expires_in": TOKEN_TTL_SECONDS,
+            })
+
+        def log_message(self, fmt, *args):  # quiet unless OIDC_STUB_VERBOSE
+            if os.environ.get("OIDC_STUB_VERBOSE"):
+                sys.stderr.write("oidc-stub: " + fmt % args + "\n")
+
+    return Handler
+
+
+def mint_token(
+    sub: str,
+    aud: str = DEFAULT_AUDIENCE,
+    issuer: str | None = None,
+    timeout: float = 10.0,
+) -> str:
+    """Get a Bearer token for ``sub`` from a RUNNING stub (client_credentials).
+
+    Importable by conftest/tests. Goes over HTTP so the token is signed with
+    the key held by the stub process run.sh started (proxy env is bypassed —
+    the stub is always on localhost).
+    """
+    issuer = (issuer or os.environ.get(
+        "OIDC_STUB_ISSUER", f"http://localhost:{DEFAULT_PORT}")).rstrip("/")
+    body = urllib.parse.urlencode(
+        {"grant_type": "client_credentials", "client_id": sub, "audience": aud}
+    ).encode()
+    req = urllib.request.Request(
+        f"{issuer}/token", data=body,
+        headers={"Content-Type": "application/x-www-form-urlencoded"},
+    )
+    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
+    with opener.open(req, timeout=timeout) as resp:
+        return json.loads(resp.read())["access_token"]
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__.split("\n", 1)[0])
+    parser.add_argument("--port", type=int, default=DEFAULT_PORT)
+    parser.add_argument("--host", default="127.0.0.1")
+    parser.add_argument("--audience", default=DEFAULT_AUDIENCE)
+    parser.add_argument(
+        "--issuer", default=None,
+        help="issuer URL in discovery/tokens (default http://localhost:<port>)",
+    )
+    args = parser.parse_args()
+
+    issuer = args.issuer or f"http://localhost:{args.port}"
+    stub = OidcStub(issuer=issuer, default_audience=args.audience)
+    server = ThreadingHTTPServer((args.host, args.port), _make_handler(stub))
+    server.daemon_threads = True
+
+    stop = threading.Event()
+    for sig in (signal.SIGTERM, signal.SIGINT):
+        signal.signal(sig, lambda *_: stop.set())
+
+    thread = threading.Thread(target=server.serve_forever, daemon=True)
+    thread.start()
+    print(
+        f"oidc-stub ready: issuer={issuer} audience={args.audience} "
+        f"discovery={issuer}/.well-known/openid-configuration",
+        flush=True,
+    )
+    stop.wait()
+    server.shutdown()
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
