diff --git a/crates/lakekeeper/src/api/uc/mod.rs b/crates/lakekeeper/src/api/uc/mod.rs
new file mode 100644
index 00000000..93a33afb
--- /dev/null
+++ b/crates/lakekeeper/src/api/uc/mod.rs
@@ -0,0 +1,275 @@
+//! Unity Catalog-compatible REST API, served under `/api/2.1/unity-catalog`.
+//!
+//! Maps Unity Catalog concepts onto Lakekeeper entities:
+//! UC `catalog` == Lakekeeper warehouse (in the default project),
+//! UC `schema` == top-level namespace in that warehouse.
+//!
+//! This module owns the UC wire format: the error envelope
+//! ([`UcErrorResponse`]), pagination conventions (`max_results` /
+//! `page_token`, `next_page_token`) and epoch-millisecond timestamps.
+
+pub mod v1;
+
+use axum::{Json, Router, response::IntoResponse};
+use http::StatusCode;
+use iceberg_ext::catalog::rest::{ErrorModel, IcebergErrorResponse};
+use serde::{Deserialize, Serialize};
+
+use crate::{CONFIG, api::ApiContext};
+
+/// Result type returned by all UC handlers.
+pub type UcResult<T> = Result<T, UcErrorResponse>;
+
+pub const UC_ERROR_DETAIL_TYPE: &str = "google.rpc.ErrorInfo";
+
+/// Entry of the `details` list in the UC error envelope.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct UcErrorDetail {
+    #[serde(rename = "@type")]
+    pub r#type: String,
+    pub reason: String,
+}
+
+/// Unity Catalog error envelope:
+/// `{"error_code": ..., "message": ..., "details": [...]}`.
+///
+/// The HTTP status code is preserved from the original Lakekeeper error and
+/// is not part of the serialized body.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct UcErrorResponse {
+    /// Original HTTP status code. Not serialized into the response body.
+    #[serde(skip)]
+    pub status: u16,
+    pub error_code: String,
+    pub message: String,
+    pub details: Vec<UcErrorDetail>,
+}
+
+impl UcErrorResponse {
+    #[must_use]
+    pub fn new(status: u16, error_code: impl Into<String>, message: impl Into<String>) -> Self {
+        let error_code = error_code.into();
+        Self {
+            status,
+            details: vec![UcErrorDetail {
+                r#type: UC_ERROR_DETAIL_TYPE.to_string(),
+                reason: error_code.clone(),
+            }],
+            error_code,
+            message: message.into(),
+        }
+    }
+
+    #[must_use]
+    pub fn invalid_argument(message: impl Into<String>) -> Self {
+        Self::new(
+            StatusCode::BAD_REQUEST.as_u16(),
+            "INVALID_ARGUMENT",
+            message,
+        )
+    }
+
+    #[must_use]
+    pub fn not_found(message: impl Into<String>) -> Self {
+        Self::new(StatusCode::NOT_FOUND.as_u16(), "NOT_FOUND", message)
+    }
+
+    #[must_use]
+    pub fn internal(message: impl Into<String>) -> Self {
+        Self::new(
+            StatusCode::INTERNAL_SERVER_ERROR.as_u16(),
+            "INTERNAL",
+            message,
+        )
+    }
+}
+
+/// UC `error_code` for an HTTP status code produced by Lakekeeper.
+///
+/// Lakekeeper already masks unauthorized-to-see entities as 404, so the
+/// status codes can be mapped verbatim; anything unmapped is `INTERNAL`.
+#[must_use]
+pub fn uc_error_code_for_status(status: u16) -> &'static str {
+    match status {
+        400 => "INVALID_ARGUMENT",
+        401 => "UNAUTHENTICATED",
+        403 => "PERMISSION_DENIED",
+        404 => "NOT_FOUND",
+        409 => "ALREADY_EXISTS",
+        _ => "INTERNAL",
+    }
+}
+
+impl From<ErrorModel> for UcErrorResponse {
+    fn from(e: ErrorModel) -> Self {
+        Self::new(e.code, uc_error_code_for_status(e.code), e.message)
+    }
+}
+
+impl From<IcebergErrorResponse> for UcErrorResponse {
+    fn from(e: IcebergErrorResponse) -> Self {
+        e.error.into()
+    }
+}
+
+impl IntoResponse for UcErrorResponse {
+    fn into_response(self) -> axum::response::Response {
+        let status = StatusCode::from_u16(self.status).unwrap_or(StatusCode::INTERNAL_SERVER_ERROR);
+        if status.is_server_error() {
+            tracing::warn!(?self, "Returning UC API server error");
+        } else {
+            tracing::debug!(?self, "Returning UC API client error");
+        }
+        (status, Json(self)).into_response()
+    }
+}
+
+/// Response body for successful UC DELETE operations: `{}` with HTTP 200.
+#[derive(Debug, Clone, Default, PartialEq, Eq, Serialize, Deserialize)]
+pub struct UcEmptyResponse {}
+
+impl IntoResponse for UcEmptyResponse {
+    fn into_response(self) -> axum::response::Response {
+        Json(self).into_response()
+    }
+}
+
+/// Common UC list-endpoint pagination query parameters.
+#[derive(Debug, Clone, Default, PartialEq, Eq, Serialize, Deserialize)]
+pub struct UcPaginationQuery {
+    #[serde(default)]
+    pub max_results: Option<i64>,
+    #[serde(default)]
+    pub page_token: Option<String>,
+}
+
+/// Effective page size for a UC `max_results` parameter.
+///
+/// UC semantics: `> 0` = min(value, server cap), `0` or absent = server
+/// default, `< 0` = `INVALID_ARGUMENT`.
+pub(crate) fn effective_page_size(max_results: Option<i64>) -> UcResult<i64> {
+    match max_results {
+        Some(n) if n < 0 => Err(UcErrorResponse::invalid_argument(format!(
+            "max_results must not be negative, got {n}"
+        ))),
+        Some(0) | None => Ok(CONFIG.page_size_or_pagination_default(None)),
+        Some(n) => Ok(CONFIG.page_size_or_pagination_default(Some(n))),
+    }
+}
+
+/// UC timestamps are int64 epoch milliseconds.
+pub(crate) fn to_epoch_millis(dt: chrono::DateTime<chrono::Utc>) -> i64 {
+    dt.timestamp_millis()
+}
+
+/// Router serving the Unity Catalog-compatible API. Mount under
+/// `/api/2.1/unity-catalog`.
+pub fn uc_router<I: v1::UcCatalogService<S>, S: crate::api::ThreadSafe>() -> Router<ApiContext<S>> {
+    v1::router::<I, S>()
+}
+
+#[cfg(test)]
+mod tests {
+    use http_body_util::BodyExt as _;
+
+    use super::*;
+
+    #[test]
+    fn test_error_envelope_serialization_is_exact() {
+        let err = UcErrorResponse::not_found("Schema not found: main.default");
+        let json = serde_json::to_string(&err).unwrap();
+        assert_eq!(
+            json,
+            r#"{"error_code":"NOT_FOUND","message":"Schema not found: main.default","details":[{"@type":"google.rpc.ErrorInfo","reason":"NOT_FOUND"}]}"#
+        );
+    }
+
+    #[test]
+    fn test_empty_response_serializes_to_empty_object() {
+        assert_eq!(serde_json::to_string(&UcEmptyResponse {}).unwrap(), "{}");
+    }
+
+    #[test]
+    fn test_status_to_error_code_mapping() {
+        for (status, code) in [
+            (400, "INVALID_ARGUMENT"),
+            (401, "UNAUTHENTICATED"),
+            (403, "PERMISSION_DENIED"),
+            (404, "NOT_FOUND"),
+            (409, "ALREADY_EXISTS"),
+            (500, "INTERNAL"),
+            (503, "INTERNAL"),
+            (418, "INTERNAL"),
+        ] {
+            let err: UcErrorResponse = ErrorModel::builder()
+                .message("msg")
+                .r#type("SomeInternalType")
+                .code(status)
+                .build()
+                .into();
+            assert_eq!(err.error_code, code, "status {status}");
+            assert_eq!(err.status, status);
+            assert_eq!(
+                err.details,
+                vec![UcErrorDetail {
+                    r#type: UC_ERROR_DETAIL_TYPE.to_string(),
+                    reason: code.to_string(),
+                }]
+            );
+        }
+    }
+
+    #[test]
+    fn test_iceberg_error_response_conversion_preserves_message() {
+        let iceberg: IcebergErrorResponse = ErrorModel::builder()
+            .message("Namespace does not exist")
+            .r#type("NamespaceNotFound")
+            .code(404)
+            .build()
+            .into();
+        let uc: UcErrorResponse = iceberg.into();
+        assert_eq!(uc.status, 404);
+        assert_eq!(uc.error_code, "NOT_FOUND");
+        assert_eq!(uc.message, "Namespace does not exist");
+    }
+
+    #[tokio::test]
+    async fn test_into_response_preserves_original_status_and_body() {
+        let response =
+            UcErrorResponse::new(409, "ALREADY_EXISTS", "Schema already exists").into_response();
+        assert_eq!(response.status(), StatusCode::CONFLICT);
+        let body = response.into_body().collect().await.unwrap().to_bytes();
+        let json: serde_json::Value = serde_json::from_slice(&body).unwrap();
+        assert_eq!(
+            json,
+            serde_json::json!({
+                "error_code": "ALREADY_EXISTS",
+                "message": "Schema already exists",
+                "details": [
+                    {"@type": "google.rpc.ErrorInfo", "reason": "ALREADY_EXISTS"}
+                ]
+            })
+        );
+    }
+
+    #[test]
+    fn test_effective_page_size() {
+        assert_eq!(
+            effective_page_size(None).unwrap(),
+            i64::from(CONFIG.pagination_size_default)
+        );
+        assert_eq!(
+            effective_page_size(Some(0)).unwrap(),
+            i64::from(CONFIG.pagination_size_default)
+        );
+        assert_eq!(effective_page_size(Some(7)).unwrap(), 7);
+        // Capped at the server maximum.
+        assert_eq!(
+            effective_page_size(Some(i64::MAX)).unwrap(),
+            i64::from(CONFIG.pagination_size_max)
+        );
+        let err = effective_page_size(Some(-1)).unwrap_err();
+        assert_eq!(err.status, 400);
+        assert_eq!(err.error_code, "INVALID_ARGUMENT");
+    }
+}
