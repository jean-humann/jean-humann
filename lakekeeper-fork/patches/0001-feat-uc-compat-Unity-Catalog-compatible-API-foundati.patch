+//! UC Schemas endpoints. A UC schema is a top-level Lakekeeper namespace in
+//! the warehouse named by `catalog_name`; the UC `comment` is stored as the
+//! namespace property `comment`.
+
+use std::collections::HashMap;
+
+use axum::{
+    Extension, Json,
+    extract::{Path, Query, State},
+};
+use serde::{Deserialize, Serialize};
+
+use super::UcCatalogService;
+use crate::{
+    api::{
+        ApiContext,
+        uc::{UcEmptyResponse, UcResult},
+    },
+    request_metadata::RequestMetadata,
+};
+
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct CreateSchemaRequest {
+    pub name: String,
+    pub catalog_name: String,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub comment: Option<String>,
+    #[serde(default, skip_serializing_if = "HashMap::is_empty")]
+    pub properties: HashMap<String, String>,
+    /// Not supported by the compatibility API; requests carrying it are
+    /// rejected with `INVALID_ARGUMENT`.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub storage_root: Option<String>,
+}
+
+#[derive(Debug, Clone, Default, PartialEq, Serialize, Deserialize)]
+pub struct UpdateSchemaRequest {
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub comment: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub properties: Option<HashMap<String, String>>,
+    /// Not supported by the compatibility API; requests carrying it are
+    /// rejected with `INVALID_ARGUMENT`.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub new_name: Option<String>,
+}
+
+/// UC `SchemaInfo`. UC DTOs use snake_case field names (serde default).
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct SchemaInfo {
+    pub name: String,
+    pub catalog_name: String,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub comment: Option<String>,
+    #[serde(default)]
+    pub properties: HashMap<String, String>,
+    /// `<catalog_name>.<name>`.
+    pub full_name: String,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub owner: Option<String>,
+    /// Epoch milliseconds.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub created_at: Option<i64>,
+    /// Epoch milliseconds.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub updated_at: Option<i64>,
+    /// Namespace ID.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub schema_id: Option<String>,
+}
+
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct ListSchemasResponse {
+    #[serde(default)]
+    pub schemas: Vec<SchemaInfo>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub next_page_token: Option<String>,
+}
+
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct ListSchemasQuery {
+    pub catalog_name: String,
+    #[serde(default)]
+    pub max_results: Option<i64>,
+    #[serde(default)]
+    pub page_token: Option<String>,
+}
+
+#[derive(Debug, Clone, Copy, Default, PartialEq, Eq, Serialize, Deserialize)]
+pub struct DeleteSchemaQuery {
+    #[serde(default)]
+    pub force: bool,
+}
+
+impl axum::response::IntoResponse for SchemaInfo {
+    fn into_response(self) -> axum::response::Response {
+        Json(self).into_response()
+    }
+}
+
+impl axum::response::IntoResponse for ListSchemasResponse {
+    fn into_response(self) -> axum::response::Response {
+        Json(self).into_response()
+    }
+}
+
+pub(crate) async fn create_schema<I: UcCatalogService<S>, S: crate::api::ThreadSafe>(
+    State(api_context): State<ApiContext<S>>,
+    Extension(metadata): Extension<RequestMetadata>,
+    Json(request): Json<CreateSchemaRequest>,
+) -> UcResult<SchemaInfo> {
+    I::create_schema(request, api_context, metadata).await
+}
+
+pub(crate) async fn list_schemas<I: UcCatalogService<S>, S: crate::api::ThreadSafe>(
+    Query(query): Query<ListSchemasQuery>,
+    State(api_context): State<ApiContext<S>>,
+    Extension(metadata): Extension<RequestMetadata>,
+) -> UcResult<ListSchemasResponse> {
+    I::list_schemas(query, api_context, metadata).await
+}
+
+pub(crate) async fn get_schema<I: UcCatalogService<S>, S: crate::api::ThreadSafe>(
+    Path(full_name): Path<String>,
+    State(api_context): State<ApiContext<S>>,
+    Extension(metadata): Extension<RequestMetadata>,
+) -> UcResult<SchemaInfo> {
+    I::get_schema(full_name, api_context, metadata).await
+}
+
+pub(crate) async fn update_schema<I: UcCatalogService<S>, S: crate::api::ThreadSafe>(
+    Path(full_name): Path<String>,
+    State(api_context): State<ApiContext<S>>,
+    Extension(metadata): Extension<RequestMetadata>,
+    Json(request): Json<UpdateSchemaRequest>,
+) -> UcResult<SchemaInfo> {
+    I::update_schema(full_name, request, api_context, metadata).await
+}
+
+pub(crate) async fn delete_schema<I: UcCatalogService<S>, S: crate::api::ThreadSafe>(
+    Path(full_name): Path<String>,
+    Query(query): Query<DeleteSchemaQuery>,
+    State(api_context): State<ApiContext<S>>,
+    Extension(metadata): Extension<RequestMetadata>,
+) -> UcResult<UcEmptyResponse> {
+    I::delete_schema(full_name, query, api_context, metadata)
+        .await
+        .map(|()| UcEmptyResponse {})
+}
