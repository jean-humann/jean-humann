+//! Server-side implementation of the Unity Catalog compatibility API
+//! (`crate::api::uc`).
+
+pub(crate) mod catalogs;
+pub(crate) mod resolve;
+pub(crate) mod schemas;
+
+use async_trait::async_trait;
+
+use crate::{
+    api::{
+        ApiContext,
+        uc::{
+            UcPaginationQuery, UcResult,
+            v1::{
+                CatalogInfo, CreateSchemaRequest, DeleteSchemaQuery, ListCatalogsResponse,
+                ListSchemasQuery, ListSchemasResponse, SchemaInfo, UcCatalogService,
+                UpdateSchemaRequest,
+            },
+        },
+    },
+    request_metadata::RequestMetadata,
+    server::CatalogServer,
+    service::{CatalogStore, SecretStore, State, authz::Authorizer},
+};
+
+#[async_trait]
+impl<C: CatalogStore, A: Authorizer + Clone, S: SecretStore> UcCatalogService<State<A, C, S>>
+    for CatalogServer<C, A, S>
+{
+    async fn list_catalogs(
+        query: UcPaginationQuery,
+        state: ApiContext<State<A, C, S>>,
+        request_metadata: RequestMetadata,
+    ) -> UcResult<ListCatalogsResponse> {
+        catalogs::list_catalogs::<C, A, S>(query, state, request_metadata).await
+    }
+
+    async fn get_catalog(
+        name: String,
+        state: ApiContext<State<A, C, S>>,
+        request_metadata: RequestMetadata,
+    ) -> UcResult<CatalogInfo> {
+        catalogs::get_catalog::<C, A, S>(name, state, request_metadata).await
+    }
+
+    async fn create_schema(
+        request: CreateSchemaRequest,
+        state: ApiContext<State<A, C, S>>,
+        request_metadata: RequestMetadata,
+    ) -> UcResult<SchemaInfo> {
+        schemas::create_schema::<C, A, S>(request, state, request_metadata).await
+    }
+
+    async fn list_schemas(
+        query: ListSchemasQuery,
+        state: ApiContext<State<A, C, S>>,
+        request_metadata: RequestMetadata,
+    ) -> UcResult<ListSchemasResponse> {
+        schemas::list_schemas::<C, A, S>(query, state, request_metadata).await
+    }
+
+    async fn get_schema(
+        full_name: String,
+        state: ApiContext<State<A, C, S>>,
+        request_metadata: RequestMetadata,
+    ) -> UcResult<SchemaInfo> {
+        schemas::get_schema::<C, A, S>(full_name, state, request_metadata).await
+    }
+
+    async fn update_schema(
+        full_name: String,
+        request: UpdateSchemaRequest,
+        state: ApiContext<State<A, C, S>>,
+        request_metadata: RequestMetadata,
+    ) -> UcResult<SchemaInfo> {
+        schemas::update_schema::<C, A, S>(full_name, request, state, request_metadata).await
+    }
+
+    async fn delete_schema(
+        full_name: String,
+        query: DeleteSchemaQuery,
+        state: ApiContext<State<A, C, S>>,
+        request_metadata: RequestMetadata,
+    ) -> UcResult<()> {
+        schemas::delete_schema::<C, A, S>(full_name, query, state, request_metadata).await
+    }
+}
diff --git a/crates/lakekeeper/src/server/uc/resolve.rs b/crates/lakekeeper/src/server/uc/resolve.rs
new file mode 100644
index 00000000..992a33ba
--- /dev/null
+++ b/crates/lakekeeper/src/server/uc/resolve.rs
@@ -0,0 +1,129 @@
+//! Name resolution for the Unity Catalog compatibility API:
+//! UC `catalog_name` → warehouse in the caller's (default) project,
+//! UC `schema` (part of `full_name`) → top-level namespace.
+
+use std::sync::Arc;
+
+use iceberg::NamespaceIdent;
+use iceberg_ext::catalog::rest::IcebergErrorResponse;
+
+use crate::{
+    api::uc::{UcErrorResponse, UcResult},
+    request_metadata::RequestMetadata,
+    service::{
+        CachePolicy, CatalogNamespaceOps, CatalogStore, CatalogWarehouseOps, NamespaceHierarchy,
+        ResolvedWarehouse, WarehouseId, WarehouseStatus,
+        authz::{Authorizer, AuthzNamespaceOps},
+        events::context::{UserProvidedNamespace, authz_to_error_no_audit},
+    },
+};
+
+/// Convert any Lakekeeper API error into the UC error envelope, preserving
+/// the HTTP status code.
+pub(crate) fn uc_err(e: impl Into<IcebergErrorResponse>) -> UcErrorResponse {
+    UcErrorResponse::from(e.into())
+}
+
+/// Resolve a UC `catalog_name` to an active warehouse of the caller's
+/// project (the default project for requests without an explicit project).
+///
+/// Performs no authorization — callers must authorize the warehouse (or an
+/// operation on one of its children, which masks non-visible warehouses as
+/// 404) before returning warehouse data to the client.
+pub(crate) async fn resolve_catalog_warehouse<C: CatalogStore>(
+    request_metadata: &RequestMetadata,
+    catalog_name: &str,
+    catalog_state: C::State,
+) -> UcResult<Arc<ResolvedWarehouse>> {
+    let project_id = request_metadata.require_project_id(None).map_err(uc_err)?;
+    C::get_warehouse_by_name(
+        catalog_name,
+        &project_id,
+        WarehouseStatus::active(),
+        catalog_state,
+    )
+    .await
+    .map_err(uc_err)?
+    .ok_or_else(|| catalog_not_found(catalog_name))
+}
+
+pub(crate) fn catalog_not_found(catalog_name: &str) -> UcErrorResponse {
+    UcErrorResponse::not_found(format!("Catalog not found: {catalog_name}"))
+}
+
+/// Split a UC schema `full_name` (`<catalog>.<schema>`) into its parts.
+/// UC schemas map to top-level namespaces, so the schema part must be a
+/// single (dot-free) name.
+pub(crate) fn split_schema_full_name(full_name: &str) -> UcResult<(&str, &str)> {
+    match full_name.split_once('.') {
+        Some((catalog, schema))
+            if !catalog.is_empty() && !schema.is_empty() && !schema.contains('.') =>
+        {
+            Ok((catalog, schema))
+        }
+        _ => Err(UcErrorResponse::invalid_argument(format!(
+            "Invalid schema full name '{full_name}'. Expected '<catalog>.<schema>'."
+        ))),
+    }
+}
+
+/// Resolve a UC schema name to its top-level namespace, authorizing `action`
+/// (non-visible namespaces are masked as 404 by the authorizer).
+pub(crate) async fn resolve_schema_namespace<C: CatalogStore, A: Authorizer>(
+    authorizer: &A,
+    request_metadata: &RequestMetadata,
+    warehouse_id: WarehouseId,
+    schema_name: &str,
+    action: impl Into<A::NamespaceAction> + Send,
+    catalog_state: C::State,
+) -> UcResult<(Arc<ResolvedWarehouse>, NamespaceHierarchy)> {
+    let namespace = NamespaceIdent::new(schema_name.to_string());
+    authorizer
+        .load_and_authorize_namespace_action::<C>(
+            request_metadata,
+            UserProvidedNamespace::new(warehouse_id, namespace),
+            action,
+            CachePolicy::Skip,
+            catalog_state,
+        )
+        .await
+        .map_err(|e| uc_err(authz_to_error_no_audit(e)))
+}
+
+/// Fetch a namespace that is known to exist (e.g. right after creating or
+/// updating it). Skips the namespace cache so fresh mutations are visible.
+pub(crate) async fn require_namespace<C: CatalogStore>(
+    warehouse_id: WarehouseId,
+    namespace: &NamespaceIdent,
+    catalog_state: C::State,
+) -> UcResult<NamespaceHierarchy> {
+    C::get_namespace_cache_aware(
+        warehouse_id,
+        namespace.clone(),
+        CachePolicy::Skip,
+        catalog_state,
+    )
+    .await
+    .map_err(uc_err)?
+    .ok_or_else(|| {
+        UcErrorResponse::not_found(format!("Schema not found: {}", namespace.to_url_string()))
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn test_split_schema_full_name() {
+        assert_eq!(
+            split_schema_full_name("cat.schema").unwrap(),
+            ("cat", "schema")
+        );
+        for bad in ["", "cat", "cat.", ".schema", "cat.a.b", "."] {
+            let err = split_schema_full_name(bad).unwrap_err();
+            assert_eq!(err.status, 400, "{bad}");
+            assert_eq!(err.error_code, "INVALID_ARGUMENT", "{bad}");
+        }
+    }
+}
diff --git a/crates/lakekeeper/src/server/uc/schemas.rs b/crates/lakekeeper/src/server/uc/schemas.rs
new file mode 100644
index 00000000..33d78618
--- /dev/null
+++ b/crates/lakekeeper/src/server/uc/schemas.rs
@@ -0,0 +1,305 @@
+//! UC Schemas handlers. Delegate to the Iceberg REST namespace handlers
+//! (`NamespaceService` on `CatalogServer`) so authorization, idempotency and
+//! authorizer bookkeeping stay identical to the Iceberg surface, then map
+//! namespaces to the UC `SchemaInfo` wire shape.
+
+use std::collections::HashMap;
+
+use iceberg::NamespaceIdent;
+use iceberg_ext::catalog::rest::{CreateNamespaceRequest, UpdateNamespacePropertiesRequest};
+
+use crate::{
+    api::{
+        ApiContext,
+        iceberg::v1::{
+            ListNamespacesQuery, PageToken,
+            namespace::{NamespaceDropFlags, NamespaceParameters, NamespaceService as _},
+        },
+        uc::{
+            UcErrorResponse, UcResult, effective_page_size, to_epoch_millis,
+            v1::{
+                CreateSchemaRequest, DeleteSchemaQuery, ListSchemasQuery, ListSchemasResponse,
+                SchemaInfo, UpdateSchemaRequest,
+            },
+        },
+    },
+    request_metadata::RequestMetadata,
+    server::{
+        CatalogServer,
+        uc::resolve::{
+            require_namespace, resolve_catalog_warehouse, resolve_schema_namespace,
+            split_schema_full_name, uc_err,
+        },
+    },
+    service::{
+        CatalogNamespaceOps, CatalogStore, NamespaceWithParent, SecretStore, State, WarehouseId,
+        authz::{Authorizer, CatalogNamespaceAction},
+    },
+};
+
+/// Namespace property carrying the UC schema `comment`.
+const COMMENT_PROPERTY: &str = "comment";
+
+fn schema_info(catalog_name: &str, namespace: &NamespaceWithParent) -> SchemaInfo {
+    let name = namespace.namespace_ident().as_ref().join(".");
+    let mut properties = namespace.properties().cloned().unwrap_or_default();
+    let comment = properties.remove(COMMENT_PROPERTY);
+    SchemaInfo {
+        full_name: format!("{catalog_name}.{name}"),
+        name,
+        catalog_name: catalog_name.to_string(),
+        comment,
+        properties,
+        owner: None,
+        created_at: Some(to_epoch_millis(namespace.created_at())),
+        updated_at: namespace.updated_at().map(to_epoch_millis),
+        schema_id: Some(namespace.namespace_id().to_string()),
+    }
+}
+
+fn namespace_parameters(warehouse_id: WarehouseId, namespace: &NamespaceIdent) -> NamespaceParameters {
+    NamespaceParameters {
+        prefix: Some(warehouse_id.to_string().into()),
+        namespace: namespace.clone(),
+    }
+}
+
+pub(crate) async fn create_schema<C: CatalogStore, A: Authorizer + Clone, S: SecretStore>(
+    request: CreateSchemaRequest,
+    state: ApiContext<State<A, C, S>>,
+    request_metadata: RequestMetadata,
+) -> UcResult<SchemaInfo> {
+    let CreateSchemaRequest {
+        name,
+        catalog_name,
+        comment,
+        mut properties,
+        storage_root,
+    } = request;
+    if storage_root.is_some() {
+        return Err(UcErrorResponse::invalid_argument(
+            "storage_root is not supported by the Unity Catalog compatibility API. \
+             Schema locations are derived from the warehouse storage profile.",
+        ));
+    }
+    if name.contains('.') {
+        return Err(UcErrorResponse::invalid_argument(format!(
+            "Invalid schema name '{name}': schema names must not contain '.'."
+        )));
+    }
+
+    let warehouse = resolve_catalog_warehouse::<C>(
+        &request_metadata,
+        &catalog_name,
+        state.v1_state.catalog.clone(),
+    )
+    .await?;
+    let warehouse_id = warehouse.warehouse_id;
+
+    if let Some(comment) = comment {
+        properties.insert(COMMENT_PROPERTY.to_string(), comment);
+    }
+    let namespace = NamespaceIdent::new(name);
+
+    // Authorization (`CreateNamespace` on the warehouse) happens inside the
+    // delegated handler.
+    CatalogServer::<C, A, S>::create_namespace(
+        Some(warehouse_id.to_string().into()),
+        CreateNamespaceRequest {
+            namespace: namespace.clone(),
+            properties: Some(properties),
+        },
+        state.clone(),
+        request_metadata.clone(),
+    )
+    .await
+    .map_err(uc_err)?;
+
+    // Re-fetch for the server-populated fields (id, timestamps, location).
+    let hierarchy =
+        require_namespace::<C>(warehouse_id, &namespace, state.v1_state.catalog).await?;
+    Ok(schema_info(&catalog_name, &hierarchy.namespace))
+}
+
+pub(crate) async fn list_schemas<C: CatalogStore, A: Authorizer + Clone, S: SecretStore>(
+    query: ListSchemasQuery,
+    state: ApiContext<State<A, C, S>>,
+    request_metadata: RequestMetadata,
+) -> UcResult<ListSchemasResponse> {
+    let ListSchemasQuery {
+        catalog_name,
+        max_results,
+        page_token,
+    } = query;
+    let page_size = effective_page_size(max_results)?;
+    let warehouse = resolve_catalog_warehouse::<C>(
+        &request_metadata,
+        &catalog_name,
+        state.v1_state.catalog.clone(),
+    )
+    .await?;
+    let warehouse_id = warehouse.warehouse_id;
+
+    // Top-level namespaces only (parent = None). Authorization
+    // (`ListNamespaces` + per-namespace `IncludeInList`) happens inside the
+    // delegated handler.
+    let response = CatalogServer::<C, A, S>::list_namespaces(
+        Some(warehouse_id.to_string().into()),
+        ListNamespacesQuery {
+            page_token: page_token.map_or(PageToken::Empty, PageToken::Present),
+            page_size: Some(page_size),
+            parent: None,
+            return_uuids: false,
+            return_protection_status: false,
+        },
+        state.clone(),
+        request_metadata,
+    )
+    .await
+    .map_err(uc_err)?;
+
+    // Enrich with per-namespace metadata (id, timestamps, comment). The
+    // listed namespaces passed `IncludeInList`, so reading their metadata
+    // does not leak anything; races with concurrent drops simply skip.
+    let mut schemas = Vec::with_capacity(response.namespaces.len());
+    let lookups = response.namespaces.iter().map(|namespace_ident| {
+        let catalog_state = state.v1_state.catalog.clone();
+        async move {
+            C::get_namespace_cache_aware(
+                warehouse_id,
+                namespace_ident.clone(),
+                crate::service::CachePolicy::Skip,
+                catalog_state,
+            )
+            .await
+        }
+    });
+    for hierarchy in futures::future::try_join_all(lookups).await.map_err(uc_err)? {
+        if let Some(hierarchy) = hierarchy {
+            schemas.push(schema_info(&catalog_name, &hierarchy.namespace));
+        }
+    }
+
+    Ok(ListSchemasResponse {
+        schemas,
+        next_page_token: response.next_page_token,
+    })
+}
+
+pub(crate) async fn get_schema<C: CatalogStore, A: Authorizer + Clone, S: SecretStore>(
+    full_name: String,
+    state: ApiContext<State<A, C, S>>,
+    request_metadata: RequestMetadata,
+) -> UcResult<SchemaInfo> {
+    let (catalog_name, schema_name) = split_schema_full_name(&full_name)?;
+    let warehouse = resolve_catalog_warehouse::<C>(
+        &request_metadata,
+        catalog_name,
+        state.v1_state.catalog.clone(),
+    )
+    .await?;
+
+    let (_warehouse, hierarchy) = resolve_schema_namespace::<C, A>(
+        &state.v1_state.authz,
+        &request_metadata,
+        warehouse.warehouse_id,
+        schema_name,
+        CatalogNamespaceAction::GetMetadata,
+        state.v1_state.catalog,
+    )
+    .await?;
+
+    Ok(schema_info(catalog_name, &hierarchy.namespace))
+}
+
+pub(crate) async fn update_schema<C: CatalogStore, A: Authorizer + Clone, S: SecretStore>(
+    full_name: String,
+    request: UpdateSchemaRequest,
+    state: ApiContext<State<A, C, S>>,
+    request_metadata: RequestMetadata,
+) -> UcResult<SchemaInfo> {
+    let UpdateSchemaRequest {
+        comment,
+        properties,
+        new_name,
+    } = request;
+    if new_name.is_some() {
+        return Err(UcErrorResponse::invalid_argument(
+            "Renaming schemas is not supported by the Unity Catalog compatibility API.",
+        ));
+    }
+    let (catalog_name, schema_name) = split_schema_full_name(&full_name)?;
+    let warehouse = resolve_catalog_warehouse::<C>(
+        &request_metadata,
+        catalog_name,
+        state.v1_state.catalog.clone(),
+    )
+    .await?;
+    let warehouse_id = warehouse.warehouse_id;
+    let namespace = NamespaceIdent::new(schema_name.to_string());
+
+    let mut updates: HashMap<String, String> = properties.unwrap_or_default();
+    if let Some(comment) = comment {
+        updates.insert(COMMENT_PROPERTY.to_string(), comment);
+    }
+
+    if updates.is_empty() {
+        // Nothing to change; behave like a get (incl. authorization).
+        return get_schema::<C, A, S>(full_name, state, request_metadata).await;
+    }
+
+    // Authorization (`UpdateProperties` on the namespace) happens inside the
+    // delegated handler; missing namespaces surface as 404.
+    CatalogServer::<C, A, S>::update_namespace_properties(
+        namespace_parameters(warehouse_id, &namespace),
+        UpdateNamespacePropertiesRequest {
+            removals: None,
+            updates: Some(updates),
+        },
+        state.clone(),
+        request_metadata.clone(),
+    )
+    .await
+    .map_err(uc_err)?;
+
+    let hierarchy =
+        require_namespace::<C>(warehouse_id, &namespace, state.v1_state.catalog).await?;
+    Ok(schema_info(catalog_name, &hierarchy.namespace))
+}
+
+pub(crate) async fn delete_schema<C: CatalogStore, A: Authorizer + Clone, S: SecretStore>(
+    full_name: String,
+    query: DeleteSchemaQuery,
+    state: ApiContext<State<A, C, S>>,
+    request_metadata: RequestMetadata,
+) -> UcResult<()> {
+    let (catalog_name, schema_name) = split_schema_full_name(&full_name)?;
+    let warehouse = resolve_catalog_warehouse::<C>(
+        &request_metadata,
+        catalog_name,
+        state.v1_state.catalog.clone(),
+    )
+    .await?;
+    let namespace = NamespaceIdent::new(schema_name.to_string());
+
+    // Non-recursive drop: fails when the schema is not empty. UC reports
+    // that as a 400 rather than Lakekeeper's 409.
+    CatalogServer::<C, A, S>::drop_namespace(
+        namespace_parameters(warehouse.warehouse_id, &namespace),
+        NamespaceDropFlags {
+            force: query.force,
+            purge: false,
+            recursive: false,
+        },
+        state,
+        request_metadata,
+    )
+    .await
+    .map_err(|e| {
+        if e.error.r#type == "NamespaceNotEmptyException" {
+            UcErrorResponse::invalid_argument(e.error.message)
+        } else {
+            uc_err(e)
+        }
+    })
+}
-- 
