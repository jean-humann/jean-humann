+//! UC Catalogs endpoints. UC catalogs map read-only onto Lakekeeper
+//! warehouses of the default project; create/update/delete go through the
+//! Lakekeeper management API instead.
+
+use std::collections::HashMap;
+
+use axum::{
+    Extension,
+    extract::{Path, Query, State},
+};
+use serde::{Deserialize, Serialize};
+
+use super::UcCatalogService;
+use crate::{
+    api::{
+        ApiContext,
+        uc::{UcErrorResponse, UcPaginationQuery, UcResult},
+    },
+    request_metadata::RequestMetadata,
+};
+
+/// UC `CatalogInfo`. UC DTOs use snake_case field names (serde default).
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct CatalogInfo {
+    pub name: String,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub comment: Option<String>,
+    #[serde(default)]
+    pub properties: HashMap<String, String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub owner: Option<String>,
+    /// Epoch milliseconds. Lakekeeper warehouses do not track a creation
+    /// timestamp, so this is omitted.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub created_at: Option<i64>,
+    /// Epoch milliseconds.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub updated_at: Option<i64>,
+    /// Warehouse ID.
+    pub id: String,
+}
+
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct ListCatalogsResponse {
+    #[serde(default)]
+    pub catalogs: Vec<CatalogInfo>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub next_page_token: Option<String>,
+}
+
+impl axum::response::IntoResponse for CatalogInfo {
+    fn into_response(self) -> axum::response::Response {
+        axum::Json(self).into_response()
+    }
+}
+
+impl axum::response::IntoResponse for ListCatalogsResponse {
+    fn into_response(self) -> axum::response::Response {
+        axum::Json(self).into_response()
+    }
+}
+
+pub(crate) async fn list_catalogs<I: UcCatalogService<S>, S: crate::api::ThreadSafe>(
+    Query(query): Query<UcPaginationQuery>,
+    State(api_context): State<ApiContext<S>>,
+    Extension(metadata): Extension<RequestMetadata>,
+) -> UcResult<ListCatalogsResponse> {
+    I::list_catalogs(query, api_context, metadata).await
+}
+
+pub(crate) async fn get_catalog<I: UcCatalogService<S>, S: crate::api::ThreadSafe>(
+    Path(name): Path<String>,
+    State(api_context): State<ApiContext<S>>,
+    Extension(metadata): Extension<RequestMetadata>,
+) -> UcResult<CatalogInfo> {
+    I::get_catalog(name, api_context, metadata).await
+}
+
+fn manage_catalogs_via_management_api(operation: &str) -> UcErrorResponse {
+    UcErrorResponse::invalid_argument(format!(
+        "{operation} catalogs is not supported by the Unity Catalog compatibility API. \
+         UC catalogs map to Lakekeeper warehouses; use the Lakekeeper management API \
+         (/management/v1/warehouse) to manage them."
+    ))
+}
+
+pub(crate) async fn create_catalog_unsupported() -> UcErrorResponse {
+    manage_catalogs_via_management_api("Creating")
+}
+
+pub(crate) async fn update_catalog_unsupported() -> UcErrorResponse {
+    manage_catalogs_via_management_api("Updating")
+}
+
+pub(crate) async fn delete_catalog_unsupported() -> UcErrorResponse {
+    manage_catalogs_via_management_api("Deleting")
+}
diff --git a/crates/lakekeeper/src/api/uc/v1/mod.rs b/crates/lakekeeper/src/api/uc/v1/mod.rs
new file mode 100644
index 00000000..dd22cd2e
--- /dev/null
+++ b/crates/lakekeeper/src/api/uc/v1/mod.rs
@@ -0,0 +1,98 @@
+//! Unity Catalog API v1 (`/api/2.1/unity-catalog`): routes, DTOs and the
+//! [`UcCatalogService`] trait implemented by `crate::server::CatalogServer`.
+
+pub mod catalogs;
+pub mod schemas;
+
+use async_trait::async_trait;
+use axum::{
+    Router,
+    routing::{get, post},
+};
+
+pub use self::{
+    catalogs::{CatalogInfo, ListCatalogsResponse},
+    schemas::{
+        CreateSchemaRequest, DeleteSchemaQuery, ListSchemasQuery, ListSchemasResponse, SchemaInfo,
+        UpdateSchemaRequest,
+    },
+};
+use super::{UcPaginationQuery, UcResult};
+use crate::{api::ApiContext, request_metadata::RequestMetadata};
+
+/// Handler backend for the Unity Catalog-compatible API. Keeps the axum
+/// handlers thin; implemented by `crate::server::CatalogServer`.
+#[async_trait]
+pub trait UcCatalogService<S: crate::api::ThreadSafe>
+where
+    Self: Send + Sync + 'static,
+{
+    async fn list_catalogs(
+        query: UcPaginationQuery,
+        state: ApiContext<S>,
+        request_metadata: RequestMetadata,
+    ) -> UcResult<ListCatalogsResponse>;
+
+    async fn get_catalog(
+        name: String,
+        state: ApiContext<S>,
+        request_metadata: RequestMetadata,
+    ) -> UcResult<CatalogInfo>;
+
+    async fn create_schema(
+        request: CreateSchemaRequest,
+        state: ApiContext<S>,
+        request_metadata: RequestMetadata,
+    ) -> UcResult<SchemaInfo>;
+
+    async fn list_schemas(
+        query: ListSchemasQuery,
+        state: ApiContext<S>,
+        request_metadata: RequestMetadata,
+    ) -> UcResult<ListSchemasResponse>;
+
+    /// `full_name` is `<catalog>.<schema>`.
+    async fn get_schema(
+        full_name: String,
+        state: ApiContext<S>,
+        request_metadata: RequestMetadata,
+    ) -> UcResult<SchemaInfo>;
+
+    async fn update_schema(
+        full_name: String,
+        request: UpdateSchemaRequest,
+        state: ApiContext<S>,
+        request_metadata: RequestMetadata,
+    ) -> UcResult<SchemaInfo>;
+
+    async fn delete_schema(
+        full_name: String,
+        query: DeleteSchemaQuery,
+        state: ApiContext<S>,
+        request_metadata: RequestMetadata,
+    ) -> UcResult<()>;
+}
+
+pub fn router<I: UcCatalogService<S>, S: crate::api::ThreadSafe>() -> Router<ApiContext<S>> {
+    Router::new()
+        .route(
+            "/catalogs",
+            get(catalogs::list_catalogs::<I, S>).post(catalogs::create_catalog_unsupported),
+        )
+        .route(
+            "/catalogs/{name}",
+            get(catalogs::get_catalog::<I, S>)
+                .patch(catalogs::update_catalog_unsupported)
+                .delete(catalogs::delete_catalog_unsupported),
+        )
+        .route(
+            "/schemas",
+            post(schemas::create_schema::<I, S>).get(schemas::list_schemas::<I, S>),
+        )
+        .route(
+            "/schemas/{full_name}",
+            get(schemas::get_schema::<I, S>)
+                .patch(schemas::update_schema::<I, S>)
+                .delete(schemas::delete_schema::<I, S>),
+        )
+}
