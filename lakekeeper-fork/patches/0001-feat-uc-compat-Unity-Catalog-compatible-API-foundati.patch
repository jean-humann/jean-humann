+//! Unity Catalog compatibility API (Phase A): Catalogs + Schemas handlers,
+//! driven through the `UcCatalogService` trait on `CatalogServer` (same
+//! harness as `server_generic_tables.rs`).
+
+use std::collections::HashMap;
+
+use iceberg::NamespaceIdent;
+use lakekeeper::{
+    api::{
+        ApiContext,
+        iceberg::v1::namespace::{NamespaceDropFlags, NamespaceParameters, NamespaceService as _},
+        uc::{
+            UcPaginationQuery,
+            v1::{
+                CreateSchemaRequest, DeleteSchemaQuery, ListSchemasQuery, UcCatalogService as _,
+                UpdateSchemaRequest,
+            },
+        },
+    },
+    server::CatalogServer,
+    service::{
+        CatalogStore, CatalogWarehouseOps as _, State, Transaction as _,
+        authz::AllowAllAuthorizer,
+        storage::{MemoryProfile, StorageProfile},
+    },
+};
+use lakekeeper_integration_tests::{get_api_context, random_request_metadata};
+use lakekeeper_storage_postgres::{
+    PostgresBackend, SecretsState, warehouse::test::initialize_warehouse,
+};
+use sqlx::PgPool;
+
+type Ctx = ApiContext<State<AllowAllAuthorizer, PostgresBackend, SecretsState>>;
+
+/// Returns `(ctx, warehouse_id, catalog_name)`. The warehouse gets a unique
+/// name: the warehouse name→id cache is process-global, while every
+/// `#[sqlx::test]` runs against its own database — a shared name would make
+/// concurrent tests resolve each other's warehouses.
+async fn setup(pool: PgPool) -> (Ctx, lakekeeper::WarehouseId, String) {
+    lakekeeper_storage_postgres::migrations::migrate_core_only(&pool)
+        .await
+        .unwrap();
+    let api_context = get_api_context(&pool, AllowAllAuthorizer::default()).await;
+    let state = api_context.v1_state.catalog.clone();
+    // Creates a warehouse in the default (nil) project.
+    let (_project_id, warehouse_id) = initialize_warehouse(
+        state.clone(),
+        Some(StorageProfile::Memory(MemoryProfile::default())),
+        None,
+        None,
+        true,
+    )
+    .await;
+
+    let catalog_name = format!("uc_wh_{}", uuid::Uuid::now_v7().simple());
+    let mut t = <PostgresBackend as CatalogStore>::Transaction::begin_write(state)
+        .await
+        .unwrap();
+    PostgresBackend::rename_warehouse(warehouse_id, &catalog_name, t.transaction())
+        .await
+        .unwrap();
+    t.commit().await.unwrap();
+
+    (api_context, warehouse_id, catalog_name)
+}
+
+fn create_schema_request(catalog_name: &str, name: &str) -> CreateSchemaRequest {
+    CreateSchemaRequest {
+        name: name.to_string(),
+        catalog_name: catalog_name.to_string(),
+        comment: Some("a test schema".to_string()),
+        properties: HashMap::from([("owner_team".to_string(), "data".to_string())]),
+        storage_root: None,
+    }
+}
+
+#[sqlx::test]
+async fn test_list_catalogs_contains_warehouse(pool: PgPool) {
+    let (ctx, warehouse_id, catalog_name) = setup(pool).await;
+
+    let response = CatalogServer::list_catalogs(
+        UcPaginationQuery::default(),
+        ctx.clone(),
+        random_request_metadata(),
+    )
+    .await
+    .unwrap();
+    assert!(response.next_page_token.is_none());
+    let catalog = response
+        .catalogs
+        .iter()
+        .find(|c| c.name == catalog_name)
+        .expect("warehouse must be listed as UC catalog");
+    assert_eq!(catalog.id, warehouse_id.to_string());
+    assert!(catalog.comment.is_none());
+    assert!(catalog.properties.is_empty());
+}
+
+#[sqlx::test]
+async fn test_get_catalog(pool: PgPool) {
+    let (ctx, warehouse_id, catalog_name) = setup(pool).await;
+
+    let catalog =
+        CatalogServer::get_catalog(catalog_name.clone(), ctx.clone(), random_request_metadata())
+            .await
+            .unwrap();
+    assert_eq!(catalog.name, catalog_name);
+    assert_eq!(catalog.id, warehouse_id.to_string());
+
+    let err = CatalogServer::get_catalog(
+        "no_such_warehouse".to_string(),
+        ctx,
+        random_request_metadata(),
+    )
+    .await
+    .unwrap_err();
+    assert_eq!(err.status, 404, "{err:?}");
+    assert_eq!(err.error_code, "NOT_FOUND");
+}
+
+#[sqlx::test]
+async fn test_schema_crud_roundtrip(pool: PgPool) {
+    let (ctx, _warehouse_id, catalog_name) = setup(pool).await;
+
+    // Create
+    let created = CatalogServer::create_schema(
+        create_schema_request(&catalog_name, "uc_schema"),
+        ctx.clone(),
+        random_request_metadata(),
+    )
+    .await
+    .unwrap();
+    assert_eq!(created.name, "uc_schema");
+    assert_eq!(created.catalog_name, catalog_name);
+    assert_eq!(created.full_name, format!("{catalog_name}.uc_schema"));
+    assert_eq!(created.comment.as_deref(), Some("a test schema"));
+    assert_eq!(
+        created.properties.get("owner_team").map(String::as_str),
+        Some("data")
+    );
+    assert!(created.schema_id.is_some());
+    assert!(created.created_at.is_some());
+
+    // Get
+    let fetched = CatalogServer::get_schema(
+        created.full_name.clone(),
+        ctx.clone(),
+        random_request_metadata(),
+    )
+    .await
+    .unwrap();
+    assert_eq!(fetched.schema_id, created.schema_id);
+    assert_eq!(fetched.full_name, created.full_name);
+    assert_eq!(fetched.comment, created.comment);
+    assert_eq!(fetched.created_at, created.created_at);
+
+    // List
+    let listed = CatalogServer::list_schemas(
+        ListSchemasQuery {
+            catalog_name: catalog_name.clone(),
+            max_results: None,
+            page_token: None,
+        },
+        ctx.clone(),
+        random_request_metadata(),
+    )
+    .await
+    .unwrap();
+    let entry = listed
+        .schemas
+        .iter()
+        .find(|s| s.name == "uc_schema")
+        .expect("created schema must be listed");
+    assert_eq!(entry.schema_id, created.schema_id);
+    assert_eq!(entry.comment.as_deref(), Some("a test schema"));
+
+    // Update comment + properties
+    let updated = CatalogServer::update_schema(
+        created.full_name.clone(),
+        UpdateSchemaRequest {
+            comment: Some("updated comment".to_string()),
+            properties: Some(HashMap::from([("tier".to_string(), "gold".to_string())])),
+            new_name: None,
+        },
+        ctx.clone(),
+        random_request_metadata(),
+    )
+    .await
+    .unwrap();
+    assert_eq!(updated.comment.as_deref(), Some("updated comment"));
+    assert_eq!(
+        updated.properties.get("tier").map(String::as_str),
+        Some("gold")
+    );
+    // Pre-existing properties are preserved.
+    assert_eq!(
+        updated.properties.get("owner_team").map(String::as_str),
+        Some("data")
+    );
+
+    // Rename is not supported.
+    let err = CatalogServer::update_schema(
+        created.full_name.clone(),
+        UpdateSchemaRequest {
+            comment: None,
+            properties: None,
+            new_name: Some("renamed".to_string()),
+        },
+        ctx.clone(),
+        random_request_metadata(),
+    )
+    .await
+    .unwrap_err();
+    assert_eq!(err.status, 400, "{err:?}");
+    assert_eq!(err.error_code, "INVALID_ARGUMENT");
+
+    // Delete
+    CatalogServer::delete_schema(
+        created.full_name.clone(),
+        DeleteSchemaQuery::default(),
+        ctx.clone(),
+        random_request_metadata(),
+    )
+    .await
+    .unwrap();
+
+    // Get after delete -> 404 NOT_FOUND
+    let err = CatalogServer::get_schema(created.full_name, ctx, random_request_metadata())
+        .await
+        .unwrap_err();
+    assert_eq!(err.status, 404, "{err:?}");
+    assert_eq!(err.error_code, "NOT_FOUND");
+}
+
+#[sqlx::test]
+async fn test_get_missing_schema_is_404(pool: PgPool) {
+    let (ctx, _, catalog_name) = setup(pool).await;
+    let err = CatalogServer::get_schema(
+        format!("{catalog_name}.does_not_exist"),
+        ctx.clone(),
+        random_request_metadata(),
+    )
+    .await
+    .unwrap_err();
+    assert_eq!(err.status, 404, "{err:?}");
+    assert_eq!(err.error_code, "NOT_FOUND");
+
+    // Missing catalog is a 404 as well.
+    let err = CatalogServer::get_schema(
+        "no_such_catalog.does_not_exist".to_string(),
+        ctx,
+        random_request_metadata(),
+    )
+    .await
+    .unwrap_err();
+    assert_eq!(err.status, 404, "{err:?}");
+    assert_eq!(err.error_code, "NOT_FOUND");
+}
+
+#[sqlx::test]
+async fn test_invalid_full_name_is_400(pool: PgPool) {
+    let (ctx, _, _) = setup(pool).await;
+    for bad in ["nodot", "cat.a.b", ".schema", "cat."] {
+        let err =
+            CatalogServer::get_schema(bad.to_string(), ctx.clone(), random_request_metadata())
+                .await
+                .unwrap_err();
+        assert_eq!(err.status, 400, "{bad}: {err:?}");
+        assert_eq!(err.error_code, "INVALID_ARGUMENT", "{bad}");
+    }
+}
+
+#[sqlx::test]
+async fn test_delete_missing_schema_is_404(pool: PgPool) {
+    let (ctx, _, catalog_name) = setup(pool).await;
+    let err = CatalogServer::delete_schema(
+        format!("{catalog_name}.does_not_exist"),
+        DeleteSchemaQuery::default(),
+        ctx,
+        random_request_metadata(),
+    )
+    .await
+    .unwrap_err();
+    assert_eq!(err.status, 404, "{err:?}");
+    assert_eq!(err.error_code, "NOT_FOUND");
+}
+
+#[sqlx::test]
+async fn test_delete_non_empty_schema_maps_to_400(pool: PgPool) {
+    let (ctx, warehouse_id, catalog_name) = setup(pool).await;
+
+    CatalogServer::create_schema(
+        create_schema_request(&catalog_name, "non_empty"),
+        ctx.clone(),
+        random_request_metadata(),
+    )
+    .await
+    .unwrap();
+
+    // Make the schema non-empty with a nested namespace (created through the
+    // Iceberg REST surface; UC only sees depth-1 namespaces).
+    let child =
+        NamespaceIdent::from_vec(vec!["non_empty".to_string(), "child".to_string()]).unwrap();
+    CatalogServer::create_namespace(
+        Some(warehouse_id.to_string().into()),
+        lakekeeper::api::CreateNamespaceRequest {
+            namespace: child.clone(),
+            properties: None,
+        },
+        ctx.clone(),
+        random_request_metadata(),
+    )
+    .await
+    .unwrap();
+
+    let err = CatalogServer::delete_schema(
+        format!("{catalog_name}.non_empty"),
+        DeleteSchemaQuery::default(),
+        ctx.clone(),
+        random_request_metadata(),
+    )
+    .await
+    .unwrap_err();
+    assert_eq!(err.status, 400, "{err:?}");
+    assert_eq!(err.error_code, "INVALID_ARGUMENT");
+
+    // After dropping the child, the schema can be deleted.
+    CatalogServer::drop_namespace(
+        NamespaceParameters {
+            prefix: Some(warehouse_id.to_string().into()),
+            namespace: child,
+        },
+        NamespaceDropFlags {
+            force: false,
+            purge: false,
+            recursive: false,
+        },
+        ctx.clone(),
+        random_request_metadata(),
+    )
+    .await
+    .unwrap();
+    CatalogServer::delete_schema(
+        format!("{catalog_name}.non_empty"),
+        DeleteSchemaQuery::default(),
+        ctx,
+        random_request_metadata(),
+    )
+    .await
+    .unwrap();
+}
+
+#[sqlx::test]
+async fn test_list_schemas_pagination(pool: PgPool) {
+    let (ctx, _, catalog_name) = setup(pool).await;
+
+    for name in ["pag_a", "pag_b", "pag_c"] {
+        CatalogServer::create_schema(
+            create_schema_request(&catalog_name, name),
+            ctx.clone(),
+            random_request_metadata(),
+        )
+        .await
+        .unwrap();
+    }
+
+    // Negative max_results is rejected.
+    let err = CatalogServer::list_schemas(
+        ListSchemasQuery {
+            catalog_name: catalog_name.clone(),
+            max_results: Some(-1),
+            page_token: None,
+        },
+        ctx.clone(),
+        random_request_metadata(),
+    )
+    .await
+    .unwrap_err();
+    assert_eq!(err.status, 400, "{err:?}");
+    assert_eq!(err.error_code, "INVALID_ARGUMENT");
+
+    // Page through with max_results=2 and collect everything.
+    let mut collected = Vec::new();
+    let mut page_token = None;
+    loop {
+        let page = CatalogServer::list_schemas(
+            ListSchemasQuery {
+                catalog_name: catalog_name.clone(),
+                max_results: Some(2),
+                page_token,
+            },
+            ctx.clone(),
+            random_request_metadata(),
+        )
+        .await
+        .unwrap();
+        assert!(page.schemas.len() <= 2);
+        collected.extend(page.schemas.into_iter().map(|s| s.name));
+        page_token = page.next_page_token;
+        if page_token.is_none() {
+            break;
+        }
+    }
+    for name in ["pag_a", "pag_b", "pag_c"] {
+        assert!(collected.contains(&name.to_string()), "{collected:?}");
+    }
+}
