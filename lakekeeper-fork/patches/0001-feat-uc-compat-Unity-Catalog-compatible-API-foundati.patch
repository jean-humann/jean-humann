diff --git a/crates/lakekeeper/src/server/uc/catalogs.rs b/crates/lakekeeper/src/server/uc/catalogs.rs
new file mode 100644
index 00000000..2b0226d2
--- /dev/null
+++ b/crates/lakekeeper/src/server/uc/catalogs.rs
@@ -0,0 +1,135 @@
+//! UC Catalogs handlers: read-only view of the warehouses in the caller's
+//! (default) project. Mirrors the management API's list/get warehouse
+//! authorization (`ListWarehouses` + `IncludeInList`, `GetMetadata`).
+
+use std::collections::HashMap;
+
+use crate::{
+    api::{
+        ApiContext,
+        uc::{
+            UcErrorResponse, UcPaginationQuery, UcResult, effective_page_size, to_epoch_millis,
+            v1::{CatalogInfo, ListCatalogsResponse},
+        },
+    },
+    request_metadata::RequestMetadata,
+    server::uc::resolve::{resolve_catalog_warehouse, uc_err},
+    service::{
+        CatalogGetWarehouseByIdError, CatalogStore, CatalogWarehouseOps, ResolvedWarehouse,
+        SecretStore, State,
+        authz::{
+            AuthZProjectOps, Authorizer, AuthzWarehouseOps, CatalogProjectAction,
+            CatalogWarehouseAction,
+        },
+        events::context::authz_to_error_no_audit,
+    },
+};
+
+fn catalog_info(warehouse: &ResolvedWarehouse) -> CatalogInfo {
+    CatalogInfo {
+        name: warehouse.name.clone(),
+        comment: None,
+        properties: HashMap::new(),
+        owner: None,
+        // Warehouses do not track a creation timestamp.
+        created_at: None,
+        updated_at: warehouse.updated_at.map(to_epoch_millis),
+        id: warehouse.warehouse_id.to_string(),
+    }
+}
+
+/// Parse the offset carried by a UC catalogs `page_token` (client-side
+/// pagination over the full, name-sorted warehouse list).
+fn parse_offset_token(page_token: Option<&str>) -> UcResult<usize> {
+    match page_token {
+        None => Ok(0),
+        Some(t) => t.parse().map_err(|_| {
+            UcErrorResponse::invalid_argument(format!("Invalid page_token '{t}'."))
+        }),
+    }
+}
+
+pub(crate) async fn list_catalogs<C: CatalogStore, A: Authorizer + Clone, S: SecretStore>(
+    query: UcPaginationQuery,
+    state: ApiContext<State<A, C, S>>,
+    request_metadata: RequestMetadata,
+) -> UcResult<ListCatalogsResponse> {
+    let page_size = usize::try_from(effective_page_size(query.max_results)?)
+        .map_err(|_| UcErrorResponse::internal("Invalid effective page size"))?;
+    let offset = parse_offset_token(query.page_token.as_deref())?;
+
+    // ------------------- AuthZ -------------------
+    let authorizer = state.v1_state.authz;
+    let project_id = request_metadata.require_project_id(None).map_err(uc_err)?;
+    authorizer
+        .require_project_action(
+            &request_metadata,
+            &project_id,
+            CatalogProjectAction::ListWarehouses,
+        )
+        .await
+        .map_err(|e| uc_err(authz_to_error_no_audit(e)))?;
+
+    // ------------------- Business Logic -------------------
+    let warehouses = C::list_warehouses(&project_id, None, state.v1_state.catalog)
+        .await
+        .map_err(uc_err)?;
+
+    let mut visible: Vec<_> = authorizer
+        .are_allowed_warehouse_actions_vec(
+            &request_metadata,
+            None,
+            &warehouses
+                .iter()
+                .map(|w| (&**w, CatalogWarehouseAction::IncludeInList))
+                .collect::<Vec<_>>(),
+        )
+        .await
+        .map_err(|e| uc_err(authz_to_error_no_audit(e)))?
+        .into_allowed()
+        .into_iter()
+        .zip(warehouses)
+        .filter_map(|(allowed, warehouse)| allowed.then_some(warehouse))
+        .collect();
+
+    // Client-side pagination: warehouses per project are few, so paginate
+    // over the full, name-sorted list with a plain offset token.
+    visible.sort_by(|a, b| a.name.cmp(&b.name));
+    let total = visible.len();
+    let catalogs: Vec<CatalogInfo> = visible
+        .iter()
+        .skip(offset)
+        .take(page_size)
+        .map(|w| catalog_info(w))
+        .collect();
+    let next_page_token = (!catalogs.is_empty() && offset + catalogs.len() < total)
+        .then(|| (offset + catalogs.len()).to_string());
+
+    Ok(ListCatalogsResponse {
+        catalogs,
+        next_page_token,
+    })
+}
+
+pub(crate) async fn get_catalog<C: CatalogStore, A: Authorizer + Clone, S: SecretStore>(
+    name: String,
+    state: ApiContext<State<A, C, S>>,
+    request_metadata: RequestMetadata,
+) -> UcResult<CatalogInfo> {
+    let authorizer = state.v1_state.authz;
+    let warehouse =
+        resolve_catalog_warehouse::<C>(&request_metadata, &name, state.v1_state.catalog).await?;
+
+    // Non-visible warehouses are masked as 404 by the authorizer.
+    let warehouse = authorizer
+        .require_warehouse_action(
+            &request_metadata,
+            warehouse.warehouse_id,
+            Ok::<_, CatalogGetWarehouseByIdError>(Some(warehouse)),
+            CatalogWarehouseAction::GetMetadata,
+        )
+        .await
+        .map_err(|e| uc_err(authz_to_error_no_audit(e)))?;
+
+    Ok(catalog_info(&warehouse))
+}
