+        deleted = uc.run(uc.volumes.delete_volume(vol.full_name))
+        assert deleted in ({}, None)  # 200 + `{}` per contract
+        with pytest.raises(NotFoundException) as ei:
+            uc.run(uc.volumes.get_volume(vol.full_name))
+        assert_uc_error(ei, 404, "NOT_FOUND")
+
+    def test_get_missing_volume_404(self, uc, schema):
+        with pytest.raises(NotFoundException) as ei:
+            uc.run(uc.volumes.get_volume(f"{schema['full_name']}.{unique_name('v')}"))
+        assert_uc_error(ei, 404, "NOT_FOUND")
+
+    def test_delete_schema_containing_volume_fails(self, uc, schema, volume_factory):
+        # UC delete-schema on a non-empty schema must 400 (design D2).
+        volume_factory(VolumeType.MANAGED)
+        with pytest.raises(ApiException) as ei:
+            uc.run(uc.schemas.delete_schema(schema["full_name"]))
+        assert ei.value.status == 400
+
+
+class TestVolumeCredentials:
+    def _creds(self, uc, volume_id, operation):
+        return uc.run(
+            uc.temp_creds.generate_temporary_volume_credentials(
+                GenerateTemporaryVolumeCredential(
+                    volume_id=volume_id, operation=operation
+                )
+            )
+        )
+
+    def test_read_credentials_shape(self, uc, volume_factory):
+        vol = volume_factory(VolumeType.MANAGED)
+        creds = self._creds(uc, vol.volume_id, VolumeOperation.READ_VOLUME)
+        aws = creds.aws_temp_credentials
+        assert aws is not None
+        assert aws.access_key_id and aws.secret_access_key and aws.session_token
+        # expiration_time is top-level epoch millis (present for STS creds).
+        if creds.expiration_time is not None:
+            assert creds.expiration_time > 10**12  # millis, not seconds
+
+    def test_write_then_read_via_boto3(self, uc, volume_factory):
+        vol = volume_factory(VolumeType.MANAGED)
+        bucket, prefix = split_s3_uri(vol.storage_location)
+        key = f"{prefix}/hello.txt"
+        payload = b"uc-volume-e2e"
+
+        write_creds = self._creds(uc, vol.volume_id, VolumeOperation.WRITE_VOLUME)
+        s3w = s3_client_from_creds(write_creds)
+        s3w.put_object(Bucket=bucket, Key=key, Body=payload)
+
+        read_creds = self._creds(uc, vol.volume_id, VolumeOperation.READ_VOLUME)
+        s3r = s3_client_from_creds(read_creds)
+        body = s3r.get_object(Bucket=bucket, Key=key)["Body"].read()
+        assert body == payload
+
+    def test_read_credentials_cannot_write(self, uc, volume_factory):
+        # Best-effort: relies on MinIO enforcing the STS session policy that
+        # downscopes READ_VOLUME credentials. Skip (not fail) if the store
+        # does not enforce it.
+        vol = volume_factory(VolumeType.MANAGED)
+        bucket, prefix = split_s3_uri(vol.storage_location)
+        read_creds = self._creds(uc, vol.volume_id, VolumeOperation.READ_VOLUME)
+        s3r = s3_client_from_creds(read_creds)
+        try:
+            s3r.put_object(Bucket=bucket, Key=f"{prefix}/nope.txt", Body=b"x")
+        except Exception:
+            return  # denied as expected
+        pytest.skip("MinIO did not enforce read-only downscoping (session policy)")
+
+    def test_creds_for_unknown_volume_404(self, uc, warehouse):
+        with pytest.raises(ApiException) as ei:
+            uc.run(
+                uc.temp_creds.generate_temporary_volume_credentials(
+                    GenerateTemporaryVolumeCredential(
+                        volume_id=str(uuid.uuid4()),
+                        operation=VolumeOperation.READ_VOLUME,
+                    )
+                )
+            )
+        assert ei.value.status in (400, 404)
+
+
+class TestVolumeEngineAccess:
+    """Engine-connection proof: parquet in a volume read through DuckDB httpfs
+    with vended credentials."""
+
+    def test_duckdb_reads_parquet_with_vended_creds(self, uc, volume_factory):
+        import pyarrow as pa
+        import pyarrow.parquet as pq
+
+        vol = volume_factory(VolumeType.MANAGED)
+        bucket, prefix = split_s3_uri(vol.storage_location)
+        key = f"{prefix}/data/rows.parquet"
+
