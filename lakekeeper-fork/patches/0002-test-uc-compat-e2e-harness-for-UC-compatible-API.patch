+"""UC Volumes: CRUD, pagination, temporary credentials, engine access.
+
+Wire contract: uc-api-contract.md §3 + §7. Endpoints are being implemented
+concurrently (design phase B); this file is written against the contract and
+the validated unitycatalog-client 0.4.1 surface.
+"""
+
+import io
+import uuid
+
+import pytest
+from unitycatalog.client.exceptions import ApiException, NotFoundException
+from unitycatalog.client.models import (
+    CreateVolumeRequestContent,
+    GenerateTemporaryVolumeCredential,
+    UpdateVolumeRequestContent,
+    VolumeOperation,
+    VolumeType,
+)
+
+from conftest import (
+    WAREHOUSE_BASE_LOCATION,
+    assert_uc_error,
+    s3_client_from_creds,
+    split_s3_uri,
+    unique_name,
+)
+
+
+def _external_location() -> str:
+    # Must be under the warehouse base location to pass
+    # `storage_profile.require_allowed_location` (design D4).
+    return f"{WAREHOUSE_BASE_LOCATION}/external-volumes/{uuid.uuid4().hex}"
+
+
+@pytest.fixture()
+def volume_factory(uc, schema):
+    created = []
+
+    def factory(volume_type: VolumeType, **kwargs):
+        name = kwargs.pop("name", unique_name("vol"))
+        req = CreateVolumeRequestContent(
+            catalog_name=schema["catalog_name"],
+            schema_name=schema["name"],
+            name=name,
+            volume_type=volume_type,
+            **kwargs,
+        )
+        info = uc.run(uc.volumes.create_volume(req))
+        created.append(info.full_name)
+        return info
+
+    yield factory
+    for full_name in created:
+        try:
+            uc.run(uc.volumes.delete_volume(full_name))
+        except Exception:
+            pass
+
+
+class TestVolumeCrud:
+    def test_create_external_volume(self, uc, schema, volume_factory):
+        location = _external_location()
+        vol = volume_factory(
+            VolumeType.EXTERNAL, storage_location=location, comment="ext vol"
+        )
+        assert vol.volume_type == VolumeType.EXTERNAL
+        assert vol.storage_location.rstrip("/") == location.rstrip("/")
+        assert vol.full_name == f"{schema['full_name']}.{vol.name}"
+        assert vol.volume_id  # UUID string used by temporary-volume-credentials
+        assert vol.created_at is not None
+
+    def test_create_managed_volume(self, uc, schema, volume_factory):
+        vol = volume_factory(VolumeType.MANAGED)
+        assert vol.volume_type == VolumeType.MANAGED
+        # Server generates the location for MANAGED volumes.
+        assert vol.storage_location and vol.storage_location.startswith("s3://")
+
+    def test_get_by_full_name(self, uc, volume_factory):
+        vol = volume_factory(VolumeType.MANAGED)
+        got = uc.run(uc.volumes.get_volume(vol.full_name))
+        assert got.volume_id == vol.volume_id
+        assert got.full_name == vol.full_name
+
+    def test_list_and_pagination(self, uc, schema, volume_factory):
+        names = {volume_factory(VolumeType.MANAGED).name for _ in range(2)}
+        seen, token = [], None
+        for _ in range(50):
+            resp = uc.run(
+                uc.volumes.list_volumes(
+                    catalog_name=schema["catalog_name"],
+                    schema_name=schema["name"],
+                    max_results=1,
+                    page_token=token,
+                )
+            )
+            assert len(resp.volumes) <= 1
+            seen += [v.name for v in resp.volumes]
+            token = resp.next_page_token
+            if not token:
+                break
+        assert names <= set(seen)
+
+    def test_patch_comment(self, uc, volume_factory):
+        vol = volume_factory(VolumeType.MANAGED)
+        updated = uc.run(
+            uc.volumes.update_volume(
+                vol.full_name, UpdateVolumeRequestContent(comment="patched")
+            )
+        )
+        assert updated.comment == "patched"
+
+    def test_patch_new_name_rejected(self, uc, volume_factory):
+        # v1 scope cut: renames are rejected with 400 INVALID_ARGUMENT.
+        vol = volume_factory(VolumeType.MANAGED)
+        with pytest.raises(ApiException) as ei:
+            uc.run(
+                uc.volumes.update_volume(
+                    vol.full_name,
+                    UpdateVolumeRequestContent(new_name=unique_name("renamed")),
