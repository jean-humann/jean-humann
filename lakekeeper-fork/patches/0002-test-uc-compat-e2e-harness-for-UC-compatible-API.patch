diff --git a/tests/uc-compat/run.sh b/tests/uc-compat/run.sh
new file mode 100755
index 00000000..0343e011
--- /dev/null
+++ b/tests/uc-compat/run.sh
@@ -0,0 +1,176 @@
+#!/usr/bin/env bash
+# run.sh — Unity Catalog compatibility e2e runner.
+#
+# Boots postgres + openfga + minio via docker compose, builds and runs the
+# fork's `lakekeeper` binary on the HOST network (not in compose), then runs
+# the pytest suite in tests/uc-compat/ against it.
+#
+# Usage:
+#   bash tests/uc-compat/run.sh [extra pytest args...]
+#   MODE=allowall bash tests/uc-compat/run.sh -m smoke     # catalogs/schemas only
+#   MODE=openfga  bash tests/uc-compat/run.sh              # stack-level authz checks
+#
+# Environment knobs:
+#   MODE          allowall (default) | openfga
+#   SKIP_BUILD=1  don't run `cargo build -p lakekeeper-bin`
+#   KEEP_RUNNING=1  leave the compose stack + server up after the run
+#   UC_TEST_PYTHON  python interpreter with test deps (unitycatalog-client
+#                   0.4.1, unitycatalog-ai 0.4.0, boto3, duckdb, pytest, ...).
+#                   Defaults to the e2e venv next to the repo checkout if it
+#                   exists, else `python3`.
+#
+# MODE semantics
+# --------------
+# * MODE=allowall (default, fully working path):
+#     LAKEKEEPER__AUTHZ_BACKEND=allowall, authentication disabled (no
+#     LAKEKEEPER__OPENID_PROVIDER_URI). All requests are anonymous; anonymous
+#     bootstrap is permitted by the AllowAll authorizer, so the whole UC
+#     surface (catalogs/schemas/volumes/functions/models/temp-credentials)
+#     is exercised end-to-end.
+#
+# * MODE=openfga (stack verification + placeholder):
+#     LAKEKEEPER__AUTHZ_BACKEND=openfga against the compose OpenFGA (gRPC on
+#     localhost:8081). `lakekeeper migrate` creates the OpenFGA store and
+#     writes the authorization model — this run therefore proves the fork's
+#     FGA model (incl. any new volume/function/model types) is accepted by
+#     OpenFGA and that the server serves with the openfga backend.
+#     HOWEVER: the OpenFGA authorizer rejects anonymous bootstrap
+#     ("Anonymous users cannot bootstrap the catalog",
+#     crates/authz-openfga/src/authorizer.rs), and this fork has no dev/test
+#     authenticator — authentication requires a real OIDC IdP or Kubernetes
+#     tokens. So with authentication disabled the data-plane suite CANNOT run
+#     in this mode. MODE=openfga runs only test_authz.py, which asserts:
+#       - /management/v1/info reports authz-backend=openfga
+#       - anonymous bootstrap is rejected with 4xx (403)
+#       - (when UC_TEST_TOKEN is provided by an external IdP setup) owner
+#         relations / authorizer-actions on created UC objects.
+#     TODO(placeholder): add a keycloak service (see tests/docker-compose.yaml
+#     for the realm import pattern) and an OIDC token fixture to unlock the
+#     full authz matrix; until then allowall is the supported full path.
+set -euo pipefail
+
+SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
+REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
+COMPOSE=(docker compose -f "${SCRIPT_DIR}/docker-compose.yaml")
+
+MODE="${MODE:-allowall}"
+if [[ "$MODE" != "allowall" && "$MODE" != "openfga" ]]; then
+    echo "MODE must be 'allowall' or 'openfga', got: $MODE" >&2
+    exit 2
+fi
+
+# ── Python interpreter with the test dependencies ────────────────────────────
+DEFAULT_VENV="$(cd "${REPO_ROOT}/.." && pwd)/e2e-venv"
+if [ -z "${UC_TEST_PYTHON:-}" ]; then
+    if [ -x "${DEFAULT_VENV}/bin/python" ]; then
+        UC_TEST_PYTHON="${DEFAULT_VENV}/bin/python"
+    else
+        UC_TEST_PYTHON="python3"
+    fi
+fi
+echo "MODE=${MODE}  python=${UC_TEST_PYTHON}" >&2
+
+# ── Build the server on the host ─────────────────────────────────────────────
+BINARY="${REPO_ROOT}/target/debug/lakekeeper"
+if [ "${SKIP_BUILD:-0}" != "1" ]; then
+    echo "Building lakekeeper-bin (SKIP_BUILD=1 to skip)..." >&2
+    (cd "${REPO_ROOT}" && cargo build -p lakekeeper-bin)
+fi
+if [ ! -x "${BINARY}" ]; then
+    echo "Server binary not found at ${BINARY}. Build it first." >&2
+    exit 1
+fi
+
+# ── Teardown ──────────────────────────────────────────────────────────────────
+RUN_DIR="${SCRIPT_DIR}/.run"
+mkdir -p "${RUN_DIR}"
+SERVER_PID=""
+cleanup() {
+    if [ "${KEEP_RUNNING:-0}" = "1" ]; then
+        echo "KEEP_RUNNING=1 — leaving stack up (server pid: ${SERVER_PID:-n/a})" >&2
+        return
+    fi
+    if [ -n "${SERVER_PID}" ] && kill -0 "${SERVER_PID}" 2>/dev/null; then
+        kill "${SERVER_PID}" 2>/dev/null || true
+        wait "${SERVER_PID}" 2>/dev/null || true
+    fi
+    "${COMPOSE[@]}" down -v --remove-orphans >/dev/null 2>&1 || true
+}
+trap cleanup EXIT
+
+# ── Start infrastructure ─────────────────────────────────────────────────────
+"${COMPOSE[@]}" up -d
+
+wait_for() { # <name> <command...>
+    local name="$1"; shift
+    for _ in $(seq 1 60); do
+        if "$@" >/dev/null 2>&1; then echo "  ${name}: ready" >&2; return 0; fi
+        sleep 2
+    done
+    echo "  ${name}: NOT ready after 120s" >&2
+    return 1
+}
+echo "Waiting for infrastructure..." >&2
+wait_for postgres "${COMPOSE[@]}" exec -T db pg_isready -U postgres
+wait_for minio curl -sf http://localhost:9000/minio/health/live
+if [ "$MODE" = "openfga" ]; then
+    # OpenFGA serves an HTTP health endpoint on its HTTP port (published 8083).
+    wait_for openfga curl -sf http://localhost:8083/healthz
+fi
+# Bucket + non-root user creation (one-shot container).
+"${COMPOSE[@]}" wait minio-init >/dev/null 2>&1 || true
+
+# ── Server environment ───────────────────────────────────────────────────────
+export LAKEKEEPER__PG_DATABASE_URL_READ="postgresql://postgres:postgres@localhost:5433/postgres"
+export LAKEKEEPER__PG_DATABASE_URL_WRITE="postgresql://postgres:postgres@localhost:5433/postgres"
+export LAKEKEEPER__PG_ENCRYPTION_KEY="uc-e2e-insecure-encryption-key"
+export LAKEKEEPER__LISTEN_PORT="${LAKEKEEPER__LISTEN_PORT:-8181}"
+# The metrics server defaults to port 9000, which collides with MinIO's
+# published S3 port on the host network.
+export LAKEKEEPER__METRICS_PORT="${LAKEKEEPER__METRICS_PORT:-9090}"
+export RUST_LOG="${RUST_LOG:-info,lakekeeper=debug}"
+# Authentication stays DISABLED in both modes (no OPENID_PROVIDER_URI, no
+# kubernetes authn): requests are anonymous.
+export LAKEKEEPER__ENABLE_KUBERNETES_AUTHENTICATION=false
+unset LAKEKEEPER__OPENID_PROVIDER_URI || true
+
+if [ "$MODE" = "openfga" ]; then
+    export LAKEKEEPER__AUTHZ_BACKEND=openfga
+    export LAKEKEEPER__OPENFGA__ENDPOINT="http://localhost:8081"
+else
+    export LAKEKEEPER__AUTHZ_BACKEND=allowall
+fi
+
+# ── Migrate + serve ──────────────────────────────────────────────────────────
+echo "Running migrations (postgres schema + OpenFGA store/model if enabled)..." >&2
+"${BINARY}" migrate
+
+echo "Starting lakekeeper serve (log: ${RUN_DIR}/server.log)..." >&2
+"${BINARY}" serve >"${RUN_DIR}/server.log" 2>&1 &
+SERVER_PID=$!
+
+wait_for lakekeeper curl -sf "http://localhost:${LAKEKEEPER__LISTEN_PORT}/health" || {
+    echo "--- server.log (tail) ---" >&2
+    tail -50 "${RUN_DIR}/server.log" >&2
+    exit 1
+}
+
+# ── Pytest ───────────────────────────────────────────────────────────────────
+export UC_TEST_MODE="${MODE}"
+export UC_TEST_BASE_URL="http://localhost:${LAKEKEEPER__LISTEN_PORT}"
+export UC_TEST_S3_ENDPOINT="http://localhost:9000"
+
+set +e
+if [ "$MODE" = "openfga" ]; then
+    "${UC_TEST_PYTHON}" -m pytest "${SCRIPT_DIR}/test_authz.py" -v "$@"
+else
+    "${UC_TEST_PYTHON}" -m pytest "${SCRIPT_DIR}" -v "$@"
+fi
+STATUS=$?
+set -e
+
+if [ $STATUS -ne 0 ]; then
+    echo "--- server.log (tail) ---" >&2
+    tail -80 "${RUN_DIR}/server.log" >&2
+fi
+exit $STATUS
diff --git a/tests/uc-compat/test_authz.py b/tests/uc-compat/test_authz.py
new file mode 100644
index 00000000..d05aa6e8
--- /dev/null
+++ b/tests/uc-compat/test_authz.py
@@ -0,0 +1,85 @@
+"""AuthZ checks for MODE=openfga. Skipped entirely under MODE=allowall.
+
+Reality of this stack (see run.sh header): the OpenFGA authorizer rejects
+anonymous bootstrap and the fork ships no dev/test authenticator, so without
+an IdP (keycloak — placeholder, not yet in the compose file) the data-plane
+suite cannot run against the openfga backend. What IS covered here:
+
+  1. the server actually runs with authz-backend=openfga (which also proves
+     `lakekeeper migrate` successfully created the OpenFGA store and wrote
+     the fork's authorization model, incl. new UC object types);
+  2. anonymous bootstrap is rejected (the documented failure mode);
+  3. when a real bearer token IS available (UC_TEST_TOKEN, external IdP),
+     creator-owner semantics: the volume creator holds the full authorizer
+     action set via /management/v1/permissions/warehouse/{wh}/volume/{vol}/
+     authorizer-actions, and a permissions read endpoint exists.
+
+The deep allow/deny matrix needs multiple authenticated principals and is
+out of scope until the keycloak service lands.
+"""
+
+import pytest
+
+from conftest import MODE, TOKEN, unique_name
+
+pytestmark = [
+    pytest.mark.authz,
+    pytest.mark.skipif(
+        MODE != "openfga",
+        reason="authz tests only run with UC_TEST_MODE=openfga",
+    ),
+]
+
+
+def test_server_uses_openfga_backend(server):
+    assert server.info.get("authz-backend") == "openfga"
+
+
+def test_anonymous_bootstrap_is_rejected(server):
+    if TOKEN:
+        pytest.skip("token supplied; anonymous-rejection check not applicable")
+    if server.bootstrapped:
+        pytest.skip("server already bootstrapped by an authenticated principal")
+    assert server.bootstrap_error is not None
+    status = int(server.bootstrap_error.split(":", 1)[0])
+    assert 400 <= status < 500
+
+
+@pytest.mark.skipif(
+    not TOKEN,
+    reason="needs an authenticated principal (UC_TEST_TOKEN via external IdP); "
+    "keycloak service is a TODO placeholder in this stack",
+)
+class TestOwnerRelations:
+    def test_volume_creator_gets_full_action_set(self, server, uc, warehouse, schema):
+        from unitycatalog.client.models import CreateVolumeRequestContent, VolumeType
+
+        vol = uc.run(
+            uc.volumes.create_volume(
+                CreateVolumeRequestContent(
+                    catalog_name=schema["catalog_name"],
+                    schema_name=schema["name"],
+                    name=unique_name("vol"),
+                    volume_type=VolumeType.MANAGED,
+                )
+            )
+        )
+        resp = server.client.get(
+            f"/management/v1/permissions/warehouse/{warehouse['id']}"
+            f"/volume/{vol.volume_id}/authorizer-actions"
+        )
+        if resp.status_code == 404:
+            pytest.xfail(
+                "volume authorizer-actions management endpoint not implemented yet"
+            )
+        resp.raise_for_status()
+        actions = resp.json().get("allowed-actions", resp.json())
+        # Creator/owner should hold the full set incl. drop + write.
+        joined = str(actions).lower()
+        assert "drop" in joined and ("write" in joined or "read" in joined)
+
+    def test_permissions_check_endpoint_exists(self, server):
+        # Keep light: the endpoint must exist (POST body shape is
+        # backend-specific; anything but 404/405 proves routing).
+        resp = server.client.post("/management/v1/permissions/check", json={})
+        assert resp.status_code not in (404, 405)
diff --git a/tests/uc-compat/test_catalogs_schemas.py b/tests/uc-compat/test_catalogs_schemas.py
new file mode 100644
index 00000000..64e578c0
--- /dev/null
+++ b/tests/uc-compat/test_catalogs_schemas.py
@@ -0,0 +1,157 @@
+"""UC Catalogs + Schemas surface (design D2: catalog=warehouse, schema=ns).
+
+These endpoints already exist server-side; everything here is `-m smoke`
+runnable, except the delete-non-empty case which needs Volumes.
+"""
+
+import pytest
+from unitycatalog.client.exceptions import ApiException, NotFoundException
+from unitycatalog.client.models import CreateSchema, UpdateSchema
+
+from conftest import assert_uc_error, unique_name
+
+pytestmark = pytest.mark.smoke
+
+
+class TestCatalogs:
+    def test_list_catalogs_contains_warehouse(self, uc, warehouse):
+        resp = uc.run(uc.catalogs.list_catalogs())
+        names = [c.name for c in resp.catalogs]
+        assert warehouse["name"] in names
+
+    def test_get_catalog(self, uc, warehouse):
+        cat = uc.run(uc.catalogs.get_catalog(warehouse["name"]))
+        assert cat.name == warehouse["name"]
+        assert cat.id == warehouse["id"]
+
+    def test_get_catalog_404(self, uc, warehouse):
+        with pytest.raises(NotFoundException) as ei:
+            uc.run(uc.catalogs.get_catalog(unique_name("nope")))
+        assert_uc_error(ei, 404, "NOT_FOUND")
+
+    def test_catalogs_are_read_only(self, uc, warehouse):
+        # v1 scope cut: catalog create/update/delete → 400 INVALID_ARGUMENT
+        # pointing to the management API.
+        from unitycatalog.client.models import CreateCatalog, UpdateCatalog
+
+        with pytest.raises(ApiException) as ei:
+            uc.run(uc.catalogs.create_catalog(CreateCatalog(name=unique_name("cat"))))
+        assert_uc_error(ei, 400, "INVALID_ARGUMENT")
+
+        with pytest.raises(ApiException) as ei:
+            uc.run(
+                uc.catalogs.update_catalog(
+                    warehouse["name"], UpdateCatalog(comment="nope")
+                )
+            )
+        assert_uc_error(ei, 400, "INVALID_ARGUMENT")
+
+        with pytest.raises(ApiException) as ei:
+            uc.run(uc.catalogs.delete_catalog(warehouse["name"]))
+        assert_uc_error(ei, 400, "INVALID_ARGUMENT")
+
+    def test_list_catalogs_pagination_envelope(self, uc, warehouse):
+        resp = uc.run(uc.catalogs.list_catalogs(max_results=1))
+        assert len(resp.catalogs) <= 1
+
+
+class TestSchemas:
+    def test_schema_crud_roundtrip(self, uc, warehouse):
+        name = unique_name("sch")
+        full_name = f"{warehouse['name']}.{name}"
+
+        created = uc.run(
+            uc.schemas.create_schema(
+                CreateSchema(
+                    name=name, catalog_name=warehouse["name"], comment="e2e schema"
+                )
+            )
+        )
+        assert created.name == name
+        assert created.catalog_name == warehouse["name"]
+        assert created.full_name == full_name
+        assert created.comment == "e2e schema"
+
+        got = uc.run(uc.schemas.get_schema(full_name))
+        assert got.full_name == full_name
+
+        listed = uc.run(uc.schemas.list_schemas(catalog_name=warehouse["name"]))
+        assert name in [s.name for s in listed.schemas]
+
+        updated = uc.run(
+            uc.schemas.update_schema(full_name, UpdateSchema(comment="updated"))
+        )
+        assert updated.comment == "updated"
+
+        deleted = uc.run(uc.schemas.delete_schema(full_name))
+        # DELETE returns 200 with an empty JSON object.
+        assert deleted in ({}, None)
+
+        with pytest.raises(NotFoundException) as ei:
+            uc.run(uc.schemas.get_schema(full_name))
+        assert_uc_error(ei, 404, "NOT_FOUND")
+
+    def test_get_schema_404(self, uc, warehouse):
+        with pytest.raises(NotFoundException) as ei:
+            uc.run(uc.schemas.get_schema(f"{warehouse['name']}.{unique_name('nope')}"))
+        assert_uc_error(ei, 404, "NOT_FOUND")
+
+    def test_create_schema_in_missing_catalog_404(self, uc, warehouse):
+        with pytest.raises(NotFoundException) as ei:
+            uc.run(
+                uc.schemas.create_schema(
+                    CreateSchema(
+                        name=unique_name("sch"), catalog_name=unique_name("nocat")
+                    )
+                )
+            )
+        assert_uc_error(ei, 404)
+
+    def test_create_duplicate_schema_conflict(self, uc, schema):
+        with pytest.raises(ApiException) as ei:
+            uc.run(
+                uc.schemas.create_schema(
+                    CreateSchema(
+                        name=schema["name"], catalog_name=schema["catalog_name"]
+                    )
+                )
+            )
+        assert_uc_error(ei, 409, "ALREADY_EXISTS")
+
+    def test_list_schemas_pagination(self, uc, warehouse):
+        names = [unique_name("pag") for _ in range(2)]
+        for n in names:
+            uc.run(
+                uc.schemas.create_schema(
+                    CreateSchema(name=n, catalog_name=warehouse["name"])
+                )
+            )
+        try:
+            seen, token = [], None
+            for _ in range(50):
+                resp = uc.run(
+                    uc.schemas.list_schemas(
+                        catalog_name=warehouse["name"], max_results=1, page_token=token
+                    )
+                )
+                assert len(resp.schemas) <= 1
+                seen += [s.name for s in resp.schemas]
+                token = resp.next_page_token
+                if not token:
+                    break
+            for n in names:
+                assert n in seen
+        finally:
+            for n in names:
+                uc.run(uc.schemas.delete_schema(f"{warehouse['name']}.{n}"))
+
+
+def test_delete_nonexistent_schema_404(uc, warehouse):
+    with pytest.raises(NotFoundException) as ei:
+        uc.run(uc.schemas.delete_schema(f"{warehouse['name']}.{unique_name('nope')}"))
+    assert_uc_error(ei, 404, "NOT_FOUND")
+
+
+# The delete-non-empty-schema → 400 case lives in test_volumes.py
+# (test_delete_schema_containing_volume_fails): it needs the Volumes
+# endpoints to make the schema non-empty, so it cannot be `-m smoke`.
diff --git a/tests/uc-compat/test_functions.py b/tests/uc-compat/test_functions.py
new file mode 100644
index 00000000..f401ec2d
--- /dev/null
+++ b/tests/uc-compat/test_functions.py
@@ -0,0 +1,169 @@
+"""UC Functions: unitycatalog-ai create/execute + framework adapters + raw SDK.
+
+Function execution is CLIENT-side (uc-api-contract.md §8): the server must
+round-trip `routine_definition` and friends byte-identically; unitycatalog-ai
+reconstructs a Python callable from the stored definition. The LangChain and
+OpenAI toolkit tests prove framework integration without calling any LLM API.
+"""
+
+import json
+
+import pytest
+from unitycatalog.client.exceptions import ApiException, NotFoundException
+
+from conftest import assert_uc_error, unique_name
+
+
+def add_numbers(a: int, b: int) -> int:
+    """Adds two numbers and returns the result.
+
+    Args:
+        a: The first number.
+        b: The second number.
+
+    Returns:
+        The sum of the two numbers.
+    """
+    return a + b
+
+
+class TestUnitycatalogAi:
+    def test_create_retrieve_execute(self, uc_ai, schema):
+        catalog, sch = schema["catalog_name"], schema["name"]
+        full_name = f"{catalog}.{sch}.add_numbers"
+
+        def scenario(client):
+            info = client.create_python_function(
+                func=add_numbers, catalog=catalog, schema=sch, replace=True
+            )
+            assert info.full_name == full_name
+            assert info.routine_body == "EXTERNAL"
+            assert info.external_language == "PYTHON"
+
+            got = client.get_function(full_name)
+            assert got.name == "add_numbers"
+            # Byte-fidelity of the stored python body is what makes local
+            # execution possible.
+            assert "return a + b" in got.routine_definition
+
+            listed = client.list_functions(catalog=catalog, schema=sch)
+            assert full_name in [f.full_name for f in listed]
+
+            result = client.execute_function(full_name, {"a": 2, "b": 40})
+            assert result.error is None
+            assert str(result.value) == "42"
+
+            client.delete_function(full_name)
+            return True
+
