@@ -0,0 +1,94 @@
+# Infrastructure for the Unity Catalog compatibility e2e suite.
+#
+# The Lakekeeper fork binary itself is NOT part of this stack: it is built on
+# the host (`cargo build -p lakekeeper-bin`) and run on the host network by
+# `run.sh`, pointing at the published ports below.
+#
+# Images are pulled from mirror.gcr.io because docker.io/quay.io/ghcr.io blob
+# CDNs are blocked by the environment's egress proxy.
+#
+# Published ports (host):
+#   5433  -> postgres 5432   (5433 to avoid clashing with a dev pg on 5432)
+#   8081  -> openfga  8081   (gRPC; LAKEKEEPER__OPENFGA__ENDPOINT speaks gRPC)
+#   8083  -> openfga  8080   (HTTP API, handy for debugging)
+#   9000  -> minio    9000   (S3 API + STS AssumeRole)
+#   9001  -> minio    9001   (console)
+name: uc-compat-e2e
+
+services:
+  db:
+    image: mirror.gcr.io/library/postgres:16
+    environment:
+      - POSTGRES_PASSWORD=postgres
+    ports:
+      - "5433:5432"
+    healthcheck:
+      test: ["CMD-SHELL", "pg_isready -U postgres -p 5432 -d postgres"]
+      interval: 2s
+      timeout: 10s
+      retries: 5
+      start_period: 15s
+
+  # OpenFGA with in-memory datastore. Lakekeeper's `migrate` command creates
+  # the store and writes the authorization model itself (see
+  # tests/docker-compose-openfga-overlay.yaml for the reference wiring), so no
+  # store/model bootstrap container is needed. In-memory is fine for e2e: the
+  # store only needs to outlive one run of the suite.
+  openfga:
+    image: mirror.gcr.io/openfga/openfga:v1.8.13
+    command: run
+    environment:
+      - OPENFGA_DATASTORE_ENGINE=memory
+      - OPENFGA_PLAYGROUND_ENABLED=false
+    ports:
+      - "8081:8081" # gRPC (used by Lakekeeper)
+      - "8083:8080" # HTTP (debugging)
+    healthcheck:
+      test: ["CMD", "/usr/local/bin/grpc_health_probe", "-addr=localhost:8081"]
+      interval: 2s
+      timeout: 30s
+      retries: 10
+      start_period: 5s
+
+  minio:
+    image: mirror.gcr.io/minio/minio:latest
+    environment:
+      - MINIO_ROOT_USER=minioadmin
+      - MINIO_ROOT_PASSWORD=minioadmin
+      # Explicit region so vended-credential clients and the storage profile
+      # agree on a region string.
+      - MINIO_REGION=local
+    command: ["server", "--console-address", ":9001", "/data"]
+    ports:
+      - "9000:9000"
+      - "9001:9001"
+    healthcheck:
+      test: ["CMD", "mc", "ready", "local"]
+      interval: 2s
+      timeout: 10s
+      retries: 5
+      start_period: 10s
+
+  # Creates the test bucket and a non-root `lakekeeper` user with the
+  # `readwrite` policy. The warehouse storage-credential uses this user, not
+  # the root credentials: MinIO's AssumeRole STS is intended for non-root
+  # users, and session policies (which give downscoped vended credentials
+  # their read-only/read-write semantics) are only intersected against a
+  # user's attached IAM policy. Uses the minio image itself for `mc` since a
+  # separate mc image cannot be pulled through the proxy. conftest.py has a
+  # boto3 fallback that creates the bucket if this container did not run.
+  minio-init:
+    image: mirror.gcr.io/minio/minio:latest
+    depends_on:
+      minio:
+        condition: service_healthy
+    restart: "no"
+    entrypoint: >
+      /bin/sh -c "
+      set -e;
+      mc alias set local http://minio:9000 minioadmin minioadmin;
+      mc mb --ignore-existing local/uc-e2e;
+      mc admin user add local lakekeeper lakekeeper-secret || true;
+      mc admin policy attach local readwrite --user lakekeeper || true;
+      exit 0;
+      "
