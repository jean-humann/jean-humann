@@ -0,0 +1,254 @@
+"""UC Registered Models + Model Versions: MLflow-style artifact lifecycle.
+
+Contract (uc-api-contract.md §5-§7):
+  create model -> create version (PENDING_REGISTRATION, server assigns int
+  version + storage_location) -> READ_WRITE creds while pending -> upload
+  artifacts -> finalize (READY) -> READ_WRITE creds now rejected -> READ creds
+  download artifacts.
+"""
+
+import pytest
+from unitycatalog.client.exceptions import ApiException, NotFoundException
+from unitycatalog.client.models import (
+    CreateModelVersion,
+    CreateRegisteredModel,
+    FinalizeModelVersion,
+    GenerateTemporaryModelVersionCredential,
+    ModelVersionOperation,
+    ModelVersionStatus,
+    UpdateRegisteredModel,
+)
+
+from conftest import (
+    assert_uc_error,
+    s3_client_from_creds,
+    split_s3_uri,
+    unique_name,
+)
+
+ARTIFACT = b"\x93NUMPY-not-really-model-bytes"
+
+
+@pytest.fixture()
+def model(uc, schema):
+    name = unique_name("model")
+    info = uc.run(
+        uc.models.create_registered_model(
+            CreateRegisteredModel(
+                name=name,
+                catalog_name=schema["catalog_name"],
+                schema_name=schema["name"],
+                comment="e2e model",
+            )
+        )
+    )
+    yield info
+    # Cleanup: drop remaining versions, then the model.
+    try:
+        versions = uc.run(uc.model_versions.list_model_versions(info.full_name))
+        for v in versions.model_versions or []:
+            try:
+                uc.run(
+                    uc.model_versions.delete_model_version(info.full_name, v.version)
+                )
+            except Exception:
+                pass
+        uc.run(uc.models.delete_registered_model(info.full_name))
+    except Exception:
+        pass
+
+
+def _mv_creds(uc, model_info, version, operation):
+    return uc.run(
+        uc.temp_creds.generate_temporary_model_version_credentials(
+            GenerateTemporaryModelVersionCredential(
+                catalog_name=model_info.catalog_name,
+                schema_name=model_info.schema_name,
+                model_name=model_info.name,
+                version=version,
+                operation=operation,
+            )
+        )
+    )
+
+
+class TestRegisteredModels:
+    def test_create_model_shape(self, model, schema):
+        assert model.full_name == f"{schema['full_name']}.{model.name}"
+        assert model.id
+        assert model.storage_location and model.storage_location.startswith("s3://")
+        assert model.created_at is not None
+
+    def test_get_and_list(self, uc, model, schema):
+        got = uc.run(uc.models.get_registered_model(model.full_name))
+        assert got.id == model.id
+
+        listed = uc.run(
+            uc.models.list_registered_models(
+                catalog_name=schema["catalog_name"], schema_name=schema["name"]
+            )
+        )
+        assert model.full_name in [m.full_name for m in listed.registered_models]
+
+        # listRegisteredModels allows omitting catalog/schema (list-all).
+        all_models = uc.run(uc.models.list_registered_models())
+        assert model.full_name in [m.full_name for m in all_models.registered_models]
+
+    def test_update_comment(self, uc, model):
+        updated = uc.run(
+            uc.models.update_registered_model(
+                model.full_name, UpdateRegisteredModel(comment="patched")
+            )
+        )
+        assert updated.comment == "patched"
+
+    def test_get_missing_model_404(self, uc, schema):
+        with pytest.raises(NotFoundException) as ei:
+            uc.run(
+                uc.models.get_registered_model(
+                    f"{schema['full_name']}.{unique_name('m')}"
+                )
+            )
+        assert_uc_error(ei, 404, "NOT_FOUND")
+
+    def test_duplicate_model_409(self, uc, model, schema):
+        with pytest.raises(ApiException) as ei:
+            uc.run(
+                uc.models.create_registered_model(
+                    CreateRegisteredModel(
+                        name=model.name,
+                        catalog_name=schema["catalog_name"],
+                        schema_name=schema["name"],
+                    )
+                )
+            )
+        assert_uc_error(ei, 409, "ALREADY_EXISTS")
+
+
+class TestModelVersionLifecycle:
+    def test_full_artifact_lifecycle(self, uc, model):
+        # 1. Create version: server assigns version=1, PENDING_REGISTRATION,
+        #    and a managed storage_location under the model's location.
+        mv = uc.run(
+            uc.model_versions.create_model_version(
+                CreateModelVersion(
+                    model_name=model.name,
+                    catalog_name=model.catalog_name,
+                    schema_name=model.schema_name,
+                    source="uc-e2e://local-training-run",
+                    comment="v1",
+                )
+            )
+        )
+        assert mv.version == 1
+        assert mv.status == ModelVersionStatus.PENDING_REGISTRATION
+        assert mv.storage_location and mv.storage_location.startswith("s3://")
+
+        # 2. READ_WRITE creds while PENDING -> upload artifact.
+        rw = _mv_creds(
+            uc, model, mv.version, ModelVersionOperation.READ_WRITE_MODEL_VERSION
+        )
+        assert rw.aws_temp_credentials is not None
+        bucket, prefix = split_s3_uri(mv.storage_location)
+        key = f"{prefix}/model.bin"
+        s3_client_from_creds(rw).put_object(Bucket=bucket, Key=key, Body=ARTIFACT)
+
+        # 3. Finalize -> READY. Body repeats full_name+version per contract.
+        finalized = uc.run(
+            uc.model_versions.finalize_model_version(
+                model.full_name,
+                mv.version,
+                FinalizeModelVersion(full_name=model.full_name, version=mv.version),
+            )
+        )
+        assert finalized.status == ModelVersionStatus.READY
+
+        # 4. READ_WRITE creds after READY must be rejected (contract says the
+        #    reference server 400s; accept 400/409 per implementation).
+        with pytest.raises(ApiException) as ei:
+            _mv_creds(
+                uc, model, mv.version, ModelVersionOperation.READ_WRITE_MODEL_VERSION
+            )
+        assert ei.value.status in (400, 409)
+
+        # 5. READ creds -> download matches.
+        ro = _mv_creds(uc, model, mv.version, ModelVersionOperation.READ_MODEL_VERSION)
+        body = (
+            s3_client_from_creds(ro)
+            .get_object(Bucket=bucket, Key=key)["Body"]
+            .read()
+        )
+        assert body == ARTIFACT
+
+        # 6. list + get by version.
+        listed = uc.run(uc.model_versions.list_model_versions(model.full_name))
+        assert mv.version in [v.version for v in listed.model_versions]
+        got = uc.run(uc.model_versions.get_model_version(model.full_name, mv.version))
+        assert got.status == ModelVersionStatus.READY
+        assert got.id == mv.id
+
+        # 7. Version numbers auto-increment per model.
+        mv2 = uc.run(
+            uc.model_versions.create_model_version(
+                CreateModelVersion(
+                    model_name=model.name,
+                    catalog_name=model.catalog_name,
+                    schema_name=model.schema_name,
+                    source="uc-e2e://local-training-run-2",
+                )
+            )
+        )
+        assert mv2.version == 2
+
+        # 8. Delete version 2, then it 404s.
+        deleted = uc.run(
+            uc.model_versions.delete_model_version(model.full_name, mv2.version)
+        )
+        assert deleted in ({}, None)
+        with pytest.raises(NotFoundException):
+            uc.run(uc.model_versions.get_model_version(model.full_name, mv2.version))
+
+        # 9. Deleting a model with live versions fails without force.
+        with pytest.raises(ApiException) as ei:
+            uc.run(uc.models.delete_registered_model(model.full_name))
+        assert ei.value.status in (400, 409)
+
+        # 10. Drop version 1, then the model deletes cleanly and 404s.
+        uc.run(uc.model_versions.delete_model_version(model.full_name, mv.version))
+        uc.run(uc.models.delete_registered_model(model.full_name))
+        with pytest.raises(NotFoundException) as ei:
+            uc.run(uc.models.get_registered_model(model.full_name))
+        assert_uc_error(ei, 404, "NOT_FOUND")
+
+    def test_finalize_twice_rejected(self, uc, model):
+        mv = uc.run(
+            uc.model_versions.create_model_version(
+                CreateModelVersion(
+                    model_name=model.name,
+                    catalog_name=model.catalog_name,
+                    schema_name=model.schema_name,
+                    source="uc-e2e://run",
+                )
+            )
+        )
+        uc.run(
+            uc.model_versions.finalize_model_version(
+                model.full_name,
+                mv.version,
+                FinalizeModelVersion(full_name=model.full_name, version=mv.version),
+            )
+        )
+        with pytest.raises(ApiException) as ei:
+            uc.run(
+                uc.model_versions.finalize_model_version(
+                    model.full_name,
+                    mv.version,
+                    FinalizeModelVersion(full_name=model.full_name, version=mv.version),
+                )
+            )
+        assert ei.value.status in (400, 409)
+
+    def test_version_creds_for_missing_version_fail(self, uc, model):
+        with pytest.raises(ApiException) as ei:
+            _mv_creds(uc, model, 999, ModelVersionOperation.READ_MODEL_VERSION)
+        assert ei.value.status in (400, 404)
