+"""Fixtures for the Unity Catalog compatibility e2e suite.
+
+The suite talks to a Lakekeeper fork running on the host (default
+http://localhost:8181) whose UC-compatible surface is mounted at
+/api/2.1/unity-catalog. Infrastructure (postgres/openfga/minio) comes from
+tests/uc-compat/docker-compose.yaml; see run.sh for orchestration.
+
+SDK notes (validated against the pinned venv):
+  * unitycatalog-client 0.4.1 is fully async (aiohttp). Under aiohttp>=3.10
+    an ApiClient can only be CONSTRUCTED inside a running event loop, and its
+    session is bound to that loop. The ``uc`` fixture therefore runs a
+    dedicated background event-loop thread; construct + every call happen on
+    that loop via ``uc.run(coro)``.
+  * unitycatalog-ai 0.4.0's UnitycatalogFunctionClient exposes a sync facade
+    that re-enters the *running* loop via nest_asyncio when one exists. The
+    ``uc_ai`` fixture exploits this: tests hand a plain sync callable to
+    ``uc_ai(fn)`` and it is executed inside ``loop.run_until_complete`` with a
+    fresh UnitycatalogFunctionClient bound to that loop.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import dataclasses
+import json
+import os
+import threading
+import time
+import uuid
+
+import boto3
+import httpx
+import pytest
+from botocore.config import Config as BotoConfig
+
+BASE_URL = os.environ.get("UC_TEST_BASE_URL", "http://localhost:8181").rstrip("/")
+UC_HOST = f"{BASE_URL}/api/2.1/unity-catalog"
+MANAGEMENT_URL = f"{BASE_URL}/management"
+MODE = os.environ.get("UC_TEST_MODE", "allowall")
+# Optional bearer token (only meaningful when the server runs with an IdP;
+# the default e2e stack is anonymous).
+TOKEN = os.environ.get("UC_TEST_TOKEN") or None
+
+S3_ENDPOINT = os.environ.get("UC_TEST_S3_ENDPOINT", "http://localhost:9000")
+S3_REGION = os.environ.get("UC_TEST_S3_REGION", "local")
+S3_BUCKET = os.environ.get("UC_TEST_S3_BUCKET", "uc-e2e")
+S3_KEY_PREFIX = os.environ.get("UC_TEST_S3_KEY_PREFIX", "warehouse")
+# Non-root MinIO user created by the minio-init compose container. MinIO's
+# AssumeRole STS + session-policy downscoping applies to IAM users; the
+# warehouse storage-credential therefore uses this user, not minioadmin.
+S3_ACCESS_KEY = os.environ.get("UC_TEST_S3_ACCESS_KEY", "lakekeeper")
+S3_SECRET_KEY = os.environ.get("UC_TEST_S3_SECRET_KEY", "lakekeeper-secret")
+S3_ROOT_ACCESS_KEY = os.environ.get("UC_TEST_S3_ROOT_ACCESS_KEY", "minioadmin")
+S3_ROOT_SECRET_KEY = os.environ.get("UC_TEST_S3_ROOT_SECRET_KEY", "minioadmin")
+
+WAREHOUSE_NAME = os.environ.get("UC_TEST_WAREHOUSE", "uc_e2e")
+DEFAULT_PROJECT_ID = "00000000-0000-0000-0000-000000000000"
+WAREHOUSE_BASE_LOCATION = f"s3://{S3_BUCKET}/{S3_KEY_PREFIX}"
+
+
+def unique_name(prefix: str) -> str:
+    return f"{prefix}_{uuid.uuid4().hex[:12]}"
+
+
+# ─────────────────────────────────────────────────────────────────────────────
+# Raw unitycatalog-client SDK on a background event loop
+# ─────────────────────────────────────────────────────────────────────────────
+
+
+class UcSdk:
+    """unitycatalog-client 0.4.1 wrapper.
+
+    Owns a background event-loop thread; the aiohttp-backed ApiClient is
+    constructed on that loop and every SDK coroutine is dispatched to it via
+    :meth:`run`. API objects (validated to exist in 0.4.1):
+    catalogs, schemas, volumes, functions, models, model_versions, temp_creds.
+    """
+
+    def __init__(self, host: str, token: str | None = None):
+        self._loop = asyncio.new_event_loop()
+        self._thread = threading.Thread(
+            target=self._loop.run_forever, name="uc-sdk-loop", daemon=True
+        )
+        self._thread.start()
+        self._api_client = self.run(self._make_client(host, token))
+
+        from unitycatalog.client.api import (
+            CatalogsApi,
+            FunctionsApi,
+            ModelVersionsApi,
+            RegisteredModelsApi,
+            SchemasApi,
+            TemporaryCredentialsApi,
+            VolumesApi,
+        )
+
+        self.catalogs = CatalogsApi(self._api_client)
+        self.schemas = SchemasApi(self._api_client)
+        self.volumes = VolumesApi(self._api_client)
+        self.functions = FunctionsApi(self._api_client)
+        self.models = RegisteredModelsApi(self._api_client)
+        self.model_versions = ModelVersionsApi(self._api_client)
+        self.temp_creds = TemporaryCredentialsApi(self._api_client)
+
+    @staticmethod
+    async def _make_client(host: str, token: str | None):
+        # Import + construct inside the running loop: aiohttp>=3.10 requires it.
+        from unitycatalog.client import ApiClient, Configuration
+
+        return ApiClient(configuration=Configuration(host=host, access_token=token))
+
+    def run(self, coro, timeout: float = 120.0):
+        return asyncio.run_coroutine_threadsafe(coro, self._loop).result(timeout)
+
+    def close(self):
+        try:
+            self.run(self._api_client.close())
+        finally:
+            self._loop.call_soon_threadsafe(self._loop.stop)
+            self._thread.join(timeout=10)
+
+
+@pytest.fixture(scope="session")
+def uc(server) -> UcSdk:
+    sdk = UcSdk(UC_HOST, token=TOKEN)
+    yield sdk
+    sdk.close()
+
+
+def uc_error(exc_info) -> dict:
+    """Parse the UC error envelope out of an ApiException."""
+    exc = exc_info.value if hasattr(exc_info, "value") else exc_info
+    try:
+        return json.loads(exc.body or "{}")
+    except (TypeError, ValueError):
+        return {}
+
+
+def assert_uc_error(exc_info, status: int, error_code: str | None = None):
+    exc = exc_info.value if hasattr(exc_info, "value") else exc_info
+    assert exc.status == status, f"expected HTTP {status}, got {exc.status}: {exc.body}"
+    if error_code is not None:
+        body = uc_error(exc)
+        assert body.get("error_code") == error_code, (
+            f"expected error_code={error_code}, got body: {exc.body}"
+        )
+
+
+# ─────────────────────────────────────────────────────────────────────────────
+# unitycatalog-ai bridge (sync facade needs a running loop, see module docs)
+# ─────────────────────────────────────────────────────────────────────────────
+
+
+@pytest.fixture()
+def uc_ai():
+    """Run ``fn(client)`` with a UnitycatalogFunctionClient inside a loop.
+
+    Usage::
+
+        def test_x(uc_ai):
+            def scenario(client):        # sync code, sync SDK facade works
+                client.create_python_function(...)
+                return client.execute_function(...)
+            result = uc_ai(scenario)
+    """
+
+    def runner(fn, execution_mode: str = "sandbox"):
+        async def amain():
+            from unitycatalog.ai.core.client import UnitycatalogFunctionClient
+            from unitycatalog.client import ApiClient, Configuration
+
+            api = ApiClient(
+                configuration=Configuration(host=UC_HOST, access_token=TOKEN)
+            )
+            client = UnitycatalogFunctionClient(
+                api_client=api, execution_mode=execution_mode
+            )
+            try:
+                return fn(client)
+            finally:
+                await api.close()
+
+        loop = asyncio.new_event_loop()
+        asyncio.set_event_loop(loop)
+        try:
+            return loop.run_until_complete(amain())
+        finally:
+            asyncio.set_event_loop(None)
+            loop.close()
+
+    return runner
+
+
+# ─────────────────────────────────────────────────────────────────────────────
+# Management API: bootstrap + warehouse
+# ─────────────────────────────────────────────────────────────────────────────
+
+
+@dataclasses.dataclass
+class Server:
+    client: httpx.Client
+    info: dict
+    bootstrapped: bool
+    bootstrap_error: str | None = None
+
+
+def _storage_profile() -> dict:
+    # Mirrors tests/python/tests/conftest.py (S3-compatible + vended creds)
+    # and docs/docs/storage.md "S3-compatible" guidance: MinIO supports
+    # AssumeRole STS with plain access keys, so vended credentials work with
+    # sts-enabled=true + flavor=s3-compat and NO sts-role-arn.
+    return {
+        "type": "s3",
+        "bucket": S3_BUCKET,
+        "key-prefix": S3_KEY_PREFIX,
+        "endpoint": S3_ENDPOINT,
+        "sts-endpoint": S3_ENDPOINT,
+        "region": S3_REGION,
+        "path-style-access": True,
+        "flavor": "s3-compat",
+        "sts-enabled": True,
+    }
+
+
+def _storage_credential() -> dict:
+    return {
+        "type": "s3",
+        "credential-type": "access-key",
+        "aws-access-key-id": S3_ACCESS_KEY,
+        "aws-secret-access-key": S3_SECRET_KEY,
+    }
+
+
+def _ensure_bucket_and_user():
+    """boto3 fallback for environments where minio-init could not run."""
+    root = boto3.client(
+        "s3",
+        endpoint_url=S3_ENDPOINT,
+        aws_access_key_id=S3_ROOT_ACCESS_KEY,
+        aws_secret_access_key=S3_ROOT_SECRET_KEY,
+        region_name=S3_REGION,
+        config=BotoConfig(s3={"addressing_style": "path"}),
+    )
+    try:
+        root.head_bucket(Bucket=S3_BUCKET)
+    except Exception:
+        try:
+            root.create_bucket(Bucket=S3_BUCKET)
+        except Exception as e:  # pragma: no cover - diagnostics only
+            pytest.exit(f"Cannot create bucket {S3_BUCKET} on {S3_ENDPOINT}: {e}")
+
+
+@pytest.fixture(scope="session")
+def server() -> Server:
+    headers = {"Authorization": f"Bearer {TOKEN}"} if TOKEN else {}
+    client = httpx.Client(base_url=BASE_URL, headers=headers, timeout=30.0)
+
+    # Wait for the server (run.sh already waits; this covers direct pytest use).
+    deadline = time.time() + 60
+    while True:
+        try:
+            client.get("/health").raise_for_status()
+            break
+        except Exception:
+            if time.time() > deadline:
+                pytest.exit(f"Lakekeeper not reachable at {BASE_URL}")
+            time.sleep(1)
+
+    info = client.get("/management/v1/info")
+    info.raise_for_status()
+    info = info.json()
+
+    bootstrapped = bool(info.get("bootstrapped"))
+    bootstrap_error = None
+    if not bootstrapped:
+        # POST /management/v1/bootstrap, body per management-open-api.yaml
+        # (required: accept-terms-of-use). Works anonymously with the
+        # AllowAll authorizer; the OpenFGA authorizer rejects anonymous
+        # bootstrap — recorded instead of failing so MODE=openfga can assert
+        # the rejection.
+        resp = client.post(
+            "/management/v1/bootstrap", json={"accept-terms-of-use": True}
+        )
+        if resp.status_code < 300:
+            bootstrapped = True
+        else:
+            bootstrap_error = f"{resp.status_code}: {resp.text}"
+
+    srv = Server(
+        client=client,
+        info=info,
+        bootstrapped=bootstrapped,
+        bootstrap_error=bootstrap_error,
+    )
+    yield srv
+    client.close()
+
+
+@pytest.fixture(scope="session")
+def warehouse(server: Server) -> dict:
+    """Ensure the `uc_e2e` warehouse exists in the default project.
+
+    Returns ``{"id": ..., "name": ...}``. The warehouse doubles as the UC
+    *catalog* (design D2: UC catalog == Lakekeeper warehouse).
+    """
+    if not server.bootstrapped:
+        pytest.skip(
+            "Server could not be bootstrapped anonymously "
+            f"({server.bootstrap_error}); data-plane tests need MODE=allowall "
+            "or an IdP token via UC_TEST_TOKEN."
+        )
+
+    _ensure_bucket_and_user()
+    mgmt = server.client
+
+    listing = mgmt.get(
+        "/management/v1/warehouse", params={"project-id": DEFAULT_PROJECT_ID}
+    )
+    listing.raise_for_status()
+    for wh in listing.json().get("warehouses", []):
+        if wh.get("name") == WAREHOUSE_NAME:
+            return {"id": wh["id"], "name": WAREHOUSE_NAME}
+
+    payload = {
+        "warehouse-name": WAREHOUSE_NAME,
+        "project-id": DEFAULT_PROJECT_ID,
+        "storage-profile": _storage_profile(),
+        "storage-credential": _storage_credential(),
+    }
+    resp = mgmt.post("/management/v1/warehouse", json=payload)
+    assert resp.status_code < 300, (
+        f"warehouse creation failed ({resp.status_code}): {resp.text}"
+    )
+    return {"id": resp.json()["warehouse-id"], "name": WAREHOUSE_NAME}
+
+
+@pytest.fixture()
+def schema(uc: UcSdk, warehouse: dict) -> dict:
+    """A fresh UC schema (top-level Lakekeeper namespace) per test."""
+    from unitycatalog.client.models import CreateSchema
+
+    name = unique_name("sch")
+    info = uc.run(
+        uc.schemas.create_schema(
+            CreateSchema(name=name, catalog_name=warehouse["name"])
+        )
+    )
+    yield {
+        "name": name,
+        "catalog_name": warehouse["name"],
+        "full_name": f"{warehouse['name']}.{name}",
+        "info": info,
+    }
+    try:
+        uc.run(uc.schemas.delete_schema(f"{warehouse['name']}.{name}", force=True))
+    except Exception:
+        pass
+
+
+# ─────────────────────────────────────────────────────────────────────────────
+# S3 helpers (vended credentials → boto3)
+# ─────────────────────────────────────────────────────────────────────────────
+
+
+def s3_client_from_creds(temp_creds):
+    """boto3 S3 client from a UC TemporaryCredentials response."""
+    aws = temp_creds.aws_temp_credentials
+    assert aws is not None, f"expected aws_temp_credentials, got: {temp_creds}"
+    return boto3.client(
+        "s3",
+        endpoint_url=S3_ENDPOINT,
+        aws_access_key_id=aws.access_key_id,
+        aws_secret_access_key=aws.secret_access_key,
+        aws_session_token=aws.session_token,
+        region_name=S3_REGION,
+        config=BotoConfig(s3={"addressing_style": "path"}),
+    )
+
+
+def split_s3_uri(uri: str) -> tuple[str, str]:
+    assert uri.startswith("s3://"), uri
+    bucket, _, key = uri[len("s3://") :].partition("/")
+    return bucket, key.rstrip("/")
